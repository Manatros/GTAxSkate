+    /// SkateMods: the player's own setup from the options menu: truck
+    /// tightness and wheel hardness (0 to 1), the trainer multipliers in
+    /// `TrainerTuning` field order (pop, grind pop, push speed, push power,
+    /// braking, steering, wobble, off-board jump, grip, turn power, manual
+    /// drag; each positive) and hold-fakie. False (unchanged) when a value
+    /// is out of range.
+    pub fn set_player_setup(&mut self, truck: f32, wheel: f32, tuning: [f32; 11], hold_fakie: bool) -> bool {
+        if tuning.iter().any(|v| !v.is_finite() || *v <= 0.) || !truck.is_finite() || !wheel.is_finite() {
+            return false;
+        }
+        self.physics.set_equipment_preferences(truck, wheel);
+        let [pop, grind_pop, push_speed, push_power, braking, steering, wobble, offboard_jump, grip, turn_power, manual_drag] =
+            tuning;
+        self.physics.trainer = crate::tuning::TrainerTuning {
+            pop, grind_pop, push_speed, push_power, braking, steering, wobble, offboard_jump, grip, turn_power, manual_drag,
+            hold_fakie,
+        };
+        true
+    }
