+/// Puts the body (`bones`) in the world on the skater's spot (`root`).
+/// Skate's render pose comes about the animation's origin at some moments
+/// and in the world at others: whichever puts the hips nearer the skater
+/// is taken. A body still off the spot (its hips more than `REACH` across,
+/// or far above or below) is moved onto it, so it can not drift away from
+/// the skater and the camera.
+fn settle(root: &Mat4, names: &[String], bones: &mut [Mat4]) {
+    const REACH: f32 = 0.75;
+    const HIPS_HEIGHT: f32 = 0.95;
+    let Some(hips) = names.iter().position(|n| n.eq_ignore_ascii_case("HIPS")).filter(|&i| i < bones.len()) else {
+        return;
+    };
+    let stand = root.w_axis.truncate();
+    let across = |p: Vec3| Vec2::new(p.x - stand.x, p.z - stand.z).length();
+    let raw = bones[hips].w_axis.truncate();
+    if across(root.transform_point3(raw)) < across(raw) {
+        for bone in bones.iter_mut() {
+            *bone = *root * *bone;
+        }
+    }
+    let at = bones[hips].w_axis.truncate();
+    let mut offset = Vec3::ZERO;
+    if across(at) > REACH {
+        offset.x = stand.x - at.x;
+        offset.z = stand.z - at.z;
+    }
+    if (at.y - stand.y).abs() > 2.5 {
+        offset.y = stand.y + HIPS_HEIGHT - at.y;
+    }
+    if offset != Vec3::ZERO && offset.is_finite() {
+        for bone in bones.iter_mut() {
+            bone.w_axis += offset.extend(0.);
         }
     }
 }
 
