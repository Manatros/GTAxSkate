+/// Keeps the checkpoint (the last calm moment outside a trick sequence)
+/// and carries out a requested return.
+fn checkpoint(session: &mut SessionMarker, physics: &GamePhysics, skater: &mut SkaterRuntime) {
+    let p = &skater.player_input.physical;
+    let state = p.state.state_16;
+    let deck = physics.board.part_transforms()[BodyId::Deck.index()];
+    let rolling = p.state.category_12 == 100 && p.collision.wheel_count_0 >= 2 && state != 104 && deck.basis.columns[1][1] > 0.71;
+    let standing = p.state.category_12 == 500 && state == 500;
+    if (rolling || standing) && !skater.scoring.in_sequence() && !session.return_requested {
+        let (transform, on_board) = here(physics, skater);
+        session.checkpoint = Some(Marker { transform, on_board, foot_forward: skater.animation.foot_forward(), generation: 0 });
+    }
+    if !session.return_requested {
+        return;
+    }
+    let ready = p.state.flag_69 == 0
+        && state != 702
+        && !(physics.board_wiping_out && p.skeleton.teleport_pending_604 != 0)
+        && skater.player_input.pending_teleport().is_none();
+    if !ready {
+        return;
+    }
+    session.return_requested = false;
+    let Some(target) = session.marker.or(session.checkpoint) else { return };
+    match skater.player_input.request_teleport(target.transform) {
+        Ok(()) => {
+            skater.animation.restore_foot_forward(target.foot_forward);
+            skater.teleport_state.request_manual(target.transform, target.on_board);
+            bevy::log::info!("Skate: back to the {}", if session.marker.is_some() { "session marker" } else { "checkpoint" });
+        }
+        Err(e) => warn!("Skate return rejected: {e}"),
+    }
+}
