diff --git a/rust/skatev-runtime/src/lib.rs b/rust/skatev-runtime/src/lib.rs
index 40bfd87..39f069a 100644
--- a/rust/skatev-runtime/src/lib.rs
+++ b/rust/skatev-runtime/src/lib.rs
@@ -1034,6 +1034,33 @@ pub unsafe extern "C" fn sv_set_difficulty(rt: *mut c_void, index: u32) -> u32 {
     })
 }
 
+/// SkateMods: the player's setup from SkateGTA.asi's options menu: truck
+/// tightness and wheel hardness (0 to 1), `tuning` = 11 positive multipliers
+/// (pop, grind pop, push speed, push power, braking, steering, wobble,
+/// off-board jump, grip, turn power, manual drag), hold-fakie. Kept for every
+/// later session. Returns 1 when taken.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn sv_set_player_setup(rt: *mut c_void, truck: f32, wheel: f32, tuning: *const f32, hold_fakie: u32) -> u32 {
+    guard(0, || {
+        let Some(rt) = (unsafe { runtime(rt) }) else { return 0 };
+        if tuning.is_null() {
+            return 0;
+        }
+        let mut t = [1.0f32; 11];
+        t.copy_from_slice(unsafe { std::slice::from_raw_parts(tuning, 11) });
+        if t.iter().any(|v| !v.is_finite() || *v <= 0.) || !truck.is_finite() || !wheel.is_finite() {
+            return 0;
+        }
+        *worker::PLAYER_SETUP.lock().unwrap_or_else(|e| e.into_inner()) = Some(worker::PlayerSetup {
+            truck: truck.clamp(0., 1.),
+            wheel: wheel.clamp(0., 1.),
+            tuning: t,
+            hold_fakie: hold_fakie != 0,
+        });
+        rt.jobs.send(Job::PlayerSetup).is_ok() as u32
+    })
+}
+
 /// The SkateV ramp-lip rule (overlay patch 0033): nonzero (the default) lets
 /// a rolling board stall on a lip only riding up into it slowly; 0 restores
