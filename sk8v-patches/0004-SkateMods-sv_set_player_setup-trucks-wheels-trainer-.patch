                     camera_type = t;
@@ -1688,8 +1696,28 @@ fn life(shared: &Mutex<Shared>, f: impl FnOnce(&mut LifecycleShared)) {
 
 /// The host settings a new session starts with; later changes are applied
 /// by their jobs (plain session fields, kept across activations).
+/// SkateMods: truck tightness, wheel hardness, the 11 trainer multipliers
+/// and hold-fakie from SkateGTA.asi's options menu; every new session takes
+/// them too.
+#[derive(Clone, Copy, Debug)]
+pub struct PlayerSetup {
+    pub truck: f32,
+    pub wheel: f32,
+    pub tuning: [f32; 11],
+    pub hold_fakie: bool,
+}
+pub static PLAYER_SETUP: std::sync::Mutex<Option<PlayerSetup>> = std::sync::Mutex::new(None);
+
+fn apply_player_setup(s: &mut Session) {
+    let setup = *PLAYER_SETUP.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(p) = setup {
+        s.set_player_setup(p.truck, p.wheel, p.tuning, p.hold_fakie);
+    }
+}
+
 fn apply_settings(s: &mut Session, hall_of_meat: bool, bail: Option<f32>, air: Option<f32>, lip: bool, difficulty: u32,
                   camera_type: u32) {
+    apply_player_setup(s);
     s.set_hall_of_meat(hall_of_meat);
     s.set_difficulty(difficulty);
     s.set_camera_type(camera_type);
