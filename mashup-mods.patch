diff --git a/crates/frame/src/audio_device.rs b/crates/frame/src/audio_device.rs
new file mode 100644
index 0000000..fb3450f
--- /dev/null
+++ b/crates/frame/src/audio_device.rs
@@ -0,0 +1,46 @@
+//! The sound output device the player picked in the options.
+
+use bevy::prelude::*;
+
+/// Which output device the game's sound goes to.
+#[derive(Resource, Default, Clone, Debug, PartialEq)]
+pub struct AudioDevice {
+    /// The device asked for; `None` follows the system's default device.
+    pub wanted: Option<String>,
+    /// Steps through the device list asked for and not yet taken (the
+    /// options' "next device").
+    pub step: i32,
+    /// The device sound goes to now, as the audio last opened it.
+    pub current: Option<String>,
+}
+
+impl AudioDevice {
+    /// The name to show for the device sound goes to.
+    pub fn label(&self) -> String {
+        self.current.clone().unwrap_or_else(|| "System default".to_owned())
+    }
+
+    /// The device `step` places on from `wanted` in `names`, the system's
+    /// default counting as the place before the first.
+    pub fn stepped(wanted: Option<&str>, names: &[String], step: i32) -> Option<String> {
+        let places = names.len() as i32 + 1;
+        let at = wanted.and_then(|w| names.iter().position(|n| n == w)).map_or(0, |i| i as i32 + 1);
+        let next = (at + step).rem_euclid(places);
+        (next > 0).then(|| names[next as usize - 1].clone())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stepping_goes_round_the_devices_and_the_default() {
+        let names = vec!["Speakers".to_owned(), "Headset".to_owned()];
+        assert_eq!(AudioDevice::stepped(None, &names, 1).as_deref(), Some("Speakers"));
+        assert_eq!(AudioDevice::stepped(Some("Speakers"), &names, 1).as_deref(), Some("Headset"));
+        assert_eq!(AudioDevice::stepped(Some("Headset"), &names, 1), None);
+        assert_eq!(AudioDevice::stepped(None, &names, -1).as_deref(), Some("Headset"));
+        assert_eq!(AudioDevice::stepped(Some("Unplugged"), &names, 1).as_deref(), Some("Speakers"));
+    }
+}
