+/// The controller button that hands the pad to the weapons.
+fn skate_layer_button(layer: skate_rules::PadLayer) -> Option<crate::binds::PadButton> {
+    use crate::binds::PadButton as P;
+    match layer {
+        skate_rules::PadLayer::Back => Some(P::Select),
+        skate_rules::PadLayer::Lb => Some(P::LeftBumper),
+        skate_rules::PadLayer::Rb => Some(P::RightBumper),
+        skate_rules::PadLayer::LeftStick => Some(P::LeftStick),
+        skate_rules::PadLayer::DpadUp => Some(P::DpadUp),
+        skate_rules::PadLayer::DpadDown => Some(P::DpadDown),
+        skate_rules::PadLayer::Off => None,
+    }
