+/// Skate 3's ground surfaces, its `physics_surfaces` profiles: how fast the
+/// board rolls, how it slides and brakes.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum Surface {
+    /// Concrete, wood, metal, tile.
+    #[default]
+    Smooth = 1,
+    /// Asphalt, brick, rock, gravel.
+    Rough = 2,
+    /// Grass, dirt, carpet.
+    Slow = 3,
+    /// Ice.
+    Slippery = 4,
+    /// Sand, mud, snow, water.
+    VerySlow = 5,
+}
+
+impl Surface {
+    /// The surface numbered `index` (1 to 5); anything else is smooth.
+    pub fn from_index(index: u8) -> Self {
+        match index {
+            2 => Self::Rough,
+            3 => Self::Slow,
+            4 => Self::Slippery,
+            5 => Self::VerySlow,
+            _ => Self::Smooth,
+        }
+    }
+}
+
+fn material(name: &str, physics: u32) -> skate_data::skate_map::Material {
+    skate_data::skate_map::Material {
+        name: name.into(),
+        flags: 0,
+        friction: 0.8,
+        restitution: 0.,
+        color: [1.; 3],
+        roughness: 1.,
+        emissive: 0.,
+        textures: [0; 5],
+        indirect_strength: 1.,
+        alpha_mode: 0,
+        alpha_cutoff: 0.5,
+        audio: 0,
+        physics,
+        pattern: 0,
+        depth_layer: None,
+        retail_definition: None,
+    }
+}
+
+/// IW4L's collision as a Skate map: the triangles, each with a material
+/// for its ground surface (one material when none are given), and rails.
+fn collision_map(
+    triangles: Vec<[[f32; 3]; 3]>,
+    surfaces: Option<&[Surface]>,
+    rails: Vec<Vec<[f32; 3]>>,
+    spawn: [f32; 3],
+    heading: f32,
+) -> SkateMap {
+    let materials = match surfaces {
+        None => vec![material("MW2", 0)],
+        // Material n (1-based) is surface n.
+        Some(_) => ["smooth", "rough", "slow", "slippery", "veryslow"]
+            .iter()
+            .enumerate()
+            .map(|(i, name)| material(name, i as u32 + 1))
+            .collect(),
+    };
+    let material_of = |i: usize| -> u32 {
+        surfaces.map_or(1, |s| s.get(i).copied().unwrap_or_default() as u32)
+    };
+    SkateMap {
+            version: 14,
+            name: "IW4L collision".into(),
+            spawn,
+            heading,
+            environment: vec![],
+            materials,
+            textures: vec![],
+            geometry: Geometry {
+                vertices: vec![],
+                indices: vec![],
+                collision: triangles
+                    .into_iter()
+                    .enumerate()
+                    .map(|(i, points)| Collision {
+                        points,
+                        surface: 0,
+                        material: material_of(i),
+                        native_edges: None,
+                    })
+                    .collect(),
+            },
+            rails: rails
+                .into_iter()
+                .enumerate()
+                .map(|(i, p)| Rail {
+                    name: format!("iw4_edge_{i}"),
+                    closed: false,
+                    points: p,
+                    native: None,
+                })
+                .collect(),
+            doors: vec![],
+            lights: vec![],
+            routes: vec![],
+            extensions: vec![],
+    }
+}
