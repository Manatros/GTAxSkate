+
+/// Skate 3's physics modes, which the game calls difficulty.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum SkateDifficulty {
+    #[default]
+    Easy,
+    Normal,
+    Hardcore,
+}
+
+impl SkateDifficulty {
+    pub const ALL: [Self; 3] = [Self::Easy, Self::Normal, Self::Hardcore];
+    /// The key Skate's `physics_mode` collection uses.
+    pub fn key(self) -> &'static str {
+        match self {
+            Self::Easy => "easy",
+            Self::Normal => "normal",
+            Self::Hardcore => "hardcore",
+        }
+    }
+    pub fn parse(value: &str) -> Option<Self> {
+        Self::ALL.into_iter().find(|d| d.key().eq_ignore_ascii_case(value))
+    }
+}
+
+/// The tunable multipliers, in [`SkateSettings::tuning`] order: console
+/// name and what it changes. 1 is Skate 3's own value.
+pub const SKATE_TUNING: [(&str, &str); 11] = [
+    ("pop", "ollie and flip pop height"),
+    ("grindpop", "pop out of grinds"),
+    ("pushspeed", "top pushing speed"),
+    ("pushpower", "speed each push adds"),
+    ("braking", "braking force"),
+    ("steering", "steering"),
+    ("wobble", "speed wobble"),
+    ("offboardjump", "jump height off the board"),
+    ("grip", "grip of wheels and slides"),
+    ("turnpower", "turning strength"),
+    ("manualdrag", "drag while manualling"),
+];
+const TUNING_RANGE: (f32, f32) = (0.1, 5.0);
+
+/// Skate 3's options as the player sets them with the `skate` console
+/// command: physics difficulty, the board's trucks and wheels, and the
+/// engine's tuning multipliers.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SkateSettings {
+    pub difficulty: SkateDifficulty,
+    /// 0 loose to 1 tight.
+    pub truck_tightness: f32,
+    /// 0 soft to 1 hard.
+    pub wheel_hardness: f32,
+    pub tuning: [f32; SKATE_TUNING.len()],
+    /// The engine's hold-fakie option.
+    pub hold_fakie: bool,
+    /// How a fall off the board hurts.
+    pub fall: skate_rules::FallRules,
+    /// First or third person, and whether skate mode starts on foot.
+    pub camera: skate_rules::CameraRule,
+    pub start: skate_rules::StartRule,
+    /// Weapons, the board as a weapon, killstreaks and crafting while
+    /// skating.
+    pub combat: skate_rules::Combat,
+    /// The board's sounds, 0 (off) to 1.
+    pub board_volume: f32,
+    /// A bail goes back to the checkpoint (the session marker, or where
+    /// the failed line started) by itself, or only on its key.
+    pub auto_retry: bool,
+    /// The class editor's board preview shows Skate's skater holding the
+    /// board, or the board alone.
+    pub preview_skater: bool,
+    /// The controls show on screen while skating and building.
+    pub show_controls: bool,
+}
+
+impl Default for SkateSettings {
+    fn default() -> Self {
+        Self {
+            difficulty: SkateDifficulty::Easy,
+            truck_tightness: 0.7,
+            wheel_hardness: 0.7,
+            tuning: [1.0; SKATE_TUNING.len()],
+            hold_fakie: false,
+            fall: skate_rules::FallRules::default(),
+            camera: skate_rules::CameraRule::default(),
+            start: skate_rules::StartRule::default(),
+            combat: skate_rules::Combat::default(),
+            board_volume: 0.8,
+            auto_retry: true,
+            // The board alone: held by the skater it is too small to see.
+            preview_skater: false,
+            show_controls: true,
+        }
+    }
+}
+
+fn unit(value: &str, what: &str) -> Result<f32, String> {
+    match value.parse::<f32>() {
+        Ok(v) if (0.0..=1.0).contains(&v) => Ok(v),
+        _ => Err(format!("{what} is 0 (loose/soft) to 1 (tight/hard), not {value:?}")),
+    }
+}
+
+fn on_off(value: &str) -> Option<bool> {
+    match value.to_ascii_lowercase().as_str() {
+        "on" | "1" | "true" => Some(true),
+        "off" | "0" | "false" => Some(false),
+        _ => None,
+    }
+}
+
+impl SkateSettings {
+    pub const USAGE: &str = "skate [on|off|status|settings|reset] | skate difficulty easy|normal|hardcore | skate trucks|wheels 0-1 | skate holdfakie on|off | skate falldamage mw2|skate|off | skate camera auto|third|first | skate start foot|board | skate guns|melee|ram|killstreaks|crafting on|off | skate padaim back|lb|rb|ls|up|down|off | skate sound 0-100 | skate checkpoint auto|key | skate preview skater|board | skate controls on|off | skate tune <name> 0.1-5 (names: pop grindpop pushspeed pushpower braking steering wobble offboardjump grip turnpower manualdrag)";
+
+    /// Applies a `skate` console command's arguments (`difficulty hardcore`,
+    /// `tune pop 1.5`, ...). Returns what changed, or why nothing did.
+    pub fn command(&mut self, args: &[String]) -> Result<String, String> {
+        let arg = |i: usize| args.get(i).map(String::as_str);
+        match (arg(0), arg(1), arg(2)) {
+            (Some("difficulty"), Some(value), None) => {
+                let d = SkateDifficulty::parse(value)
+                    .ok_or_else(|| format!("difficulty is easy, normal or hardcore, not {value:?}"))?;
+                self.difficulty = d;
+                Ok(format!("skate difficulty {}", d.key()))
+            }
+            (Some("trucks"), Some(value), None) => {
+                self.truck_tightness = unit(value, "trucks")?;
+                Ok(format!("skate trucks {:.2}", self.truck_tightness))
+            }
+            (Some("wheels"), Some(value), None) => {
+                self.wheel_hardness = unit(value, "wheels")?;
+                Ok(format!("skate wheels {:.2}", self.wheel_hardness))
+            }
+            (Some("holdfakie"), Some(value), None) => {
+                self.hold_fakie = on_off(value).ok_or_else(|| format!("holdfakie is on or off, not {value:?}"))?;
+                Ok(format!("skate holdfakie {}", if self.hold_fakie { "on" } else { "off" }))
+            }
+            (Some("tune"), Some(name), Some(value)) => {
+                let index = SKATE_TUNING
+                    .iter()
+                    .position(|(key, _)| key.eq_ignore_ascii_case(name))
+                    .ok_or_else(|| format!("no tuning called {name:?}; try skate settings"))?;
+                let v = value
+                    .parse::<f32>()
+                    .ok()
+                    .filter(|v| (TUNING_RANGE.0..=TUNING_RANGE.1).contains(v))
+                    .ok_or_else(|| format!("{name} is {} to {}, not {value:?}", TUNING_RANGE.0, TUNING_RANGE.1))?;
+                self.tuning[index] = v;
+                Ok(format!("skate tune {} {v:.2}", SKATE_TUNING[index].0))
+            }
+            (Some("falldamage"), Some(value), None) => {
+                self.fall = skate_rules::FallRules::parse(value)
+                    .ok_or_else(|| format!("falldamage is mw2, skate or off, not {value:?}"))?;
+                Ok(format!("skate falldamage {}", self.fall.key()))
+            }
+            (Some("camera"), Some(value), None) => {
+                self.camera = skate_rules::CameraRule::parse(value)
+                    .ok_or_else(|| format!("camera is auto, third or first, not {value:?}"))?;
+                Ok(format!("skate camera {}", self.camera.key()))
+            }
+            (Some("start"), Some(value), None) => {
+                self.start = skate_rules::StartRule::parse(value)
+                    .ok_or_else(|| format!("start is foot or board, not {value:?}"))?;
+                Ok(format!("skate start {}", self.start.key()))
+            }
+            (Some("sound"), Some(value), None) => {
+                let v = value
+                    .parse::<f32>()
+                    .ok()
+                    .filter(|v| (0.0..=100.0).contains(v))
+                    .ok_or_else(|| format!("sound is the board's volume, 0 to 100, not {value:?}"))?;
+                self.board_volume = v / 100.;
+                Ok(format!("skate sound {}", v.round()))
+            }
+            (Some("checkpoint"), Some(value), None) => {
+                self.auto_retry = match value.to_ascii_lowercase().as_str() {
+                    "auto" | "on" => true,
+                    "key" | "off" => false,
+                    _ => return Err(format!("checkpoint is auto (back after a bail) or key, not {value:?}")),
+                };
+                Ok(format!("skate checkpoint {}", if self.auto_retry { "auto" } else { "key" }))
+            }
+            (Some("controls"), Some(value), None) => {
+                self.show_controls = on_off(value).ok_or_else(|| format!("controls (on screen) is on or off, not {value:?}"))?;
+                Ok(format!("skate controls {}", if self.show_controls { "on" } else { "off" }))
+            }
+            (Some("preview"), Some(value), None) => {
+                self.preview_skater = match value.to_ascii_lowercase().as_str() {
+                    "skater" | "character" => true,
+                    "board" => false,
+                    _ => return Err(format!("preview is skater (holding the board) or board, not {value:?}")),
+                };
+                Ok(format!("skate preview {}", if self.preview_skater { "skater" } else { "board" }))
+            }
+            (Some("padaim"), Some(value), None) => {
+                self.combat.pad_layer = skate_rules::PadLayer::parse(value)
+                    .ok_or_else(|| format!("padaim is back, lb, rb, ls, up, down or off, not {value:?}"))?;
+                Ok(format!("skate padaim {}", self.combat.pad_layer.key()))
+            }
+            (Some(name), Some(value), None) if self.combat.switch(name).is_some() => {
+                let on = on_off(value).ok_or_else(|| format!("{name} is on or off, not {value:?}"))?;
+                *self.combat.switch(name).expect("checked") = on;
+                Ok(format!("skate {} {}", name.to_ascii_lowercase(), if on { "on" } else { "off" }))
+            }
+            (Some("reset"), None, None) => {
+                *self = Self::default();
+                Ok("skate settings reset to Skate 3's own".into())
+            }
+            _ => Err(format!("usage: {}", Self::USAGE)),
+        }
+    }
+
+    /// The settings as console lines.
+    pub fn describe(&self) -> Vec<String> {
+        let mut lines = vec![
+            format!("difficulty {}", self.difficulty.key()),
+            format!("trucks {:.2}  wheels {:.2}  holdfakie {}", self.truck_tightness, self.wheel_hardness, if self.hold_fakie { "on" } else { "off" }),
+            format!("sound {}  checkpoint {}", (self.board_volume * 100.).round(), if self.auto_retry { "auto" } else { "key" }),
+        ];
+        let combat = self.combat;
+        let on = |v: bool| if v { "on" } else { "off" };
+        lines.push(format!(
+            "guns {}  melee {}  ram {}  killstreaks {}  crafting {}  padaim {}",
+            on(combat.guns),
+            on(combat.melee),
+            on(combat.ram),
+            on(combat.streaks),
+            on(combat.crafting),
+            combat.pad_layer.key()
+        ));
+        for ((name, what), value) in SKATE_TUNING.iter().zip(self.tuning) {
+            lines.push(format!("tune {name} {value:.2} ({what})"));
+        }
+        lines
+    }
+
+    /// One `key value` line each, for the settings file.
+    pub fn to_text(&self) -> String {
+        let mut text = format!(
+            "difficulty {}\ntrucks {}\nwheels {}\nholdfakie {}\n",
+            self.difficulty.key(),
+            self.truck_tightness,
+            self.wheel_hardness,
+            if self.hold_fakie { "on" } else { "off" },
+        );
+        text.push_str(&format!("falldamage {}\n", self.fall.key()));
+        text.push_str(&format!("camera {}\nstart {}\n", self.camera.key(), self.start.key()));
+        for name in skate_rules::Combat::SWITCHES {
+            let on = *self.combat.clone().switch(name).expect("a switch");
+            text.push_str(&format!("{name} {}\n", if on { "on" } else { "off" }));
+        }
+        text.push_str(&format!("padaim {}\n", self.combat.pad_layer.key()));
+        text.push_str(&format!("sound {}\n", (self.board_volume * 100.).round()));
+        text.push_str(&format!("checkpoint {}\n", if self.auto_retry { "auto" } else { "key" }));
+        text.push_str(&format!("preview {}\n", if self.preview_skater { "skater" } else { "board" }));
+        text.push_str(&format!("controls {}\n", if self.show_controls { "on" } else { "off" }));
+        for ((name, _), value) in SKATE_TUNING.iter().zip(self.tuning) {
+            text.push_str(&format!("tune {name} {value}\n"));
+        }
+        text
+    }
+
+    /// Reads [`to_text`](Self::to_text); a line it cannot use is skipped,
+    /// so a damaged file costs that setting only.
+    pub fn from_text(text: &str) -> Self {
+        let mut settings = Self::default();
+        for line in text.lines() {
+            let args: Vec<String> = line.split_whitespace().map(str::to_owned).collect();
+            if !args.is_empty() && args[0] != "reset" {
+                let _ = settings.command(&args);
+            }
+        }
+        settings
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(line: &str) -> Vec<String> {
+        line.split_whitespace().map(str::to_owned).collect()
+    }
+
+    #[test]
+    fn riding_with_weapons_is_set_and_kept() {
+        let mut s = SkateSettings::default();
+        assert!(s.command(&args("guns off")).is_ok());
+        assert!(s.command(&args("killstreaks off")).is_ok());
+        assert!(s.command(&args("padaim up")).is_ok());
+        assert!(s.command(&args("ram maybe")).is_err());
+        assert!(s.command(&args("padaim x")).is_err());
+        let back = SkateSettings::from_text(&s.to_text());
+        assert_eq!(back, s);
+        assert!(!back.combat.guns && !back.combat.streaks && back.combat.melee);
+        assert_eq!(back.combat.pad_layer, skate_rules::PadLayer::DpadUp);
+    }
+
+    #[test]
+    fn commands_change_settings_and_reject_bad_values() {
+        let mut s = SkateSettings::default();
+        assert!(s.command(&args("difficulty hardcore")).is_ok());
+        assert_eq!(s.difficulty, SkateDifficulty::Hardcore);
+        assert!(s.command(&args("tune pop 1.5")).is_ok());
+        assert_eq!(s.tuning[0], 1.5);
+        assert!(s.command(&args("trucks 0.2")).is_ok());
+        assert!(s.command(&args("holdfakie on")).is_ok());
+        assert!(s.hold_fakie);
+        for bad in ["difficulty insane", "tune pop 9", "tune jetpack 1", "trucks 2", "holdfakie maybe", "tune pop"] {
+            let before = s.clone();
+            assert!(s.command(&args(bad)).is_err(), "{bad}");
+            assert_eq!(s, before, "{bad} changed something");
+        }
+        assert!(s.command(&args("reset")).is_ok());
+        assert_eq!(s, SkateSettings::default());
+    }
+
+    #[test]
+    fn settings_file_roundtrips() {
+        let mut s = SkateSettings::default();
+        for line in ["difficulty normal", "wheels 0.35", "tune grip 2.25", "tune manualdrag 0.5", "holdfakie on"] {
+            s.command(&args(line)).unwrap();
+        }
+        assert_eq!(SkateSettings::from_text(&s.to_text()), s);
+        assert_eq!(SkateSettings::from_text("nonsense\ntune pop 3\n").tuning[0], 3.0);
+    }
+}
