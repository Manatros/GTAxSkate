+    use asset_game::{MenuCatalog, MenuDef, MenuItem};
+
+    /// The video options page's rows the pages built on it copy.
+    fn video_page() -> MenuDef {
+        let names = [
+            "video_resolution",
+            "video_resolution_label",
+            "video_brightness",
+            "video_brightness_label",
+            "video_display_mode",
+            "video_display_mode_label",
+            "video_advanced",
+            "video_fov",
+            "video_fov_label",
+            "video_title",
+        ];
+        let mut page = MenuDef::default();
+        page.name = "pc_options_video".into();
+        page.items = names
+            .iter()
+            .map(|name| MenuItem {
+                name: (*name).into(),
+                ..Default::default()
+            })
+            .collect();
+        page
+    }
+
+    #[test]
+    fn the_skate_pages_load_on_the_video_page() {
+        let mut catalog = MenuCatalog::default();
+        catalog.menus.insert("pc_options_video".into(), video_page());
+        catalog.load_definitions(include_str!("../menus/skate.json")).unwrap();
+        let main = catalog.get("options_skate").unwrap();
+        let dvars: Vec<&str> = main.items.iter().map(|i| i.dvar.as_str()).filter(|d| !d.is_empty()).collect();
+        assert!(dvars.contains(&"ui_skate_difficulty") && dvars.contains(&"ui_skate_sound"), "{dvars:?}");
+        let feel = catalog.get("options_skate_feel").unwrap();
+        assert!(feel.items.iter().any(|i| i.dvar == "ui_skate_flick_ms"));
+        let tuning = catalog.get("options_skate_tuning").unwrap();
+        assert_eq!(tuning.items.iter().filter(|i| i.dvar.starts_with("ui_skate_tune_")).count(), frame::SKATE_TUNING.len());
+        let keys = catalog.get("options_skate_keys").unwrap();
+        assert!(keys.items.iter().any(|i| i.name == "skate_key_13"));
+        let combat = catalog.get("options_skate_combat").unwrap();
+        let switches: Vec<&str> = combat.items.iter().map(|i| i.dvar.as_str()).filter(|d| !d.is_empty()).collect();
+        assert_eq!(
+            switches,
+            ["ui_skate_guns", "ui_skate_melee", "ui_skate_ram", "ui_skate_killstreaks", "ui_skate_crafting", "ui_skate_padaim"]
+        );
+        for menu in [main, tuning, keys, combat, feel] {
+            let mut rows: Vec<f32> = menu.items.iter().filter(|i| i.vis_exp != "0").map(|i| i.rect.y).collect();
+            rows.dedup();
+            assert!(rows.iter().all(|y| *y < 400.), "{}: rows run off the page", menu.name);
+        }
+    }
+}
