+/// Whether an attached model's bone hangs off the upper body (the gun).
+fn attached_to_upper(dobj: &xmodel_runtime::DObj, i: usize, upper: usize) -> bool {
+    let mut at = dobj.bones[i].parent;
+    while let Some(p) = at {
+        if dobj.bones[p].model == 0 {
+            return under(dobj, p, upper);
+        }
+        at = dobj.bones[p].parent;
+    }
