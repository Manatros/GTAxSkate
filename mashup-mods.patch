+    use playerstate_iw4::buttons as b;
+    const LINGER: f32 = 1.5;
+    const ANGLE2SHORT: f32 = 65536.0 / 360.0;
+    let Some(ps) = ps else { return };
+    let combat = mode.settings.combat;
+    let shooting = cmd.buttons & (b::ATTACK | b::ADS) != 0 || ps.f_weapon_pos_frac > 0.01;
+    if combat.guns && shooting {
+        host.aim_left = LINGER;
+    } else {
+        host.aim_left = (host.aim_left - dt).max(0.);
+    }
+    mode.aiming = combat.guns && host.aim_left > 0.;
+    // The upper body turns to the aim and back, not at once.
+    let target = if mode.aiming { 1. } else { 0. };
+    let step = (dt * 6.).min(1.);
+    mode.aim_blend += (target - mode.aim_blend) * step;
+    if (mode.aim_blend - target).abs() < 0.01 {
+        mode.aim_blend = target;
+    }
+    let Some((camera, fov)) = mode.camera else { return };
+    // First person looks as MW2 does: the mouse turns the view, the board
+    // goes where it goes.
+    if !mode.aiming && !mode.first_person {
+        // MW2 view = command angles + delta angles.
+        let f = camera.forward();
+        let yaw = f.y.atan2(f.x).to_degrees();
+        let pitch = (-f.z).clamp(-1., 1.).asin().to_degrees();
+        let short = |degrees: f32, delta: f32| {
+            let a = (degrees - delta + 180.).rem_euclid(360.) - 180.;
+            (a * ANGLE2SHORT).round() as i32
+        };
+        look.angles[0] = short(pitch, ps.delta_angles[0]);
+        look.angles[1] = short(yaw, ps.delta_angles[1]);
+        return;
+    }
+    let pitch = (look.angles[0] as f32 / ANGLE2SHORT + ps.delta_angles[0]).to_radians();
+    let yaw = (look.angles[1] as f32 / ANGLE2SHORT + ps.delta_angles[1]).to_radians();
+    mode.aim_yaw = yaw;
+    let forward = Vec3::new(pitch.cos() * yaw.cos(), pitch.cos() * yaw.sin(), -pitch.sin());
