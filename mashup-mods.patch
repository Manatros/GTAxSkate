+/// The Skate 3 data folder, the board library in it and the default
+/// skater's board parts, read once.
+struct BoardSources {
+    library: Option<skate_boards::Library>,
+    defaults: skate_boards::Board,
+}
+
+fn board_sources() -> Option<&'static BoardSources> {
+    static SOURCES: OnceLock<Option<BoardSources>> = OnceLock::new();
+    SOURCES
+        .get_or_init(|| {
+            let root = std::path::PathBuf::from(std::env::var_os("IW4L_SKATE_ASSETS")?);
+            let library = if skate_boards::Library::exists(&root) {
+                skate_boards::Library::load(&root)
+                    .map_err(|e| diag::warn!(World, "skate boards: {e}"))
+                    .ok()
+            } else {
+                None
+            };
+            let defaults = skate_boards::Board::default_board(&root, BOARD_TEXTURE_LIMIT)
+                .map_err(|e| diag::warn!(World, "skate boards: default parts: {e}"))
+                .ok()?;
+            Some(BoardSources { library, defaults })
+        })
+        .as_ref()
+}
+
+/// Skate 3's board catalog, when the player has converted it.
+pub fn skate_board_library() -> Option<&'static skate_boards::Library> {
+    board_sources()?.library.as_ref()
+}
