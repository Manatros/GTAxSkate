+//! Everything around the skating, run once a frame by either game: the
+//! Skate menu (LB + Back), the replay recorder and editor (LB + right stick
+//! click for the instant replay), the Hall of Meat, the Game of S.K.A.T.E.
+//! and Own the Spot. The game hands over the skater and the controller and
+//! draws what comes back: HUD items, the replay's pose and camera, and a
+//! few effects.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use crate::editor::{self, Editor};
+use crate::hud::{self, Align, Anchor, Item, Labels, buttons};
+use crate::math::{M4, V3, distance, length, translation};
+use crate::meat::{self, Report, Tracker};
+use crate::menu::{self, Choice, Cursor, Nav, Row};
