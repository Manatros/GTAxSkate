+
+/// Whether a skater's controller button belongs to the board rather than
+/// MW2's binds: all but the D-pad and Start, unless the weapons button is
+/// held, which itself is never MW2's. With LB held (Skate's session-marker
+/// button) the D-pad places and returns to the marker, so it is the
+/// board's too.
+fn skate_pad_claims(
+    button: crate::binds::PadButton,
+    layer: Option<crate::binds::PadButton>,
+    held: bool,
+    marker_held: bool,
+) -> bool {
+    use crate::binds::PadButton as P;
+    if Some(button) == layer {
+        return true;
+    }
+    if held {
+        return false;
+    }
+    let dpad = matches!(button, P::DpadUp | P::DpadDown | P::DpadLeft | P::DpadRight);
+    (dpad && marker_held) || !(dpad || button == P::Start)
+}
+
+/// Whether the mouse moves the trick stick now, so not the aim.
+fn skate_mouse_on_board(
+    controls: &skate_input::Controls,
+    keys: &ButtonInput<KeyCode>,
+    mouse: &ButtonInput<MouseButton>,
+) -> bool {
+    match controls.mouse {
+        skate_input::MouseTrick::Off => false,
+        skate_input::MouseTrick::Always => true,
+        skate_input::MouseTrick::Hold => skate_input::ACTIONS
+            .iter()
+            .position(|(action, ..)| *action == skate_input::Action::MouseTrick)
+            .and_then(|index| controls.keys.get(index))
+            .is_some_and(|names| {
+                names.iter().any(|name| match frame::skate_key(name) {
+                    Some(frame::SkateKeyInput::Key(key)) => keys.pressed(key),
+                    Some(frame::SkateKeyInput::Mouse(button)) => mouse.pressed(button),
+                    None => false,
+                })
+            }),
+    }
+}
+
+#[cfg(test)]
+mod skate_pad_tests {
+    use super::*;
+    use crate::binds::PadButton as P;
+
+    #[test]
+    fn the_weapons_button_hands_the_pad_over() {
+        let layer = skate_layer_button(skate_rules::PadLayer::default());
+        assert_eq!(layer, Some(P::Select));
+        assert!(skate_pad_claims(P::RightTrigger, layer, false, false), "the board's trigger");
+        assert!(!skate_pad_claims(P::DpadRight, layer, false, false), "killstreaks stay MW2's");
+        assert!(skate_pad_claims(P::DpadDown, layer, false, true), "LB + D-pad is a session marker");
+        assert!(!skate_pad_claims(P::Start, layer, false, false));
+        assert!(!skate_pad_claims(P::RightTrigger, layer, true, false), "fire while Back is held");
+        assert!(skate_pad_claims(P::Select, layer, true, false), "the layer button is nobody's");
+        let up = skate_layer_button(skate_rules::PadLayer::DpadUp);
+        assert!(skate_pad_claims(P::DpadUp, up, false, false));
+        assert!(skate_layer_button(skate_rules::PadLayer::Off).is_none());
+    }
+}
diff --git a/crates/console/src/skate_options.rs b/crates/console/src/skate_options.rs
new file mode 100644
index 0000000..2a13b08
--- /dev/null
+++ b/crates/console/src/skate_options.rs
@@ -0,0 +1,288 @@
+//! The Skate options pages (`crates/ui/menus/skate.json`): Skate 3's
+//! options and the keyboard and mouse controls, changed while playing, and
+//! key capture for the bindings page.
+
+use bevy::input::ButtonInput;
+use bevy::input::keyboard::KeyCode;
+use bevy::input::mouse::MouseButton;
+use bevy::prelude::*;
+use frame::{SKATE_TUNING, SkateDifficulty, SkateKeyInput, UiMenuDvars};
+use skate_input::{ACTIONS, Controls, MouseTrick};
+
+use crate::{CommandSpec, ConsoleCommand, ConsoleRegistry};
+
+/// Rows of the bindings page.
+const ROWS: usize = 14;
+
+pub(crate) fn register(registry: &mut ConsoleRegistry) {
+    for name in ["skate_bind", "skate_keys_page", "skate_keys_defaults", "skate_options_defaults", "snd_device_next", "snd_device_prev"] {
+        registry.register(CommandSpec::new(name));
+    }
+}
+
+fn number(value: &str, low: f32, high: f32) -> Option<f32> {
+    value.parse::<f32>().ok().filter(|v| v.is_finite()).map(|v| v.clamp(low, high))
+}
+
+/// Applies one menu setting; true when something changed, and whether it was
+/// Skate's options (rather than the controls).
+fn apply(name: &str, value: &str, mode: &mut frame::SkateMode, controls: &mut Controls) -> Option<bool> {
+    let settings = &mut mode.settings;
+    match name {
+        "ui_skate_difficulty" => settings.difficulty = SkateDifficulty::parse(value)?,
+        "ui_skate_trucks" => settings.truck_tightness = number(value, 0., 1.)?,
+        "ui_skate_wheels" => settings.wheel_hardness = number(value, 0., 1.)?,
+        "ui_skate_holdfakie" => settings.hold_fakie = value == "1",
+        "ui_skate_sound" => settings.board_volume = number(value, 0., 100.)? / 100.,
+        "ui_skate_retry" => settings.auto_retry = value == "1",
+        "ui_skate_preview" => settings.preview_skater = value == "skater",
+        "ui_skate_hints" => settings.show_controls = value == "1",
+        "ui_skate_fall" => settings.fall = skate_rules::FallRules::parse(value)?,
+        "ui_skate_camera" => settings.camera = skate_rules::CameraRule::parse(value)?,
+        "ui_skate_start" => settings.start = skate_rules::StartRule::parse(value)?,
+        "ui_skate_padaim" => settings.combat.pad_layer = skate_rules::PadLayer::parse(value)?,
+        "ui_skate_scheme" => {
+            let v: u8 = value.parse().ok()?;
+            controls.classic = v & 1 != 0;
+            controls.modern = v & 2 != 0;
+            return Some(false);
+        }
+        "ui_skate_mouse" => {
+            controls.mouse = match value {
+                "off" => MouseTrick::Off,
+                "hold" => MouseTrick::Hold,
+                "always" => MouseTrick::Always,
+                _ => return None,
+            };
+            return Some(false);
+        }
+        "ui_skate_mouse_throw" => {
+            controls.mouse_throw = number(value, 5., 1000.)?;
+            return Some(false);
+        }
+        "ui_skate_flick_ms" => {
+            controls.flick_ms = number(value, 5., 300.)?;
+            return Some(false);
+        }
+        "ui_skate_buffer_ms" => {
+            controls.buffer_ms = number(value, 0., 150.)?;
+            return Some(false);
+        }
+        "ui_skate_ramp_ms" => {
+            controls.ramp_ms = number(value, 0., 1000.)?;
+            return Some(false);
+        }
+        _ if name.strip_prefix("ui_skate_").is_some_and(|n| settings.combat.switch(n).is_some()) => {
+            let switch = settings.combat.switch(&name["ui_skate_".len()..]).expect("checked");
+            *switch = value == "1";
+        }
+        _ => {
+            let key = name.strip_prefix("ui_skate_tune_")?;
+            let index = SKATE_TUNING.iter().position(|(n, _)| *n == key)?;
+            settings.tuning[index] = number(value, 0.1, 5.)?;
+        }
+    }
+    Some(true)
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn route(
+    mut events: MessageReader<ConsoleCommand>,
+    mut mode: ResMut<frame::SkateMode>,
+    mut keys: ResMut<frame::SkateKeys>,
+    keyboard: Res<ButtonInput<KeyCode>>,
+    mouse: Res<ButtonInput<MouseButton>>,
+    mut dvars: ResMut<UiMenuDvars>,
+    mut armed: Local<bool>,
+    mut device: Option<ResMut<frame::AudioDevice>>,
+) {
+    for command in events.read() {
+        match command.name.as_str() {
+            "set" | "seta" => {
+                let [name, value, ..] = command.args.as_slice() else { continue };
+                if !name.starts_with("ui_skate_") {
+                    continue;
+                }
+                let mut controls = keys.controls.clone();
+                match apply(name, value, &mut mode, &mut controls) {
+                    Some(true) => mode.settings_revision += 1,
+                    Some(false) if controls != keys.controls => {
+                        keys.controls = controls;
+                        keys.revision += 1;
+                    }
+                    _ => {}
+                }
+            }
+            "skate_bind" => {
+                if let Some(row) = command.args.first().and_then(|a| a.parse::<usize>().ok())
+                    && keys.first + row < ACTIONS.len()
+                {
+                    keys.capture = Some(keys.first + row);
+                    *armed = false;
+                }
+            }
+            "skate_keys_page" => {
+                keys.capture = None;
+                keys.first = if keys.first + ROWS >= ACTIONS.len() { 0 } else { keys.first + ROWS };
+            }
+            "skate_keys_defaults" => {
+                keys.capture = None;
+                keys.controls.keys = Controls::default().keys;
+                keys.revision += 1;
+            }
+            "snd_device_next" => {
+                if let Some(device) = device.as_deref_mut() {
+                    device.step += 1;
+                }
+            }
+            "snd_device_prev" => {
+                if let Some(device) = device.as_deref_mut() {
+                    device.step -= 1;
+                }
+            }
+            "skate_options_defaults" => {
+                mode.settings = frame::SkateSettings::default();
+                mode.settings_revision += 1;
+                let bound = std::mem::take(&mut keys.controls.keys);
+                keys.controls = Controls { keys: bound, ..Controls::default() };
+                keys.revision += 1;
+            }
+            _ => {}
+        }
+    }
+
+    // A key for the action waiting on the bindings page. The click that
+    // asked for it is not the answer.
+    if let Some(index) = keys.capture {
+        if !*armed {
+            *armed = true;
+        } else if keyboard.just_pressed(KeyCode::Escape) {
+            keys.capture = None;
+        } else if keyboard.just_pressed(KeyCode::Delete) {
+            keys.controls.unbind(index);
+            keys.capture = None;
+            keys.revision += 1;
+        } else if let Some(name) = skate_input::keys::KEYS.iter().map(|(name, _)| *name).find(|name| {
+            match frame::skate_key(name) {
+                Some(SkateKeyInput::Key(key)) => keyboard.just_pressed(key),
+                Some(SkateKeyInput::Mouse(button)) => mouse.just_pressed(button),
+                None => false,
+            }
+        }) {
+            if keys.controls.bind(index, name).is_ok() {
+                keys.revision += 1;
+            }
+            keys.capture = None;
+        }
+    }
+
+    if let Some(device) = device.as_deref() {
+        dvars.set("ui_skate_value_audio_device", device.label());
+    }
+    let settings = &mode.settings;
+    dvars.set("ui_skate_difficulty", settings.difficulty.key());
+    dvars.set("ui_skate_trucks", settings.truck_tightness.to_string());
+    dvars.set("ui_skate_wheels", settings.wheel_hardness.to_string());
+    dvars.set("ui_skate_holdfakie", if settings.hold_fakie { "1" } else { "0" });
+    dvars.set("ui_skate_sound", (settings.board_volume * 100.).round().to_string());
+    dvars.set("ui_skate_retry", if settings.auto_retry { "1" } else { "0" });
+    dvars.set("ui_skate_preview", if settings.preview_skater { "skater" } else { "board" });
+    dvars.set("ui_skate_hints", if settings.show_controls { "1" } else { "0" });
+    dvars.set("ui_skate_fall", settings.fall.key());
+    dvars.set("ui_skate_camera", settings.camera.key());
+    dvars.set("ui_skate_start", settings.start.key());
+    for name in skate_rules::Combat::SWITCHES {
+        let on = *settings.combat.clone().switch(name).expect("a switch");
+        dvars.set(&format!("ui_skate_{name}"), if on { "1" } else { "0" });
+    }
+    dvars.set("ui_skate_padaim", settings.combat.pad_layer.key());
+    dvars.set(
+        "ui_skate_combat_hint",
+        "Keyboard: MW2's own keys fire, aim, reload and throw. Controller: hold the weapons button for MW2's triggers and buttons; the D-pad stays killstreaks.",
+    );
+    for (i, (name, _)) in SKATE_TUNING.iter().enumerate() {
+        dvars.set(&format!("ui_skate_tune_{name}"), settings.tuning[i].to_string());
+    }
+    let controls = &keys.controls;
+    dvars.set("ui_skate_scheme", (u8::from(controls.classic) | u8::from(controls.modern) << 1).to_string());
+    dvars.set(
+        "ui_skate_mouse",
+        match controls.mouse {
+            MouseTrick::Off => "off",
+            MouseTrick::Hold => "hold",
+            MouseTrick::Always => "always",
+        },
+    );
+    dvars.set("ui_skate_mouse_throw", controls.mouse_throw.to_string());
+    dvars.set("ui_skate_flick_ms", controls.flick_ms.to_string());
+    dvars.set("ui_skate_buffer_ms", controls.buffer_ms.to_string());
+    dvars.set("ui_skate_ramp_ms", controls.ramp_ms.to_string());
+    for (name, value) in [
+        ("keys", "Edit"),
+        ("tuning", "Edit"),
+        ("reset", "Reset"),
+        ("keys_reset", "Reset"),
+        ("back_tuning", ""),
+        ("back_keys", ""),
+        ("combat", "Edit"),
+        ("back_combat", ""),
+        ("feel", "Edit"),
+        ("back_feel", ""),
+    ] {
+        dvars.set(&format!("ui_skate_value_{name}"), value);
+    }
+    let pages = ACTIONS.len().div_ceil(ROWS);
+    dvars.set("ui_skate_value_keys_page", format!("Next ({} / {pages})", keys.first / ROWS + 1));
+    for row in 0..ROWS {
+        let index = keys.first + row;
+        let (label, value) = match ACTIONS.get(index) {
+            Some((action, _, label, _)) => {
+                let value = if keys.capture == Some(index) {
+                    "Press a key...".to_owned()
+                } else if controls.uses(*action) {
+                    controls.keys_text(index)
+                } else {
+                    format!("{} (off)", controls.keys_text(index))
+                };
+                ((*label).to_owned(), value)
+            }
+            None => (String::new(), String::new()),
+        };
+        dvars.set(&format!("ui_skate_keyname_{row}"), label);
+        dvars.set(&format!("ui_skate_keyval_{row}"), value);
+    }
+    dvars.set(
+        "ui_skate_keys_hint",
+        if keys.capture.is_some() {
+            "Press a key or mouse button. Esc cancels, Delete clears."
+        } else {
+            "Select a row to change its key. While you skate, these keys drive the board instead of MW2."
+        },
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn menu_settings_reach_the_options_and_controls() {
+        let mut mode = frame::SkateMode::default();
+        let mut controls = Controls::default();
+        assert_eq!(apply("ui_skate_difficulty", "hardcore", &mut mode, &mut controls), Some(true));
+        assert_eq!(mode.settings.difficulty, SkateDifficulty::Hardcore);
+        assert_eq!(apply("ui_skate_tune_grip", "2.5", &mut mode, &mut controls), Some(true));
+        assert_eq!(mode.settings.tuning[8], 2.5);
+        assert_eq!(apply("ui_skate_scheme", "2", &mut mode, &mut controls), Some(false));
+        assert!(!controls.classic && controls.modern);
+        assert_eq!(apply("ui_skate_flick_ms", "9999", &mut mode, &mut controls), Some(false));
+        assert_eq!(controls.flick_ms, 300.);
+        assert_eq!(apply("ui_skate_tune_nonsense", "1", &mut mode, &mut controls), None);
+        assert_eq!(apply("ui_skate_guns", "0", &mut mode, &mut controls), Some(true));
+        assert!(!mode.settings.combat.guns);
+        assert_eq!(apply("ui_skate_padaim", "rb", &mut mode, &mut controls), Some(true));
+        assert_eq!(mode.settings.combat.pad_layer, skate_rules::PadLayer::Rb);
+        assert_eq!(apply("ui_skate_padaim", "nose", &mut mode, &mut controls), None);
+        assert_eq!(apply("ui_skate_mouse", "sideways", &mut mode, &mut controls), None);
+    }
+}
