+//! The output device the player picked (`frame::AudioDevice`): opened at
+//! start, switched while playing (sounds carry on, on the new device), and
+//! remembered beside the game.
+
+use bevy::audio::{AudioOutput, output_device_names};
+use bevy::prelude::*;
+
+fn saved_path() -> Option<std::path::PathBuf> {
+    Some(std::env::current_exe().ok()?.parent()?.join("audio-device.txt"))
+}
+
+fn load() -> Option<String> {
+    let text = std::fs::read_to_string(saved_path()?).ok()?;
+    let name = text.trim();
+    (!name.is_empty()).then(|| name.to_owned())
+}
+
+fn save(device: Option<&str>) {
+    if let Some(path) = saved_path()
+        && let Err(e) = std::fs::write(&path, device.unwrap_or(""))
+    {
+        diag::warn!(Audio, "audio device choice not saved to {}: {e}", path.display());
+    }
+}
+
+pub(crate) fn register(app: &mut App) {
+    app.init_resource::<frame::AudioDevice>()
+        .add_systems(Startup, open_saved)
+        .add_systems(Update, follow_choice);
+}
+
+fn open_saved(mut choice: ResMut<frame::AudioDevice>, output: Option<ResMut<AudioOutput>>) {
+    let Some(mut output) = output else { return };
+    choice.wanted = load();
+    if choice.wanted.is_some() && !output.switch(choice.wanted.as_deref()) {
+        diag::warn!(Audio, "audio device {:?} not found; using the system default", choice.wanted);
+    }
+    choice.current = output.device().map(str::to_owned);
+    diag::info!(Audio, "audio output: {}", choice.label());
+}
+
+fn follow_choice(mut choice: ResMut<frame::AudioDevice>, output: Option<ResMut<AudioOutput>>) {
+    let Some(mut output) = output else { return };
+    if choice.step == 0 {
+        return;
+    }
+    let names = output_device_names();
+    let step = std::mem::take(&mut choice.step);
+    choice.wanted = frame::AudioDevice::stepped(choice.wanted.as_deref(), &names, step);
+    save(choice.wanted.as_deref());
+    output.switch(choice.wanted.as_deref());
+    choice.current = output.device().map(str::to_owned);
+    diag::info!(Audio, "audio output: {}", choice.label());
+}
