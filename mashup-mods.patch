+/// Getting on and off the board, the camera eases from where it was to its
+/// new place (MW2's view to Skate's, and back) instead of cutting.
+#[derive(Default)]
+pub struct CameraSwitch {
+    was_skating: bool,
+    last: Option<Transform>,
+    from: Option<(Transform, f32)>,
+}
+
+const CAMERA_EASE_SECONDS: f32 = 0.45;
+
+pub fn ease_skate_camera_switch(
+    skate: Res<frame::SkateMode>,
+    time: Res<Time>,
+    mut state: Local<CameraSwitch>,
+    mut q: Query<
+        &mut Transform,
+        (
+            With<FlyCamera>,
+            Without<RemotePlayer>,
+            Without<WorldScriptModelInstance>,
+        ),
+    >,
+) {
+    let now = time.elapsed_secs();
+    let skating = skate.active && !skate.bones.is_empty();
+    let Some(mut transform) = q.iter_mut().next() else { return };
+    if skating != state.was_skating {
+        state.was_skating = skating;
+        state.from = state.last.map(|last| (last, now));
+    }
+    if let Some((from, since)) = state.from {
+        let t = ((now - since) / CAMERA_EASE_SECONDS).clamp(0., 1.);
+        let e = t * t * (3. - 2. * t);
+        // Far apart (a respawn, a teleport): cut.
+        if t >= 1. || from.translation.distance(transform.translation) > 600. {
+            state.from = None;
+        } else {
+            transform.translation = from.translation.lerp(transform.translation, e);
+            transform.rotation = from.rotation.slerp(transform.rotation, e);
+        }
+    }
+    state.last = Some(*transform);
+}
