+/// The board the player has worn in, read once and kept as it changes.
+fn wear_state() -> &'static std::sync::Mutex<(skate_boards::wear::Wear, Option<std::path::PathBuf>)> {
+    static WEAR: OnceLock<std::sync::Mutex<(skate_boards::wear::Wear, Option<std::path::PathBuf>)>> = OnceLock::new();
+    WEAR.get_or_init(|| {
+        let path = std::env::var_os("IW4L_SKATE_ASSETS")
+            .map(std::path::PathBuf::from)
+            .map(|root| root.parent().map(Path::to_path_buf).unwrap_or(root).join("skate-wear.txt"));
+        let wear = path
+            .as_ref()
+            .and_then(|path| std::fs::read_to_string(path).ok())
+            .map(|text| skate_boards::wear::Wear::from_text(&text))
+            .unwrap_or_default();
+        std::sync::Mutex::new((wear, path))
+    })
+}
+
+/// How worn the player's parts are.
+pub fn board_wear() -> skate_boards::wear::Wear {
+    wear_state().lock().map(|state| state.0.clone()).unwrap_or_default()
+}
+
+/// Wears the board `choice` by riding; true when a part wore through.
+pub fn wear_board(choice: &skate_boards::BoardChoice, usage: &skate_boards::wear::Usage) -> bool {
+    let Ok(mut state) = wear_state().lock() else { return false };
+    let fresh = skate_board_library().map_or_else(|| choice.clone(), |library| library.fresh(choice));
+    state.0.ride(&fresh, usage)
+}
+
+/// A new one of a part: its wear starts over.
+pub fn renew_board_part(part: &skate_boards::PartRef) {
+    if let Ok(mut state) = wear_state().lock() {
+        state.0.renew(part);
+    }
+}
+
+/// Saves the wear beside the Skate options.
+pub fn save_board_wear() {
+    let Ok(state) = wear_state().lock() else { return };
+    if let Some(path) = &state.1
+        && let Err(e) = std::fs::write(path, state.0.to_text())
+    {
+        diag::warn!(World, "skate boards: wear not saved to {}: {e}", path.display());
+    }
+}
+
+/// The board `choice` as it looks ridden: new parts as chosen, worn-through
+/// ones in their worn finish.
+pub fn board_as_ridden(choice: &skate_boards::BoardChoice) -> skate_boards::BoardChoice {
+    let Some(library) = skate_board_library() else { return choice.clone() };
+    let fresh = library.fresh(choice);
+    wear_state().lock().map(|state| state.0.look(&fresh, library)).unwrap_or(fresh)
+}
