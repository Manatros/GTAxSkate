+/// The key a skate control key name means.
+pub fn skate_key(name: &str) -> Option<SkateKeyInput> {
+    SKATE_KEY_CODES.iter().find(|(n, _)| n.eq_ignore_ascii_case(name)).map(|(_, k)| *k)
+}
+
+/// The skate control key name of a key.
+pub fn skate_key_name(input: SkateKeyInput) -> Option<&'static str> {
+    SKATE_KEY_CODES.iter().find(|(_, k)| *k == input).map(|(n, _)| *n)
+}
