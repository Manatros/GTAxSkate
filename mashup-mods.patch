+
+/// The board of the class the player plays, as chosen.
+pub fn active_board_choice() -> skate_boards::BoardChoice {
+    class_boards().lock().map(|state| state.active.clone()).unwrap_or_default()
+}
+
+/// Texture size limit for board parts, as for the default board.
+const BOARD_TEXTURE_LIMIT: u32 = 512;
+
+impl BotModel {
+    /// A board built from Skate 3 catalog parts. Triangles are rewound for
+    /// the engine as the default board's are.
+    pub fn from_board(board: &skate_boards::Board) -> Result<Self, String> {
+        let model = Self {
+            lighting_gain: 1.0,
+            joints: board
+                .joints
+                .iter()
+                .map(|joint| BotJoint {
+                    target: joint.name.clone(),
+                    origin: [0.0; 3],
+                    end: None,
+                    target_child: None,
+                    inverse_bind: Some(joint.inverse_bind),
+                })
+                .collect(),
+            surfaces: board
+                .surfaces
+                .iter()
+                .map(|surface| BotSurface {
+                    material: surface.material.clone(),
+                    texture: surface.texture,
+                    vertices: surface
+                        .vertices
+                        .iter()
+                        .map(|v| {
+                            let u = half::f16::from_f32(v.uv[0]).to_bits();
+                            let w = half::f16::from_f32(v.uv[1]).to_bits();
+                            BotVertex {
+                                position: v.position,
+                                normal: v.normal,
+                                uv: (u32::from(u) << 16) | u32::from(w),
+                                joints: v.joints.map(|j| j as usize),
+                                weights: v.weights,
+                            }
+                        })
+                        .collect(),
+                    indices: surface
+                        .indices
+                        .as_chunks::<3>()
+                        .0
+                        .iter()
+                        .flat_map(|&[a, b, c]| [a, c, b])
+                        .collect(),
+                })
+                .collect(),
+            textures: board
+                .textures
+                .iter()
+                .map(|t| {
+                    Ok(BotTexture {
+                        width: u16::try_from(t.width).map_err(|_| "board texture too large")?,
+                        height: u16::try_from(t.height).map_err(|_| "board texture too large")?,
+                        rgba: t.rgba.clone(),
+                    })
+                })
+                .collect::<Result<_, &str>>()?,
+        };
+        validate(&model)?;
+        Ok(model)
+    }
+}
