+/// The board a class rides: its own when one was picked, else one that
+/// suits its primary weapon (the same each time for the same class).
+pub fn class_board(board: &skate_boards::BoardChoice, primary: &str, class_name: &str) -> skate_boards::BoardChoice {
+    if !board.is_default() {
+        return board.clone();
+    }
+    match skate_board_library() {
+        Some(library) => skate_boards::fitting_board(|part| library.items(part).to_vec(), primary, class_name),
+        None => board.clone(),
+    }
+}
