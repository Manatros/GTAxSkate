+const RAMP_SLOPE: f32 = 6.;
+
+/// Whether points (MW2 inches, z up) make a small, low object.
+fn pebble(points: impl Iterator<Item = Vec3>) -> bool {
+    let (mut lo, mut hi) = (Vec3::splat(f32::INFINITY), Vec3::splat(f32::NEG_INFINITY));
+    let mut any = false;
+    for p in points {
+        lo = lo.min(p);
+        hi = hi.max(p);
+        any = true;
+    }
+    any && hi.z - lo.z < PEBBLE_HEIGHT && (hi.x - lo.x).max(hi.y - lo.y) < PEBBLE_ACROSS
+}
+
+/// For an upright triangle of a small step (a lip), the ramp in front of
+/// it: its lower corners moved out along its facing onto the floor below.
+fn lip_ramp(p: &[Vec3; 3]) -> Option<[Vec3; 3]> {
+    let n = (p[1] - p[0]).cross(p[2] - p[0]).try_normalize()?;
+    if n.z.abs() > 0.2 {
+        return None;
     }
+    let top = p.iter().map(|v| v.z).fold(f32::NEG_INFINITY, f32::max);
+    let bottom = p.iter().map(|v| v.z).fold(f32::INFINITY, f32::min);
+    let height = top - bottom;
+    if height < 0.25 || height > LIP_HEIGHT {
+        return None;
+    }
+    let out = Vec3::new(n.x, n.y, 0.).try_normalize()? * (height * RAMP_SLOPE).clamp(3., 15.);
+    Some(p.map(|v| if v.z < (top + bottom) * 0.5 { Vec3::new(v.x, v.y, bottom) + out } else { v }))
 }
 
