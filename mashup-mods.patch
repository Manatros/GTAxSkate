+[package]
+name = "skate_park"
+version = "0.1.0"
+edition = "2024"
+license = "GPL-3.0-or-later"
+publish = false
+description = "Skate 3's object dropper: ramps, rails, ledges and boxes to build a park anywhere, their shapes and grind rails, and the dropper's controls. Shared by the mashup and Skate 3 for GTA V."
+
+# No dependencies, nothing inherited: Skate 3 for GTA V builds this crate
+# from its own workspace too.
+[dependencies]
diff --git a/crates/skate_park/src/lib.rs b/crates/skate_park/src/lib.rs
new file mode 100644
index 0000000..1219e20
--- /dev/null
+++ b/crates/skate_park/src/lib.rs
@@ -0,0 +1,318 @@
+//! Skate 3's object dropper: kickers, ramps, a quarter pipe, banks, rails,
+//! ledges, manual pads and funboxes dropped anywhere to build a park, as
+//! Skate 3 lets you anywhere in San Vanelona.
+//!
+//! [`shape`] is each object's geometry (metres, x right, y away from the
+//! one dropping it, z up, centred on its footprint) with the edges that
+//! grind as rails; [`Dropper`] is the dropper's controls: pick an object,
+//! move and turn its ghost, drop it, pick one back up.
+
+pub mod shapes;
+
+pub use shapes::{Material, Shape, shape};
+
+/// What can be dropped, in the dropper's order.
+pub const KINDS: [&str; 10] = [
+    "Kicker",
+    "Launch ramp",
+    "Quarter pipe",
+    "Bank",
+    "Flat rail",
+    "Down rail",
+    "Ledge",
+    "Manual pad",
+    "Funbox",
+    "Crate",
+];
+
+/// Most objects one skater keeps dropped.
+pub const MAX_OBJECTS: usize = 24;
+
+/// A dropped object: which ([`KINDS`]), where its footprint's centre sits
+/// on the ground and which way it faces (radians about the up axis, 0
+/// facing +y), in the host game's units.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct ParkObject {
+    pub kind: u8,
+    pub at: [f32; 3],
+    pub yaw: f32,
+}
+
+impl ParkObject {
+    /// Whether this is a usable object: a known kind at a finite place.
+    pub fn valid(&self) -> bool {
+        usize::from(self.kind) < KINDS.len() && self.at.iter().all(|v| v.is_finite()) && self.yaw.is_finite()
+    }
+
+    /// Its shape placed in the world, in the host's units (`unit` metres
+    /// each).
+    pub fn placed(&self, unit: f32) -> Shape {
+        let mut s = shape(usize::from(self.kind));
+        let (sin, cos) = self.yaw.sin_cos();
+        let place = |p: [f32; 3]| {
+            let x = p[0] * cos - p[1] * sin;
+            let y = p[0] * sin + p[1] * cos;
+            [self.at[0] + x / unit, self.at[1] + y / unit, self.at[2] + p[2] / unit]
+        };
+        let turn = |n: [f32; 3]| [n[0] * cos - n[1] * sin, n[0] * sin + n[1] * cos, n[2]];
+        for t in &mut s.triangles {
+            t.points = t.points.map(place);
+            t.normal = turn(t.normal);
+        }
+        for rail in &mut s.rails {
+            for p in rail.iter_mut() {
+                *p = place(*p);
+            }
+        }
+        s
+    }
+}
+
+/// The controller as the dropper reads it: XInput button bits, sticks -1
+/// to 1 (y up) and triggers 0 to 1.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Pad {
+    pub buttons: u16,
+    pub left: [f32; 2],
+    pub right: [f32; 2],
+    pub triggers: [f32; 2],
+}
+
+pub mod buttons {
+    pub const DPAD_LEFT: u16 = 0x0004;
+    pub const DPAD_RIGHT: u16 = 0x0008;
+    pub const LB: u16 = 0x0100;
+    pub const RB: u16 = 0x0200;
+    pub const A: u16 = 0x1000;
+    pub const B: u16 = 0x2000;
+    pub const X: u16 = 0x4000;
+    pub const Y: u16 = 0x8000;
+}
+
+/// What the dropper did this frame.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Event {
+    Opened,
+    Closed,
+    /// The skater's objects changed.
+    Changed,
+    /// The ghost cannot go there: the skater has the most objects already.
+    Full,
+}
+
+/// Metres the ghost first sits ahead, moves a second, and may stray.
+const AHEAD: f32 = 4.;
+const MOVE_SPEED: f32 = 5.;
+const REACH: f32 = 25.;
+/// Radians a second it turns, and metres a second it rises or sinks.
+const TURN_SPEED: f32 = 2.;
+const LIFT_SPEED: f32 = 1.5;
+/// Metres within which the ghost picks a dropped object back up.
+const PICK_UP: f32 = 2.5;
+
+/// The object dropper's state for one skater: the ghost and what they
+/// dropped. Positions are metres in the host's world, z up.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Dropper {
+    pub open: bool,
+    /// The object the ghost is.
+    pub kind: usize,
+    /// The ghost: where, facing, raised or lowered from the skater's feet.
+    pub at: [f32; 3],
+    pub yaw: f32,
+    pub lift: f32,
+    /// What this skater dropped (metres).
+    pub placed: Vec<ParkObject>,
+    last: u16,
+    /// The bumper held was part of a D-pad combination.
+    bumper_spent: bool,
+    /// How many objects there are to pick from: [`KINDS`] unless the host
+    /// game has a list of its own.
+    pub kinds: usize,
+}
+
+impl Dropper {
+    fn count(&self) -> usize {
+        if self.kinds == 0 { KINDS.len() } else { self.kinds }
+    }
+
+    /// Opens the ghost ahead of the skater at `feet` facing `heading`
+    /// (radians, 0 along +y, as an object's yaw).
+    pub fn open(&mut self, feet: [f32; 3], heading: f32) {
+        self.open = true;
+        let (sin, cos) = heading.sin_cos();
+        self.at = [feet[0] - sin * AHEAD, feet[1] + cos * AHEAD, feet[2]];
+        self.yaw = heading;
+        self.lift = 0.;
+        // The buttons held now opened it; they wait to be let go.
+        self.last = u16::MAX;
+        self.bumper_spent = true;
+    }
+
+    /// The ghost as an object.
+    pub fn ghost(&self) -> ParkObject {
+        ParkObject {
+            kind: self.kind.min(self.count() - 1) as u8,
+            at: [self.at[0], self.at[1], self.at[2] + self.lift],
+            yaw: self.yaw,
+        }
+    }
+
+    /// One frame of the dropper's controls, `camera_yaw` turning the
+    /// sticks to the view (radians, 0 along +y). Left stick moves the
+    /// ghost, right stick turns it, triggers lower and raise it, LB / RB
+    /// change the object, A drops it, X picks up the one under it, Y picks
+    /// up all, B closes.
+    pub fn update(&mut self, pad: Pad, camera_yaw: f32, feet: [f32; 3], dt: f32) -> Vec<Event> {
+        use buttons::*;
+        let mut events = Vec::new();
+        if !self.open {
+            return events;
+        }
+        let dt = if dt.is_finite() { dt.clamp(0., 0.1) } else { 0. };
+        let pressed = |bit: u16| pad.buttons & bit != 0 && self.last & bit == 0;
+        let dead = |v: f32| if v.abs() < 0.2 { 0. } else { v.clamp(-1., 1.) };
+        let (sin, cos) = camera_yaw.sin_cos();
+        let (mx, my) = (dead(pad.left[0]), dead(pad.left[1]));
+        // Right is +x turned by the view, forward is +y turned.
+        self.at[0] += (mx * cos - my * sin) * MOVE_SPEED * dt;
+        self.at[1] += (mx * sin + my * cos) * MOVE_SPEED * dt;
+        let (dx, dy) = (self.at[0] - feet[0], self.at[1] - feet[1]);
+        let away = dx.hypot(dy);
+        if away > REACH {
+            self.at[0] = feet[0] + dx / away * REACH;
+            self.at[1] = feet[1] + dy / away * REACH;
+        }
+        self.yaw -= dead(pad.right[0]) * TURN_SPEED * dt;
+        self.lift = (self.lift + (pad.triggers[1] - pad.triggers[0]) * LIFT_SPEED * dt).clamp(-3., 6.);
+        // A bumper changes the object when let go, unless the D-pad was
+        // pressed with it (LB + right closes the dropper).
+        if pad.buttons & (DPAD_LEFT | DPAD_RIGHT) != 0 {
+            self.bumper_spent = true;
+        }
+        let released = |bit: u16| pad.buttons & bit == 0 && self.last & bit != 0 && self.last != u16::MAX;
+        let count = self.count();
+        if released(LB) && !self.bumper_spent {
+            self.kind = (self.kind + count - 1) % count;
+        }
+        if released(RB) && !self.bumper_spent {
+            self.kind = (self.kind + 1) % count;
+        }
+        if pad.buttons & (LB | RB) == 0 {
+            self.bumper_spent = false;
+        }
+        if pressed(A) {
+            if self.placed.len() >= MAX_OBJECTS {
+                events.push(Event::Full);
+            } else {
+                self.placed.push(self.ghost());
+                events.push(Event::Changed);
+            }
+        }
+        if pressed(X) {
+            let ghost = self.ghost().at;
+            let nearest = self
+                .placed
+                .iter()
+                .enumerate()
+                .map(|(i, o)| (i, (o.at[0] - ghost[0]).hypot(o.at[1] - ghost[1])))
+                .filter(|(_, d)| *d <= PICK_UP)
+                .min_by(|a, b| a.1.total_cmp(&b.1));
+            if let Some((i, _)) = nearest {
+                let picked = self.placed.remove(i);
+                self.kind = usize::from(picked.kind);
+                self.yaw = picked.yaw;
+                events.push(Event::Changed);
+            }
+        }
+        if pressed(Y) && !self.placed.is_empty() {
+            self.placed.clear();
+            events.push(Event::Changed);
+        }
+        if pressed(B) {
+            self.open = false;
+            events.push(Event::Closed);
+        }
+        self.last = if self.last == u16::MAX && pad.buttons != 0 { u16::MAX } else { pad.buttons };
+        events
+    }
+
+    /// The dropper's controls, for its HUD.
+    pub fn hints(keyboard: bool) -> &'static str {
+        if keyboard {
+            "WASD move   arrows turn   Z/C lower/raise   X/B object   Space drop   LShift pick up   Q pick up all   LCtrl done"
+        } else {
+            "Left stick move   right stick turn   LT/RT lower/raise   LB/RB object   A drop   X pick up   Y pick up all   B done"
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pad(buttons: u16) -> Pad {
+        Pad { buttons, ..Default::default() }
+    }
+
+    #[test]
+    fn the_dropper_drops_moves_and_picks_up() {
+        let mut d = Dropper::default();
+        assert!(d.update(pad(buttons::A), 0., [0.; 3], 0.1).is_empty(), "closed, it does nothing");
+        d.open([10., 20., 1.], 0.);
+        assert_eq!(d.at, [10., 24., 1.], "ahead of the skater");
+        // The buttons that opened it are let go first.
+        assert!(d.update(pad(buttons::A), 0., [10., 20., 1.], 0.01).is_empty());
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        d.update(pad(buttons::RB), 0., [10., 20., 1.], 0.01);
+        assert_eq!(KINDS[d.kind], "Kicker", "on letting go");
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        assert_eq!(KINDS[d.kind], "Launch ramp");
+        // LB then the D-pad (the combination that closes it) changes nothing.
+        d.update(pad(buttons::LB), 0., [10., 20., 1.], 0.01);
+        d.update(pad(buttons::LB | buttons::DPAD_RIGHT), 0., [10., 20., 1.], 0.01);
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        assert_eq!(KINDS[d.kind], "Launch ramp");
+        assert_eq!(d.update(pad(buttons::A), 0., [10., 20., 1.], 0.01), vec![Event::Changed]);
+        assert_eq!(d.placed[0].kind, 1);
+        // Pushed right for a second with the view turned a quarter left.
+        let right = Pad { left: [1., 0.], ..Default::default() };
+        d.update(right, std::f32::consts::FRAC_PI_2, [10., 20., 1.], 0.1);
+        assert!((d.at[1] - 24.5).abs() < 1e-4, "{:?}", d.at);
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        assert_eq!(d.update(pad(buttons::X), 0., [10., 20., 1.], 0.01), vec![Event::Changed]);
+        assert!(d.placed.is_empty(), "picked back up");
+        for _ in 0..MAX_OBJECTS {
+            d.update(pad(0), 0., [10., 20., 1.], 0.01);
+            d.update(pad(buttons::A), 0., [10., 20., 1.], 0.01);
+        }
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        assert_eq!(d.update(pad(buttons::A), 0., [10., 20., 1.], 0.01), vec![Event::Full]);
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        assert_eq!(d.update(pad(buttons::Y), 0., [10., 20., 1.], 0.01), vec![Event::Changed]);
+        assert!(d.placed.is_empty());
+        // Far pushes stop at its reach.
+        let far = Pad { left: [0., 1.], ..Default::default() };
+        for _ in 0..100 {
+            d.update(far, 0., [10., 20., 1.], 0.1);
+        }
+        assert!(((d.at[0] - 10.).hypot(d.at[1] - 20.) - REACH).abs() < 1e-3);
+        d.update(pad(0), 0., [10., 20., 1.], 0.01);
+        assert_eq!(d.update(pad(buttons::B), 0., [10., 20., 1.], 0.01), vec![Event::Closed]);
+        assert!(!d.open);
+    }
+
+    #[test]
+    fn objects_are_placed_and_turned() {
+        let o = ParkObject { kind: 4, at: [100., 200., 10.], yaw: std::f32::consts::FRAC_PI_2 };
+        assert!(o.valid());
+        let placed = o.placed(0.0254);
+        // The flat rail runs along its y; turned a quarter it runs along -x.
+        let rail = &placed.rails[0];
+        let (a, b) = (rail[0], rail[rail.len() - 1]);
+        assert!((a[1] - b[1]).abs() < 1e-2 && (a[0] - b[0]).abs() > 100., "{a:?} {b:?}");
+        assert!(rail.iter().all(|p| p[2] > 10.), "above the ground");
+        assert!(!ParkObject { kind: 99, ..o }.valid());
+        assert!(!ParkObject { at: [f32::NAN, 0., 0.], ..o }.valid());
+    }
+}
diff --git a/crates/skate_park/src/shapes.rs b/crates/skate_park/src/shapes.rs
new file mode 100644
index 0000000..d08741a
--- /dev/null
+++ b/crates/skate_park/src/shapes.rs
@@ -0,0 +1,279 @@
+//! The dropper's objects as geometry: triangles wound outward with their
+//! normals and materials, and the edges that grind as rails. Metres, x
+//! right, y away from the one dropping it (ramps rise towards +y), z up,
+//! centred on the footprint.
+
+type V3 = [f32; 3];
+
+/// What a surface looks like.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Material {
+    Concrete,
+    Wood,
+    Metal,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Triangle {
+    pub points: [V3; 3],
+    pub normal: V3,
+    pub material: Material,
+}
+
+/// An object's triangles and grind rails.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Shape {
+    pub triangles: Vec<Triangle>,
+    pub rails: Vec<Vec<V3>>,
+}
+
+fn sub(a: V3, b: V3) -> V3 {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+fn cross(a: V3, b: V3) -> V3 {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+fn normalize(a: V3) -> V3 {
+    let l = (a[0] * a[0] + a[1] * a[1] + a[2] * a[2]).sqrt();
+    if l > 1e-9 { [a[0] / l, a[1] / l, a[2] / l] } else { [0., 0., 1.] }
+}
+
+impl Shape {
+    /// A triangle wound counter-clockwise seen from outside.
+    fn tri(&mut self, a: V3, b: V3, c: V3, material: Material) {
+        let normal = cross(sub(b, a), sub(c, a));
+        if normal.iter().all(|v| v.abs() < 1e-9) {
+            return;
+        }
+        self.triangles.push(Triangle { points: [a, b, c], normal: normalize(normal), material });
+    }
+
+    /// A quad a, b, c, d counter-clockwise seen from outside.
+    fn quad(&mut self, a: V3, b: V3, c: V3, d: V3, material: Material) {
+        self.tri(a, b, c, material);
+        self.tri(a, c, d, material);
+    }
+
+    /// A box from `lo` to `hi`.
+    fn cuboid(&mut self, lo: V3, hi: V3, material: Material) {
+        let [x0, y0, z0] = lo;
+        let [x1, y1, z1] = hi;
+        let p = |x: f32, y: f32, z: f32| [x, y, z];
+        self.quad(p(x0, y0, z1), p(x1, y0, z1), p(x1, y1, z1), p(x0, y1, z1), material); // top
+        self.quad(p(x0, y1, z0), p(x1, y1, z0), p(x1, y0, z0), p(x0, y0, z0), material); // bottom
+        self.quad(p(x0, y0, z0), p(x1, y0, z0), p(x1, y0, z1), p(x0, y0, z1), material); // front (-y)
+        self.quad(p(x1, y1, z0), p(x0, y1, z0), p(x0, y1, z1), p(x1, y1, z1), material); // back (+y)
+        self.quad(p(x0, y1, z0), p(x0, y0, z0), p(x0, y0, z1), p(x0, y1, z1), material); // left (-x)
+        self.quad(p(x1, y0, z0), p(x1, y1, z0), p(x1, y1, z1), p(x1, y0, z1), material); // right (+x)
+    }
+
+    /// A ramp `width` wide over `y0`..`y1`, rising from 0 to `height` along
+    /// +y, with its back wall and sides.
+    fn wedge(&mut self, width: f32, y0: f32, y1: f32, height: f32, material: Material) {
+        let (x0, x1) = (-width / 2., width / 2.);
+        let p = |x: f32, y: f32, z: f32| [x, y, z];
+        self.quad(p(x0, y0, 0.), p(x1, y0, 0.), p(x1, y1, height), p(x0, y1, height), material);
+        self.quad(p(x1, y1, 0.), p(x0, y1, 0.), p(x0, y1, height), p(x1, y1, height), material);
+        self.quad(p(x0, y1, 0.), p(x1, y1, 0.), p(x1, y0, 0.), p(x0, y0, 0.), material);
+        self.tri(p(x0, y1, 0.), p(x0, y0, 0.), p(x0, y1, height), material);
+        self.tri(p(x1, y0, 0.), p(x1, y1, 0.), p(x1, y1, height), material);
+    }
+
+    /// The edges along x at `y`, `z`, as one rail from `x0` to `x1`.
+    fn rail_x(&mut self, x0: f32, x1: f32, y: f32, z: f32) {
+        self.rails.push(vec![[x0, y, z], [x1, y, z]]);
+    }
+
+    /// Centres the footprint on the origin.
+    fn centred(mut self) -> Self {
+        let mut lo = [f32::INFINITY; 2];
+        let mut hi = [f32::NEG_INFINITY; 2];
+        for p in self.triangles.iter().flat_map(|t| t.points) {
+            for k in 0..2 {
+                lo[k] = lo[k].min(p[k]);
+                hi[k] = hi[k].max(p[k]);
+            }
+        }
+        let c = [(lo[0] + hi[0]) / 2., (lo[1] + hi[1]) / 2.];
+        let shift = |p: &mut V3| {
+            p[0] -= c[0];
+            p[1] -= c[1];
+        };
+        for t in &mut self.triangles {
+            t.points.iter_mut().for_each(shift);
+        }
+        for rail in &mut self.rails {
+            rail.iter_mut().for_each(shift);
+        }
+        self
+    }
+}
+
+/// A rail `length` long along y, its top at `z0` at the near end and `z1`
+/// at the far one, on posts.
+fn rail(length: f32, z0: f32, z1: f32) -> Shape {
+    use Material::Metal;
+    let mut s = Shape::default();
+    const BAR: f32 = 0.025;
+    let (y0, y1) = (0., length);
+    let slope = |y: f32| z0 + (z1 - z0) * (y - y0) / length;
+    // The bar in pieces, so a sloped one follows its slope.
+    const PIECES: usize = 6;
+    for i in 0..PIECES {
+        let a = y0 + length * i as f32 / PIECES as f32;
+        let b = y0 + length * (i + 1) as f32 / PIECES as f32;
+        let (za, zb) = (slope(a), slope(b));
+        let p = |x: f32, y: f32, z: f32| [x, y, z];
+        s.quad(p(-BAR, a, za), p(BAR, a, za), p(BAR, b, zb), p(-BAR, b, zb), Metal);
+        s.quad(p(BAR, a, za - 2. * BAR), p(-BAR, a, za - 2. * BAR), p(-BAR, b, zb - 2. * BAR), p(BAR, b, zb - 2. * BAR), Metal);
+        s.quad(p(-BAR, a, za - 2. * BAR), p(-BAR, a, za), p(-BAR, b, zb), p(-BAR, b, zb - 2. * BAR), Metal);
+        s.quad(p(BAR, a, za), p(BAR, a, za - 2. * BAR), p(BAR, b, zb - 2. * BAR), p(BAR, b, zb), Metal);
+    }
+    s.quad([-BAR, y0, z0 - 2. * BAR], [BAR, y0, z0 - 2. * BAR], [BAR, y0, z0], [-BAR, y0, z0], Metal);
+    s.quad([BAR, y1, z1 - 2. * BAR], [-BAR, y1, z1 - 2. * BAR], [-BAR, y1, z1], [BAR, y1, z1], Metal);
+    for y in [y0 + 0.2, y1 - 0.2] {
+        s.cuboid([-0.03, y - 0.03, 0.], [0.03, y + 0.03, slope(y) - 2. * BAR], Metal);
+    }
+    s.rails.push(vec![[0., y0, z0], [0., y1, z1]]);
+    s
+}
+
+/// Object `kind`'s shape (see [`crate::KINDS`]); an unknown kind is a
+/// crate.
+pub fn shape(kind: usize) -> Shape {
+    use Material::*;
+    let mut s = Shape::default();
+    match kind {
+        // Kicker: a short, steep little launch.
+        0 => s.wedge(1.2, 0., 1.3, 0.45, Wood),
+        // Launch ramp: longer and higher, with a flat deck at the top.
+        1 => {
+            s.wedge(1.8, 0., 2.4, 1.0, Wood);
+            s.cuboid([-0.9, 2.4, 0.], [0.9, 3.0, 1.0], Wood);
+        }
+        // Quarter pipe: a transition up to vertical, a deck, coping.
+        2 => {
+            const R: f32 = 1.8;
+            const W: f32 = 3.0;
+            const STEPS: usize = 12;
+            const DECK: f32 = 1.0;
+            let (x0, x1) = (-W / 2., W / 2.);
+            let profile: Vec<(f32, f32)> = (0..=STEPS)
+                .map(|i| {
+                    let a = (i as f32 / STEPS as f32) * 88f32.to_radians();
+                    (R * a.sin(), R * (1. - a.cos()))
+                })
+                .collect();
+            let top = profile[STEPS];
+            for w in profile.windows(2) {
+                let ((ya, za), (yb, zb)) = (w[0], w[1]);
+                s.quad([x0, ya, za], [x1, ya, za], [x1, yb, zb], [x0, yb, zb], Concrete);
+            }
+            let back = top.0 + DECK;
+            s.quad([x0, top.0, top.1], [x1, top.0, top.1], [x1, back, top.1], [x0, back, top.1], Concrete);
+            s.quad([x1, back, 0.], [x0, back, 0.], [x0, back, top.1], [x1, back, top.1], Concrete);
+            s.quad([x0, back, 0.], [x1, back, 0.], [x1, 0., 0.], [x0, 0., 0.], Concrete);
+            // The sides, fanned from the bottom of the back wall.
+            let corner = (back, 0.);
+            let mut outline = profile.clone();
+            outline.push((back, top.1));
+            for w in outline.windows(2) {
+                let ((ya, za), (yb, zb)) = (w[0], w[1]);
+                s.tri([x0, corner.0, corner.1], [x0, ya, za], [x0, yb, zb], Concrete);
+                s.tri([x1, corner.0, corner.1], [x1, yb, zb], [x1, ya, za], Concrete);
+            }
+            s.rail_x(x0, x1, top.0, top.1);
+        }
+        // Bank: a long, tall wedge to carve and air off.
+        3 => s.wedge(2.4, 0., 2.2, 1.2, Concrete),
+        4 => s = rail(3.5, 0.35, 0.35),
+        // Down rail: from waist height down to a low end, ridden downhill
+        // (towards -y), so it starts high at the far end.
+        5 => s = rail(3.5, 0.35, 1.0),
+        // Ledge: a concrete block with metal-edged top corners.
+        6 => {
+            s.cuboid([-0.3, 0., 0.], [0.3, 3.5, 0.45], Concrete);
+            s.rails.push(vec![[-0.3, 0., 0.45], [-0.3, 3.5, 0.45]]);
+            s.rails.push(vec![[0.3, 0., 0.45], [0.3, 3.5, 0.45]]);
+        }
+        // Manual pad: low and wide; its edges grind too.
+        7 => {
+            s.cuboid([-0.7, 0., 0.], [0.7, 3.0, 0.2], Concrete);
+            s.rails.push(vec![[-0.7, 0., 0.2], [-0.7, 3.0, 0.2]]);
+            s.rails.push(vec![[0.7, 0., 0.2], [0.7, 3.0, 0.2]]);
+        }
+        // Funbox: banks up to a flat top and down again, ledges on its
+        // sides.
+        8 => {
+            const H: f32 = 0.6;
+            const W: f32 = 2.4;
+            s.wedge(W, 0., 1.2, H, Wood);
+            s.cuboid([-W / 2., 1.2, 0.], [W / 2., 3.0, H], Wood);
+            // The far bank, the near one turned round.
+            let mut far = Shape::default();
+            far.wedge(W, 0., 1.2, H, Wood);
+            for t in &mut far.triangles {
+                for p in &mut t.points {
+                    p[0] = -p[0];
+                    p[1] = 4.2 - p[1];
+                }
+                t.normal = [-t.normal[0], -t.normal[1], t.normal[2]];
+            }
+            s.triangles.extend(far.triangles);
+            s.rails.push(vec![[-W / 2., 1.2, H], [-W / 2., 3.0, H]]);
+            s.rails.push(vec![[W / 2., 1.2, H], [W / 2., 3.0, H]]);
+        }
+        // Crate: a wooden box to ollie onto or over.
+        _ => {
+            s.cuboid([-0.6, 0., 0.], [0.6, 1.2, 0.7], Wood);
+            for (y, x0, x1) in [(0., -0.6, 0.6), (1.2, -0.6, 0.6)] {
+                s.rail_x(x0, x1, y, 0.7);
+            }
+        }
+    }
+    s.centred()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_object_is_solid_and_outward() {
+        for kind in 0..crate::KINDS.len() {
+            let s = shape(kind);
+            assert!(s.triangles.len() >= 8, "{}", crate::KINDS[kind]);
+            assert!(!s.rails.is_empty() || matches!(kind, 0 | 1 | 3), "{} grinds", crate::KINDS[kind]);
+            let mut lo = [f32::INFINITY; 3];
+            let mut hi = [f32::NEG_INFINITY; 3];
+            let mut centre = [0f32; 3];
+            let n = (s.triangles.len() * 3) as f32;
+            for p in s.triangles.iter().flat_map(|t| t.points) {
+                for k in 0..3 {
+                    lo[k] = lo[k].min(p[k]);
+                    hi[k] = hi[k].max(p[k]);
+                    centre[k] += p[k] / n;
+                }
+            }
+            assert!(lo[2].abs() < 1e-5, "{} sits on the ground", crate::KINDS[kind]);
+            assert!((lo[0] + hi[0]).abs() < 1e-4 && (lo[1] + hi[1]).abs() < 1e-4, "centred");
+            // Wound outward, the enclosed volume (divergence theorem) is
+            // positive and within the bounding box's.
+            let volume: f32 = s
+                .triangles
+                .iter()
+                .map(|t| {
+                    let [a, b, c] = t.points;
+                    let bc = cross(b, c);
+                    (a[0] * bc[0] + a[1] * bc[1] + a[2] * bc[2]) / 6.
+                })
+                .sum();
+            let bounds = (hi[0] - lo[0]) * (hi[1] - lo[1]) * (hi[2] - lo[2]);
+            assert!(volume > 0. && volume <= bounds * 1.01, "{}: {volume} of {bounds}", crate::KINDS[kind]);
+            assert!(centre.iter().all(|v| v.is_finite()));
+            for rail in &s.rails {
+                assert!(rail.len() >= 2 && rail.iter().all(|p| p.iter().all(|v| v.is_finite())));
+            }
+        }
+    }
+}
