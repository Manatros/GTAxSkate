index 0000000..d88403d
--- /dev/null
+++ b/crates/skate_modes/src/meat.rs
@@ -0,0 +1,393 @@
+//! The Hall of Meat: bails scored by how hard the body hits. While the
+//! skater wipes out, each part of the skeleton is watched for sudden stops
+//! (an impact is a sharp change of a bone's velocity); the damage they add
+//! up to bruises, cracks, fractures, breaks and shatters, and the bail's
+//! "meat" is that damage plus its speed and its drop.
+//!
+//! Skate 3's own injury tables are not part of the rebuilt engine, so the
+//! thresholds here are tuned to its ragdoll rather than copied.
+
+use crate::hud::{self, Align, Anchor, Item, Rgba};
+use crate::math::{V3, distance, length, scale, sub};
+use crate::sprites::Sprite;
+
+/// The skeleton's parts: name, the Skate bones whose middle stands for
+/// it, how much an impact there counts, and whether it is a joint.
+pub const REGIONS: [(&str, &[&str], f32, bool); 19] = [
+    ("Skull", &["HEAD"], 1.35, false),
+    ("Neck", &["NECK"], 1.25, true),
+    ("Right Collarbone", &["RIGHTSHOULDER"], 1.0, false),
+    ("Left Collarbone", &["LEFTSHOULDER"], 1.0, false),
+    ("Ribs", &["SPINE1", "SPINE3"], 1.0, false),
+    ("Spine", &["SPINE"], 1.15, false),
+    ("Pelvis", &["HIPS"], 1.0, false),
+    ("Right Humerus", &["RIGHTARM", "RIGHTFOREARM"], 1.0, false),
+    ("Left Humerus", &["LEFTARM", "LEFTFOREARM"], 1.0, false),
+    ("Right Forearm", &["RIGHTFOREARM", "RIGHTHAND"], 1.0, false),
+    ("Left Forearm", &["LEFTFOREARM", "LEFTHAND"], 1.0, false),
+    ("Right Wrist", &["RIGHTHAND"], 1.1, true),
+    ("Left Wrist", &["LEFTHAND"], 1.1, true),
+    ("Right Femur", &["RIGHTUPLEG", "RIGHTLEG"], 0.9, false),
+    ("Left Femur", &["LEFTUPLEG", "LEFTLEG"], 0.9, false),
+    ("Right Tibia", &["RIGHTLEG", "RIGHTFOOT"], 1.0, false),
+    ("Left Tibia", &["LEFTLEG", "LEFTFOOT"], 1.0, false),
+    ("Right Ankle", &["RIGHTFOOT", "RIGHTTOEBASE"], 1.05, true),
+    ("Left Ankle", &["LEFTFOOT", "LEFTTOEBASE"], 1.05, true),
+];
+
+pub const N: usize = REGIONS.len();
+
+/// How badly a part is hurt.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Severity {
+    None,
+    Bruised,
+    Cracked,
+    Fractured,
+    Broken,
+    Shattered,
+}
+
+impl Severity {
+    /// The severity of `damage` (see [`Tracker`]).
+    pub fn of(damage: f32) -> Self {
+        match damage {
+            d if d >= 110. => Self::Shattered,
+            d if d >= 60. => Self::Broken,
+            d if d >= 30. => Self::Fractured,
+            d if d >= 12. => Self::Cracked,
+            d if d >= 4. => Self::Bruised,
+            _ => Self::None,
+        }
+    }
+
+    /// Points a part at this severity adds to the bail.
+    pub fn bonus(self) -> f32 {
+        match self {
+            Self::None => 0.,
+            Self::Bruised => 100.,
+            Self::Cracked => 300.,
+            Self::Fractured => 750.,
+            Self::Broken => 1500.,
+            Self::Shattered => 3000.,
+        }
+    }
+
+    /// The word for this severity of a bone, or of a joint.
+    pub fn word(self, joint: bool) -> &'static str {
+        match (self, joint) {
+            (Self::None, _) => "",
+            (Self::Bruised, _) => "Bruised",
+            (Self::Cracked, false) => "Cracked",
+            (Self::Cracked, true) => "Sprained",
+            (Self::Fractured, false) => "Fractured",
+            (Self::Fractured, true) => "Dislocated",
+            (Self::Broken, _) => "Broken",
+            (Self::Shattered, _) => "Shattered",
+        }
+    }
+
+    /// The skeleton's tint for this severity.
+    pub fn color(self) -> Rgba {
+        match self {
+            Self::None => [0.75, 0.88, 1., 0.55],
+            Self::Bruised => [1., 0.92, 0.35, 1.],
+            Self::Cracked => [1., 0.68, 0.2, 1.],
+            Self::Fractured => [1., 0.42, 0.12, 1.],
+            Self::Broken => [0.95, 0.12, 0.08, 1.],
+            Self::Shattered => [0.75, 0.0, 0.25, 1.],
+        }
+    }
+}
+
+/// "Fractured Left Femur".
+pub fn injury_name(region: usize, severity: Severity) -> String {
+    let (name, _, _, joint) = REGIONS[region];
+    format!("{} {name}", severity.word(joint))
+}
+
+/// A finished bail.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Report {
+    pub meat: f32,
+    /// Each part's damage.
+    pub damage: [f32; N],
+    pub speed: f32,
+    pub drop: f32,
+    pub seconds: f32,
+}
+
+impl Report {
+    pub fn severity(&self, region: usize) -> Severity {
+        Severity::of(self.damage[region])
+    }
+
+    /// The injuries, worst first.
+    pub fn injuries(&self) -> Vec<(usize, Severity)> {
+        let mut list: Vec<(usize, Severity)> =
+            (0..N).map(|i| (i, self.severity(i))).filter(|(_, s)| *s > Severity::None).collect();
+        list.sort_by(|a, b| b.1.cmp(&a.1).then(self.damage[b.0].total_cmp(&self.damage[a.0])));
+        list
+    }
+
+    /// Bones broken or worse.
+    pub fn broken(&self) -> usize {
+        (0..N).filter(|i| self.severity(*i) >= Severity::Broken).count()
+    }
+}
+
+/// Meat for a bail's damage, top speed (m/s) and drop (m).
+pub fn meat(damage: &[f32; N], speed: f32, drop: f32) -> f32 {
+    let parts: f32 = damage.iter().map(|d| d * 12. + Severity::of(*d).bonus()).sum();
+    if parts <= 0. {
+        return 0.;
+    }
+    parts + speed.max(0.) * 40. + drop.max(0.) * 160.
+}
+
+/// Watches one wipeout.
+#[derive(Clone, Debug)]
+pub struct Tracker {
+    started: f64,
+    last: Option<(f64, [Option<V3>; N])>,
+    velocity: [Option<V3>; N],
+    damage: [f32; N],
+    speed: f32,
+    top: f32,
+    bottom: f32,
+    /// Injuries as they happen, for the HUD: time, part, how bad.
+    pub fresh: Vec<(f64, usize, Severity)>,
+    /// Sensitivity: damage is multiplied by this.
+    pub sensitivity: f32,
+    /// When the last hard impact was.
+    pub last_hit: f64,
+}
+
+/// Velocity changes (m/s, within one look) below this are not impacts.
+const IMPACT: f32 = 3.0;
+/// A part that moves this far in one look was teleported, not thrown.
+const JUMP: f32 = 4.0;
+
+impl Tracker {
+    pub fn new(time: f64, speed: f32, height: f32, sensitivity: f32) -> Self {
+        Self {
+            started: time,
+            last: None,
+            velocity: [None; N],
+            damage: [0.; N],
+            speed,
+            top: height,
+            bottom: height,
+            fresh: Vec::new(),
+            sensitivity,
+            last_hit: time,
+        }
+    }
+
+    /// The middles of the parts from bones named `names` (Skate space).
+    pub fn parts(names: &[String], positions: &[V3]) -> [Option<V3>; N] {
+        let mut out = [None; N];
+        for (i, (_, bones, _, _)) in REGIONS.iter().enumerate() {
+            let found: Vec<V3> = bones
+                .iter()
+                .filter_map(|b| names.iter().position(|n| n.eq_ignore_ascii_case(b)))
+                .filter_map(|k| positions.get(k).copied())
+                .collect();
+            if !found.is_empty() {
+                let mut sum = [0.; 3];
+                for p in &found {
+                    sum = crate::math::add(sum, *p);
+                }
+                out[i] = Some(scale(sum, 1. / found.len() as f32));
+            }
+        }
+        out
+    }
+
+    /// One look at the body at `time`: the parts' positions (Skate space,
+    /// y up) and the skater's speed.
+    pub fn update(&mut self, time: f64, parts: &[Option<V3>; N], speed: f32) {
+        self.speed = self.speed.max(speed);
+        if let Some(hips) = parts[6] {
+            self.top = self.top.max(hips[1]);
+            self.bottom = self.bottom.min(hips[1]);
+        }
+        let Some((then, before)) = self.last else {
+            self.last = Some((time, *parts));
+            return;
+        };
+        let dt = (time - then) as f32;
+        if dt <= 1e-4 {
+            return;
+        }
+        for i in 0..N {
+            let (Some(now), Some(was)) = (parts[i], before[i]) else {
+                self.velocity[i] = None;
+                continue;
+            };
+            if distance(now, was) > JUMP {
+                self.velocity[i] = None;
+                continue;
+            }
+            let v = scale(sub(now, was), 1. / dt);
+            if let Some(old) = self.velocity[i] {
+                let change = length(sub(v, old));
+                // A slower look spreads a hit over more time: scale to 60 Hz.
+                let change = change * (1. / 60. / dt).clamp(0.25, 1.);
+                if change > IMPACT {
+                    let excess = change - IMPACT;
+                    let before = Severity::of(self.damage[i]);
+                    self.damage[i] += excess * excess * REGIONS[i].2 * self.sensitivity;
+                    let after = Severity::of(self.damage[i]);
+                    if after > before {
+                        self.fresh.push((time, i, after));
+                    }
+                    if excess > 1. {
+                        self.last_hit = time;
+                    }
+                }
+            }
+            self.velocity[i] = Some(v);
+        }
+        self.last = Some((time, *parts));
+    }
+
+    pub fn meat(&self) -> f32 {
+        meat(&self.damage, self.speed, self.top - self.bottom)
+    }
+
+    pub fn report(&self, time: f64) -> Report {
+        Report {
+            meat: self.meat(),
+            damage: self.damage,
+            speed: self.speed,
+            drop: self.top - self.bottom,
+            seconds: (time - self.started) as f32,
+        }
+    }
+
+    pub fn started(&self) -> f64 {
+        self.started
+    }
+}
+
+/// The skeleton with each part tinted by its injury, `w` wide at `x`, `y`.
+pub fn skeleton(report_damage: &[f32; N], anchor: Anchor, x: f32, y: f32, w: f32, flash: f32) -> Vec<Item> {
+    let h = w * 2.;
+    let mut items = vec![Item::sprite(Sprite::Body, anchor, x, y, w, h, [0.55, 0.75, 1., 0.5])];
+    for (i, damage) in report_damage.iter().enumerate() {
+        let severity = Severity::of(*damage);
+        let mut color = severity.color();
+        if severity >= Severity::Broken {
+            // Broken bones throb.
+            color = hud::alpha(color, 0.75 + 0.25 * flash);
+        }
+        items.push(Item::sprite(Sprite::Bone(i as u8), anchor, x, y, w, h, color));
+    }
+    items
+}
+
+/// The Hall of Meat's results panel for a bail.
+pub fn panel(report: &Report, best: f32, new_best: bool, age: f32) -> Vec<Item> {
+    let mut items = Vec::new();
+    let a = (age / 0.3).clamp(0., 1.);
+    let slide = (1. - a) * 40.;
+    let (x, y, w, h) = (-300. - slide, 90., 270., 300.);
+    items.push(Item::rect(Anchor::Center, x, y, w, h, hud::PANEL).faded(a));
+    items.push(Item::rect(Anchor::Center, x, y, w, 4., hud::MEAT_RED).faded(a));
+    items.push(Item::title("HALL OF MEAT", Anchor::Center, x + 14., y + 12., 22., Align::Left, hud::MEAT_RED).faded(a));
+    let flash = ((age * 6.).sin() * 0.5 + 0.5).clamp(0., 1.);
+    items.extend(skeleton(&report.damage, Anchor::Center, x + 10., y + 44., 112., flash).into_iter().map(|i| i.faded(a)));
+    let list_x = x + 130.;
+    let mut row = y + 48.;
+    let injuries = report.injuries();
+    for (region, severity) in injuries.iter().take(8) {
+        items.push(Item::text(injury_name(*region, *severity), Anchor::Center, list_x, row, 11., Align::Left, severity.color()).faded(a));
+        row += 15.;
+    }
+    if injuries.is_empty() {
+        items.push(Item::text("Walked it off", Anchor::Center, list_x, row, 12., Align::Left, hud::WHITE).faded(a));
+    }
+    let foot = y + h - 70.;
+    items.push(Item::sprite(Sprite::Splat, Anchor::Center, x + 18., foot - 16., 54., 54., hud::alpha(hud::MEAT_RED, 0.85)).faded(a));
+    items.push(Item::title("MEAT", Anchor::Center, x + 80., foot - 10., 11., Align::Left, hud::MEAT_RED).faded(a));
+    items.push(Item::digits(hud::points(report.meat), Anchor::Center, x + 80., foot + 2., 24., Align::Left, hud::WHITE).faded(a));
+    items.push(Item::text(
+        format!("{} broken   {:.0} km/h   {:.1} m drop", report.broken(), report.speed * 3.6, report.drop),
+        Anchor::Center,
+        x + 14.,
+        foot + 34.,
+        10.,
+        Align::Left,
+        [0.85, 0.85, 0.9, 1.],
+    ).faded(a));
+    let best_text = if new_best { "NEW BEST!".to_owned() } else { format!("BEST {}", hud::points(best)) };
+    let best_color = if new_best { hud::alpha(hud::SKATE_YELLOW, 0.6 + 0.4 * flash) } else { hud::COOL_BLUE };
+    items.push(Item::title(best_text, Anchor::Center, x + 14., foot + 50., 13., Align::Left, best_color).faded(a));
+    items
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn standing(offset: f32) -> [Option<V3>; N] {
+        let mut parts = [None; N];
+        for (i, p) in parts.iter_mut().enumerate() {
+            *p = Some([0., 1. + i as f32 * 0.05 + offset, 0.]);
+        }
+        parts
+    }
+
+    #[test]
+    fn hard_stops_hurt_and_soft_ones_do_not() {
+        let mut t = Tracker::new(0., 5., 2., 1.);
+        // Falling at 9 m/s for a few looks, then stopping dead.
+        let mut time = 0.;
+        let mut y = 2.;
+        for _ in 0..10 {
+            t.update(time, &standing(y), 5.);
+            time += 1. / 60.;
+            y -= 9. / 60.;
+        }
+        assert_eq!(t.meat(), 0., "a steady fall hurts nothing");
+        for _ in 0..3 {
+            t.update(time, &standing(y), 5.);
+            time += 1. / 60.;
+        }
+        let report = t.report(time);
+        assert!(report.meat > 0.);
+        let injuries = report.injuries();
+        assert!(!injuries.is_empty());
+        assert!(injuries.iter().all(|(_, s)| *s >= Severity::Cracked), "{injuries:?}");
+        assert!(!t.fresh.is_empty());
+        assert!(report.drop > 0.);
+        // The skull counts for more than the femur.
+        assert!(report.damage[0] > report.damage[13]);
+    }
+
+    #[test]
+    fn teleports_are_not_impacts() {
+        let mut t = Tracker::new(0., 0., 0., 1.);
+        t.update(0., &standing(0.), 0.);
+        t.update(1. / 60., &standing(0.), 0.);
+        t.update(2. / 60., &standing(50.), 0.);
+        t.update(3. / 60., &standing(50.), 0.);
+        assert_eq!(t.meat(), 0.);
+    }
+
+    #[test]
+    fn names_severities_and_parts() {
+        assert_eq!(injury_name(14, Severity::Fractured), "Fractured Left Femur");
+        assert_eq!(injury_name(12, Severity::Fractured), "Dislocated Left Wrist");
+        assert_eq!(Severity::of(70.), Severity::Broken);
+        let names: Vec<String> = ["HEAD", "HIPS", "LEFTARM", "LEFTFOREARM"].iter().map(|s| s.to_string()).collect();
+        let parts = Tracker::parts(&names, &[[0., 2., 0.], [0., 1., 0.], [1., 1.5, 0.], [1., 1.1, 0.]]);
+        assert_eq!(parts[0], Some([0., 2., 0.]));
+        assert_eq!(parts[8], Some([1., 1.3, 0.]));
+        assert!(parts[13].is_none());
+        let report = Report { meat: 5000., damage: [70.; N], speed: 8., drop: 3., seconds: 2. };
+        assert_eq!(report.broken(), N);
+        assert!(!panel(&report, 4000., true, 1.).is_empty());
+    }
+}
diff --git a/crates/skate_modes/src/menu.rs b/crates/skate_modes/src/menu.rs
new file mode 100644
index 0000000..1fcac61
--- /dev/null
+++ b/crates/skate_modes/src/menu.rs
@@ -0,0 +1,188 @@
+//! The Skate menu's list: rows to pick with the stick or the D-pad, some
+//! with a value to change left and right, drawn as Skate 3's side panel.
+
+use crate::hud::{self, Align, Anchor, Control, Item, Labels, buttons};
+
+/// What a row does when picked or changed.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Row<A> {
+    pub label: String,
+    /// A value shown at the right, changed with left and right.
+    pub value: Option<String>,
+    pub action: A,
+    /// Greyed out: shown, not pickable.
+    pub off: bool,
+}
+
+impl<A> Row<A> {
+    pub fn new(label: impl Into<String>, action: A) -> Self {
+        Self { label: label.into(), value: None, action, off: false }
+    }
+
+    pub fn value(mut self, value: impl Into<String>) -> Self {
+        self.value = Some(value.into());
+        self
+    }
+
+    pub fn off(mut self, off: bool) -> Self {
+        self.off = off;
+        self
+    }
+}
+
+/// What the player did with the menu this frame.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Choice<A> {
+    None,
+    Pick(A),
+    /// Left (-1) or right (+1) on a row with a value.
+    Change(A, i32),
+    Back,
+}
+
+/// The cursor and the stick's repeat.
+#[derive(Clone, Debug, Default)]
+pub struct Cursor {
+    pub row: usize,
+    held: f32,
+    last_dir: (i32, i32),
+}
+
+/// How the menu reads the controller: buttons pressed this frame and the
+/// left stick.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Nav {
+    pub pressed: u16,
+    pub held: u16,
+    pub stick: [f32; 2],
+}
+
+impl Cursor {
+    /// Moves through `rows` by `nav` for `dt` seconds.
+    pub fn update<A: Clone>(&mut self, rows: &[Row<A>], nav: Nav, dt: f32) -> Choice<A> {
+        if rows.is_empty() {
+            return if nav.pressed & buttons::B != 0 { Choice::Back } else { Choice::None };
+        }
+        self.row = self.row.min(rows.len() - 1);
+        let dy = if nav.held & buttons::DPAD_UP != 0 || nav.stick[1] > 0.6 {
+            -1
+        } else if nav.held & buttons::DPAD_DOWN != 0 || nav.stick[1] < -0.6 {
+            1
+        } else {
+            0
+        };
+        let dx = if nav.held & buttons::DPAD_LEFT != 0 || nav.stick[0] < -0.6 {
+            -1
+        } else if nav.held & buttons::DPAD_RIGHT != 0 || nav.stick[0] > 0.6 {
+            1
+        } else {
+            0
+        };
+        // A step on the first push, then repeats while held.
+        let dir = (dx, dy);
+        let step = if dir == (0, 0) {
+            self.held = 0.;
+            false
+        } else if dir != self.last_dir {
+            self.held = 0.;
+            true
+        } else {
+            self.held += dt;
+            if self.held > 0.38 {
+                self.held -= 0.09;
+                true
+            } else {
+                false
+            }
+        };
+        self.last_dir = dir;
+        if step && dy != 0 {
+            let n = rows.len() as i32;
+            let mut r = self.row as i32;
+            for _ in 0..n {
+                r = (r + dy).rem_euclid(n);
+                if !rows[r as usize].off {
+                    break;
+                }
+            }
+            self.row = r as usize;
+        }
+        let row = &rows[self.row];
+        if step && dx != 0 && row.value.is_some() && !row.off {
+            return Choice::Change(row.action.clone(), dx);
+        }
+        if nav.pressed & buttons::A != 0 && !row.off {
+            return Choice::Pick(row.action.clone());
+        }
+        if nav.pressed & buttons::B != 0 {
+            return Choice::Back;
+        }
+        Choice::None
+    }
+}
+
+/// Draws the menu: title, rows (the picked one lit), and its hints.
+pub fn draw<A>(title: &str, rows: &[Row<A>], cursor: &Cursor, labels: &dyn Labels, age: f32) -> Vec<Item> {
+    let a = (age / 0.18).clamp(0., 1.);
+    let slide = (1. - a) * -60.;
+    let (x, y, w) = (36. + slide, 70., 330.);
+    let row_h = 24.;
+    let h = 62. + rows.len() as f32 * row_h + 34.;
+    let mut items = vec![
+        Item::rect(Anchor::Left, x, y, w, h, hud::PANEL),
+        Item::rect(Anchor::Left, x, y, 5., h, hud::SKATE_YELLOW),
+        Item::title(title, Anchor::Left, x + 20., y + 14., 24., Align::Left, hud::SKATE_YELLOW),
+    ];
+    for (i, row) in rows.iter().enumerate() {
+        let ry = y + 56. + i as f32 * row_h;
+        let picked = i == cursor.row;
+        if picked {
+            items.push(Item::rect(Anchor::Left, x + 5., ry - 3., w - 5., row_h - 2., [1., 0.78, 0.18, 0.92]));
+        }
+        let color = if row.off {
+            [0.5, 0.5, 0.52, 1.]
+        } else if picked {
+            hud::BLACK
+        } else {
+            hud::WHITE
+        };
+        items.push(Item::text(&row.label, Anchor::Left, x + 20., ry + 1., 14., Align::Left, color));
+        if let Some(value) = &row.value {
+            let shown = if picked && !row.off { format!("<  {value}  >") } else { value.clone() };
+            items.push(Item::text(shown, Anchor::Left, x + w - 14., ry + 1., 13., Align::Right, color));
+        }
+    }
+    items.extend(hud::hints(
+        labels,
+        &[(Control::Button(buttons::A), "Select"), (Control::Button(buttons::B), "Back")],
+        Anchor::Left,
+        x + w * 0.5,
+        y + h - 26.,
+        12.,
+    ));
+    items.into_iter().map(|i| i.faded(a)).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_cursor_moves_skips_greyed_rows_and_picks() {
+        let rows = vec![Row::new("A", 1), Row::new("B", 2).off(true), Row::new("C", 3).value("On")];
+        let mut c = Cursor::default();
+        let down = Nav { held: buttons::DPAD_DOWN, ..Default::default() };
+        assert_eq!(c.update(&rows, down, 0.016), Choice::None);
+        assert_eq!(c.row, 2, "the greyed row is skipped");
+        // Held, it waits before repeating.
+        assert_eq!(c.update(&rows, down, 0.1), Choice::None);
+        assert_eq!(c.row, 2);
+        c.update(&rows, Nav::default(), 0.016);
+        let right = Nav { stick: [1., 0.], ..Default::default() };
+        assert_eq!(c.update(&rows, right, 0.016), Choice::Change(3, 1));
+        c.update(&rows, Nav::default(), 0.016);
+        assert_eq!(c.update(&rows, Nav { pressed: buttons::A, ..Default::default() }, 0.016), Choice::Pick(3));
+        assert_eq!(c.update(&rows, Nav { pressed: buttons::B, ..Default::default() }, 0.016), Choice::Back);
+        assert!(!draw("SKATE", &rows, &c, &hud::PadLabels, 1.).is_empty());
+    }
+}
