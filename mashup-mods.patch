+/// The picker's preview of the hovered board finish: its graphic, title and
+/// where it comes from.
+fn board_preview_dvars(state: &ClassMenuState, choices: &[String], board: &skate_boards::BoardChoice, dvars: &mut UiMenuDvars) {
+    let hovered = state.part.zip(choices.get(state.page * PAGE_SIZE + state.hover));
+    let value = hovered.and_then(|(_, value)| board_value(value));
+    let part = state.part.unwrap_or(Part::Deck);
+    // The whole board in 3D with the hovered part on it, turning over.
