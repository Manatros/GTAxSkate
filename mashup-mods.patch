+    dvars.set("ui_class_preview_width", "200");
+    dvars.set(
+        "ui_class_preview_title",
+        hovered.map(|(part, _)| board_title(part, value.as_ref())).unwrap_or_default(),
+    );
+    for at in 0..asset_game::CacStatBar::ALL.len() {
+        dvars.set(&format!("ui_class_stat_{at}"), "0");
+        dvars.set(&format!("ui_class_stat_visible_{at}"), "0");
+    }
+    let description = match (&value, hovered) {
+        (_, None) => String::new(),
+        (None, Some(_)) => format!("The default skater's {}.", part.label().to_lowercase()),
+        (Some(value), Some(_)) => {
+            let wear = assets::bot_model::board_wear().of(value);
+            let worn = if board.get(part) == Some(value) && wear > 0.01 {
+                format!(" Worn {:.0}%; pick it again for a new one.", (wear.min(1.) * 100.))
+            } else {
+                String::new()
+            };
+            format!(
+                "Skate 3 {}. Now on this class: {}.{worn}",
+                part.label().to_lowercase(),
+                board_title(part, board.get(part))
+            )
+        }
+    };
+    dvars.set("ui_class_description", description);
+    dvars.set(
+        "ui_class_page",
+        format!("{} / {}", state.page + 1, choices.len().max(1).div_ceil(PAGE_SIZE)),
+    );
+}
