+//! The Game of S.K.A.T.E.: one skater sets a trick, everyone else has to
+//! land the same one or take a letter; five letters and you are out, the
+//! last skater standing wins. A setter keeps setting while they land; a
+//! miss passes the set on. Rivals are other players (the mashup's match,
+//! GTA's co-op partner) or the computer.
+//!
+//! The player who starts a game runs it: others send their attempts and
+//! show the state the owner sends back (see [`crate::wire`]).
+
+use crate::hud::{self, Align, Anchor, Item, Rgba};
+use crate::sprites::Sprite;
+
+pub const LETTERS: [char; 5] = ['S', 'K', 'A', 'T', 'E'];
+
+/// A player's id: the game's client id, or [`CPU_BASE`] up for the computer.
+pub type PlayerId = u32;
+pub const CPU_BASE: PlayerId = 0xFFFF_FF00;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Player {
+    pub id: PlayerId,
+    pub name: String,
+    pub letters: u8,
+    /// The computer's level (0 to 2), for computer players.
+    pub cpu: Option<u8>,
+    /// Said yes to the invitation (the owner and the computer always have).
+    pub joined: bool,
+}
+
+impl Player {
+    pub fn out(&self) -> bool {
+        usize::from(self.letters) >= LETTERS.len()
+    }
+}
+
+/// Whose turn it is and to do what.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Phase {
+    /// Waiting for the invited to join.
+    Lobby,
+    Set { setter: usize },
+    Match { setter: usize, matcher: usize, trick: String },
+    Over { winner: usize },
+}
+
+/// How an attempt went.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Attempt {
+    /// Landed, with the tricks of the sequence in order.
+    Landed(Vec<String>),
+    Bailed,
+}
+
+/// The last thing that happened, for everyone's banner.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Outcome {
+    /// `player` set `trick`.
+    Set(usize, String),
+    /// `player` missed their set; the set passes on.
+    SetMissed(usize),
+    /// More than one trick: set again.
+    OneTrick(usize),
+    Matched(usize, String),
+    /// `player` missed and takes a letter.
+    Letter(usize),
+    Won(usize),
+}
+
+impl Outcome {
+    fn code(&self) -> (u8, usize, &str) {
+        match self {
+            Self::Set(p, t) => (1, *p, t),
+            Self::SetMissed(p) => (2, *p, ""),
+            Self::OneTrick(p) => (3, *p, ""),
+            Self::Matched(p, t) => (4, *p, t),
+            Self::Letter(p) => (5, *p, ""),
+            Self::Won(p) => (6, *p, ""),
+        }
+    }
+
+    fn from_code(code: u8, player: usize, trick: &str) -> Option<Self> {
+        Some(match code {
+            1 => Self::Set(player, trick.to_owned()),
+            2 => Self::SetMissed(player),
+            3 => Self::OneTrick(player),
+            4 => Self::Matched(player, trick.to_owned()),
+            5 => Self::Letter(player),
+            6 => Self::Won(player),
+            _ => return None,
+        })
+    }
+}
+
+/// A game.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Game {
+    pub id: u32,
+    /// Bumped by every change, so attempts name the turn they answer.
+    pub seq: u32,
+    pub players: Vec<Player>,
+    pub phase: Phase,
+    pub last: Option<Outcome>,
+}
+
+/// Tricks that only get a skater off the ground: part of a set, not the set.
+fn plain(name: &str) -> bool {
+    let n = name.to_ascii_lowercase();
+    let n = n.trim_start_matches("switch ").trim_start_matches("fakie ");
+    n == "ollie" || n == "nollie"
+}
+
+/// The trick a landed sequence counts as, or why it does not count.
+pub fn main_trick(tricks: &[String]) -> Result<String, &'static str> {
+    let named: Vec<&String> = tricks.iter().filter(|t| !t.trim().is_empty()).collect();
+    let real: Vec<&String> = named.iter().copied().filter(|t| !plain(t)).collect();
+    let mut distinct: Vec<String> = real.iter().map(|t| t.to_ascii_lowercase()).collect();
+    distinct.dedup();
+    match (distinct.len(), named.last()) {
+        (0, Some(last)) => Ok((*last).clone()),
+        (0, None) => Err("no trick"),
+        (1, _) => Ok(real.last().map(|t| (*t).clone()).unwrap_or_default()),
+        _ => Err("one trick only"),
+    }
+}
+
+impl Game {
+    pub fn new(id: u32, players: Vec<Player>, lobby: bool) -> Self {
+        Self { id, seq: 1, players, phase: if lobby { Phase::Lobby } else { Phase::Set { setter: 0 } }, last: None }
+    }
+
+    /// Starts from the lobby with whoever joined.
+    pub fn start(&mut self) -> bool {
+        if self.phase != Phase::Lobby {
+            return false;
+        }
+        self.players.retain(|p| p.joined);
+        if self.players.len() < 2 {
+            return false;
+        }
+        self.phase = Phase::Set { setter: 0 };
+        self.seq += 1;
+        true
+    }
+
+    /// The player whose attempt counts now.
+    pub fn turn(&self) -> Option<usize> {
+        match &self.phase {
+            Phase::Set { setter } => Some(*setter),
+            Phase::Match { matcher, .. } => Some(*matcher),
+            _ => None,
+        }
+    }
+
+    pub fn index_of(&self, id: PlayerId) -> Option<usize> {
+        self.players.iter().position(|p| p.id == id)
+    }
+
+    fn standing(&self) -> Vec<usize> {
+        (0..self.players.len()).filter(|i| !self.players[*i].out()).collect()
+    }
+
+    /// The next player after `from` still in, other than `skip`.
+    fn next_in(&self, from: usize, skip: Option<usize>) -> Option<usize> {
+        let n = self.players.len();
+        (1..=n).map(|k| (from + k) % n).find(|i| !self.players[*i].out() && Some(*i) != skip)
+    }
+
+    /// The matchers after the setter, in order, who still have to go after
+    /// `matcher`.
+    fn next_matcher(&self, setter: usize, after: usize) -> Option<usize> {
+        let n = self.players.len();
+        let start = (after + n - setter) % n;
+        (start + 1..n).map(|k| (setter + k) % n).find(|i| !self.players[*i].out())
+    }
+
+    /// Applies an attempt by player `who`; false when it is not their turn.
+    pub fn attempt(&mut self, who: usize, attempt: Attempt) -> bool {
+        if self.turn() != Some(who) {
+            return false;
+        }
+        match self.phase.clone() {
+            Phase::Set { setter } => match attempt {
+                Attempt::Landed(tricks) => match main_trick(&tricks) {
+                    Ok(trick) => {
+                        self.last = Some(Outcome::Set(setter, trick.clone()));
+                        self.phase = match self.next_matcher(setter, setter) {
+                            Some(matcher) => Phase::Match { setter, matcher, trick },
+                            None => Phase::Set { setter },
+                        };
+                    }
+                    Err(_) => self.last = Some(Outcome::OneTrick(setter)),
+                },
+                Attempt::Bailed => {
+                    self.last = Some(Outcome::SetMissed(setter));
+                    self.phase = Phase::Set { setter: self.next_in(setter, None).unwrap_or(setter) };
+                }
+            },
+            Phase::Match { setter, matcher, trick } => {
+                let made = match &attempt {
+                    Attempt::Landed(tricks) => main_trick(tricks).is_ok_and(|t| t.eq_ignore_ascii_case(&trick)),
+                    Attempt::Bailed => false,
+                };
+                if made {
+                    self.last = Some(Outcome::Matched(matcher, trick.clone()));
+                } else {
+                    self.players[matcher].letters += 1;
+                    self.last = Some(Outcome::Letter(matcher));
+                }
+                let standing = self.standing();
+                if standing.len() <= 1 {
+                    let winner = standing.first().copied().unwrap_or(setter);
+                    self.phase = Phase::Over { winner };
+                    self.last = Some(Outcome::Won(winner));
+                } else {
+                    self.phase = match self.next_matcher(setter, matcher) {
+                        Some(next) => Phase::Match { setter, matcher: next, trick },
+                        None => Phase::Set { setter },
+                    };
+                }
+            }
+            Phase::Lobby | Phase::Over { .. } => return false,
+        }
+        self.seq += 1;
+        true
+    }
+
+    /// Takes a player out of the game (they left).
+    pub fn remove(&mut self, who: usize) {
+        if who >= self.players.len() {
+            return;
+        }
+        self.players.remove(who);
+        let fix = |i: usize| if i > who { i - 1 } else { i };
+        let standing = self.standing();
+        if standing.len() <= 1 && !matches!(self.phase, Phase::Lobby) {
+            if let Some(winner) = standing.first().copied() {
+                self.phase = Phase::Over { winner };
+                self.last = Some(Outcome::Won(winner));
+            }
+        } else {
+            self.phase = match self.phase.clone() {
+                Phase::Set { setter } if setter == who => Phase::Set { setter: fix(setter) % self.players.len().max(1) },
+                Phase::Set { setter } => Phase::Set { setter: fix(setter) },
+                Phase::Match { setter, .. } if setter == who => Phase::Set { setter: fix(setter) % self.players.len().max(1) },
+                Phase::Match { setter, matcher, trick } if matcher == who => {
+                    // Whoever followed the one who left now has their place.
+                    let setter = fix(setter);
+                    let n = self.players.len();
+                    match self.next_matcher(setter, (matcher + n - 1) % n) {
+                        Some(next) => Phase::Match { setter, matcher: next, trick },
+                        None => Phase::Set { setter },
+                    }
+                }
+                Phase::Match { setter, matcher, trick } => Phase::Match { setter: fix(setter), matcher: fix(matcher), trick },
+                other => other,
+            };
+        }
+        self.seq += 1;
+    }
+
+    /// The game as text for the wire (see `wire`).
+    pub fn encode(&self) -> String {
+        let (phase, a, b, trick) = match &self.phase {
+            Phase::Lobby => (0, 0, 0, ""),
+            Phase::Set { setter } => (1, *setter, 0, ""),
+            Phase::Match { setter, matcher, trick } => (2, *setter, *matcher, trick.as_str()),
+            Phase::Over { winner } => (3, *winner, 0, ""),
+        };
+        let (code, who, what) = self.last.as_ref().map_or((0, 0, ""), |o| o.code());
+        let players: Vec<String> = self
+            .players
+            .iter()
+            .map(|p| format!("{}:{}:{}:{}:{}", p.id, p.letters, p.cpu.map_or(9, |c| c), u8::from(p.joined), clean(&p.name, 14)))
+            .collect();
+        format!(
+            "{},{},{},{},{},{},{},{},{},{}",
+            self.id,
+            self.seq,
+            phase,
+            a,
+            b,
+            clean(trick, 40),
+            code,
+            who,
+            clean(what, 40),
+            players.join("/")
+        )
+    }
+
+    pub fn decode(text: &str) -> Option<Self> {
+        let f: Vec<&str> = text.splitn(10, ',').collect();
+        if f.len() != 10 {
+            return None;
+        }
+        let num = |s: &str| s.parse::<usize>().ok();
+        let players = f[9]
+            .split('/')
+            .filter(|s| !s.is_empty())
+            .map(|p| {
+                let g: Vec<&str> = p.splitn(5, ':').collect();
+                (g.len() == 5).then_some(())?;
+                let cpu: u8 = g[2].parse().ok()?;
+                Some(Player {
+                    id: g[0].parse().ok()?,
+                    letters: g[1].parse::<u8>().ok()?.min(5),
+                    cpu: (cpu < 9).then_some(cpu),
+                    joined: g[3] == "1",
+                    name: g[4].to_owned(),
+                })
+            })
+            .collect::<Option<Vec<_>>>()?;
+        let n = players.len();
+        let (a, b) = (num(f[3])?, num(f[4])?);
+        let phase = match f[2] {
+            "0" => Phase::Lobby,
+            "1" if a < n => Phase::Set { setter: a },
+            "2" if a < n && b < n => Phase::Match { setter: a, matcher: b, trick: f[5].to_owned() },
+            "3" if a < n => Phase::Over { winner: a },
+            _ => return None,
+        };
+        let who = num(f[7])?;
+        let last = f[6].parse::<u8>().ok().and_then(|code| Outcome::from_code(code, who.min(n.saturating_sub(1)), f[8]));
+        Some(Self { id: f[0].parse().ok()?, seq: f[1].parse().ok()?, players, phase, last })
+    }
+}
+
+/// Text made safe for the wire's separators.
+pub fn clean(text: &str, max: usize) -> String {
+    text.chars()
+        .map(|c| if matches!(c, ',' | '/' | ':' | ';' | '|' | '=') || !c.is_ascii() || c.is_ascii_control() { ' ' } else { c })
+        .take(max)
+        .collect()
+}
+
+/// The computer's tricks: name and how hard (0 to 1).
+pub const CPU_TRICKS: [(&str, f32); 20] = [
+    ("Kickflip", 0.2),
+    ("Heelflip", 0.25),
+    ("Pop Shove-it", 0.15),
+    ("Frontside Shove-it", 0.2),
+    ("Varial Kickflip", 0.4),
+    ("Varial Heelflip", 0.45),
+    ("Fakie Kickflip", 0.4),
+    ("Nollie Kickflip", 0.45),
+    ("Nollie Heelflip", 0.5),
+    ("Hardflip", 0.55),
+    ("Inward Heelflip", 0.55),
+    ("360 Flip", 0.6),
+    ("Double Kickflip", 0.6),
+    ("Frontside 360 Shove-it", 0.6),
+    ("Switch Kickflip", 0.6),
+    ("Late Kickflip", 0.7),
+    ("Laser Flip", 0.75),
+    ("Nollie 360 Flip", 0.8),
+    ("360 Hardflip", 0.85),
+    ("Triple Kickflip", 0.9),
+];
+
+pub const CPU_NAMES: [&str; 3] = ["Rook", "Dex", "Vee"];
+pub const CPU_LEVELS: [&str; 3] = ["Amateur", "Pro", "Legend"];
+
+/// A repeatable roll in 0..1.
+fn roll(seed: u32) -> f32 {
+    let mut x = seed.wrapping_mul(0x9E37_79B9) ^ 0x7F4A_7C15;
+    x ^= x >> 16;
+    x = x.wrapping_mul(0x85EB_CA6B);
+    x ^= x >> 13;
+    x = x.wrapping_mul(0xC2B2_AE35);
+    x ^= x >> 16;
+    (x & 0xFF_FFFF) as f32 / 16_777_216.
+}
+
+fn difficulty(trick: &str) -> f32 {
+    CPU_TRICKS.iter().find(|(t, _)| t.eq_ignore_ascii_case(trick)).map_or(0.5, |(_, d)| *d)
+}
+
+/// The computer at `level` takes its turn: what it does with `seed`.
+pub fn cpu_attempt(game: &Game, level: u8, seed: u32) -> Attempt {
+    let skill = [0.55, 0.75, 0.9][usize::from(level.min(2))];
+    let lands = |d: f32, s: u32| roll(s) < (skill - d * 0.5 + 0.2).clamp(0.08, 0.97);
+    match &game.phase {
+        Phase::Match { trick, .. } => {
+            if lands(difficulty(trick), seed) { Attempt::Landed(vec![trick.clone()]) } else { Attempt::Bailed }
+        }
+        _ => {
+            let cap = [0.45, 0.7, 1.0][usize::from(level.min(2))];
+            let choices: Vec<&(&str, f32)> = CPU_TRICKS.iter().filter(|(_, d)| *d <= cap).collect();
+            let (trick, d) = choices[(roll(seed ^ 0x5151) * choices.len() as f32) as usize % choices.len()];
+            if lands(*d, seed ^ 0xA3A3) { Attempt::Landed(vec![(*trick).to_owned()]) } else { Attempt::Bailed }
+        }
+    }
+}
+
+/// The banner for the last outcome (seen `age` seconds), from player
+/// `me`'s side.
+pub fn banner(game: &Game, me: Option<usize>, age: f32) -> Option<(String, String, Rgba)> {
+    let name = |i: usize| {
+        if Some(i) == me { "YOU".to_owned() } else { game.players.get(i).map_or_else(String::new, |p| p.name.to_uppercase()) }
+    };
+    let last = game.last.as_ref()?;
+    if age > 3.5 {
+        return None;
+    }
+    Some(match last {
+        Outcome::Set(p, t) => (format!("{} SET IT", name(*p)), t.to_uppercase(), hud::SKATE_YELLOW),
+        Outcome::SetMissed(p) => (format!("{} MISSED THE SET", name(*p)), "The set passes on".into(), hud::COOL_BLUE),
+        Outcome::OneTrick(p) => (format!("{}: ONE TRICK ONLY", name(*p)), "Set again".into(), hud::COOL_BLUE),
+        Outcome::Matched(p, t) => (format!("{} MATCHED", name(*p)), t.to_uppercase(), hud::GOOD_GREEN),
+        Outcome::Letter(p) => {
+            let letters = game.players.get(*p).map_or(0, |pl| pl.letters);
+            let spelled: String = LETTERS.iter().take(usize::from(letters)).collect();
+            let sub = if usize::from(letters) >= LETTERS.len() { "OUT!".to_owned() } else { format!("{spelled}...") };
+            (format!("{} GETS A LETTER", name(*p)), sub, hud::MEAT_RED)
+        }
+        Outcome::Won(p) => (if Some(*p) == me { "YOU WIN!".into() } else { format!("{} WINS", name(*p)) }, "GAME OF S.K.A.T.E.".into(), hud::SKATE_YELLOW),
+    })
+}
+
+/// The scoreboard (each player's letters) and the turn prompt.
+pub fn board(game: &Game, me: Option<usize>, now: f32, outcome_age: f32) -> Vec<Item> {
+    let mut items = Vec::new();
+    let rows = game.players.len().min(6);
+    let tile = 20.;
+    let width = 130. + tile * 5.5;
+    let (x, y) = (-width * 0.5, 14.);
+    items.push(Item::rect(Anchor::Center, x - 8., y - 6., width + 16., 16. + rows as f32 * (tile + 4.), hud::PANEL));
+    for (row, player) in game.players.iter().take(rows).enumerate() {
+        let ry = y + 6. + row as f32 * (tile + 4.);
+        let turn = game.turn() == Some(row);
+        let name = if Some(row) == me { "YOU".to_owned() } else { player.name.clone() };
+        let color = if player.out() { [0.6, 0.6, 0.6, 1.] } else if turn { hud::SKATE_YELLOW } else { hud::WHITE };
+        if turn {
+            let pulse = 0.6 + 0.4 * (now * 5.).sin().abs();
+            items.push(Item::sprite(Sprite::Play, Anchor::Center, x - 4., ry + 3., 12., 12., hud::alpha(hud::SKATE_YELLOW, pulse)));
+        }
+        items.push(Item::text(name, Anchor::Center, x + 12., ry + 3., 12., Align::Left, color));
+        for k in 0..LETTERS.len() {
+            let lit = k < usize::from(player.letters);
+            let tx = x + 130. + k as f32 * (tile + 2.);
+            // A letter just earned pops in.
+            let fresh = lit && k + 1 == usize::from(player.letters) && matches!(game.last, Some(Outcome::Letter(p)) if p == row);
+            let grow = if fresh { hud::pop(outcome_age) } else { 1. };
+            let s = tile * grow;
+            let off = (s - tile) * 0.5;
+            items.push(Item::sprite(Sprite::Tile(k as u8 + if lit { 5 } else { 0 }), Anchor::Center, tx - off, ry - off, s, s, hud::WHITE));
+        }
+    }
+    items
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn players(n: usize) -> Vec<Player> {
+        (0..n).map(|i| Player { id: i as u32 + 1, name: format!("P{i}"), letters: 0, cpu: None, joined: true }).collect()
+    }
+
+    fn landed(t: &str) -> Attempt {
+        Attempt::Landed(vec![t.to_owned()])
+    }
+
+    #[test]
+    fn sets_matches_letters_and_a_winner() {
+        let mut g = Game::new(7, players(2), false);
+        assert_eq!(g.turn(), Some(0));
+        assert!(!g.attempt(1, landed("Kickflip")), "not their turn");
+        assert!(g.attempt(0, Attempt::Landed(vec!["Ollie".into(), "Kickflip".into()])));
+        assert_eq!(g.phase, Phase::Match { setter: 0, matcher: 1, trick: "Kickflip".into() });
+        assert!(g.attempt(1, landed("Heelflip")));
+        assert_eq!(g.players[1].letters, 1);
+        assert_eq!(g.phase, Phase::Set { setter: 0 }, "the setter sets again");
+        // A missed set passes on.
+        g.attempt(0, Attempt::Bailed);
+        assert_eq!(g.phase, Phase::Set { setter: 1 });
+        // Two tricks are no set.
+        g.attempt(1, Attempt::Landed(vec!["Kickflip".into(), "50-50 Grind".into()]));
+        assert_eq!(g.last, Some(Outcome::OneTrick(1)));
+        assert_eq!(g.phase, Phase::Set { setter: 1 });
+        for _ in 0..5 {
+            g.attempt(1, landed("Hardflip"));
+            if matches!(g.phase, Phase::Over { .. }) {
+                break;
+            }
+            g.attempt(0, Attempt::Bailed);
+        }
+        assert_eq!(g.phase, Phase::Over { winner: 1 });
+        assert_eq!(g.players[0].letters, 5);
+        assert!(banner(&g, Some(1), 0.).unwrap().0.contains("YOU WIN"));
+    }
+
+    #[test]
+    fn three_players_take_turns_and_the_out_are_skipped() {
+        let mut g = Game::new(1, players(3), false);
+        g.attempt(0, landed("Kickflip"));
+        g.attempt(1, landed("kickflip"));
+        assert_eq!(g.phase, Phase::Match { setter: 0, matcher: 2, trick: "Kickflip".into() });
+        g.players[1].letters = 5;
+        g.attempt(2, Attempt::Bailed);
+        assert_eq!(g.phase, Phase::Set { setter: 0 });
+        g.attempt(0, Attempt::Bailed);
+        assert_eq!(g.phase, Phase::Set { setter: 2 }, "the out player is skipped");
+        g.remove(0);
+        assert_eq!(g.phase, Phase::Over { winner: 1 }, "{:?}", g.players);
+    }
+
+    #[test]
+    fn games_travel_as_text() {
+        let mut g = Game::new(42, players(2), true);
+        g.players[1].joined = false;
+        g.players[1].cpu = Some(2);
+        let back = Game::decode(&g.encode()).unwrap();
+        assert_eq!(back, g);
+        g.players[1].joined = true;
+        assert!(g.start());
+        g.attempt(0, landed("Varial Kickflip"));
+        let back = Game::decode(&g.encode()).unwrap();
+        assert_eq!(back, g);
+        assert!(Game::decode("1,2,3").is_none());
+        assert_eq!(clean("a,b/c:d", 10), "a b c d");
+    }
+
+    #[test]
+    fn the_computer_plays() {
+        let g = Game::new(1, players(2), false);
+        let mut landed_any = false;
+        for seed in 0..50 {
+            if let Attempt::Landed(t) = cpu_attempt(&g, 0, seed) {
+                landed_any = true;
+                assert!(difficulty(&t[0]) <= 0.45);
+            }
+        }
+        assert!(landed_any);
+        assert!(main_trick(&["Ollie".into()]).is_ok());
+        assert!(main_trick(&[]).is_err());
+        assert!(!board(&g, Some(0), 1., 0.).is_empty());
+    }
+}
