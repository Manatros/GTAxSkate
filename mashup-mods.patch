index 0000000..f9cc84f
--- /dev/null
+++ b/crates/skate_modes/src/spots.rs
@@ -0,0 +1,307 @@
+//! Own the Spot: a spot is a circle on the map with two targets. Skate
+//! inside it for two minutes; your best line (or, at a Hall of Meat spot,
+//! your best bail) against the targets: beat the first and you Own it, the
+//! second and you Kill it. Spots are made where you stand and kept per map
+//! with their best scores.
+
+use std::path::{Path, PathBuf};
+
+use crate::hud::{self, Align, Anchor, Item};
+use crate::math::{V3, distance};
+use crate::sprites::Sprite;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Line,
+    Meat,
+}
+
+impl Kind {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Line => "OWN THE SPOT",
+            Self::Meat => "HALL OF MEAT SPOT",
+        }
+    }
+
+    /// Targets a new spot starts with.
+    pub fn targets(self) -> (f32, f32) {
+        match self {
+            Self::Line => (20_000., 50_000.),
+            Self::Meat => (8_000., 20_000.),
+        }
+    }
+}
+
+/// What a score earns at a spot.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Medal {
+    None,
+    Own,
+    Kill,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Spot {
+    pub id: u32,
+    pub name: String,
+    pub kind: Kind,
+    /// In the game's world, metres.
+    pub center: V3,
+    pub radius: f32,
+    pub own: f32,
+    pub kill: f32,
+    pub best: f32,
+}
+
+impl Spot {
+    pub fn medal(&self, score: f32) -> Medal {
+        if score >= self.kill {
+            Medal::Kill
+        } else if score >= self.own {
+            Medal::Own
+        } else {
+            Medal::None
+        }
+    }
+
+    pub fn inside(&self, at: V3) -> bool {
+        distance(at, self.center) <= self.radius
+    }
+}
+
+/// A two-minute run at a spot.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Run {
+    pub spot: u32,
+    pub started: f64,
+    pub seconds: f32,
+    pub best: f32,
+    /// Seconds spent outside the circle, in a row.
+    pub outside: f32,
+    /// The score's completed-lines total when the run began, to see each
+    /// line as it is banked.
+    pub banked: Option<f32>,
+    /// A line that left the circle is void.
+    pub void: bool,
+    /// The finish: medal and when.
+    pub done: Option<(Medal, f64)>,
+}
+
+pub const RUN_SECONDS: f32 = 120.;
+
+impl Run {
+    pub fn left(&self, now: f64) -> f32 {
+        (self.seconds - (now - self.started) as f32).max(0.)
+    }
+}
+
+/// The spots of one map.
+#[derive(Clone, Debug, Default)]
+pub struct Spots {
+    pub list: Vec<Spot>,
+    path: Option<PathBuf>,
+}
+
+impl Spots {
+    /// The spots kept in `path` (none yet if it is missing).
+    pub fn load(path: &Path) -> Self {
+        let text = std::fs::read_to_string(path).unwrap_or_default();
+        let list = text.lines().filter_map(parse).collect();
+        Self { list, path: Some(path.to_owned()) }
+    }
+
+    pub fn save(&self) -> Result<(), String> {
+        let Some(path) = &self.path else { return Ok(()) };
+        let mut text = String::from("# Skate spots: id|kind|name|x,y,z|radius|own|kill|best\n");
+        for s in &self.list {
+            text.push_str(&format!(
+                "{}|{}|{}|{},{},{}|{}|{}|{}|{}\n",
+                s.id,
+                match s.kind {
+                    Kind::Line => "line",
+                    Kind::Meat => "meat",
+                },
+                s.name.replace('|', " "),
+                s.center[0],
+                s.center[1],
+                s.center[2],
+                s.radius,
+                s.own,
+                s.kill,
+                s.best
+            ));
+        }
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        std::fs::write(path, text).map_err(|e| format!("{}: {e}", path.display()))
+    }
+
+    /// A new spot at `center`, named after `place` (or numbered).
+    pub fn create(&mut self, kind: Kind, center: V3, place: &str) -> u32 {
+        let id = self.list.iter().map(|s| s.id).max().unwrap_or(0) + 1;
+        let place = place.trim();
+        let name = if place.is_empty() { format!("Spot {id}") } else { place.chars().take(28).collect() };
+        let (own, kill) = kind.targets();
+        self.list.push(Spot { id, name, kind, center, radius: 22., own, kill, best: 0. });
+        id
+    }
+
+    pub fn get(&self, id: u32) -> Option<&Spot> {
+        self.list.iter().find(|s| s.id == id)
+    }
+
+    pub fn get_mut(&mut self, id: u32) -> Option<&mut Spot> {
+        self.list.iter_mut().find(|s| s.id == id)
+    }
+
+    /// The nearest spot to `at` within `reach` metres of its edge.
+    pub fn nearest(&self, at: V3, reach: f32) -> Option<&Spot> {
+        self.list
+            .iter()
+            .map(|s| (s, distance(at, s.center) - s.radius))
+            .filter(|(_, d)| *d <= reach)
+            .min_by(|a, b| a.1.total_cmp(&b.1))
+            .map(|(s, _)| s)
+    }
+
+    pub fn remove(&mut self, id: u32) {
+        self.list.retain(|s| s.id != id);
+    }
+}
+
+fn parse(line: &str) -> Option<Spot> {
+    let line = line.trim();
+    if line.is_empty() || line.starts_with('#') {
+        return None;
+    }
+    let f: Vec<&str> = line.split('|').collect();
+    if f.len() != 8 {
+        return None;
+    }
+    let c: Vec<f32> = f[3].split(',').filter_map(|v| v.trim().parse().ok()).collect();
+    if c.len() != 3 || c.iter().any(|v| !v.is_finite()) {
+        return None;
+    }
+    Some(Spot {
+        id: f[0].parse().ok()?,
+        kind: match f[1] {
+            "meat" => Kind::Meat,
+            _ => Kind::Line,
+        },
+        name: f[2].to_owned(),
+        center: [c[0], c[1], c[2]],
+        radius: f[4].parse::<f32>().ok()?.clamp(5., 200.),
+        own: f[5].parse().ok()?,
+        kill: f[6].parse().ok()?,
+        best: f[7].parse().ok()?,
+    })
+}
+
+/// A spot as the game draws it in the world.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Marker {
+    pub center: V3,
+    pub radius: f32,
+    pub label: String,
+    pub kind: Kind,
+    /// The best so far earns: none, own or kill.
+    pub medal: Medal,
+    /// The run is on here.
+    pub active: bool,
+}
+
+/// The HUD of a run: the clock, the best, the targets on a bar.
+pub fn run_hud(spot: &Spot, run: &Run, now: f64, live: f32) -> Vec<Item> {
+    let mut items = Vec::new();
+    let left = run.left(now);
+    let (x, y, w) = (-150., 12., 300.);
+    items.push(Item::rect(Anchor::Center, x, y, w, 58., hud::PANEL));
+    items.push(Item::sprite(Sprite::Pin, Anchor::Center, x + 6., y + 5., 18., 18., hud::SKATE_YELLOW));
+    items.push(Item::title(spot.name.to_uppercase(), Anchor::Center, x + 28., y + 6., 13., Align::Left, hud::SKATE_YELLOW));
+    let hurry = left < 10. && (now * 4.).fract() < 0.5;
+    items.push(Item::digits(hud::clock(left), Anchor::Center, x + w - 8., y + 4., 18., Align::Right, if hurry { hud::MEAT_RED } else { hud::WHITE }));
+    // The bar: best so far, the live line, and the two targets.
+    let (bx, by, bw, bh) = (x + 8., y + 30., w - 16., 8.);
+    let scale = spot.kill * 1.15;
+    let at = |v: f32| bw * (v / scale).clamp(0., 1.);
+    items.push(Item::rect(Anchor::Center, bx, by, bw, bh, [1., 1., 1., 0.15]));
+    items.push(Item::rect(Anchor::Center, bx, by, at(live.max(run.best)), bh, [1., 1., 1., 0.35]));
+    items.push(Item::rect(Anchor::Center, bx, by, at(run.best), bh, hud::SKATE_YELLOW));
+    for (target, label, sprite) in [(spot.own, "OWN", Sprite::MedalOwn), (spot.kill, "KILL", Sprite::MedalKill)] {
+        let tx = bx + at(target);
+        let got = run.best >= target;
+        items.push(Item::rect(Anchor::Center, tx - 1., by - 3., 2., bh + 6., hud::WHITE));
+        items.push(Item::sprite(sprite, Anchor::Center, tx - 7., by + bh + 1., 14., 14., if got { hud::SKATE_YELLOW } else { [0.7, 0.7, 0.75, 0.9] }));
+        items.push(Item::text(format!("{label} {}", hud::points(target)), Anchor::Center, tx - 9., by + bh + 3., 9., Align::Right, hud::WHITE));
+    }
+    let what = match spot.kind {
+        Kind::Line => "BEST LINE",
+        Kind::Meat => "BEST BAIL",
+    };
+    items.push(Item::text(format!("{what} {}", hud::points(run.best)), Anchor::Center, bx, by + bh + 3., 9., Align::Left, hud::WHITE));
+    if run.outside > 0.2 {
+        let blink = (now * 3.).fract() < 0.6;
+        if blink {
+            items.push(Item::title("GET BACK TO THE SPOT!", Anchor::Center, 0., y + 66., 15., Align::Center, hud::MEAT_RED));
+        }
+    }
+    items
+}
+
+/// The finish: OWNED / KILLED / NOT YET with the medal.
+pub fn finish_hud(spot: &Spot, run: &Run, medal: Medal, age: f32) -> Vec<Item> {
+    let a = hud::fade(age, 5.);
+    let s = hud::pop(age);
+    let (title, sprite, color) = match medal {
+        Medal::Kill => ("KILLED IT!", Some(Sprite::MedalKill), hud::SKATE_YELLOW),
+        Medal::Own => ("OWNED!", Some(Sprite::MedalOwn), [0.85, 0.88, 0.95, 1.]),
+        Medal::None => ("TIME'S UP", None, hud::WHITE),
+    };
+    let mut items = vec![Item::rect(Anchor::Center, -170., 120., 340., 150., hud::PANEL).faded(a)];
+    if let Some(sprite) = sprite {
+        let size = 96. * s;
+        items.push(Item::sprite(Sprite::Glow, Anchor::Center, -90., 105., 180., 180., hud::alpha(color, 0.35)).faded(a));
+        items.push(Item::sprite(sprite, Anchor::Center, -size * 0.5, 128. - (size - 96.) * 0.5, size, size, color).faded(a));
+    }
+    items.push(Item::title(title, Anchor::Center, 0., 228., 24., Align::Center, color).faded(a));
+    let line = format!("{}   {}   best ever {}", spot.name, hud::points(run.best), hud::points(spot.best.max(run.best)));
+    items.push(Item::text(line, Anchor::Center, 0., 254., 11., Align::Center, hud::WHITE).faded(a));
+    items
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn spots_are_made_found_kept_and_judged() {
+        let dir = std::env::temp_dir().join(format!("skate-spots-{}", std::process::id()));
+        let path = dir.join("spots.txt");
+        let mut spots = Spots::load(&path);
+        assert!(spots.list.is_empty());
+        let a = spots.create(Kind::Line, [10., 0., 5.], "Vespucci Beach");
+        let b = spots.create(Kind::Meat, [200., 0., 5.], "");
+        assert_eq!(spots.get(b).unwrap().name, "Spot 2");
+        spots.get_mut(a).unwrap().best = 23_000.;
+        spots.save().unwrap();
+        let back = Spots::load(&path);
+        assert_eq!(back.list, spots.list);
+        assert_eq!(back.nearest([12., 0., 5.], 5.).unwrap().id, a);
+        assert!(back.nearest([100., 0., 5.], 5.).is_none());
+        let spot = back.get(a).unwrap();
+        assert!(spot.inside([20., 0., 10.]) && !spot.inside([40., 0., 5.]));
+        assert_eq!(spot.medal(19_000.), Medal::None);
+        assert_eq!(spot.medal(25_000.), Medal::Own);
+        assert_eq!(spot.medal(60_000.), Medal::Kill);
+        let run = Run { spot: a, started: 0., seconds: RUN_SECONDS, best: 21_000., outside: 1., banked: None, void: false, done: None };
+        assert_eq!(run.left(30.), 90.);
+        assert!(!run_hud(spot, &run, 30., 5_000.).is_empty());
+        assert!(!finish_hud(spot, &run, Medal::Own, 0.5).is_empty());
+        let mut spots = back;
+        spots.remove(a);
+        assert!(spots.get(a).is_none());
+        let _ = std::fs::remove_dir_all(dir);
+    }
+}
diff --git a/crates/skate_modes/src/sprites.rs b/crates/skate_modes/src/sprites.rs
new file mode 100644
index 0000000..bae6d0e
--- /dev/null
+++ b/crates/skate_modes/src/sprites.rs
@@ -0,0 +1,694 @@
+//! The HUD's sprites, painted here rather than shipped as files: button
+//! glyphs, the replay editor's timeline marks and camcorder overlays, the
+//! Hall of Meat's skeleton (one sprite per bone, tinted by its injury),
+//! S.K.A.T.E.'s letter tiles, Own the Spot's medals and pins, and the
+//! screen effects (vignettes, the fisheye's barrel, film grain, the impact
+//! flash). Shapes are drawn white (greys for detail) so either game tints
+//! them; edges are antialiased from signed distances.
+
+use crate::meat::REGIONS;
+
+/// A sprite of the HUD.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Sprite {
+    Dot,
+    Ring,
+    Bumper,
+    Trigger,
+    Dpad,
+    Key,
+    Diamond,
+    Playhead,
+    Play,
+    Pause,
+    Corner(u8),
+    Camera,
+    Vignette,
+    Fisheye,
+    Grain(u8),
+    Flash,
+    Glow,
+    Fade,
+    Splat,
+    Body,
+    /// A bone of the Hall of Meat skeleton ([`REGIONS`] index).
+    Bone(u8),
+    TileBack,
+    TileEdge,
+    /// A controller glyph with its letters (see [`GLYPHS`]).
+    Glyph(u8),
+    /// A S.K.A.T.E. letter tile: 0 to 4 unearned, 5 to 9 earned.
+    Tile(u8),
+    MedalOwn,
+    MedalKill,
+    Star,
+    Pin,
+    Arrow,
+}
+
+pub const GRAINS: u8 = 4;
+
+/// The controller glyphs: their letters.
+pub const GLYPHS: [&str; 16] = ["A", "B", "X", "Y", "LB", "RB", "LT", "RT", "LS", "RS", "BACK", "START", "^", "v", "<", ">"];
+
+/// The glyph of a control's letters, if there is one.
+pub fn glyph_index(letters: &str) -> Option<u8> {
+    GLYPHS.iter().position(|g| *g == letters).map(|i| i as u8)
+}
+
+impl Sprite {
+    /// Every sprite.
+    pub fn all() -> Vec<Self> {
+        let mut all = vec![
+            Self::Dot,
+            Self::Ring,
+            Self::Bumper,
+            Self::Trigger,
+            Self::Dpad,
+            Self::Key,
+            Self::Diamond,
+            Self::Playhead,
+            Self::Play,
+            Self::Pause,
+            Self::Camera,
+            Self::Vignette,
+            Self::Fisheye,
+            Self::Flash,
+            Self::Glow,
+            Self::Fade,
+            Self::Splat,
+            Self::Body,
+            Self::TileBack,
+            Self::TileEdge,
+            Self::MedalOwn,
+            Self::MedalKill,
+            Self::Star,
+            Self::Pin,
+            Self::Arrow,
+        ];
+        all.extend((0..4).map(Self::Corner));
+        all.extend((0..GRAINS).map(Self::Grain));
+        all.extend((0..REGIONS.len() as u8).map(Self::Bone));
+        all.extend((0..GLYPHS.len() as u8).map(Self::Glyph));
+        all.extend((0..10).map(Self::Tile));
+        all
+    }
+
+    /// A short file-safe name ("bone_07").
+    pub fn name(self) -> String {
+        match self {
+            Self::Corner(i) => format!("corner_{i}"),
+            Self::Grain(i) => format!("grain_{i}"),
+            Self::Bone(i) => format!("bone_{i:02}"),
+            Self::Glyph(i) => format!("glyph_{i:02}"),
+            Self::Tile(i) => format!("tile_{i}"),
+            other => {
+                let debug = format!("{other:?}");
+                let mut out = String::new();
+                for (i, c) in debug.chars().enumerate() {
+                    if c.is_ascii_uppercase() && i > 0 {
+                        out.push('_');
+                    }
+                    out.push(c.to_ascii_lowercase());
+                }
+                out
+            }
+        }
+    }
+
+    /// Pixels across and down.
+    pub fn size(self) -> (u32, u32) {
+        match self {
+            Self::Dot | Self::Ring | Self::Pin | Self::Arrow | Self::Star | Self::Play | Self::Pause | Self::Corner(_) => (64, 64),
+            Self::TileBack | Self::TileEdge | Self::Camera | Self::Tile(_) => (64, 64),
+            Self::Glyph(i) if GLYPHS.get(usize::from(i)).is_some_and(|g| g.len() > 1 && g.len() <= 2) => (96, 64),
+            Self::Glyph(i) if GLYPHS.get(usize::from(i)).is_some_and(|g| g.len() > 2) => (128, 64),
+            Self::Glyph(_) => (64, 64),
+            Self::Bumper => (64, 32),
+            Self::Trigger | Self::Dpad => (48, 48),
+            Self::Key => (64, 48),
+            Self::Diamond | Self::Playhead => (32, 32),
+            Self::Vignette | Self::Flash | Self::Grain(_) => (256, 256),
+            Self::Fisheye => (512, 512),
+            Self::Glow | Self::Splat | Self::MedalOwn | Self::MedalKill => (128, 128),
+            Self::Fade => (16, 64),
+            Self::Body | Self::Bone(_) => (128, 256),
+        }
+    }
+
+    /// The sprite's pixels.
+    pub fn paint(self) -> Image {
+        let (w, h) = self.size();
+        let mut c = Canvas::new(w, h);
+        paint(self, &mut c);
+        c.image()
+    }
+}
+
+/// RGBA pixels, rows from the top.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Image {
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+
+impl Image {
+    /// The image as a PNG file.
+    pub fn png(&self) -> Result<Vec<u8>, String> {
+        let mut out = Vec::new();
+        {
+            let mut encoder = png::Encoder::new(&mut out, self.width, self.height);
+            encoder.set_color(png::ColorType::Rgba);
+            encoder.set_depth(png::BitDepth::Eight);
+            let mut writer = encoder.write_header().map_err(|e| e.to_string())?;
+            writer.write_image_data(&self.rgba).map_err(|e| e.to_string())?;
+        }
+        Ok(out)
+    }
+}
+
+/// Writes every sprite as `<name>.png` into `dir` (for the games that load
+/// images from files); returns the paths by sprite.
+pub fn write_all(dir: &std::path::Path) -> Result<Vec<(Sprite, std::path::PathBuf)>, String> {
+    std::fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let mut out = Vec::new();
+    for sprite in Sprite::all() {
+        let path = dir.join(format!("{}.png", sprite.name()));
+        let bytes = sprite.paint().png()?;
+        // Unchanged files are left alone (the game may hold them open).
+        if std::fs::read(&path).ok().as_deref() != Some(&bytes[..]) {
+            std::fs::write(&path, &bytes).map_err(|e| format!("{}: {e}", path.display()))?;
+        }
+        out.push((sprite, path));
+    }
+    Ok(out)
+}
+
+/// A painting surface: premultiplied-free RGBA in floats.
+struct Canvas {
+    w: u32,
+    h: u32,
+    px: Vec<[f32; 4]>,
+}
+
+type P = [f32; 2];
+
+fn len2(p: P) -> f32 {
+    (p[0] * p[0] + p[1] * p[1]).sqrt()
+}
+
+/// Signed distance to a segment `a`-`b`, `w` wide.
+fn seg(p: P, a: P, b: P, w: f32) -> f32 {
+    let pa = [p[0] - a[0], p[1] - a[1]];
+    let ba = [b[0] - a[0], b[1] - a[1]];
+    let t = ((pa[0] * ba[0] + pa[1] * ba[1]) / (ba[0] * ba[0] + ba[1] * ba[1]).max(1e-6)).clamp(0., 1.);
+    len2([pa[0] - ba[0] * t, pa[1] - ba[1] * t]) - w * 0.5
+}
+
+fn circle(p: P, c: P, r: f32) -> f32 {
+    len2([p[0] - c[0], p[1] - c[1]]) - r
+}
+
+/// An ellipse, near enough (exact on its axes).
+fn ellipse(p: P, c: P, r: P) -> f32 {
+    let q = [(p[0] - c[0]) / r[0], (p[1] - c[1]) / r[1]];
+    (len2(q) - 1.) * r[0].min(r[1])
+}
+
+/// A box centred on `c`, `half` its size, corners rounded by `r`.
+fn rbox(p: P, c: P, half: P, r: f32) -> f32 {
+    let q = [(p[0] - c[0]).abs() - half[0] + r, (p[1] - c[1]).abs() - half[1] + r];
+    len2([q[0].max(0.), q[1].max(0.)]) + q[0].max(q[1]).min(0.) - r
+}
+
+/// A convex or concave polygon (even-odd inside).
+fn poly(p: P, pts: &[P]) -> f32 {
+    let mut d = f32::INFINITY;
+    let mut inside = false;
+    let n = pts.len();
+    for i in 0..n {
+        let a = pts[i];
+        let b = pts[(i + 1) % n];
+        d = d.min(seg(p, a, b, 0.));
+        if (a[1] > p[1]) != (b[1] > p[1]) && p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0] {
+            inside = !inside;
+        }
+    }
+    if inside { -d } else { d }
+}
+
+/// A star of `n` points between radii `outer` and `inner`.
+fn star(p: P, c: P, n: usize, outer: f32, inner: f32, turn: f32) -> f32 {
+    let pts: Vec<P> = (0..n * 2)
+        .map(|i| {
+            let a = turn + i as f32 * std::f32::consts::PI / n as f32;
+            let r = if i % 2 == 0 { outer } else { inner };
+            [c[0] + a.sin() * r, c[1] - a.cos() * r]
+        })
+        .collect();
+    poly(p, &pts)
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0., 1.);
+    t * t * (3. - 2. * t)
+}
+
+/// A repeatable random number in 0..1 for `n`.
+fn hash(n: u32) -> f32 {
+    let mut x = n.wrapping_mul(0x9E37_79B9) ^ 0x85EB_CA6B;
+    x ^= x >> 15;
+    x = x.wrapping_mul(0x2C1B_3C6D);
+    x ^= x >> 12;
+    x = x.wrapping_mul(0x297A_2D39);
+    x ^= x >> 15;
+    (x & 0xFF_FFFF) as f32 / 16_777_216.
+}
+
+impl Canvas {
+    fn new(w: u32, h: u32) -> Self {
+        Self { w, h, px: vec![[1., 1., 1., 0.]; (w * h) as usize] }
+    }
+
+    /// Paints `value` (grey) where `sdf` is inside, at `opacity`.
+    fn fill(&mut self, value: f32, opacity: f32, sdf: impl Fn(P) -> f32) {
+        for y in 0..self.h {
+            for x in 0..self.w {
+                let p = [x as f32 + 0.5, y as f32 + 0.5];
+                let cover = (0.5 - sdf(p)).clamp(0., 1.) * opacity;
+                if cover <= 0. {
+                    continue;
+                }
+                let px = &mut self.px[(y * self.w + x) as usize];
+                let a = cover + px[3] * (1. - cover);
+                if a > 0. {
+                    for c in 0..3 {
+                        px[c] = (value * cover + px[c] * px[3] * (1. - cover)) / a;
+                    }
+                }
+                px[3] = a;
+            }
+        }
+    }
+
+    /// Paints a colour where `sdf` is inside.
+    fn fill_rgb(&mut self, rgb: [f32; 3], sdf: impl Fn(P) -> f32) {
+        for y in 0..self.h {
+            for x in 0..self.w {
+                let p = [x as f32 + 0.5, y as f32 + 0.5];
+                let cover = (0.5 - sdf(p)).clamp(0., 1.);
+                if cover <= 0. {
+                    continue;
+                }
+                let px = &mut self.px[(y * self.w + x) as usize];
+                let a = cover + px[3] * (1. - cover);
+                if a > 0. {
+                    for c in 0..3 {
+                        px[c] = (rgb[c] * cover + px[c] * px[3] * (1. - cover)) / a;
+                    }
+                }
+                px[3] = a;
+            }
+        }
+    }
+
+    /// Clears what `sdf` covers.
+    fn erase(&mut self, sdf: impl Fn(P) -> f32) {
+        for y in 0..self.h {
+            for x in 0..self.w {
+                let p = [x as f32 + 0.5, y as f32 + 0.5];
+                let cover = (0.5 - sdf(p)).clamp(0., 1.);
+                let px = &mut self.px[(y * self.w + x) as usize];
+                px[3] *= 1. - cover;
+            }
+        }
+    }
+
+    /// Sets every pixel from its position (0..1 across and down).
+    fn shade(&mut self, f: impl Fn(f32, f32, u32) -> [f32; 4]) {
+        for y in 0..self.h {
+            for x in 0..self.w {
+                let u = (x as f32 + 0.5) / self.w as f32;
+                let v = (y as f32 + 0.5) / self.h as f32;
+                self.px[(y * self.w + x) as usize] = f(u, v, y * self.w + x);
+            }
+        }
+    }
+
+    fn image(&self) -> Image {
+        let mut rgba = Vec::with_capacity(self.px.len() * 4);
+        for p in &self.px {
+            for c in p {
+                rgba.push((c.clamp(0., 1.) * 255.).round() as u8);
+            }
+        }
+        Image { width: self.w, height: self.h, rgba }
+    }
+}
+
+/// A stroke font for the few letters sprites carry, on a 4 x 6 grid.
+fn strokes(c: char) -> &'static [&'static [P]] {
+    match c {
+        'A' => &[&[[0., 6.], [2., 0.], [4., 6.]], &[[0.8, 3.9], [3.2, 3.9]]],
+        'B' => &[&[[0., 3.], [3., 3.], [4., 4.], [4., 5.], [3., 6.], [0., 6.], [0., 0.], [3., 0.], [4., 1.], [4., 2.], [3., 3.]]],
+        'C' => &[&[[4., 1.], [3., 0.], [1., 0.], [0., 1.], [0., 5.], [1., 6.], [3., 6.], [4., 5.]]],
+        'E' => &[&[[4., 0.], [0., 0.], [0., 6.], [4., 6.]], &[[0., 3.], [3., 3.]]],
+        'I' => &[&[[2., 0.], [2., 6.]], &[[1., 0.], [3., 0.]], &[[1., 6.], [3., 6.]]],
+        'K' => &[&[[0., 0.], [0., 6.]], &[[4., 0.], [0., 3.6]], &[[1.4, 2.6], [4., 6.]]],
+        'L' => &[&[[0., 0.], [0., 6.], [4., 6.]]],
+        'N' => &[&[[0., 6.], [0., 0.], [4., 6.], [4., 0.]]],
+        'O' => &[&[[1., 0.], [3., 0.], [4., 1.], [4., 5.], [3., 6.], [1., 6.], [0., 5.], [0., 1.], [1., 0.]]],
+        'R' => &[&[[0., 6.], [0., 0.], [3., 0.], [4., 1.], [4., 2.], [3., 3.], [0., 3.]], &[[2., 3.], [4., 6.]]],
+        'S' => &[&[[4., 1.], [3., 0.], [1., 0.], [0., 1.], [0., 2.], [1., 3.], [3., 3.], [4., 4.], [4., 5.], [3., 6.], [1., 6.], [0., 5.]]],
+        'T' => &[&[[0., 0.], [4., 0.]], &[[2., 0.], [2., 6.]]],
+        'W' => &[&[[0., 0.], [1., 6.], [2., 3.], [3., 6.], [4., 0.]]],
+        'X' => &[&[[0., 0.], [4., 6.]], &[[4., 0.], [0., 6.]]],
+        'Y' => &[&[[0., 0.], [2., 3.], [4., 0.]], &[[2., 3.], [2., 6.]]],
+        '^' => &[&[[0., 4.5], [2., 1.5], [4., 4.5]]],
+        'v' => &[&[[0., 1.5], [2., 4.5], [4., 1.5]]],
+        '<' => &[&[[3.5, 0.5], [0.5, 3.], [3.5, 5.5]]],
+        '>' => &[&[[0.5, 0.5], [3.5, 3.], [0.5, 5.5]]],
+        _ => &[],
+    }
+}
+
+/// `text` in the stroke font, `h` high, centred on `c`, strokes `w` wide.
+fn text_sdf(p: P, text: &str, c: P, h: f32, w: f32) -> f32 {
+    let unit = h / 6.;
+    let advance = unit * 5.4;
+    let n = text.chars().count() as f32;
+    let left = c[0] - (advance * n - unit * 1.4) * 0.5;
+    let top = c[1] - h * 0.5;
+    let mut d = f32::INFINITY;
+    for (k, ch) in text.chars().enumerate() {
+        let ox = left + advance * k as f32;
+        for line in strokes(ch) {
+            for pair in line.windows(2) {
+                let a = [ox + pair[0][0] * unit, top + pair[0][1] * unit];
+                let b = [ox + pair[1][0] * unit, top + pair[1][1] * unit];
+                d = d.min(seg(p, a, b, w));
+            }
+        }
+    }
+    d
+}
+
+/// Mirrors a point of the skeleton's right side (screen left) to its left.
+fn mirror(p: P) -> P {
+    [128. - p[0], p[1]]
+}
+
+/// The bones of skeleton region `i`, as distance fields over a 128x256
+/// canvas (the skater faces out: their right is the screen's left).
+fn region_shapes(i: usize, p: P) -> f32 {
+    // The right-side shapes; left ones are mirrored by the caller.
+    let side = |q: P, right: bool| if right { q } else { mirror(q) };
+    match REGIONS[i].0 {
+        "Skull" => {
+            let head = ellipse(p, [64., 24.], [13., 16.]);
+            let jaw = rbox(p, [64., 40.], [8., 4.5], 3.);
+            head.min(jaw)
+        }
+        "Neck" => (0..3).map(|k| rbox(p, [64., 47. + k as f32 * 4.], [3.2, 1.6], 1.)).fold(f32::INFINITY, f32::min),
+        "Ribs" => {
+            let mut d = seg(p, [64., 63.], [64., 98.], 3.4);
+            for k in 0..6 {
+                let y = 66. + k as f32 * 6.5;
+                let inset = (k as f32 - 2.5).abs() * 1.5;
+                for right in [true, false] {
+                    let a = side([61., y], right);
+                    let b = side([44. + inset, y + 3.], right);
+                    let c = side([48. + inset, y + 9.], right);
+                    d = d.min(seg(p, a, b, 2.6)).min(seg(p, b, c, 2.4));
+                }
+            }
+            d
+        }
+        "Spine" => (0..6).map(|k| rbox(p, [64., 102. + k as f32 * 5.], [4., 1.9], 1.)).fold(f32::INFINITY, f32::min),
+        "Pelvis" => {
+            let left = ellipse(p, [51., 139.], [13., 10.]);
+            let right = ellipse(p, [77., 139.], [13., 10.]);
+            let sacrum = poly(p, &[[58., 131.], [70., 131.], [64., 151.]]);
+            let holes = circle(p, [56., 147.], 3.4).min(circle(p, [72., 147.], 3.4));
+            left.min(right).min(sacrum).max(-holes)
+        }
+        name => {
+            let right = name.starts_with("Right");
+            let q = if right { p } else { mirror(p) };
+            match name.split_once(' ').map_or("", |(_, bone)| bone) {
+                "Collarbone" => seg(q, [61., 61.], [40., 58.], 3.6),
+                "Humerus" => circle(q, [40., 62.], 4.6).min(seg(q, [40., 63.], [34., 106.], 5.)).min(circle(q, [34., 106.], 3.6)),
+                "Forearm" => seg(q, [34., 111.], [27., 150.], 3.).min(seg(q, [37., 111.], [31., 151.], 2.6)),
+                "Wrist" => {
+                    let mut d = circle(q, [29., 157.], 4.2);
+                    for (k, tip) in [[21., 168.], [25., 172.], [30., 173.], [35., 170.]].into_iter().enumerate() {
+                        d = d.min(seg(q, [27. + k as f32 * 1.5, 160.], tip, 1.8));
+                    }
+                    d
+                }
+                "Femur" => circle(q, [54., 145.], 4.6)
+                    .min(seg(q, [54., 146.], [52., 196.], 5.6))
+                    .min(circle(q, [52., 197.], 4.2)),
+                "Tibia" => seg(q, [52., 203.], [51., 240.], 4.6).min(seg(q, [46.5, 205.], [47., 238.], 2.)),
+                "Ankle" => seg(q, [50., 244.], [41., 251.], 5.).min(circle(q, [50., 244.], 3.4)),
+                _ => f32::INFINITY,
+            }
+        }
+    }
+}
+
+fn paint(sprite: Sprite, c: &mut Canvas) {
+    let (w, h) = (c.w as f32, c.h as f32);
+    let mid = [w * 0.5, h * 0.5];
+    match sprite {
+        Sprite::Dot => c.fill(1., 1., |p| circle(p, mid, 29.)),
+        Sprite::Ring => {
+            c.fill(0.35, 0.85, |p| circle(p, mid, 27.));
+            c.fill(1., 1., |p| (circle(p, mid, 26.)).abs() - 3.5);
+        }
+        Sprite::Bumper => c.fill(1., 1., |p| rbox(p, mid, [30., 13.], 12.)),
+        Sprite::Trigger => c.fill(1., 1., |p| poly(p, &[[10., 6.], [38., 6.], [42., 42.], [6., 42.]]) - 2.),
+        Sprite::Dpad => c.fill(1., 1., |p| rbox(p, mid, [7., 21.], 2.5).min(rbox(p, mid, [21., 7.], 2.5))),
+        Sprite::Key => {
+            c.fill(0.72, 1., |p| rbox(p, mid, [30., 22.], 7.));
+            c.fill(1., 1., |p| rbox(p, [32., 21.], [25., 16.], 5.));
+        }
+        Sprite::Diamond => c.fill(1., 1., |p| poly(p, &[[16., 2.], [30., 16.], [16., 30.], [2., 16.]])),
+        Sprite::Playhead => c.fill(1., 1., |p| poly(p, &[[3., 4.], [29., 4.], [16., 28.]])),
+        Sprite::Play => c.fill(1., 1., |p| poly(p, &[[14., 8.], [56., 32.], [14., 56.]]) - 1.),
+        Sprite::Pause => c.fill(1., 1., |p| rbox(p, [22., 32.], [7., 23.], 2.).min(rbox(p, [42., 32.], [7., 23.], 2.))),
+        Sprite::Corner(i) => {
+            let flip = |p: P| {
+                let x = if i & 1 == 1 { w - p[0] } else { p[0] };
+                let y = if i & 2 == 2 { h - p[1] } else { p[1] };
+                [x, y]
+            };
+            c.fill(1., 1., |p| {
+                let q = flip(p);
+                rbox(q, [26., 6.], [22., 3.], 1.5).min(rbox(q, [6., 26.], [3., 22.], 1.5))
+            });
+        }
+        Sprite::Camera => {
+            c.fill(1., 1., |p| rbox(p, [28., 36.], [22., 15.], 4.).min(poly(p, &[[44., 30.], [60., 21.], [60., 51.], [44., 42.]])));
+            c.erase(|p| circle(p, [26., 36.], 8.));
+            c.fill(1., 1., |p| circle(p, [26., 36.], 5.));
+            c.fill(1., 1., |p| circle(p, [18., 15.], 7.).min(circle(p, [34., 15.], 7.)));
+        }
+        Sprite::Vignette => c.shade(|u, v, _| {
+            let x = (u - 0.5) * 2.;
+            let y = (v - 0.5) * 2.;
+            let r = (x * x * 0.8 + y * y).sqrt();
+            [0., 0., 0., smoothstep(0.55, 1.35, r) * 0.9]
+        }),
+        Sprite::Fisheye => c.shade(|u, v, _| {
+            // A fisheye's barrel: a rounded image, dark corners, a soft rim.
+            let x = ((u - 0.5) * 2.).abs();
+            let y = ((v - 0.5) * 2.).abs();
+            let r = (x.powf(2.4) * 0.92 + y.powf(2.4)).powf(1. / 2.4);
+            let edge = smoothstep(0.9, 1.04, r);
+            let rim = smoothstep(0.62, 0.95, r) * 0.45;
+            [0., 0., 0., (edge + rim * (1. - edge)).min(1.)]
+        }),
+        Sprite::Flash => c.shade(|u, v, _| {
+            let x = (u - 0.5) * 2.;
+            let y = (v - 0.5) * 2.;
+            let r = (x * x + y * y).sqrt();
+            [1., 1., 1., smoothstep(0.3, 1.25, r)]
+        }),
+        Sprite::Glow => c.shade(|u, v, _| {
+            let x = (u - 0.5) * 2.;
+            let y = (v - 0.5) * 2.;
+            let r = (x * x + y * y).sqrt();
+            [1., 1., 1., (1. - smoothstep(0., 1., r)).powi(2)]
+        }),
+        Sprite::Fade => c.shade(|_, v, _| [1., 1., 1., v]),
+        Sprite::Grain(seed) => c.shade(|_, _, i| {
+            let n = hash(i.wrapping_add(u32::from(seed) * 7_919_993));
+            let value = if hash(i ^ 0xABCD_1234 ^ u32::from(seed)) > 0.5 { 1. } else { 0. };
+            [value, value, value, n * n * 0.5]
+        }),
+        Sprite::Splat => {
+            c.fill(1., 1., |p| circle(p, mid, 30.));
+            for k in 0..14u32 {
+                let a = hash(k * 31 + 7) * std::f32::consts::TAU;
+                let d = 26. + hash(k * 17 + 3) * 28.;
+                let r = 5. + hash(k * 13 + 11) * 9.;
+                let at = [mid[0] + a.cos() * d, mid[1] + a.sin() * d];
+                let neck = [mid[0] + a.cos() * d * 0.5, mid[1] + a.sin() * d * 0.5];
+                c.fill(1., 1., move |p| circle(p, at, r).min(seg(p, neck, at, r * 0.9)));
+            }
+            for k in 0..10u32 {
+                let a = hash(k * 41 + 5) * std::f32::consts::TAU;
+                let d = 50. + hash(k * 23 + 9) * 10.;
+                let at = [mid[0] + a.cos() * d, mid[1] + a.sin() * d];
+                c.fill(1., 1., move |p| circle(p, at, 2. + hash(k) * 2.5));
+            }
+        }
+        Sprite::Body => {
+            let body = |p: P| {
+                let mut d = ellipse(p, [64., 24.], [17., 20.]);
+                d = d.min(rbox(p, [64., 96.], [23., 42.], 12.));
+                d = d.min(rbox(p, [64., 140.], [21., 13.], 8.));
+                d = d.min(seg(p, [64., 40.], [64., 60.], 12.));
+                for right in [true, false] {
+                    let q = if right { p } else { mirror(p) };
+                    d = d.min(seg(q, [42., 62.], [33., 108.], 13.));
+                    d = d.min(seg(q, [33., 108.], [27., 154.], 11.));
+                    d = d.min(circle(q, [28., 162.], 8.));
+                    d = d.min(seg(q, [54., 146.], [52., 198.], 17.));
+                    d = d.min(seg(q, [52., 198.], [50., 242.], 13.));
+                    d = d.min(seg(q, [50., 244.], [40., 251.], 9.));
+                }
+                d
+            };
+            c.fill(1., 0.28, body);
+            c.fill(1., 0.6, move |p| body(p).abs() - 0.9);
+        }
+        Sprite::Bone(i) => {
+            let i = usize::from(i).min(REGIONS.len() - 1);
+            c.fill(1., 1., |p| region_shapes(i, p));
+            // Darker cores read as bone, not flat shapes.
+            c.fill(0.72, 0.5, |p| region_shapes(i, p) + 1.6);
+            if REGIONS[i].0 == "Skull" {
+                c.erase(|p| ellipse(p, [58.5, 24.], [3.6, 4.2]).min(ellipse(p, [69.5, 24.], [3.6, 4.2])));
+                c.erase(|p| poly(p, &[[64., 28.], [61.5, 33.], [66.5, 33.]]));
+                for k in 0..5 {
+                    c.erase(move |p| rbox(p, [58. + k as f32 * 3., 40.5], [0.5, 2.5], 0.3));
+                }
+            }
+        }
+        Sprite::Glyph(i) => {
+            let letters = GLYPHS.get(usize::from(i)).copied().unwrap_or("?");
+            let grey = [0.82, 0.84, 0.88];
+            let dark = [0.08, 0.08, 0.1];
+            let (shape, ink): (Box<dyn Fn(P) -> f32>, [f32; 3]) = match letters {
+                "A" | "B" | "X" | "Y" => {
+                    let colour = match letters {
+                        "A" => [0.36, 0.72, 0.18],
+                        "B" => [0.86, 0.17, 0.13],
+                        "X" => [0.13, 0.42, 0.9],
+                        _ => [0.95, 0.74, 0.08],
+                    };
+                    c.fill_rgb(colour, |p| circle(p, mid, 29.));
+                    c.fill_rgb([1., 1., 1.], |p| circle(p, mid, 29.).abs() - 1.2);
+                    (Box::new(|p| text_sdf(p, letters, [32., 33.], 26., 5.)), [1., 1., 1.])
+                }
+                "LB" | "RB" | "BACK" | "START" => {
+                    let half = [w * 0.5 - 3., h * 0.5 - 12.];
+                    c.fill_rgb(grey, move |p| rbox(p, mid, half, half[1]));
+                    let size = if letters.len() > 2 { 18. } else { 22. };
+                    (Box::new(move |p| text_sdf(p, letters, mid, size, 4.)), dark)
+                }
+                "LT" | "RT" => {
+                    c.fill_rgb(grey, |p| poly(p, &[[22., 6.], [74., 6.], [86., 58.], [10., 58.]]) - 2.);
+                    (Box::new(move |p| text_sdf(p, letters, [48., 34.], 24., 4.5)), dark)
+                }
+                "LS" | "RS" => {
+                    c.fill_rgb([0.25, 0.25, 0.28], |p| circle(p, mid, 28.));
+                    c.fill_rgb(grey, |p| circle(p, mid, 27.).abs() - 3.);
+                    (Box::new(move |p| text_sdf(p, letters, mid, 22., 4.)), [1., 1., 1.])
+                }
+                arrow => {
+                    c.fill_rgb(grey, |p| rbox(p, mid, [9., 28.], 3.).min(rbox(p, mid, [28., 9.], 3.)));
+                    (Box::new(move |p| text_sdf(p, arrow, mid, 16., 4.)), dark)
+                }
+            };
+            c.fill_rgb(ink, shape);
+        }
+        Sprite::Tile(i) => {
+            let lit = i >= 5;
+            let letter = ['S', 'K', 'A', 'T', 'E'][usize::from(i % 5)].to_string();
+            let (back, edge, ink) = if lit {
+                ([0.85, 0.1, 0.08], [1., 1., 1.], [1., 1., 1.])
+            } else {
+                ([0.13, 0.13, 0.16], [0.45, 0.45, 0.5], [0.5, 0.5, 0.55])
+            };
+            c.fill_rgb(back, |p| rbox(p, mid, [28., 28.], 9.));
+            c.fill_rgb(edge, |p| rbox(p, mid, [28., 28.], 9.).abs() - 2.2);
+            c.fill_rgb(ink, move |p| text_sdf(p, &letter, [32., 33.], 32., 6.));
+        }
+        Sprite::TileBack => c.fill(1., 1., |p| rbox(p, mid, [28., 28.], 9.)),
+        Sprite::TileEdge => c.fill(1., 1., |p| rbox(p, mid, [28., 28.], 9.).abs() - 2.2),
+        Sprite::MedalOwn => {
+            c.fill(0.75, 1., |p| poly(p, &[[44., 70.], [60., 76.], [50., 124.], [40., 112.], [30., 118.]]));
+            c.fill(0.75, 1., |p| poly(p, &[[84., 70.], [68., 76.], [78., 124.], [88., 112.], [98., 118.]]));
+            c.fill(1., 1., |p| circle(p, [64., 58.], 48.));
+            c.fill(0.7, 1., |p| circle(p, [64., 58.], 41.).abs() - 2.2);
+            c.fill(0.25, 1., |p| text_sdf(p, "OWN", [64., 58.], 22., 5.));
+        }
+        Sprite::MedalKill => {
+            c.fill(0.8, 1., |p| star(p, mid, 16, 62., 50., 0.));
+            c.fill(1., 1., |p| circle(p, mid, 44.));
+            c.fill(0.7, 1., |p| circle(p, mid, 38.).abs() - 2.4);
+            c.fill(0.25, 1., |p| text_sdf(p, "KILL", mid, 20., 4.6));
+        }
+        Sprite::Star => c.fill(1., 1., |p| star(p, mid, 5, 30., 12.5, 0.)),
+        Sprite::Pin => {
+            c.fill(1., 1., |p| circle(p, [32., 24.], 17.).min(poly(p, &[[18., 32.], [46., 32.], [32., 61.]])));
+            c.erase(|p| circle(p, [32., 24.], 7.));
+        }
+        Sprite::Arrow => c.fill(1., 1., |p| poly(p, &[[32., 4.], [60., 40.], [42., 40.], [42., 60.], [22., 60.], [22., 40.], [4., 40.]])),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_sprite_paints_something_and_encodes() {
+        let all = Sprite::all();
+        let mut names: Vec<String> = all.iter().map(|s| s.name()).collect();
+        names.sort();
+        names.dedup();
+        assert_eq!(names.len(), all.len(), "names are unique");
+        assert!(names.contains(&"medal_kill".to_owned()) && names.contains(&"bone_18".to_owned()));
+        for sprite in all {
+            let image = sprite.paint();
+            assert_eq!(image.rgba.len(), (image.width * image.height * 4) as usize);
+            let opaque = image.rgba.chunks(4).filter(|p| p[3] > 128).count();
+            if !matches!(sprite, Sprite::Grain(_) | Sprite::Glow | Sprite::Vignette | Sprite::Fade | Sprite::Fisheye) {
+                assert!(opaque > 20, "{sprite:?} paints too little");
+            }
+            assert!(image.png().unwrap().starts_with(&[0x89, b'P', b'N', b'G']));
+        }
+    }
+
+    #[test]
+    fn bones_stay_on_their_side() {
+        // The skater's right humerus is on the screen's left half.
+        let image = Sprite::Bone(7).paint();
+        let (mut left, mut right) = (0, 0);
+        for (i, p) in image.rgba.chunks(4).enumerate() {
+            if p[3] > 128 {
+                if (i as u32 % image.width) < 64 { left += 1 } else { right += 1 }
+            }
+        }
+        assert!(left > 50 && right == 0, "{left} {right}");
+        // The fisheye's middle is clear, its corners dark.
+        let fisheye = Sprite::Fisheye.paint();
+        let at = |x: u32, y: u32| fisheye.rgba[((y * 512 + x) * 4 + 3) as usize];
+        assert!(at(256, 256) < 10 && at(2, 2) > 240);
+    }
+}
diff --git a/crates/skate_modes/src/wire.rs b/crates/skate_modes/src/wire.rs
new file mode 100644
index 0000000..2fe14d9
--- /dev/null
+++ b/crates/skate_modes/src/wire.rs
@@ -0,0 +1,113 @@
+//! What a skater tells the others about the modes, as one short line of
+//! text that rides with their skating (the mashup's skate report, GTA's
+//! co-op packet): the S.K.A.T.E. game they run, their attempt in someone
+//! else's, a yes to an invitation, and their Hall of Meat best.
+
+use crate::skate_game::{Game, clean};
+
+/// Longest line sent.
+pub const MAX: usize = 240;
+
+/// One skater's line, read.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Signal {
+    /// The game this skater runs.
+    pub game: Option<Game>,
+    /// Their latest attempt in another's game: game id, the turn (game
+    /// `seq`) it answers, and how it went (tricks, or none for a bail).
+    pub attempt: Option<(u32, u32, Option<Vec<String>>)>,
+    /// They joined game `id`.
+    pub joined: Option<u32>,
+    pub meat_best: Option<f32>,
+}
+
+impl Signal {
+    pub fn encode(&self) -> String {
+        let mut parts = Vec::new();
+        if let Some(game) = &self.game {
+            parts.push(format!("G={}", game.encode()));
+        }
+        if let Some((id, seq, result)) = &self.attempt {
+            let what = match result {
+                None => "bail".to_owned(),
+                Some(tricks) => {
+                    let list: Vec<String> = tricks.iter().rev().take(4).rev().map(|t| clean(t, 40)).collect();
+                    format!("land/{}", list.join("/"))
+                }
+            };
+            parts.push(format!("A={id},{seq},{what}"));
+        }
+        if let Some(id) = self.joined {
+            parts.push(format!("J={id}"));
+        }
+        if let Some(best) = self.meat_best {
+            parts.push(format!("M={}", best.round() as i64));
+        }
+        let mut out = parts.join(";");
+        if out.len() > MAX {
+            // The game matters most; attempts next.
+            out = parts.into_iter().take(2).collect::<Vec<_>>().join(";");
+            out.truncate(MAX);
+        }
+        out
+    }
+
+    pub fn decode(text: &str) -> Self {
+        let mut out = Self::default();
+        for part in text.split(';') {
+            let Some((key, value)) = part.split_once('=') else { continue };
+            match key {
+                "G" => out.game = Game::decode(value),
+                "A" => {
+                    let f: Vec<&str> = value.splitn(3, ',').collect();
+                    if f.len() == 3
+                        && let (Ok(id), Ok(seq)) = (f[0].parse(), f[1].parse())
+                    {
+                        let result = if f[2] == "bail" {
+                            Some(None)
+                        } else {
+                            f[2].strip_prefix("land").map(|rest| Some(rest.split('/').filter(|t| !t.is_empty()).map(str::to_owned).collect()))
+                        };
+                        if let Some(result) = result {
+                            out.attempt = Some((id, seq, result));
+                        }
+                    }
+                }
+                "J" => out.joined = value.parse().ok(),
+                "M" => out.meat_best = value.parse::<f32>().ok().filter(|v| v.is_finite()),
+                _ => {}
+            }
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::skate_game::{Game, Player};
+
+    #[test]
+    fn signals_round_trip() {
+        let players = vec![
+            Player { id: 3, name: "the maintainer".into(), letters: 2, cpu: None, joined: true },
+            Player { id: 9, name: "Sam, the 2nd".into(), letters: 0, cpu: None, joined: true },
+        ];
+        let game = Game::new(5, players, false);
+        let s = Signal {
+            game: Some(game),
+            attempt: Some((8, 12, Some(vec!["Ollie".into(), "Varial Kickflip".into()]))),
+            joined: Some(8),
+            meat_best: Some(12345.4),
+        };
+        let back = Signal::decode(&s.encode());
+        assert_eq!(back.game.as_ref().unwrap().players[1].name, "Sam  the 2nd");
+        assert_eq!(back.attempt, s.attempt);
+        assert_eq!(back.joined, Some(8));
+        assert_eq!(back.meat_best, Some(12345.));
+        let bail = Signal { attempt: Some((1, 2, None)), ..Default::default() };
+        assert_eq!(Signal::decode(&bail.encode()).attempt, Some((1, 2, None)));
+        assert_eq!(Signal::decode("junk;X=1;A=1"), Signal::default());
+        assert!(s.encode().len() <= MAX);
+    }
+}
