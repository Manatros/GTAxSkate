+        let names = vec!["ROOT".to_owned(), "HIPS".to_owned(), "HEAD".to_owned()];
+        let bones = vec![
+            Mat4::IDENTITY,
+            Mat4::from_translation(at + Vec3::Y * 0.95),
+            Mat4::from_translation(at + Vec3::Y * 1.7),
+        ];
+        (names, bones)
+    }
+
+    #[test]
+    fn a_body_about_the_animation_origin_goes_to_the_skater() {
+        let root = Mat4::from_rotation_translation(Quat::from_rotation_y(1.), Vec3::new(40., 2., -12.));
+        let (names, mut bones) = body(Vec3::ZERO);
+        settle(&root, &names, &mut bones);
+        assert!(bones[1].w_axis.truncate().distance(Vec3::new(40., 2.95, -12.)) < 1e-3);
+    }
+
+    #[test]
+    fn a_body_in_the_world_stays_and_a_drifting_one_comes_back() {
+        let root = Mat4::from_translation(Vec3::new(40., 2., -12.));
+        let (names, mut bones) = body(Vec3::new(40.2, 2., -12.));
+        settle(&root, &names, &mut bones);
+        assert!((bones[1].w_axis.x - 40.2).abs() < 1e-4, "near enough is left alone");
+        let (names, mut bones) = body(Vec3::new(55., 2., -12.));
+        settle(&root, &names, &mut bones);
+        let hips = bones[1].w_axis.truncate();
+        assert!((hips.x - 40.).abs() < 1e-3 && (hips.y - 2.95).abs() < 1e-3);
+        assert!((bones[2].w_axis.y - 3.7).abs() < 1e-3, "the rest of the body comes along");
+    }
+}
