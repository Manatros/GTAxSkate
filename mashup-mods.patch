+/// The loading screen's picture for the Minecraft map, in the style of
+/// Minecraft's own: its dirt block, tiled large and darkened. Drawn from the
+/// fetched files; a dark dirt-like pattern until they are in. Returns width,
+/// height and RGBA pixels.
+pub fn loading_background() -> (u32, u32, Vec<u8>) {
+    const WIDTH: u32 = 1280;
+    const HEIGHT: u32 = 720;
+    const TILE: u32 = 64;
+    let dirt = root().and_then(|root| dirt_texture(&root)).unwrap_or_else(fallback_dirt);
+    let (size, texels) = dirt;
+    let mut pixels = Vec::with_capacity((WIDTH * HEIGHT * 4) as usize);
+    for y in 0..HEIGHT {
+        let ty = ((y % TILE) * size / TILE) as usize;
+        for x in 0..WIDTH {
+            let tx = ((x % TILE) * size / TILE) as usize;
+            let p = &texels[(ty * size as usize + tx) * 4..][..4];
+            // Minecraft darkens its dirt background to about a quarter.
+            pixels.extend_from_slice(&[p[0] / 4, p[1] / 4, p[2] / 4, 255]);
+        }
+    }
+    (WIDTH, HEIGHT, pixels)
+}
+
+/// The dirt block texture (square, RGBA) from Minecraft's files.
+fn dirt_texture(root: &std::path::Path) -> Option<(u32, Vec<u8>)> {
+    let packs = std::fs::read_dir(root.join("resourcepacks")).ok()?;
+    let path = packs
+        .flatten()
+        .flat_map(|kind| std::fs::read_dir(kind.path()).into_iter().flatten().flatten())
+        .map(|pack| pack.path().join("assets/minecraft/textures/block/dirt.png"))
+        .find(|path| path.is_file())?;
+    let bytes = std::fs::read(path).ok()?;
+    let mut decoder = png::Decoder::new(std::io::Cursor::new(bytes));
+    decoder.set_transformations(png::Transformations::normalize_to_color8());
+    let mut reader = decoder.read_info().ok()?;
+    let mut buffer = vec![0; reader.output_buffer_size()?];
+    let frame = reader.next_frame(&mut buffer).ok()?;
+    let channels = frame.color_type.samples();
+    let size = frame.width;
+    if size == 0 || frame.height < size {
+        return None;
+    }
+    // An animated texture stacks frames; the first square is enough.
+    let rgba: Vec<u8> = buffer[..(size * size) as usize * channels]
+        .chunks_exact(channels)
+        .flat_map(|p| match channels {
+            1 | 2 => [p[0], p[0], p[0], 255],
+            _ => [p[0], p[1], p[2], 255],
+        })
+        .collect();
+    Some((size, rgba))
+}
+
+/// A 16 by 16 dirt-like pattern: browns varied per texel, the same every time.
+fn fallback_dirt() -> (u32, Vec<u8>) {
+    const SHADES: [[u8; 3]; 4] = [[134, 96, 67], [121, 85, 58], [150, 108, 74], [96, 67, 45]];
+    let mut seed = 0x2545_F491u32;
+    let rgba = (0..256)
+        .flat_map(|_| {
+            seed ^= seed << 13;
+            seed ^= seed >> 17;
+            seed ^= seed << 5;
+            let [r, g, b] = SHADES[(seed % 4) as usize];
+            [r, g, b, 255]
+        })
+        .collect();
+    (16, rgba)
+}
+
