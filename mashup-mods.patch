+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn score(tricks: u32, landings: u32) -> frame::SkateScore {
+        frame::SkateScore {
+            trick: "Kickflip".into(),
+            tricks,
+            sequence: 1250.,
+            multiplier: 2.,
+            line: 3400.,
+            completed: 10000.,
+            last_reward: 900.,
+            landings,
+            clean: true,
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn tricks_and_landings_show_then_fade() {
+        let mut state = State::default();
+        let first = state.lines(&score(4, 2), 0.);
+        assert!(first.iter().all(|l| !l.text.contains("Kickflip")), "an old trick is not news");
+        assert!(first.iter().any(|l| l.text == "SESSION 13,400"));
+        let lines = state.lines(&score(5, 2), 1.);
+        assert_eq!(lines[0].text, "Kickflip");
+        assert_eq!(lines[1].text, "1,250  x2.0");
+        let lines = state.lines(&score(5, 3), 2.);
+        assert!(lines.iter().any(|l| l.text == "+900  Clean!"));
+        let faded = state.lines(&score(5, 3), 3.2);
+        let name = faded.iter().find(|l| l.text == "Kickflip").unwrap();
+        assert!(name.color[3] < 1. && name.color[3] > 0.);
+        assert!(state.lines(&score(5, 3), 10.).iter().all(|l| l.size == Size::Small && l.right));
+        let _ = Size::Tiny;
+        let mut nollie = score(6, 3);
+        nollie.trick = "Nollie Kickflip".into();
+        nollie.nollie = true;
+        assert_eq!(state.lines(&nollie, 10.2)[0].text, "Nollie Kickflip");
+        let mut bail = score(6, 4);
+        bail.bailed = true;
+        assert!(state.lines(&bail, 10.5).iter().any(|l| l.text == "BAIL"));
+        assert_eq!(points(1234567.4), "1,234,567");
+    }
+
+    #[test]
+    fn the_dropper_shows_its_object_and_controls() {
+        let mut state = State::default();
+        let keys = skate_input::Controls::default();
+        let mut dropper = frame::SkateDropper {
+            open: false,
+            object: "Kicker".into(),
+            previous: "Crate".into(),
+            next: "Launch ramp".into(),
+            placed: 2,
+            max: 24,
+            pad: true,
+        };
+        assert!(state.dropper_lines(&dropper, 0, &keys, 0.).is_empty());
+        dropper.open = true;
+        let lines = state.dropper_lines(&dropper, 0, &keys, 0.1);
+        assert_eq!(lines[1].text, "<  Crate      KICKER      Launch ramp  >");
+        assert_eq!(lines[2].text, "2 of 24 placed");
+        assert!(lines[3].text.starts_with("[W A S D / Left stick] Move"), "{}", lines[3].text);
+        dropper.pad = false;
+        let lines = state.dropper_lines(&dropper, 0, &keys, 0.15);
+        assert!(lines[3].text.starts_with("[W A S D] Move"), "{}", lines[3].text);
+        dropper.open = false;
+        assert_eq!(state.dropper_lines(&dropper, 1, &keys, 0.2)[0].text, "Back to the checkpoint");
+        assert!(state.controls_lines(&keys, false, false, 0.).iter().any(|l| l.text == "[Space] Push"));
+        assert!(state.controls_lines(&keys, false, false, 20.).is_empty(), "they go after a while");
+        assert!(!state.controls_lines(&keys, false, true, 21.).is_empty(), "and come back off the board");
+    }
+
+    #[test]
+    fn the_session_marker_prompts_and_flashes() {
+        let mut state = State::default();
+        let keys = skate_input::Controls::default();
+        let mut marker = frame::SkateMarker::default();
+        assert!(state.marker_lines(&marker, &keys, true, 0.).is_empty());
+        marker.prompt = true;
+        marker.can_place = true;
+        assert_eq!(state.marker_lines(&marker, &keys, true, 0.1)[0].text, "[N / LB + Down] Set marker");
+        assert_eq!(state.marker_lines(&marker, &keys, false, 0.1)[0].text, "[N] Set marker");
+        marker.placements = 1;
+        marker.placed = true;
+        let lines = state.marker_lines(&marker, &keys, true, 0.2);
+        assert!(lines[0].text.ends_with("[M / Hold LB + Up] Back to it"));
+        assert!(lines.iter().any(|l| l.text == "Marker set"));
+        marker.prompt = false;
+        marker.progress = 0.5;
+        assert_eq!(state.marker_lines(&marker, &keys, true, 2.)[0].text, "Back to the marker 50%");
+    }
+}
