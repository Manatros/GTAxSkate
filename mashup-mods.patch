+#[derive(Default)]
+struct ClassBoards {
+    /// The boards of the player's classes, as the class editor last set them.
+    wanted: Vec<skate_boards::BoardChoice>,
+    /// The board of the class the player plays.
+    active: skate_boards::BoardChoice,
+    /// The boards whose materials this map installed.
+    installed: Vec<(skate_boards::BoardChoice, Arc<BotModel>)>,
+}
+
+fn class_boards() -> &'static std::sync::Mutex<ClassBoards> {
+    static BOARDS: OnceLock<std::sync::Mutex<ClassBoards>> = OnceLock::new();
+    BOARDS.get_or_init(Default::default)
+}
+
+/// The boards of every class, so each map installs their materials.
+pub fn set_class_boards(boards: Vec<skate_boards::BoardChoice>) {
+    if let Ok(mut state) = class_boards().lock() {
+        state.wanted = boards;
+    }
+}
+
+/// The board of the class the player spawned with.
+pub fn set_active_board(board: skate_boards::BoardChoice) {
+    if let Ok(mut state) = class_boards().lock() {
+        state.active = board;
+    }
+}
+
+/// Whether `board` can show on this map: the default board always can, a
+/// custom one once a map load has installed its materials.
+pub fn board_installed(board: &skate_boards::BoardChoice) -> bool {
+    board.is_default()
+        || class_boards()
+            .lock()
+            .is_ok_and(|state| state.installed.iter().any(|(choice, _)| choice == board))
+}
+
+/// Builds the meshes of every class's board for the map being loaded.
+fn prepare_class_boards() {
+    let Ok(mut state) = class_boards().lock() else {
+        return;
+    };
+    let mut wanted = state.wanted.clone();
+    wanted.push(state.active.clone());
+    wanted.retain(|choice| !choice.is_default());
+    wanted.sort_by_key(skate_boards::BoardChoice::to_text);
+    wanted.dedup();
+    let mut installed = Vec::new();
+    if let Some(sources) = board_sources().filter(|_| !wanted.is_empty()) {
+        for choice in wanted {
+            let built = skate_boards::assemble(
+                sources.library.as_ref(),
+                &sources.defaults,
+                &choice,
+                BOARD_TEXTURE_LIMIT,
+            )
+            .and_then(|board| BotModel::from_board(&board));
+            match built {
+                Ok(model) => installed.push((choice, Arc::new(model))),
+                Err(e) => diag::warn!(World, "skate boards: {}: {e}", choice.to_text()),
+            }
+        }
+    }
+    if !installed.is_empty() {
+        diag::info!(World, "skate boards: {} class boards ready", installed.len());
+    }
+    state.installed = installed;
+}
+
+/// The class boards installed for this map.
+pub fn class_board_models() -> Vec<Arc<BotModel>> {
+    class_boards()
+        .lock()
+        .map(|state| state.installed.iter().map(|(_, model)| model.clone()).collect())
+        .unwrap_or_default()
+}
+
+/// The board the player's class rides, when it is not the default board
