diff --git a/crates/skate_modes/src/math.rs b/crates/skate_modes/src/math.rs
new file mode 100644
index 0000000..997976d
--- /dev/null
+++ b/crates/skate_modes/src/math.rs
@@ -0,0 +1,223 @@
+//! The little vector maths the modes need, on plain arrays so the crate
+//! links into either game without a maths library. Matrices are column-major
+//! `[f32; 16]` (as `glam::Mat4::to_cols_array` gives them), quaternions
+//! `[x, y, z, w]`.
+
+pub type V3 = [f32; 3];
+pub type Quat = [f32; 4];
+pub type M4 = [f32; 16];
+
+pub fn add(a: V3, b: V3) -> V3 {
+    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
+}
+
+pub fn sub(a: V3, b: V3) -> V3 {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+pub fn scale(a: V3, s: f32) -> V3 {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+
+pub fn dot(a: V3, b: V3) -> f32 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+pub fn cross(a: V3, b: V3) -> V3 {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+pub fn length(a: V3) -> f32 {
+    dot(a, a).sqrt()
+}
+
+pub fn distance(a: V3, b: V3) -> f32 {
+    length(sub(a, b))
+}
+
+/// `a` made one long, or `fallback` when it has no length.
+pub fn normalize_or(a: V3, fallback: V3) -> V3 {
+    let l = length(a);
+    if l > 1e-6 && l.is_finite() { scale(a, 1. / l) } else { fallback }
+}
+
+pub fn lerp(a: V3, b: V3, t: f32) -> V3 {
+    add(a, scale(sub(b, a), t))
+}
+
+pub fn lerp_f(a: f32, b: f32, t: f32) -> f32 {
+    a + (b - a) * t
+}
+
+/// Eases 0..1 in and out.
+pub fn smooth(t: f32) -> f32 {
+    let t = t.clamp(0., 1.);
+    t * t * (3. - 2. * t)
+}
+
+/// An angle wrapped to -π..π.
+pub fn wrap_angle(a: f32) -> f32 {
+    let tau = std::f32::consts::TAU;
+    let mut a = a % tau;
+    if a > std::f32::consts::PI {
+        a -= tau;
+    } else if a < -std::f32::consts::PI {
+        a += tau;
+    }
+    a
+}
+
+/// `a` towards `b` by `t`, the short way round.
+pub fn lerp_angle(a: f32, b: f32, t: f32) -> f32 {
+    a + wrap_angle(b - a) * t
+}
+
+pub fn translation(m: &M4) -> V3 {
+    [m[12], m[13], m[14]]
+}
+
+pub fn column(m: &M4, i: usize) -> V3 {
+    [m[i * 4], m[i * 4 + 1], m[i * 4 + 2]]
+}
+
+/// A rotation's quaternion from its matrix's (unit) columns.
+pub fn quat_from_matrix(m: &M4) -> Quat {
+    let x = normalize_or(column(m, 0), [1., 0., 0.]);
+    let y = normalize_or(column(m, 1), [0., 1., 0.]);
+    let z = normalize_or(column(m, 2), [0., 0., 1.]);
+    let (m00, m01, m02) = (x[0], y[0], z[0]);
+    let (m10, m11, m12) = (x[1], y[1], z[1]);
+    let (m20, m21, m22) = (x[2], y[2], z[2]);
+    let trace = m00 + m11 + m22;
+    let q = if trace > 0. {
+        let s = (trace + 1.).sqrt() * 2.;
+        [(m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s]
+    } else if m00 > m11 && m00 > m22 {
+        let s = (1. + m00 - m11 - m22).sqrt() * 2.;
+        [0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s]
+    } else if m11 > m22 {
+        let s = (1. + m11 - m00 - m22).sqrt() * 2.;
+        [(m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s]
+    } else {
+        let s = (1. + m22 - m00 - m11).sqrt() * 2.;
+        [(m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s]
+    };
+    quat_normalize(q)
+}
+
+pub fn quat_normalize(q: Quat) -> Quat {
+    let l = (q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]).sqrt();
+    if l > 1e-9 && l.is_finite() { [q[0] / l, q[1] / l, q[2] / l, q[3] / l] } else { [0., 0., 0., 1.] }
+}
+
+/// The rotation from `a` to `b` by `t`, the short way.
+pub fn slerp(a: Quat, b: Quat, t: f32) -> Quat {
+    let mut b = b;
+    let mut d = a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
+    if d < 0. {
+        b = [-b[0], -b[1], -b[2], -b[3]];
+        d = -d;
+    }
+    if d > 0.9995 {
+        return quat_normalize([
+            lerp_f(a[0], b[0], t),
+            lerp_f(a[1], b[1], t),
+            lerp_f(a[2], b[2], t),
+            lerp_f(a[3], b[3], t),
+        ]);
+    }
+    let theta = d.clamp(-1., 1.).acos();
+    let s = theta.sin();
+    let wa = ((1. - t) * theta).sin() / s;
+    let wb = (t * theta).sin() / s;
+    quat_normalize([
+        a[0] * wa + b[0] * wb,
+        a[1] * wa + b[1] * wb,
+        a[2] * wa + b[2] * wb,
+        a[3] * wa + b[3] * wb,
+    ])
+}
+
+/// A rigid transform from a rotation and a position.
+pub fn matrix(q: Quat, p: V3) -> M4 {
+    let [x, y, z, w] = q;
+    let (x2, y2, z2) = (x + x, y + y, z + z);
+    let (xx, xy, xz) = (x * x2, x * y2, x * z2);
+    let (yy, yz, zz) = (y * y2, y * z2, z * z2);
+    let (wx, wy, wz) = (w * x2, w * y2, w * z2);
+    [
+        1. - (yy + zz),
+        xy + wz,
+        xz - wy,
+        0.,
+        xy - wz,
+        1. - (xx + zz),
+        yz + wx,
+        0.,
+        xz + wy,
+        yz - wx,
+        1. - (xx + yy),
+        0.,
+        p[0],
+        p[1],
+        p[2],
+        1.,
+    ]
+}
+
+/// Yaw (about Skate's up, +y) and pitch of a direction, in radians; yaw 0
+/// looks along +z.
+pub fn yaw_pitch(d: V3) -> (f32, f32) {
+    let d = normalize_or(d, [0., 0., 1.]);
+    (d[0].atan2(d[2]), d[1].clamp(-1., 1.).asin())
+}
+
+/// The direction of a yaw and pitch (see [`yaw_pitch`]).
+pub fn direction(yaw: f32, pitch: f32) -> V3 {
+    let (sy, cy) = yaw.sin_cos();
+    let (sp, cp) = pitch.sin_cos();
+    [sy * cp, sp, cy * cp]
+}
+
+/// Right, up and forward of a view looking along `forward`, Skate's up (+y)
+/// kept upright.
+pub fn look_basis(forward: V3) -> [V3; 3] {
+    let f = normalize_or(forward, [0., 0., 1.]);
+    let right = normalize_or(cross([0., 1., 0.], f), [1., 0., 0.]);
+    let up = cross(f, right);
+    [right, up, f]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn close(a: f32, b: f32) -> bool {
+        (a - b).abs() < 1e-4
+    }
+
+    #[test]
+    fn matrices_and_quaternions_round_trip() {
+        let q = quat_normalize([0.2, -0.5, 0.3, 0.8]);
+        let m = matrix(q, [1., 2., 3.]);
+        let back = quat_from_matrix(&m);
+        let same = (0..4).all(|i| close(back[i], q[i])) || (0..4).all(|i| close(back[i], -q[i]));
+        assert!(same, "{q:?} {back:?}");
+        assert_eq!(translation(&m), [1., 2., 3.]);
+        let half = slerp([0., 0., 0., 1.], [0., 1., 0., 0.], 0.5);
+        assert!(close(half[1], std::f32::consts::FRAC_1_SQRT_2));
+    }
+
+    #[test]
+    fn angles_and_directions() {
+        let (yaw, pitch) = yaw_pitch([1., 0., 0.]);
+        assert!(close(yaw, std::f32::consts::FRAC_PI_2) && close(pitch, 0.));
+        let d = direction(yaw, 0.3);
+        let (y2, p2) = yaw_pitch(d);
+        assert!(close(y2, yaw) && close(p2, 0.3));
+        assert!(close(wrap_angle(3. * std::f32::consts::PI), std::f32::consts::PI));
+        assert!(close(lerp_angle(3.0, -3.0, 0.5), std::f32::consts::PI) || close(lerp_angle(3.0, -3.0, 0.5), -std::f32::consts::PI));
+        let [r, u, f] = look_basis([0., 0., 2.]);
+        assert!(close(f[2], 1.) && close(u[1], 1.) && close(dot(r, f), 0.));
+    }
+}
