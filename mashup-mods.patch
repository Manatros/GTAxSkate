+#[cfg(test)]
+mod row_tests {
+    use super::*;
+    use crate::MenuRect;
+
+    fn at(x: f32, y: f32, w: f32) -> MenuItem {
+        MenuItem {
+            rect: MenuRect { x, y, w, h: 18.0, horz_align: 1, vert_align: 1 },
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn a_new_row_goes_below_and_pushes_the_column_down() {
+        let mut items = vec![
+            at(10.0, 100.0, 150.0), // perk 3
+            at(10.0, 120.0, 150.0), // deathstreak
+            at(10.0, 160.0, 150.0), // rename, further down the column
+            at(300.0, 140.0, 200.0), // the panel beside the column
+            at(0.0, 0.0, 640.0), // a backdrop above
+        ];
+        let mut row = at(10.0, 120.0, 150.0);
+        let (previous, last) = (items[0].rect, items[1].rect);
+        insert_row(&mut items, &mut row, &previous, &last).unwrap();
+        assert_eq!(row.rect.y, 140.0);
+        assert_eq!(items[2].rect.y, 180.0, "rename moved down a row");
+        assert_eq!(items[3].rect.y, 140.0, "the panel stays");
+        assert_eq!(items[1].rect.y, 120.0);
+        assert_eq!(items[4].rect.y, 0.0);
+        assert!(insert_row(&mut items, &mut row, &last, &previous).is_err());
+    }
+}
