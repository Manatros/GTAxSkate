+//! The Hall of Meat skeleton, every bone layered, at 3x.
+use skate_modes::meat::{REGIONS, Severity};
+use skate_modes::sprites::{Image, Sprite};
+
+fn main() {
+    let (w, h) = (128u32 * 3, 256u32 * 3);
+    let mut out = vec![30u8; (w * h * 4) as usize];
+    for p in out.chunks_mut(4) {
+        p[3] = 255;
+    }
+    let mut layers = vec![(Sprite::Body, [0.55, 0.75, 1.])];
+    let sev = [Severity::None, Severity::Bruised, Severity::Cracked, Severity::Fractured, Severity::Broken, Severity::Shattered];
+    for i in 0..REGIONS.len() {
+        let c = sev[i % sev.len()].color();
+        layers.push((Sprite::Bone(i as u8), [c[0], c[1], c[2]]));
+    }
+    for (sprite, tint) in layers {
+        let img = sprite.paint();
+        for y in 0..h {
+            for x in 0..w {
+                let s = &img.rgba[(((y / 3) * img.width + x / 3) * 4) as usize..][..4];
+                let a = f32::from(s[3]) / 255.;
+                let d = &mut out[((y * w + x) * 4) as usize..][..4];
+                for c in 0..3 {
+                    d[c] = (f32::from(s[c]) * tint[c] * a + f32::from(d[c]) * (1. - a)) as u8;
+                }
+            }
+        }
+    }
+    let path = std::env::args().nth(1).unwrap();
+    std::fs::write(&path, Image { width: w, height: h, rgba: out }.png().unwrap()).unwrap();
+}
