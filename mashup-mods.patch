diff --git a/crates/sim/src/board.rs b/crates/sim/src/board.rs
new file mode 100644
index 0000000..821ae7b
--- /dev/null
+++ b/crates/sim/src/board.rs
@@ -0,0 +1,369 @@
+//! Skaters in the sim. A skater's position comes from outside (the Skate
+//! engine moves them), so movement is skipped for them; these rules decide
+//! what still runs: their weapon (drive-bys, the board swung as a melee
+//! weapon, killstreaks) and the board as a weapon of its own, riding into
+//! enemies.
+//!
+//! The rules are per client and live beside the world, so a host applies
+//! them to whoever skates on it, whatever machine the skater is on.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+use crate::frame::FrameWorld;
+use crate::identities::{DamageSource, PelletId};
+use crate::match_state::ClientLifecycle;
+use crate::world::{ClientId, Tick};
+
+/// Most bones a skater's pose carries: Skate's body bones that drive the
+/// soldier, the board's, and the root.
+pub const SKATE_POSE_BONES: usize = 40;
+
+/// One bone of a skater's pose, in Skate space (metres, y up): which bone
+/// (see [`skate_name_hash`]; 0 is the root), where, and its rotation as a
+/// quaternion scaled to `i16`.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct SkateBone {
+    pub name: u32,
+    pub position: [f32; 3],
+    pub rotation: [i16; 4],
+}
+
+/// A skater's pose as everyone else sees it, what their board does (for
+/// its sounds) and which board it is.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SkatePose {
+    pub bones: Vec<SkateBone>,
+    pub cue: SkateCue,
+    /// The board's parts (`skate_boards::BoardChoice` text; empty for the
+    /// default board).
+    pub board: String,
+}
+
+/// What a skater's board does, for its sounds on others' machines: Skate's
+/// state (`skate_sound::state_code`), speed (tenths of a metre a second),
+/// vertical speed (quarters, up positive), ground surface and wheels down.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SkateCue {
+    pub state: u8,
+    pub speed: u8,
+    pub vertical: i8,
+    pub surface: u8,
+    pub wheels: u8,
+}
+
+/// Longest board text a skater sends.
+pub const SKATE_BOARD_TEXT: usize = 200;
+
+/// What a skating client tells the host: where the board has them, the
+/// pose others see, what they may do, and a fall to be hurt by.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SkateMotion {
+    pub active: bool,
+    /// Map units.
+    pub origin: [f32; 3],
+    pub rules: RiderRules,
+    /// Fall damage since the last report, percent of full health.
+    pub fall_percent: u8,
+    pub bone_count: u8,
+    pub bones: [SkateBone; SKATE_POSE_BONES],
+    pub cue: SkateCue,
+    /// The board's parts as text, `board_len` bytes of it.
+    pub board_len: u8,
+    pub board: [u8; SKATE_BOARD_TEXT],
+}
+
+impl Default for SkateMotion {
+    fn default() -> Self {
+        Self {
+            active: false,
+            origin: [0.; 3],
+            rules: RiderRules::default(),
+            fall_percent: 0,
+            bone_count: 0,
+            bones: [SkateBone::default(); SKATE_POSE_BONES],
+            cue: SkateCue::default(),
+            board_len: 0,
+            board: [0; SKATE_BOARD_TEXT],
+        }
+    }
+}
+
+impl SkateMotion {
+    pub fn pose(&self) -> SkatePose {
+        SkatePose {
+            bones: self.bones[..usize::from(self.bone_count).min(SKATE_POSE_BONES)].to_vec(),
+            cue: self.cue,
+            board: self.board_text().to_owned(),
+        }
+    }
+
+    /// Sets the board text; one too long for the report is left out.
+    pub fn set_board(&mut self, text: &str) {
+        if text.len() <= SKATE_BOARD_TEXT && text.is_ascii() {
+            self.board[..text.len()].copy_from_slice(text.as_bytes());
+            self.board_len = text.len() as u8;
+        } else {
+            self.board_len = 0;
+        }
+    }
+
+    pub fn board_text(&self) -> &str {
+        std::str::from_utf8(&self.board[..usize::from(self.board_len).min(SKATE_BOARD_TEXT)]).unwrap_or("")
+    }
+}
+
+/// A bone name's id in a [`SkatePose`] (FNV-1a; never 0, the root's).
+pub fn skate_name_hash(name: &str) -> u32 {
+    let mut hash: u32 = 0x811c_9dc5;
+    for byte in name.bytes() {
+        hash ^= u32::from(byte);
+        hash = hash.wrapping_mul(0x0100_0193);
+    }
+    hash.max(1)
+}
+
+/// Farthest a skater may move between two reports (inches), so a client
+/// cannot teleport across the map.
+const MAX_STEP: f32 = 600.;
+
+/// Applies a skater's report on the host: the board moves them, the rules
+/// say what else they may do, a fall hurts, and the pose goes out to
+/// everyone with the next snapshot.
+pub(crate) fn apply_motion(world: &mut FrameWorld, id: ClientId, motion: &SkateMotion) {
+    let alive = world.client_meta(id).is_some_and(|m| m.lifecycle == ClientLifecycle::Alive);
+    if !motion.active || !alive {
+        world.external_motion.remove(&id);
+        set_rider(id.0, None);
+        world.client_meta_mut(id).skate = None;
+        return;
+    }
+    let origin_ok = motion.origin.iter().all(|v| v.is_finite());
+    let near = world.player(id).is_some_and(|ps| {
+        let d: f32 = (0..3).map(|k| (ps.origin[k] - motion.origin[k]).powi(2)).sum::<f32>().sqrt();
+        d <= MAX_STEP || !world.external_motion.contains(&id)
+    });
+    world.external_motion.insert(id);
+    if origin_ok && near {
+        world.set_origin(id, motion.origin);
+    }
+    set_rider(id.0, Some(motion.rules));
+    if motion.fall_percent > 0 {
+        crate::damage::push_fall_damage(id.0, u32::from(motion.fall_percent));
+    }
+    world.client_meta_mut(id).skate = Some(motion.pose());
+}
+
+/// What a skating client may do besides skate.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RiderRules {
+    /// The weapon keeps working: shooting, aiming, reloading, grenades,
+    /// melee and killstreak weapons. Movement stays the board's.
+    pub armed: bool,
+    /// Riding into an enemy hurts them.
+    pub ram: bool,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Rider {
+    rules: RiderRules,
+    /// Where the rider was at the last tick, for their speed.
+    last: Option<([f32; 3], Tick)>,
+    /// Inches per second, along the ground and up.
+    velocity: [f32; 3],
+}
+
+static RIDERS: Mutex<Vec<(u32, Rider)>> = Mutex::new(Vec::new());
+/// When each rider last hit each victim, so one pass is one hit.
+static HITS: Mutex<Option<HashMap<(u32, u32), Tick>>> = Mutex::new(None);
+
+/// Inches per metre.
+const INCHES: f32 = 1. / 0.0254;
+/// How close (inches, across) the board must come to someone to hit them,
+/// and how far up or down.
+const REACH: f32 = 36.;
+const REACH_UP: f32 = 60.;
+/// The same rider hits the same victim again only after this many ticks.
+const REHIT_TICKS: u32 = 20;
+
+/// Marks `client` as skating with `rules`, or (`None`) as not skating.
+pub fn set_rider(client: u32, rules: Option<RiderRules>) {
+    let Ok(mut riders) = RIDERS.lock() else { return };
+    match rules {
+        Some(rules) => match riders.iter_mut().find(|(c, _)| *c == client) {
+            Some((_, rider)) => rider.rules = rules,
+            None => riders.push((client, Rider { rules, last: None, velocity: [0.; 3] })),
+        },
+        None => riders.retain(|(c, _)| *c != client),
+    }
+}
+
+/// The rules of a skating client, if they skate.
+pub fn rider(client: u32) -> Option<RiderRules> {
+    RIDERS.lock().ok()?.iter().find(|(c, _)| *c == client).map(|(_, r)| r.rules)
+}
+
+/// A skating client's last measured speed, metres a second.
+pub fn rider_speed(client: u32) -> Option<f32> {
+    let riders = RIDERS.lock().ok()?;
+    let (_, rider) = riders.iter().find(|(c, _)| *c == client)?;
+    let v = rider.velocity;
+    Some((v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt() / INCHES)
+}
+
+/// Measures the riders' speeds from where they are now, and lets the
+/// fast ones hit the enemies they ride into.
+pub(crate) fn apply_board_hits(world: &mut FrameWorld, tick: Tick) {
+    // Only the world that decides damage measures: a client's predicted
+    // copy runs other ticks.
+    if !world.publishes_snapshot() {
+        return;
+    }
+    let riders: Vec<(u32, Rider)> = {
+        let Ok(mut riders) = RIDERS.lock() else { return };
+        for (client, rider) in riders.iter_mut() {
+            let Some(ps) = world.player(ClientId(*client)) else {
+                rider.last = None;
+                continue;
+            };
+            if let Some((from, at)) = rider.last
+                && tick.0 > at.0
+            {
+                let seconds = (tick.0 - at.0) as f32 * crate::MATCH_TICK_MS as f32 / 1000.;
+                rider.velocity = std::array::from_fn(|k| (ps.origin[k] - from[k]) / seconds);
+            }
+            rider.last = Some((ps.origin, tick));
+        }
+        riders.clone()
+    };
+    let ids = world.client_ids_sorted();
+    let mut hits = Vec::new();
+    for (client, rider) in &riders {
+        if !rider.rules.ram {
+            continue;
+        }
+        let attacker = ClientId(*client);
+        let v = rider.velocity;
+        let speed = (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt() / INCHES;
+        let percent = skate_rules::ram_damage(speed);
+        if percent == 0 {
+            continue;
+        }
+        let Some(meta) = world.client_meta(attacker) else { continue };
+        if meta.lifecycle != ClientLifecycle::Alive {
+            continue;
+        }
+        let attacker_life = meta.life_sequence;
+        let Some(from) = world.player(attacker).map(|ps| (ps.origin, ps.weapon)) else { continue };
+        for &victim in &ids {
+            if victim == attacker {
+                continue;
+            }
+            let Some(meta) = world.client_meta(victim) else { continue };
+            if meta.lifecycle != ClientLifecycle::Alive {
+                continue;
+            }
+            let Some(ps) = world.player(victim) else { continue };
+            let d = [ps.origin[0] - from.0[0], ps.origin[1] - from.0[1], ps.origin[2] - from.0[2]];
+            let across = d[0].hypot(d[1]);
+            // Close, and ahead of the board rather than left behind.
+            if across > REACH || d[2].abs() > REACH_UP || d[0] * v[0] + d[1] * v[1] < 0. {
+                continue;
+            }
+            let max_health = ps.max_health.max(1);
+            let amount = ((max_health as u64 * u64::from(percent)).div_ceil(100)).min(i32::MAX as u64) as i32;
+            hits.push((attacker, attacker_life, victim, meta.life_sequence, from, amount));
+        }
+    }
+    let Ok(mut recent) = HITS.lock() else { return };
+    let recent = recent.get_or_insert_with(HashMap::new);
+    recent.retain(|_, at| tick.0.saturating_sub(at.0) < REHIT_TICKS);
+    for (attacker, attacker_life, victim, target_life, (origin, weapon), amount) in hits {
+        if recent.contains_key(&(attacker.0, victim.0)) {
+            continue;
+        }
+        recent.insert((attacker.0, victim.0), tick);
+        let attempt = crate::DamageAttempt {
+            source: DamageSource::Melee,
+            pellet: PelletId(0),
+            attacker,
+            attacker_life,
+            target: victim,
+            target_life,
+            weapon,
+            amount,
+            killcam_entity_start_time: 0,
+            inflictor_origin: Some(origin),
+            hitloc: 0,
+            splash: false,
+        };
+        let _ = crate::damage::apply_damage_attempt(world, tick, &attempt);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn riders_come_and_go() {
+        // A client number no other test uses.
+        let client = 4000;
+        assert_eq!(rider(client), None);
+        set_rider(client, Some(RiderRules { armed: true, ram: false }));
+        assert_eq!(rider(client), Some(RiderRules { armed: true, ram: false }));
+        set_rider(client, Some(RiderRules { armed: false, ram: true }));
+        assert_eq!(rider(client).map(|r| r.ram), Some(true));
+        assert_eq!(rider_speed(client), Some(0.));
+        set_rider(client, None);
+        assert_eq!(rider(client), None);
+    }
+
+    #[test]
+    fn a_motion_carries_its_pose() {
+        let mut motion = SkateMotion { active: true, bone_count: 2, ..Default::default() };
+        motion.bones[1] = SkateBone { name: skate_name_hash("HIPS"), position: [0., 1., 0.], rotation: [0, 0, 0, i16::MAX] };
+        let pose = motion.pose();
+        assert_eq!(pose.bones.len(), 2);
+        assert_eq!(pose.bones[1].name, skate_name_hash("HIPS"));
+        assert_ne!(skate_name_hash(""), 0);
+        assert_ne!(skate_name_hash("HIPS"), skate_name_hash("HEAD"));
+    }
+}
+
+/// The objects a skater dropped with the object dropper, as a fixed list
+/// for the wire (see `skate_park`). Positions are map units.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SkatePark {
+    pub count: u8,
+    pub objects: [skate_park::ParkObject; skate_park::MAX_OBJECTS],
+}
+
+impl Default for SkatePark {
+    fn default() -> Self {
+        Self { count: 0, objects: [skate_park::ParkObject::default(); skate_park::MAX_OBJECTS] }
+    }
+}
+
+impl SkatePark {
+    /// The usable objects of `list`, as many as fit.
+    pub fn from_list(list: &[skate_park::ParkObject]) -> Self {
+        let mut park = Self::default();
+        for object in list.iter().filter(|o| o.valid()).take(skate_park::MAX_OBJECTS) {
+            park.objects[usize::from(park.count)] = *object;
+            park.count += 1;
+        }
+        park
+    }
+
+    pub fn list(&self) -> &[skate_park::ParkObject] {
+        &self.objects[..usize::from(self.count).min(skate_park::MAX_OBJECTS)]
+    }
+}
+
+/// A skater's dropped objects, applied on the host: kept with the client
+/// and sent to everyone, so all of them skate the same park.
+pub(crate) fn apply_park(world: &mut FrameWorld, id: ClientId, park: &SkatePark) {
+    let clean = SkatePark::from_list(park.list());
+    world.client_meta_mut(id).park = clean.list().to_vec();
+}
