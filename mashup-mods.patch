+    last: Vec<Mat4>,
+    from: Option<(Vec<Mat4>, std::time::Instant)>,
+}
+
+const BODY_EASE_SECONDS: f32 = 0.35;
+
+fn switch() -> &'static std::sync::Mutex<Switch> {
+    static SWITCH: OnceLock<std::sync::Mutex<Switch>> = OnceLock::new();
+    SWITCH.get_or_init(|| std::sync::Mutex::new(Switch { skating: false, last: Vec::new(), from: None }))
+}
+
+/// Eases the local body between MW2's pose and the skater's when skating
+/// starts or stops. `world` is this frame's pose and `to_map` takes it to
+/// map space (the identity for the skater's, the body's placement for MW2's).
+pub fn ease_switch(skating: bool, world: &mut [Mat4], to_map: Mat4) {
+    let Ok(mut s) = switch().lock() else { return };
+    if skating != s.skating {
+        s.skating = skating;
+        let last = std::mem::take(&mut s.last);
+        s.from = (last.len() == world.len()).then(|| (last, std::time::Instant::now()));
+    }
+    let from_map = to_map.inverse();
+    if let Some((from, since)) = &s.from {
+        let t = (since.elapsed().as_secs_f32() / BODY_EASE_SECONDS).clamp(0., 1.);
+        if t >= 1. || from.len() != world.len() {
+            s.from = None;
+        } else {
+            let e = t * t * (3. - 2. * t);
+            for (now, was) in world.iter_mut().zip(from) {
+                *now = mix(from_map * *was, *now, e);
+            }
+        }
+    }
+    s.last = world.iter().map(|m| to_map * *m).collect();
+}
