+pub fn active_skate_board() -> Option<Arc<BotModel>> {
+    let state = class_boards().lock().ok()?;
+    state
+        .installed
+        .iter()
+        .find(|(choice, _)| *choice == state.active)
+        .map(|(_, model)| model.clone())
+}
