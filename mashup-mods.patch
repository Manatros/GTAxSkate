+    if combat.melee {
+        mask |= b::MELEE_CHARGE;
+    }
+    if combat.streaks {
+        mask |= b::LOCATION_SELECT | b::LOCATION_CANCEL | b::REMOTE_CONTROL | b::USE | b::USE_RELOAD;
+        if held_item {
+            mask |= b::ATTACK;
+        }
+    }
