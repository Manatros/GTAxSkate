diff --git a/crates/hud/src/skate_hud.rs b/crates/hud/src/skate_hud.rs
new file mode 100644
index 0000000..98edc5a
--- /dev/null
+++ b/crates/hud/src/skate_hud.rs
@@ -0,0 +1,483 @@
+//! Skate 3's HUD while skating: the trick being done, the sequence's points
+//! and multiplier, what a landing scored (or the bail), and the line and
+//! session totals, in MW2's HUD fonts.
+
+use std::collections::HashMap;
+
+use asset_game::MenuCatalog;
+use bevy::prelude::*;
+use hud_iw4::{ALIGN_CENTER, ALIGN_VIEWABLE};
+
+use crate::draw2d::{Draw2dCmd, Draw2dList, Draw2dOp, Draw2dProvenance, tessellate_fonts};
+use crate::gpu_list::{self, HudTessPass, TessJob};
+use crate::images::HudImages;
+
+/// Seconds a trick name stays, and a landing's points.
+const TRICK_SECONDS: f64 = 2.5;
+const LANDING_SECONDS: f64 = 2.0;
+const MARKER_SECONDS: f64 = 1.5;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum Size {
+    Big,
+    Small,
+    Tiny,
+}
+
+/// Seconds the controls show after skating starts (or after getting on or
+/// off the board), the last of them fading.
+const CONTROLS_SECONDS: f64 = 12.;
+
+/// One line of the HUD: text, centre x (or right edge for `right`) and
+/// baseline y in 640x480 virtual units, size and colour.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Line {
+    pub text: String,
+    pub x: f32,
+    pub y: f32,
+    pub size: Size,
+    pub color: [f32; 4],
+    pub right: bool,
+    /// `x` is the left edge (when not `right`).
+    pub left: bool,
+}
+
+#[derive(Default)]
+pub(crate) struct State {
+    tricks: Option<(u32, f64)>,
+    landings: Option<(u32, f64)>,
+    markers: Option<(u64, f64)>,
+    retries: Option<(u32, f64)>,
+    /// When the controls started showing, and on foot or not then.
+    controls: Option<(bool, f64)>,
+}
+
+/// "12,450".
+pub(crate) fn points(value: f32) -> String {
+    let digits = (value.max(0.).round() as u64).to_string();
+    let mut out = String::new();
+    for (i, c) in digits.chars().enumerate() {
+        if i > 0 && (digits.len() - i) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(c);
+    }
+    out
+}
+
+fn fade(since: f64, lasting: f64) -> f32 {
+    (1.0 - ((since - lasting * 0.75) / (lasting * 0.25)).clamp(0.0, 1.0)) as f32
+}
+
+impl State {
+    /// The HUD for `score` at time `now` (seconds).
+    /// The session marker's prompt, its "set" flash and the hold to return.
+    pub(crate) fn marker_lines(&mut self, marker: &frame::SkateMarker, keys: &skate_input::Controls, pad: bool, now: f64) -> Vec<Line> {
+        match self.markers {
+            Some((seen, _)) if seen == marker.placements => {}
+            Some(_) => self.markers = Some((marker.placements, now)),
+            None => self.markers = Some((marker.placements, f64::NEG_INFINITY)),
+        }
+        let mut lines = Vec::new();
+        let white = [1., 1., 1., 0.9];
+        if marker.progress > 0. {
+            lines.push(Line {
+                text: format!("Back to the marker {:.0}%", marker.progress.clamp(0., 1.) * 100.),
+                x: 0.,
+                y: 200.,
+                size: Size::Small,
+                color: white,
+                right: false,
+                left: false,
+            });
+        } else if marker.prompt {
+            let set = skate_input::hints::one(keys, pad, "LB + Down", "marker_place");
+            let back = skate_input::hints::one(keys, pad, "Hold LB + Up", "marker_return");
+            let place = if marker.can_place { format!("[{set}] Set marker") } else { "No marker here".into() };
+            let back = if marker.placed { format!("   [{back}] Back to it") } else { String::new() };
+            lines.push(Line { text: format!("{place}{back}"), x: 0., y: 200., size: Size::Small, color: white, right: false, left: false });
+        }
+        let age = self.markers.map_or(f64::INFINITY, |(_, at)| now - at);
+        if age < MARKER_SECONDS {
+            let a = fade(age, MARKER_SECONDS);
+            lines.push(Line { text: "Marker set".into(), x: 0., y: 216., size: Size::Small, color: [0.5, 0.85, 1., a], right: false, left: false });
+        }
+        lines
+    }
+
+    /// The object dropper's panel: the object between its neighbours, how
+    /// many are dropped, and its controls on the player's own keys; and a
+    /// flash on going back to the checkpoint.
+    pub(crate) fn dropper_lines(&mut self, dropper: &frame::SkateDropper, retries: u32, keys: &skate_input::Controls, now: f64) -> Vec<Line> {
+        match self.retries {
+            Some((seen, _)) if seen == retries => {}
+            Some(_) => self.retries = Some((retries, now)),
+            None => self.retries = Some((retries, f64::NEG_INFINITY)),
+        }
+        let mut lines = Vec::new();
+        let age = self.retries.map_or(f64::INFINITY, |(_, at)| now - at);
+        if age < MARKER_SECONDS {
+            let a = fade(age, MARKER_SECONDS);
+            lines.push(Line { text: "Back to the checkpoint".into(), x: 0., y: 216., size: Size::Small, color: [0.5, 0.85, 1., a], right: false, left: false });
+        }
+        if dropper.open {
+            let white = [1., 1., 1., 0.95];
+            let dim = [0.75, 0.78, 0.85, 0.85];
+            lines.push(Line { text: "OBJECT DROPPER".into(), x: 0., y: 292., size: Size::Small, color: [1., 0.85, 0.3, 1.], right: false, left: false });
+            lines.push(Line {
+                text: format!("<  {}      {}      {}  >", dropper.previous, dropper.object.to_uppercase(), dropper.next),
+                x: 0.,
+                y: 312.,
+                size: Size::Big,
+                color: white,
+                right: false,
+                left: false,
+            });
+            lines.push(Line { text: format!("{} of {} placed", dropper.placed, dropper.max), x: 0., y: 334., size: Size::Small, color: dim, right: false, left: false });
+            let hints = skate_input::hints::dropper(keys, dropper.pad);
+            for (row, pair) in hints.chunks(2).enumerate() {
+                let text = pair.iter().map(|(key, what)| format!("[{key}] {what}")).collect::<Vec<_>>().join("        ");
+                lines.push(Line { text, x: 0., y: 354. + row as f32 * 15., size: Size::Small, color: white, right: false, left: false });
+            }
+        }
+        lines
+    }
+
+    /// The controls while skating, small down the left side, on the
+    /// player's own keys (or the controller's buttons): for a while after
+    /// skating starts, or after getting on or off the board.
+    pub(crate) fn controls_lines(&mut self, keys: &skate_input::Controls, pad: bool, on_foot: bool, now: f64) -> Vec<Line> {
+        match self.controls {
+            Some((was, _)) if was == on_foot => {}
+            _ => self.controls = Some((on_foot, now)),
+        }
+        let age = self.controls.map_or(f64::INFINITY, |(_, at)| now - at);
+        if age >= CONTROLS_SECONDS {
+            return Vec::new();
+        }
+        let a = fade(age, CONTROLS_SECONDS) * 0.85;
+        skate_input::hints::skating(keys, pad, on_foot)
+            .into_iter()
+            .enumerate()
+            .map(|(i, (key, what))| Line {
+                text: format!("[{key}] {what}"),
+                x: -305.,
+                y: 236. + i as f32 * 10.,
+                size: Size::Tiny,
+                color: [1., 1., 1., a],
+                right: false,
+                left: true,
+            })
+            .collect()
+    }
+
+    pub(crate) fn lines(&mut self, score: &frame::SkateScore, now: f64) -> Vec<Line> {
+        // A changed counter is a new trick or a new landing; the first
+        // look at a session only remembers where the counters are.
+        match self.tricks {
+            Some((seen, _)) if seen == score.tricks => {}
+            Some(_) => self.tricks = Some((score.tricks, now)),
+            None => self.tricks = Some((score.tricks, f64::NEG_INFINITY)),
+        }
+        match self.landings {
+            Some((seen, _)) if seen == score.landings => {}
+            Some(_) => self.landings = Some((score.landings, now)),
+            None => self.landings = Some((score.landings, f64::NEG_INFINITY)),
+        }
+        let mut lines = Vec::new();
+        let trick_age = self.tricks.map_or(f64::INFINITY, |(_, at)| now - at);
+        if trick_age < TRICK_SECONDS && !score.trick.is_empty() {
+            let mut name = String::new();
+            for (on, word) in [(score.switch, "Switch "), (score.fakie, "Fakie "), (score.nollie, "Nollie ")] {
+                // "Nollie Kickflip" already says so.
+                if on && !score.trick.starts_with(word) {
+                    name.push_str(word);
+                }
+            }
+            name.push_str(&score.trick);
+            let a = fade(trick_age, TRICK_SECONDS);
+            lines.push(Line { text: name, x: 0., y: 120., size: Size::Big, color: [1., 1., 1., a], right: false, left: false });
+            if score.sequence > 0. {
+                let text = if score.multiplier > 1.01 {
+                    format!("{}  x{:.1}", points(score.sequence), score.multiplier)
+                } else {
+                    points(score.sequence)
+                };
+                lines.push(Line { text, x: 0., y: 140., size: Size::Small, color: [1., 0.85, 0.3, a], right: false, left: false });
+            }
+        }
+        let landing_age = self.landings.map_or(f64::INFINITY, |(_, at)| now - at);
+        if landing_age < LANDING_SECONDS {
+            let a = fade(landing_age, LANDING_SECONDS);
+            let (text, color) = if score.bailed {
+                ("BAIL".to_owned(), [1., 0.25, 0.2, a])
+            } else {
+                let quality = if score.clean {
+                    "  Clean!"
+                } else if score.sketchy {
+                    "  Sketchy"
+                } else {
+                    ""
+                };
+                (format!("+{}{quality}", points(score.last_reward)), [0.45, 1., 0.45, a])
+            };
+            lines.push(Line { text, x: 0., y: 160., size: Size::Small, color, right: false, left: false });
+        }
+        if score.line > 0. {
+            lines.push(Line {
+                text: format!("LINE {}", points(score.line)),
+                x: 300.,
+                y: 30.,
+                size: Size::Small,
+                color: [1., 1., 1., 0.9],
+                right: true,
+                left: false,
+            });
+        }
+        let session = score.completed + score.line;
+        if session > 0. {
+            lines.push(Line {
+                text: format!("SESSION {}", points(session)),
+                x: 300.,
+                y: 46.,
+                size: Size::Small,
+                color: [0.8, 0.9, 1., 0.9],
+                right: true,
+                left: false,
+            });
+        }
+        lines
+    }
+
+    pub(crate) fn reset(&mut self) {
+        *self = Self::default();
+    }
+}
+
+#[derive(Component)]
+pub(crate) struct SkateHudRaster;
+
+pub(crate) fn spawn_skate_hud(root: &mut ChildSpawnerCommands) {
+    crate::font_overlay::spawn_overlay(root, SkateHudRaster);
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn update_skate_hud(
+    surface: Res<crate::surface::Hud2dSurface>,
+    catalog: Option<Res<MenuCatalog>>,
+    mode: Res<frame::SkateMode>,
+    input: Res<frame::HudInputView>,
+    keys: Res<frame::SkateKeys>,
+    time: Res<Time>,
+    mut state: Local<State>,
+    mut hud_images: ResMut<HudImages>,
+    mut images: ResMut<Assets<Image>>,
+    mut pass: ResMut<HudTessPass>,
+) {
+    pass.skate = TessJob::Hide;
+    if !mode.active {
+        state.reset();
+        return;
+    }
+    if !surface.is_ready() || input.script_menu_open || input.console_open {
+        return;
+    }
+    let Some(catalog) = catalog.as_ref() else { return };
+    let mut lines = state.lines(&mode.score, time.elapsed_secs_f64());
+    let pad = mode.dropper.pad;
+    lines.extend(state.marker_lines(&mode.marker, &keys.controls, pad, time.elapsed_secs_f64()));
+    lines.extend(state.dropper_lines(&mode.dropper, mode.retries, &keys.controls, time.elapsed_secs_f64()));
+    if mode.settings.show_controls && !mode.dropper.open {
+        lines.extend(state.controls_lines(&keys.controls, pad, skate_rules::on_foot(&mode.status), time.elapsed_secs_f64()));
+    }
+    if lines.is_empty() {
+        return;
+    }
+    let placement = surface.scale_virtual_to_real()[1];
+    let face = |size: Size| -> Option<(&'static str, f32)> {
+        let (font_enum, text_scale) = match size {
+            Size::Big => (9, 0.5),
+            Size::Small => (10, 0.4),
+            Size::Tiny => (10, 0.28),
+        };
+        let name = hud_iw4::ui_get_font_handle(font_enum, placement, text_scale);
+        catalog
+            .font(name)
+            .map(|_| (name, text_scale))
+            .or_else(|| catalog.font("fonts/normalfont").map(|_| ("fonts/normalfont", text_scale)))
+    };
+    let mut fonts = HashMap::new();
+    let mut cmds = Vec::new();
+    let mut materials = Vec::new();
+    for line in lines {
+        let Some((font_name, text_scale)) = face(line.size) else { continue };
+        let Some(font) = catalog.font(font_name) else { continue };
+        let nscale = hud_iw4::normalized_text_scale(font.pixel_height, text_scale);
+        let width = crate::chrome::ui_text_width(font, &line.text, text_scale);
+        let (x, horz) = if line.right {
+            (line.x - width, ALIGN_CENTER)
+        } else if line.left {
+            (line.x, ALIGN_CENTER)
+        } else {
+            (line.x - width * 0.5, ALIGN_CENTER)
+        };
+        let rect = surface.apply_rect(x, line.y, nscale, nscale, horz, ALIGN_VIEWABLE);
+        let material = asset_core::AssetRef::bare_name(&font.material).to_owned();
+        materials.push(material.clone());
+        cmds.push(Draw2dCmd {
+            material_namespace: crate::images::HUD_CHROME_NAMESPACE,
+            x: rect.x,
+            y: rect.y,
+            w: rect.w,
+            h: rect.h,
+            s0: 0.0,
+            t0: 0.0,
+            s1: 1.0,
+            t1: 1.0,
+            color: line.color,
+            material,
+            op: Draw2dOp::TextRun {
+                font: font_name.to_owned(),
+                scale: nscale,
+                text: line.text,
+                loc_key: String::new(),
+                style: 3,
+                fx: None,
+                glow: None,
+            },
+            provenance: Draw2dProvenance::CgDraw { site: "skate_hud" },
+            layer: 1,
+        });
+        fonts.insert(font_name.to_owned(), font);
+    }
+    if materials
+        .iter()
+        .any(|m| hud_images.get(crate::images::HUD_CHROME_NAMESPACE, m, &mut images).is_none())
+    {
+        return;
+    }
+    let (quads, _) = tessellate_fonts(&Draw2dList { cmds }, &fonts);
+    pass.skate = if quads.is_empty() { TessJob::Hide } else { TessJob::Quads(quads) };
+}
+
+pub(crate) fn flush_skate_hud_tess(
+    surface: Res<crate::surface::Hud2dSurface>,
+    mut pass: ResMut<HudTessPass>,
+    mut hud_images: ResMut<HudImages>,
+    mut images: ResMut<Assets<Image>>,
+    mut frame: ResMut<gpu_list::HudTessGpuFrame>,
+    mut host: Query<(Entity, &mut Node, &mut gpu_list::GpuListLatch), With<SkateHudRaster>>,
+) {
+    let _body = gpu_list::TessBody::open();
+    if !surface.is_ready() {
+        return;
+    }
+    let job = std::mem::take(&mut pass.skate);
+    if let Ok((_, mut node, mut latch)) = host.single_mut() {
+        gpu_list::apply_tess_job(
+            job,
+            &mut node,
+            &mut latch,
+            &mut hud_images,
+            &mut images,
+            &mut frame,
+            surface.width(),
+            surface.height(),
+        );
+    }
+}
