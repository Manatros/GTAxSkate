diff --git a/crates/audio/src/room.rs b/crates/audio/src/room.rs
new file mode 100644
index 0000000..516e713
--- /dev/null
+++ b/crates/audio/src/room.rs
@@ -0,0 +1,389 @@
+//! The room the listener is in, heard: a reverb on the match's mix that
+//! follows the space around the camera (its size, how closed in it is and
+//! what its walls are made of), and a slap-back echo off far walls in the
+//! open. The world is probed elsewhere (see `render_anim`); what is found is
+//! handed here with [`set_room`] and eased into while the mix plays.
+
+use std::sync::atomic::{AtomicU32, Ordering};
+
+/// The space around the listener, as the probe found it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Room {
+    /// Seconds for the reverb to fall by 60 dB.
+    pub decay: f32,
+    /// How much of the reverb is heard, 0 to 1.
+    pub wet: f32,
+    /// How quickly the walls swallow the highs, 0 (hard) to 1 (soft).
+    pub damping: f32,
+    /// Seconds before the first reflections come back.
+    pub predelay: f32,
+    /// Seconds to the far wall and back, and how loud that echo is.
+    pub echo_delay: f32,
+    pub echo_gain: f32,
+}
+
+impl Room {
+    /// Nothing around: no reverb, no echo.
+    pub const OPEN: Room = Room { decay: 0.3, wet: 0., damping: 0.5, predelay: 0.01, echo_delay: 0.1, echo_gain: 0. };
+}
+
+struct Shared([AtomicU32; 6]);
+
+static ROOM: Shared = Shared([
+    AtomicU32::new(0),
+    AtomicU32::new(0),
+    AtomicU32::new(0),
+    AtomicU32::new(0),
+    AtomicU32::new(0),
+    AtomicU32::new(0),
+]);
+static SET: AtomicU32 = AtomicU32::new(0);
+
+/// The room to sound like from now on (eased into over a moment).
+pub fn set_room(room: Room) {
+    let values = [room.decay, room.wet, room.damping, room.predelay, room.echo_delay, room.echo_gain];
+    for (slot, value) in ROOM.0.iter().zip(values) {
+        slot.store(if value.is_finite() { value } else { 0. }.to_bits(), Ordering::Relaxed);
+    }
+    SET.store(1, Ordering::Release);
+}
+
+fn room() -> Room {
+    if SET.load(Ordering::Acquire) == 0 {
+        return Room::OPEN;
+    }
+    let v: Vec<f32> = ROOM.0.iter().map(|a| f32::from_bits(a.load(Ordering::Relaxed))).collect();
+    Room {
+        decay: v[0].clamp(0.1, 4.),
+        wet: v[1].clamp(0., 1.),
+        damping: v[2].clamp(0., 1.),
+        predelay: v[3].clamp(0., 0.1),
+        echo_delay: v[4].clamp(0.02, 0.45),
+        echo_gain: v[5].clamp(0., 0.6),
+    }
+}
+
+/// Inches to metres, and the speed of sound in metres a second.
+const INCH: f32 = 0.0254;
+const SPEED_OF_SOUND: f32 = 343.;
+
+/// The room rays out from the listener describe: each ray's direction (z
+/// up) and, when it struck something, how far (inches) and how soft the
+/// surface was (0 hard to 1 soft).
+pub fn room_from_rays(rays: &[(bevy::math::Vec3, Option<(f32, f32)>)]) -> Room {
+    let n = rays.len().max(1) as f32;
+    let struck: Vec<(f32, f32)> = rays.iter().filter_map(|(_, hit)| *hit).collect();
+    if struck.is_empty() {
+        return Room::OPEN;
+    }
+    // How much a ray's wall closes the room in: a near one fully, one far
+    // off (a building across the street, seen from under a roof) hardly,
+    // as little of what reaches it comes back.
+    let closing = |hit: Option<(f32, f32)>| hit.map_or(0., |(distance, _)| 1. - ((distance * INCH - 20.) / 25.).clamp(0., 1.));
+    let enclosure = rays.iter().map(|(_, hit)| closing(*hit)).sum::<f32>() / n;
+    // Closed in round the ear: walls, not only a roof and the floor.
+    let (level, level_closed) = rays
+        .iter()
+        .filter(|(d, _)| d.z.abs() < 0.35)
+        .fold((0f32, 0f32), |(a, b), (_, hit)| (a + 1., b + closing(*hit)));
+    let walled = if level > 0. { level_closed / level } else { 0. };
+    // A ceiling: of the rays going up, the share that struck something.
+    let (up, up_struck) = rays
+        .iter()
+        .filter(|(d, _)| d.z > 0.35)
+        .fold((0f32, 0f32), |(a, b), (_, hit)| (a + 1., b + closing(*hit)));
+    let covered = if up > 0. { up_struck / up } else { 0. };
+    let weight: f32 = rays.iter().map(|(_, hit)| closing(*hit)).sum();
+    let mean = if weight > 0. {
+        rays.iter().filter_map(|(_, hit)| hit.map(|h| h.0 * closing(*hit))).sum::<f32>() / weight * INCH
+    } else {
+        struck.iter().map(|h| h.0).sum::<f32>() / struck.len() as f32 * INCH
+    };
+    let walls = struck.iter().map(|h| h.1).sum::<f32>() / struck.len() as f32;
+    // Open sky (and open sides) swallow everything sent their way.
+    let absorb = (walls * enclosure + (1. - enclosure)).clamp(0.02, 1.);
+    // Sabine's decay for a box whose sides are about this far apart.
+    let side = mean * 1.7;
+    let decay = (0.161 * (side / 6.) / absorb).clamp(0.15, 3.);
+    // A roof alone (a carport, an awning, a bridge) is no hall: the reverb
+    // needs walls round the ear as well.
+    let wet = (covered.powf(1.2) * walled.powf(1.5) * 0.3 + enclosure * walled * 0.06).clamp(0., 0.4);
+    let predelay = (mean * 2. / SPEED_OF_SOUND).min(0.08);
+    // Outdoors, a far wall level with the ear answers back (the ground far
+    // off at a slant is no wall).
+    let far = rays
+        .iter()
+        .filter(|(d, _)| d.z.abs() < 0.3)
+        .filter_map(|(_, hit)| *hit)
+        .map(|(distance, absorb)| (distance * INCH, absorb))
+        .filter(|(metres, _)| *metres > 12.)
+        .fold(None, |best: Option<(f32, f32)>, (d, a)| Some(best.map_or((d, a), |b| if d < b.0 { (d, a) } else { b })));
+    let (echo_delay, echo_gain) = match far {
+        Some((distance, absorb)) if covered < 0.4 => {
+            ((distance * 2. / SPEED_OF_SOUND).min(0.45), (0.25 * (1. - absorb) * (1. - covered)).max(0.))
+        }
+        _ => (0.1, 0.),
+    };
+    Room { decay, wet, damping: walls.clamp(0., 1.), predelay, echo_delay, echo_gain }
+}
+
+/// Freeverb's comb and all-pass lengths (at 44.1 kHz), and the right
+/// channel's spread.
+const COMBS: [usize; 8] = [1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617];
+const ALLPASSES: [usize; 4] = [556, 441, 341, 225];
+const SPREAD: usize = 23;
+/// Samples between looks at the room.
+const BLOCK: u32 = 256;
+
+struct Comb {
+    buffer: Vec<f32>,
+    at: usize,
+    store: f32,
+    feedback: f32,
+    damp: f32,
+}
+
+impl Comb {
+    fn new(len: usize) -> Self {
+        Self { buffer: vec![0.; len.max(1)], at: 0, store: 0., feedback: 0.5, damp: 0.3 }
+    }
+    fn tune(&mut self, decay: f32, damp: f32, rate: f32) {
+        // Each pass round the comb loses its share of 60 dB over `decay`.
+        self.feedback = 10f32.powf(-3. * self.buffer.len() as f32 / (decay * rate)).min(0.98);
+        self.damp = damp;
+    }
+    fn process(&mut self, input: f32) -> f32 {
+        let out = self.buffer[self.at];
+        self.store = out * (1. - self.damp) + self.store * self.damp;
+        self.buffer[self.at] = input + self.store * self.feedback;
+        self.at = (self.at + 1) % self.buffer.len();
+        out
+    }
+}
+
+struct Allpass {
+    buffer: Vec<f32>,
+    at: usize,
+}
+
+impl Allpass {
+    fn new(len: usize) -> Self {
+        Self { buffer: vec![0.; len.max(1)], at: 0 }
+    }
+    fn process(&mut self, input: f32) -> f32 {
+        let delayed = self.buffer[self.at];
+        let out = delayed - input;
+        self.buffer[self.at] = input + delayed * 0.5;
+        self.at = (self.at + 1) % self.buffer.len();
+        out
+    }
+}
+
+/// A delay line read at a changing distance behind the write head.
+struct Delay {
+    buffer: Vec<f32>,
+    at: usize,
+}
+
+impl Delay {
+    fn new(len: usize) -> Self {
+        Self { buffer: vec![0.; len.max(2)], at: 0 }
+    }
+    fn push(&mut self, input: f32) {
+        self.buffer[self.at] = input;
+        self.at = (self.at + 1) % self.buffer.len();
+    }
+    fn tap(&self, behind: usize) -> f32 {
+        let len = self.buffer.len();
+        let behind = behind.clamp(1, len - 1);
+        self.buffer[(self.at + len - behind) % len]
+    }
+}
+
+/// The reverb and echo for a stereo mix at `rate` samples a second.
+pub(crate) struct RoomSound {
+    rate: f32,
+    left: (Vec<Comb>, Vec<Allpass>),
+    right: (Vec<Comb>, Vec<Allpass>),
+    predelay: Delay,
+    echo: Delay,
+    /// What is heard now, eased towards the room each block.
+    now: Room,
+    until_look: u32,
+    echo_lowpass: f32,
+}
+
+impl RoomSound {
+    pub(crate) fn new(rate: u32) -> Self {
+        let rate = rate as f32;
+        let scale = rate / 44_100.;
+        let side = |spread: usize| {
+            (
+                COMBS.iter().map(|&n| Comb::new(((n + spread) as f32 * scale) as usize)).collect(),
+                ALLPASSES.iter().map(|&n| Allpass::new(((n + spread) as f32 * scale) as usize)).collect(),
+            )
+        };
+        Self {
+            rate,
+            left: side(0),
+            right: side(SPREAD),
+            predelay: Delay::new((rate * 0.11) as usize),
+            echo: Delay::new((rate * 0.5) as usize),
+            now: Room::OPEN,
+            until_look: 0,
+            echo_lowpass: 0.,
+        }
+    }
+
+    fn look(&mut self) {
+        let want = room();
+        // About a third of a second to move into a new room.
+        let k = 0.05;
+        let ease = |a: f32, b: f32| a + (b - a) * k;
+        self.now = Room {
+            decay: ease(self.now.decay, want.decay),
+            wet: ease(self.now.wet, want.wet),
+            damping: ease(self.now.damping, want.damping),
+            predelay: ease(self.now.predelay, want.predelay),
+            echo_delay: ease(self.now.echo_delay, want.echo_delay),
+            echo_gain: ease(self.now.echo_gain, want.echo_gain),
+        };
+        let damp = 0.15 + self.now.damping * 0.7;
+        for comb in self.left.0.iter_mut().chain(self.right.0.iter_mut()) {
+            comb.tune(self.now.decay, damp, self.rate);
+        }
+    }
+
+    /// One stereo frame through the room.
+    pub(crate) fn process(&mut self, l: f32, r: f32) -> (f32, f32) {
+        if self.until_look == 0 {
+            self.until_look = BLOCK;
+            self.look();
+        }
+        self.until_look -= 1;
+        let dry = (l + r) * 0.5;
+        self.predelay.push(dry);
+        let echo_in = self.echo.tap((self.now.echo_delay * self.rate) as usize);
+        // Far walls give back the lows more than the highs.
+        self.echo_lowpass += (echo_in - self.echo_lowpass) * 0.35;
+        self.echo.push(dry + self.echo_lowpass * self.now.echo_gain * 0.35);
+        if self.now.wet < 1e-4 && self.now.echo_gain < 1e-4 {
+            return (l, r);
+        }
+        let input = self.predelay.tap((self.now.predelay * self.rate) as usize) * 0.015;
+        let side = |(combs, passes): &mut (Vec<Comb>, Vec<Allpass>)| {
+            let mut out: f32 = combs.iter_mut().map(|c| c.process(input)).sum();
+            for pass in passes.iter_mut() {
+                out = pass.process(out);
+            }
+            out
+        };
+        let wl = side(&mut self.left);
+        let wr = side(&mut self.right);
+        // The reverb as loud as its share; the direct sound a touch quieter
+        // in a big wet room so the total stays level.
+        let wet = self.now.wet * 3.;
+        let direct = 1. - self.now.wet * 0.25;
+        let echo = self.echo_lowpass * self.now.echo_gain;
+        let out = |dry: f32, w: f32, other: f32| {
+            let v = dry * direct + (w * 0.85 + other * 0.15) * wet + echo;
+            if v.is_finite() { v.clamp(-1.5, 1.5) } else { 0. }
+        };
+        (out(l, wl, wr), out(r, wr, wl))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn energy_after(rate: u32, room: Room, after: usize) -> f32 {
+        let mut sound = RoomSound::new(rate);
+        sound.now = room;
+        sound.until_look = u32::MAX;
+        let damp = 0.15 + room.damping * 0.7;
+        for comb in sound.left.0.iter_mut().chain(sound.right.0.iter_mut()) {
+            comb.tune(room.decay, damp, rate as f32);
+        }
+        let mut tail = 0.;
+        for i in 0..after + 4800 {
+            let x = if i < 480 { 0.8 } else { 0. };
+            let (l, r) = sound.process(x, x);
+            if i >= after {
+                tail += l * l + r * r;
+            }
+        }
+        tail
+    }
+
+    #[test]
+    fn a_hall_rings_longer_than_a_carpeted_room_and_the_open_not_at_all() {
+        let hall = Room { decay: 2.5, wet: 0.35, damping: 0.1, predelay: 0.03, echo_delay: 0.1, echo_gain: 0. };
+        let lounge = Room { decay: 0.35, wet: 0.35, damping: 0.8, predelay: 0.005, ..hall };
+        let after = 24_000;
+        let (h, l, o) = (energy_after(48_000, hall, after), energy_after(48_000, lounge, after), energy_after(48_000, Room::OPEN, after));
+        assert!(h > l * 10., "hall {h} lounge {l}");
+        assert!(o < 1e-9, "open {o}");
+    }
+
+    #[test]
+    fn the_mix_stays_finite_and_bounded() {
+        let mut sound = RoomSound::new(48_000);
+        set_room(Room { decay: 3.9, wet: 1., damping: 0., predelay: 0.1, echo_delay: 0.3, echo_gain: 0.6 });
+        for i in 0..96_000 {
+            let x = if i % 2 == 0 { 1. } else { -1. };
+            let (l, r) = sound.process(x, x);
+            assert!(l.is_finite() && r.is_finite() && l.abs() <= 1.5 && r.abs() <= 1.5);
+        }
+        set_room(Room::OPEN);
+    }
+
+    /// Rays round a sphere, as the renderer sends them.
+    fn rays(hit: impl Fn(bevy::math::Vec3) -> Option<(f32, f32)>) -> Room {
+        let golden = std::f32::consts::PI * (3. - 5f32.sqrt());
+        let rays: Vec<_> = (0..48)
+            .map(|i| {
+                let z = 1. - 2. * (i as f32 + 0.5) / 48.;
+                let r = (1. - z * z).sqrt();
+                let a = golden * i as f32;
+                let d = bevy::math::Vec3::new(r * a.cos(), r * a.sin(), z);
+                (d, hit(d))
+            })
+            .collect();
+        room_from_rays(&rays)
+    }
+
+    #[test]
+    fn halls_ring_rooms_with_carpet_do_not_and_fields_are_dry() {
+        let hall = rays(|_| Some((600., 0.03)));
+        let lounge = rays(|_| Some((100., 0.6)));
+        let field = rays(|d| (d.z < -0.1).then_some((60., 0.6)));
+        assert!(hall.decay > 1.5 && hall.wet > 0.25, "{hall:?}");
+        assert!(lounge.decay < 0.4, "{lounge:?}");
+        assert!(field.wet < 0.05 && field.echo_gain < 0.01, "{field:?}");
+    }
+
+    #[test]
+    fn under_a_roof_with_open_sides_is_no_hall() {
+        // A carport: a roof 3 m up, the ground, buildings 45 m off.
+        let shelter = rays(|d| {
+            if d.z > 0.35 {
+                Some((3. / d.z / INCH, 0.03))
+            } else if d.z < -0.1 {
+                Some(((1.6 / -d.z).min(40.) / INCH, 0.05))
+            } else {
+                Some((45. / INCH, 0.03))
+            }
+        });
+        assert!(shelter.wet < 0.1, "{shelter:?}");
+        let room = rays(|_| Some((4. / INCH, 0.05)));
+        assert!(room.wet > shelter.wet * 3., "{room:?} vs {shelter:?}");
+    }
+
+    #[test]
+    fn a_street_answers_back_off_its_far_wall() {
+        let street = rays(|d| if d.z < -0.1 { Some((60., 0.05)) } else if d.x > 0.7 { Some((25. / INCH, 0.03)) } else { None });
+        assert!(street.echo_gain > 0.1, "{street:?}");
+        assert!((street.echo_delay - 50. / SPEED_OF_SOUND).abs() < 0.03, "{street:?}");
+    }
+}
diff --git a/crates/audio/src/skate.rs b/crates/audio/src/skate.rs
new file mode 100644
index 0000000..28d1c9c
--- /dev/null
+++ b/crates/audio/src/skate.rs
@@ -0,0 +1,192 @@
+//! The board's sounds while skating (`skate_sound`): the local skater's at
+//! the listener, every other skater's from where they ride, falling off
+//! with distance and panned as MW2's world sounds are. Each skater's board
+//! is one endless stream the game feeds what the board does, frame by
+//! frame.
+
+use std::collections::HashMap;
+use std::num::NonZero;
+use std::sync::{Arc, Mutex};
+
+use bevy::audio::{AddAudioSource, ChannelCount, Decodable, PlaybackSettings, SampleRate, Source};
+use bevy::prelude::*;
+use skate_sound::{Synth, Tracker};
+
+use crate::playback::{AmbientListener, world_oneshot_channel_gains};
+
+/// Inches within which another skater's board is heard at full volume, and
+/// beyond which it is not heard.
+const NEAR: f32 = 120.;
+const FAR: f32 = 1800.;
+/// The board against MW2's mix.
+const MIX_GAIN: f32 = 1.6;
+/// Samples rendered at a time.
+const BLOCK: usize = 512;
+
+struct Voice {
+    synth: Synth,
+    left: f32,
+    right: f32,
+    /// Cleared when the skater stops: the stream ends and its player goes.
+    alive: bool,
+}
+
+/// One skater's board, as an audio source.
+#[derive(Asset, TypePath, Clone)]
+pub struct BoardSound {
+    voice: Arc<Mutex<Voice>>,
+}
+
+pub struct BoardDecoder {
+    voice: Arc<Mutex<Voice>>,
+    block: Vec<f32>,
+    at: usize,
+    gains: (f32, f32),
+    right: Option<f32>,
+}
+
+impl Iterator for BoardDecoder {
+    type Item = f32;
+
+    fn next(&mut self) -> Option<f32> {
+        if let Some(right) = self.right.take() {
+            return Some(right);
+        }
+        if self.at >= self.block.len() {
+            let mut voice = self.voice.lock().ok()?;
+            if !voice.alive {
+                return None;
+            }
+            self.block.resize(BLOCK, 0.);
+            voice.synth.render(&mut self.block);
+            self.gains = (voice.left, voice.right);
+            self.at = 0;
+        }
+        // A bad value would silence the whole mix: never let one out.
+        let clean = |v: f32| if v.is_finite() { v.clamp(-1., 1.) } else { 0. };
+        let sample = self.block[self.at];
+        self.at += 1;
+        self.right = Some(clean(sample * self.gains.1));
+        Some(clean(sample * self.gains.0))
+    }
+}
+
+impl Source for BoardDecoder {
+    fn current_span_len(&self) -> Option<usize> {
+        None
+    }
+
+    fn channels(&self) -> ChannelCount {
+        NonZero::new(2).unwrap()
+    }
+
+    fn sample_rate(&self) -> SampleRate {
+        NonZero::new(skate_sound::RATE).unwrap()
+    }
+
+    fn total_duration(&self) -> Option<std::time::Duration> {
+        None
+    }
+}
+
+impl Decodable for BoardSound {
+    type Decoder = BoardDecoder;
+
+    fn decoder(&self) -> Self::Decoder {
+        BoardDecoder { voice: Arc::clone(&self.voice), block: Vec::new(), at: 0, gains: (0., 0.), right: None }
+    }
+}
+
+struct Board {
+    voice: Arc<Mutex<Voice>>,
+    tracker: Tracker,
+    seen: bool,
+}
+
+/// Every skater's board being heard, by client id.
+#[derive(Resource, Default)]
+struct BoardSounds {
+    boards: HashMap<u32, Board>,
+}
+
+pub(crate) fn register(app: &mut App) {
+    app.add_audio_source::<BoardSound>()
+        .init_resource::<BoardSounds>()
+        .add_systems(Update, board_sounds);
+}
+
+fn board_sounds(
+    time: Res<Time>,
+    local: Option<Res<frame::SkateMode>>,
+    remote: Option<Res<frame::RemoteSkaters>>,
+    listeners: Query<&Transform, With<AmbientListener>>,
+    mut sounds: ResMut<BoardSounds>,
+    mut assets: ResMut<Assets<BoardSound>>,
+    mut commands: Commands,
+) {
+    let dt = time.delta_secs();
+    let volume = local.as_ref().map_or(0.8, |m| m.settings.board_volume).clamp(0., 1.);
+    let ear = listeners.iter().next().map(|t| (t.translation, t.rotation * Vec3::X));
+    for board in sounds.boards.values_mut() {
+        board.seen = false;
+    }
+    let centre = std::f32::consts::FRAC_1_SQRT_2;
+    let mut riders: Vec<(&frame::SkateMode, Option<Vec3>, bool)> = Vec::new();
+    if let Some(mode) = local.as_deref().filter(|m| m.active && !m.bones.is_empty()) {
+        // The board is heard where it is seen: from the side the camera
+        // has it on (in first person, under the listener: centred).
+        riders.push((mode, Some(mode.root.w_axis.truncate()), true));
+    }
+    if let Some(remote) = remote.as_deref() {
+        for mode in remote.by_client.values().filter(|m| m.active) {
+            riders.push((mode, Some(mode.root.w_axis.truncate()), false));
+        }
+    }
+    for (mode, at, own) in riders {
+        let board = sounds.boards.entry(mode.client).or_insert_with(|| {
+            let voice = Arc::new(Mutex::new(Voice { synth: Synth::new(), left: 0., right: 0., alive: true }));
+            commands.spawn((
+                AudioPlayer(assets.add(BoardSound { voice: Arc::clone(&voice) })),
+                PlaybackSettings::DESPAWN,
+            ));
+            Board { voice, tracker: Tracker::default(), seen: true }
+        });
+        board.seen = true;
+        let b = mode.board;
+        let (heard, hits) = board.tracker.update(&mode.status, b.speed, b.vertical, b.wheels_down, b.surface, dt);
+        let (left, right) = match (at, ear) {
+            (Some(at), Some((ear, right))) if own => {
+                // Never quieter than a board right beside the camera, and
+                // half way to the middle so it does not leave one ear.
+                let (l, r) = world_oneshot_channel_gains(ear, right, at, 1.0);
+                ((l + centre) * 0.5, (r + centre) * 0.5)
+            }
+            (Some(at), Some((ear, right))) => {
+                let distance = (at - ear).length();
+                let falloff = (1. - (distance - NEAR).max(0.) / (FAR - NEAR)).clamp(0., 1.);
+                let (l, r) = world_oneshot_channel_gains(ear, right, at, 1.0);
+                (l * falloff, r * falloff)
+            }
+            (Some(_), None) => (0., 0.),
+            (None, _) => (centre, centre),
+        };
+        if let Ok(mut voice) = board.voice.lock() {
+            voice.synth.volume = volume;
+            voice.synth.set(heard);
+            for hit in hits {
+                voice.synth.hit(hit);
+            }
+            voice.left = if left.is_finite() { left * MIX_GAIN } else { 0. };
+            voice.right = if right.is_finite() { right * MIX_GAIN } else { 0. };
+        }
+    }
+    // Skaters who stopped: their streams end.
+    sounds.boards.retain(|_, board| {
+        if !board.seen
+            && let Ok(mut voice) = board.voice.lock()
+        {
+            voice.alive = false;
+        }
+        board.seen
+    });
+}
