+/// model space, radians) and
+/// moved so its lower spine sits on the skater's; `blend` eases it in.
+pub fn graft_upper(dobj: &xmodel_runtime::DObj, skate: &mut [Mat4], mw2: &[Mat4], aim_yaw: f32, blend: f32) {
+    let find = |name: &str| dobj.bones.iter().position(|b| b.name == name);
+    let (Some(lower), Some(upper)) = (find("j_spinelower"), find("j_spineupper")) else { return };
+    let (Some(at_skate), Some(at_mw2)) = (skate.get(lower), mw2.get(lower)) else { return };
+    let to = at_skate.w_axis.truncate();
+    let from = at_mw2.w_axis.truncate();
+    let graft = Mat4::from_translation(to) * Mat4::from_rotation_z(aim_yaw) * Mat4::from_translation(-from);
+    let blend = blend.clamp(0., 1.);
+    for i in 0..dobj.bones.len().min(skate.len()).min(mw2.len()) {
+        let upper_body = under(dobj, i, upper) || (dobj.bones[i].model != 0 && attached_to_upper(dobj, i, upper));
+        if !upper_body {
+            continue;
+        }
+        let wanted = graft * mw2[i];
+        skate[i] = if blend >= 0.999 { wanted } else { mix(skate[i], wanted, blend) };
+    }
+}
