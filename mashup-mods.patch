+/// Tells the skate renderer every class's board (so each map installs them)
+/// and the board of the class the player plays.
+pub(crate) fn sync_skate_boards(store: Res<SessionClassStore>) {
+    if !store.is_changed() {
+        return;
+    }
+    // A class with no board picked rides one that suits its loadout.
+    let ridden = |slot: &ClassSlotState| assets::bot_model::class_board(&slot.board, &slot.primary, &slot.name);
+    assets::bot_model::set_class_boards(store.slots.iter().map(ridden).collect());
+    assets::bot_model::set_active_board(store.equipped_slot().map(ridden).unwrap_or_default());
+}
