+/// A board for rider `rider` drawn with the live materials, and the
+/// textures to paint into them (material, `LIVE_TEXTURE_SIZE` square RGBA).
+pub fn live_board(rider: usize, board: &skate_boards::Board) -> Result<(Arc<BotModel>, Vec<(String, Vec<u8>)>), String> {
+    let mut model = BotModel::from_board(board)?;
+    let mut slots: Vec<(skate_boards::Part, usize, String)> = Vec::new();
+    let mut paints = Vec::new();
+    for (surface, source) in model.surfaces.iter_mut().zip(&board.surfaces) {
+        let existing = slots.iter().find(|(part, texture, _)| *part == source.part && *texture == source.texture);
+        let name = match existing {
+            Some((_, _, name)) => name.clone(),
+            None => {
+                let k = slots.iter().filter(|(part, _, _)| *part == source.part).count().min(LIVE_TEXTURES - 1);
+                let name = live_material(rider, source.part, k);
+                if !slots.iter().any(|(_, _, n)| *n == name) {
+                    let texture = &board.textures[source.texture];
+                    paints.push((name.clone(), resample(texture, LIVE_TEXTURE_SIZE)));
+                }
+                slots.push((source.part, source.texture, name.clone()));
+                name
+            }
+        };
+        surface.material = name;
+    }
+    Ok((Arc::new(model), paints))
+}
+
+/// A texture stretched to a square of `side`: the mesh's coordinates run
+/// 0 to 1 whatever the image's shape.
+fn resample(texture: &skate_boards::Texture, side: u32) -> Vec<u8> {
+    let mut out = Vec::with_capacity((side * side * 4) as usize);
+    for y in 0..side {
+        for x in 0..side {
+            let uv = [(x as f32 + 0.5) / side as f32, (y as f32 + 0.5) / side as f32];
+            out.extend(texture.sample(uv));
+        }
+    }
+    out
+}
