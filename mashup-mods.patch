diff --git a/crates/render_anim/src/skate/live.rs b/crates/render_anim/src/skate/live.rs
new file mode 100644
index 0000000..a75350d
--- /dev/null
+++ b/crates/render_anim/src/skate/live.rs
@@ -0,0 +1,292 @@
+//! Boards as they are ridden, changed while the game runs: the player's
+//! class board the moment it is saved in the class editor (not from the
+//! next map), worn parts in their worn finish as riding wears them, and
+//! other skaters' own boards. Each rider has live board materials
+//! (`assets::bot_model::live_materials`) whose textures are painted with
+//! the board's finishes; the mesh is built from the board's parts.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, OnceLock};
+
+use assets::bot_model::{BotModel, LIVE_RIDERS};
+use bevy::prelude::*;
+use bevy::tasks::{AsyncComputeTaskPool, Task, futures_lite::future};
+
+type Built = Result<(Arc<BotModel>, Vec<(String, Vec<u8>)>), String>;
+
+#[derive(Default)]
+struct Rider {
+    /// The board text wanted, and the one the model and paints are for.
+    wanted: String,
+    built: Option<String>,
+    building: Option<(String, Task<Built>)>,
+    model: Option<Arc<BotModel>>,
+    /// Each live material's texture, and the image it was last painted
+    /// into.
+    textures: Vec<(String, Vec<u8>)>,
+    painted: HashMap<String, AssetId<Image>>,
+}
+
+/// The boards ready to draw: rider 0 is the local player; others hold the
+/// slot their client id took.
+#[derive(Default)]
+struct Ready {
+    models: [Option<Arc<BotModel>>; LIVE_RIDERS],
+    slots: HashMap<u32, usize>,
+}
+
+fn ready() -> &'static Mutex<Ready> {
+    static READY: OnceLock<Mutex<Ready>> = OnceLock::new();
+    READY.get_or_init(Default::default)
+}
+
+/// The board to draw for a skater: the local player's (`own`) or client
+/// `client`'s, once it is painted.
+pub fn model_for(own: bool, client: u32) -> Option<Arc<BotModel>> {
+    let ready = ready().lock().ok()?;
+    let rider = if own { 0 } else { *ready.slots.get(&client)? };
+    ready.models.get(rider)?.clone()
+}
+
+#[derive(Resource, Default)]
+pub(crate) struct LiveBoards {
+    riders: [Rider; LIVE_RIDERS],
+    slots: HashMap<u32, usize>,
+    checked_at: f32,
+}
+
+/// Seconds between looks at whether the local board changed.
+const CHECK_SECONDS: f32 = 0.25;
+
+pub(crate) fn update_live_boards(
+    time: Res<Time>,
+    mut live: ResMut<LiveBoards>,
+    mut mode: ResMut<frame::SkateMode>,
+    remote: Res<frame::RemoteSkaters>,
+    textures: Option<Res<frame::LiveBoardTextures>>,
+    mut images: ResMut<Assets<Image>>,
+) {
+    if assets::bot_model::local_skate_board().is_none() {
+        return;
+    }
+    let now = time.elapsed_secs();
+    // The local board: the class's, as worn.
+    if now - live.checked_at >= CHECK_SECONDS || live.riders[0].wanted.is_empty() && live.riders[0].built.is_none() {
+        live.checked_at = now;
+        let ridden = assets::bot_model::board_as_ridden(&assets::bot_model::active_board_choice()).to_text();
+        if mode.board_choice != ridden {
+            mode.board_choice.clone_from(&ridden);
+        }
+        live.riders[0].wanted = ridden;
+    }
+    // Others' boards, each in a slot of its own while they skate.
+    let skating: Vec<u32> = remote.by_client.values().filter(|m| m.active).map(|m| m.client).collect();
+    live.slots.retain(|client, _| skating.contains(client));
+    for client in &skating {
+        if !live.slots.contains_key(client) {
+            let used: Vec<usize> = live.slots.values().copied().collect();
+            if let Some(free) = (1..LIVE_RIDERS).find(|s| !used.contains(s)) {
+                live.slots.insert(*client, free);
+            }
+        }
+    }
+    let slots = live.slots.clone();
+    for (client, slot) in &slots {
+        if let Some(theirs) = remote.by_client.get(client) {
+            live.riders[*slot].wanted.clone_from(&theirs.board_choice);
+        }
+    }
+    let empty = HashMap::new();
+    let handles = textures.as_ref().map_or(&empty, |t| &t.by_name);
+    let mut models: [Option<Arc<BotModel>>; LIVE_RIDERS] = Default::default();
+    for (index, rider) in live.riders.iter_mut().enumerate() {
+        let in_use = index == 0 || slots.values().any(|s| *s == index);
+        if !in_use {
+            continue;
+        }
+        step(index, rider, handles, &mut images);
+        models[index] = rider.model.clone().filter(|_| painted(rider, handles));
+    }
+    if let Ok(mut ready) = ready().lock() {
+        ready.models = models;
+        ready.slots = slots;
+    }
+}
+
+/// Builds the wanted board off the frame, then paints its textures.
+fn step(index: usize, rider: &mut Rider, handles: &HashMap<String, Handle<Image>>, images: &mut Assets<Image>) {
+    if let Some((text, task)) = rider.building.as_mut()
+        && let Some(result) = future::block_on(future::poll_once(task))
+    {
+        let text = std::mem::take(text);
+        rider.building = None;
+        match result {
+            Ok((model, textures)) => {
+                rider.model = Some(model);
+                rider.textures = textures;
+                rider.painted.clear();
+            }
+            Err(e) => {
+                diag::warn!(World, "skate board for rider {index}: {e}");
+                rider.model = None;
+            }
+        }
+        rider.built = Some(text);
+    }
+    if rider.building.is_none() && rider.built.as_deref() != Some(rider.wanted.as_str()) {
+        let text = rider.wanted.clone();
+        let wanted = skate_boards::BoardChoice::from_text(&text);
+        let task = AsyncComputeTaskPool::get().spawn(async move {
+            let board = assets::bot_model::assemble_skate_board(&wanted)?;
+            assets::bot_model::live_board(index, &board)
+        });
+        rider.building = Some((text, task));
+    }
+    // Paint what is not yet painted into this map's images.
+    for (material, rgba) in &rider.textures {
+        let Some(handle) = handles.get(&format!("{material}/diffuse")) else { continue };
+        if rider.painted.get(material) == Some(&handle.id()) {
+            continue;
+        }
+        if let Some(mut image) = images.get_mut(handle) {
+            let side = assets::bot_model::LIVE_TEXTURE_SIZE;
+            let levels = image.texture_descriptor.mip_level_count.max(1);
+            let rgba8 = matches!(
+                image.texture_descriptor.format,
+                bevy::render::render_resource::TextureFormat::Rgba8Unorm | bevy::render::render_resource::TextureFormat::Rgba8UnormSrgb
+            );
+            let fits = image.width() == side && image.height() == side && rgba.len() == (side * side * 4) as usize;
+            if fits && rgba8 {
+                // The whole mip chain, so the upload matches the texture.
+                image.data = Some(with_mips(rgba, side, levels));
+                rider.painted.insert(material.clone(), handle.id());
+            } else {
+                diag::warn!(
+                    World,
+                    "skate board texture {material}: {}x{} {:?} cannot take a {side}px board texture",
+                    image.width(),
+                    image.height(),
+                    image.texture_descriptor.format
+                );
+                // Not tried again for this image.
+                rider.painted.insert(material.clone(), handle.id());
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn mip_chains_halve_down_to_one_texel() {
+        let base = vec![200u8; 8 * 8 * 4];
+        let chain = super::with_mips(&base, 8, 4);
+        assert_eq!(chain.len(), (64 + 16 + 4 + 1) * 4);
+        assert!(chain.iter().all(|v| *v == 200));
+        assert_eq!(super::with_mips(&base, 8, 1), base);
+    }
+}
+
+/// `rgba` (`side` square) and its `levels - 1` halvings, box filtered.
+fn with_mips(rgba: &[u8], side: u32, levels: u32) -> Vec<u8> {
+    let mut out = rgba.to_vec();
+    let mut level = rgba.to_vec();
+    let mut size = side as usize;
+    for _ in 1..levels {
+        let half = (size / 2).max(1);
+        let mut next = vec![0u8; half * half * 4];
+        for y in 0..half {
+            for x in 0..half {
+                for c in 0..4 {
+                    let at = |xx: usize, yy: usize| u32::from(level[((yy.min(size - 1)) * size + xx.min(size - 1)) * 4 + c]);
+                    let sum = at(x * 2, y * 2) + at(x * 2 + 1, y * 2) + at(x * 2, y * 2 + 1) + at(x * 2 + 1, y * 2 + 1);
+                    next[(y * half + x) * 4 + c] = (sum / 4) as u8;
+                }
+            }
+        }
+        out.extend_from_slice(&next);
+        level = next;
+        size = half;
+    }
+    out
+}
+
+/// Whether every texture of the rider's board is painted into this map's
+/// images, so drawing it shows the board and not the last one.
+fn painted(rider: &Rider, handles: &HashMap<String, Handle<Image>>) -> bool {
+    !rider.textures.is_empty()
+        && rider.textures.iter().all(|(material, _)| {
+            handles
+                .get(&format!("{material}/diffuse"))
+                .is_some_and(|handle| rider.painted.get(material) == Some(&handle.id()))
+        })
+}
+
+/// Riding wears the board: what the local skater did, gathered and handed
+/// to the wear every few seconds, and saved now and then.
+#[derive(Resource, Default)]
+pub(crate) struct BoardWear {
+    usage: skate_boards::wear::Usage,
+    landings: Option<u32>,
+    reported_at: f32,
+    saved_at: f32,
+    riding: bool,
+}
+
+const REPORT_SECONDS: f32 = 2.;
+const SAVE_SECONDS: f32 = 30.;
+
+pub(crate) fn wear_boards(time: Res<Time>, mode: Res<frame::SkateMode>, mut wear: ResMut<BoardWear>) {
+    let now = time.elapsed_secs();
+    if !mode.active {
+        if wear.riding {
+            wear.riding = false;
+            report(&mut wear, now);
+            assets::bot_model::save_board_wear();
+            wear.saved_at = now;
+        }
+        wear.landings = None;
+        return;
+    }
+    wear.riding = true;
+    let dt = time.delta_secs().min(0.25);
+    let b = mode.board;
+    match mode.status.as_str() {
+        "GrindFiftyFifty" | "GrindFiveO" | "GrindBackslash" => wear.usage.truck_grind += dt,
+        "GrindBoardslide" | "GrindTipslide" | "GrindDarkslide" => wear.usage.deck_slide += dt,
+        "SlideGround" => wear.usage.powerslide += dt,
+        _ => {}
+    }
+    if b.wheels_down > 0 && !skate_rules::on_foot(&mode.status) {
+        wear.usage.rolled += b.speed * dt;
+    }
+    let score = &mode.score;
+    match wear.landings {
+        Some(seen) if seen != score.landings => {
+            if score.bailed {
+                wear.usage.bails += 1;
+            } else {
+                wear.usage.landings += 1;
+            }
+        }
+        _ => {}
+    }
+    wear.landings = Some(score.landings);
+    if now - wear.reported_at >= REPORT_SECONDS {
+        report(&mut wear, now);
+    }
+    if now - wear.saved_at >= SAVE_SECONDS {
+        wear.saved_at = now;
+        assets::bot_model::save_board_wear();
+    }
+}
+
+fn report(wear: &mut BoardWear, now: f32) {
+    wear.reported_at = now;
+    let usage = std::mem::take(&mut wear.usage);
+    if usage != skate_boards::wear::Usage::default()
+        && assets::bot_model::wear_board(&assets::bot_model::active_board_choice(), &usage)
+    {
+        diag::info!(World, "Skate: a board part wore through");
+    }
+}
diff --git a/crates/render_anim/src/skate/park.rs b/crates/render_anim/src/skate/park.rs
new file mode 100644
index 0000000..0b25f70
--- /dev/null
+++ b/crates/render_anim/src/skate/park.rs
@@ -0,0 +1,255 @@
+//! Skate 3's object dropper in the mashup: ramps, rails, ledges and boxes
+//! dropped anywhere while skating (`skate_park`). Every player's objects
+//! travel with their client to the host and on to everyone, so a park
+//! built together is skated together; the Skate engine rides them as
+//! collision with grind rails, and they are drawn with the skaters.
+
+use std::sync::{Arc, Mutex, OnceLock};
+
+use bevy::prelude::*;
+use skate_park::{Dropper, Material, ParkObject};
+
+use crate::anim::remote_body::{CpuBodyGeom, CpuSurfMeta};
+
+/// Metres in a map unit (an inch).
+pub const INCH: f32 = 0.0254;
+
+/// The local player's dropper and everyone's objects.
+#[derive(Resource, Default)]
+pub(crate) struct Park {
+    /// The dropper works in metres.
+    pub dropper: Dropper,
+    /// The objects last told to the host (map units).
+    sent: Option<Vec<ParkObject>>,
+    /// Everyone's objects (map units), and a count of their changes.
+    all: Vec<ParkObject>,
+    pub revision: u64,
+}
+
+impl Park {
+    /// This player's objects in map units.
+    pub fn mine(&self) -> Vec<ParkObject> {
+        self.dropper
+            .placed
+            .iter()
+            .map(|o| ParkObject { at: o.at.map(|v| v / INCH), ..*o })
+            .collect()
+    }
+
+    /// Everyone's objects, map units.
+    pub fn all(&self) -> &[ParkObject] {
+        &self.all
+    }
+}
+
+/// The objects' collision in Skate's space: triangles, their surfaces and
+/// rails.
+#[derive(Clone, Default)]
+pub struct ParkCollision {
+    pub triangles: Vec<[[f32; 3]; 3]>,
+    pub rails: Vec<Vec<[f32; 3]>>,
+}
+
+pub fn collision(objects: &[ParkObject]) -> ParkCollision {
+    let to_skate = |p: [f32; 3]| super::collision::to_skate(Vec3::from_array(p)).to_array();
+    let mut out = ParkCollision::default();
+    for object in objects.iter().filter(|o| o.valid()) {
+        let shape = object.placed(INCH);
+        out.triangles.extend(shape.triangles.iter().map(|t| t.points.map(to_skate)));
+        out.rails.extend(shape.rails.iter().map(|r| r.iter().map(|p| to_skate(*p)).collect()));
+    }
+    out
+}
+
+/// Gathers everyone's objects and tells the host about this player's.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn sync_park(
+    local: Res<net::LocalPresentClient>,
+    presented: Res<net::PresentedSnapshot>,
+    mut park: ResMut<Park>,
+    mut authority: Option<ResMut<net::AuthorityWorld>>,
+    mut inbox: Option<ResMut<net::ClientActionInbox>>,
+    mut ids: Option<ResMut<net::ActionRequestIds>>,
+) {
+    let mine = park.mine();
+    if park.sent.as_ref() != Some(&mine) {
+        let message = sim::SkatePark::from_list(&mine);
+        let sent = if let Some(authority) = authority.as_deref_mut() {
+            authority.0.apply_skate_park(local.0, &message);
+            true
+        } else if let (Some(inbox), Some(ids)) = (inbox.as_deref_mut(), ids.as_deref_mut()) {
+            let action = sim::ClientAction::SkatePark { request_id: ids.allocate(), park: message };
+            inbox.push(local.0, action).map_err(|e| diag::warn!(World, "Skate park not queued: {e}")).is_ok()
+        } else {
+            false
+        };
+        if sent || park.sent.is_none() && mine.is_empty() {
+            park.sent = Some(mine.clone());
+        }
+    }
+    let mut all = mine;
+    if let Some(snapshot) = presented.snapshot() {
+        for (id, _) in &snapshot.players {
+            if *id == local.0 {
+                continue;
+            }
+            if let Some(meta) = snapshot.meta.for_client(*id) {
+                all.extend(meta.park.iter().copied().filter(ParkObject::valid));
+            }
+        }
+    }
+    if all != park.all {
+        park.all = all;
+        park.revision = park.revision.wrapping_add(1);
+    }
+    let ghost = park
+        .dropper
+        .open
+        .then(|| {
+            let g = park.dropper.ghost();
+            ParkObject { at: g.at.map(|v| v / INCH), ..g }
+        });
+    publish_geometry(&park.all, ghost, park.revision);
+}
+
+/// The objects to draw, built when they change.
+struct Drawn {
+    key: (u64, Option<[u32; 5]>),
+    geom: Arc<CpuBodyGeom>,
+    origin: [f32; 3],
+    revision: u64,
+}
+
+fn drawn() -> &'static Mutex<Option<Drawn>> {
+    static DRAWN: OnceLock<Mutex<Option<Drawn>>> = OnceLock::new();
+    DRAWN.get_or_init(Default::default)
+}
+
+fn publish_geometry(objects: &[ParkObject], ghost: Option<ParkObject>, revision: u64) {
+    let key = (revision, ghost.map(|g| [g.kind as u32, g.at[0].to_bits(), g.at[1].to_bits(), g.at[2].to_bits(), g.yaw.to_bits()]));
+    let Ok(mut slot) = drawn().lock() else { return };
+    if slot.as_ref().is_some_and(|d| d.key == key) {
+        return;
+    }
+    let mut all: Vec<ParkObject> = objects.to_vec();
+    all.extend(ghost);
+    if all.is_empty() {
+        *slot = None;
+        return;
+    }
+    let geom = geometry(&all);
+    let mut centre = Vec3::ZERO;
+    for object in &all {
+        centre += Vec3::from_array(object.at);
+    }
+    centre /= all.len() as f32;
+    let next = slot.as_ref().map_or(1, |d| d.revision.wrapping_add(1));
+    *slot = Some(Drawn { key, geom: Arc::new(geom), origin: centre.to_array(), revision: next });
+}
+
+/// The dropped objects to draw this frame: geometry in map space, where to
+/// light it, and a count of its changes.
+pub fn to_draw() -> Option<(Arc<CpuBodyGeom>, [f32; 3], u64)> {
+    let slot = drawn().lock().ok()?;
+    slot.as_ref().map(|d| (Arc::clone(&d.geom), d.origin, d.revision))
+}
+
+/// The scene key the objects draw under: past any entity number.
+pub const SCENE_KEY: u32 = 4000;
+
+fn pack_unit(n: Vec3) -> [u8; 4] {
+    let n = n.normalize_or(Vec3::Z);
+    [(n.x * 127. + 127.5) as u8, (n.y * 127. + 127.5) as u8, (n.z * 127. + 127.5) as u8, 63]
+}
+
+/// The objects as one mesh in map space, a surface per material, with
+/// texture coordinates a metre to a tile, laid along each face.
+fn geometry(objects: &[ParkObject]) -> CpuBodyGeom {
+    let mut geom = CpuBodyGeom::default();
+    for (material, name) in [Material::Concrete, Material::Wood, Material::Metal].into_iter().zip(assets::bot_model::PARK_MATERIALS) {
+        let index_start = geom.indices.len() as u32;
+        for object in objects {
+            let shape = object.placed(INCH);
+            // The same shape unturned, in metres about the object: its
+            // texture is laid from it, so the numbers stay small (16-bit
+            // texture coordinates far out in a map are metres apart, and
+            // a face would show one flat colour) and the grain turns with
+            // the object.
+            let own = ParkObject { kind: object.kind, at: [0.; 3], yaw: 0. }.placed(1.);
+            for (t, local) in shape.triangles.iter().zip(&own.triangles).filter(|(t, _)| t.material == material) {
+                let n = Vec3::from_array(t.normal);
+                let ln = Vec3::from_array(local.normal);
+                let base = geom.packed.len() as u32;
+                for (p, lp) in t.points.into_iter().zip(local.points) {
+                    let metres = Vec3::from_array(lp);
+                    // Lay the texture on the plane the face mostly faces.
+                    let uv = if ln.z.abs() >= ln.x.abs() && ln.z.abs() >= ln.y.abs() {
+                        [metres.x, metres.y]
+                    } else if ln.x.abs() >= ln.y.abs() {
+                        [metres.y, metres.z]
+                    } else {
+                        [metres.x, metres.z]
+                    };
+                    let mut packed = [0; asset_iw4::size::GFX_PACKED_VERTEX];
+                    for (i, f) in p.iter().enumerate() {
+                        packed[i * 4..i * 4 + 4].copy_from_slice(&f.to_le_bytes());
+                    }
+                    packed[12..16].copy_from_slice(&1f32.to_le_bytes());
+                    packed[16..20].fill(255);
+                    let u = half::f16::from_f32(uv[0]).to_bits();
+                    let v = half::f16::from_f32(uv[1]).to_bits();
+                    packed[20..24].copy_from_slice(&((u32::from(u) << 16) | u32::from(v)).to_le_bytes());
+                    packed[24..28].copy_from_slice(&pack_unit(n));
+                    packed[28..32].copy_from_slice(&pack_unit(n.any_orthonormal_vector()));
+                    geom.packed.push(packed);
+                }
+                // The engine winds the other way round.
+                geom.indices.extend([base, base + 2, base + 1]);
+            }
+        }
+        let index_count = geom.indices.len() as u32 - index_start;
+        if index_count > 0 {
+            geom.surfaces.push(CpuSurfMeta { index_start, index_count, name: Some(name.to_owned()) });
+        }
+    }
+    geom.decoded_n = geom.packed.len();
+    geom
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn far_out_objects_keep_their_texture() {
+        let geom = geometry(&[ParkObject { kind: 0, at: [90_000., -70_000., 300.], yaw: 2. }]);
+        let uvs: Vec<[f32; 2]> = geom
+            .packed
+            .iter()
+            .map(|p| {
+                let packed = u32::from_le_bytes(p[20..24].try_into().unwrap());
+                [half::f16::from_bits((packed >> 16) as u16).to_f32(), half::f16::from_bits(packed as u16).to_f32()]
+            })
+            .collect();
+        assert!(uvs.iter().all(|uv| uv[0].abs() < 20. && uv[1].abs() < 20.), "{uvs:?}");
+        // Faces do not collapse to one point of the texture.
+        let spread = uvs.iter().map(|uv| uv[0]).fold(f32::NEG_INFINITY, f32::max) - uvs.iter().map(|uv| uv[0]).fold(f32::INFINITY, f32::min);
+        assert!(spread > 0.5);
+    }
+
+    #[test]
+    fn objects_become_a_mesh_and_collision() {
+        let objects = [
+            ParkObject { kind: 0, at: [100., 0., 0.], yaw: 0. },
+            ParkObject { kind: 4, at: [-100., 0., 0.], yaw: 1. },
+        ];
+        let geom = geometry(&objects);
+        assert_eq!(geom.decoded_n, geom.packed.len());
+        assert_eq!(geom.surfaces.len(), 2, "wood and metal");
+        assert!(geom.indices.iter().all(|i| (*i as usize) < geom.decoded_n));
+        let c = collision(&objects);
+        assert!(!c.triangles.is_empty() && c.rails.len() == 1);
+        // In Skate's space (metres, y up) the rail is above the ground.
+        assert!(c.rails[0].iter().all(|p| p[1] > 0.3));
+    }
+}
