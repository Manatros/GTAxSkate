+/// Readies a match's scripts for the Minecraft world: adds its scoring
+/// script, and drops the stand-in map's kill volumes. Those `trigger_hurt`
+/// brushes sit where the stand-in map's pits and underside are, invisible in
+/// the Minecraft world, and MW2's level script kills whoever touches one: in
+/// a cave or ravine below their height the player died on the spot.
+pub fn prepare_scripts(scripts: &mut crate::ScriptSources) {
+    scripts.insert_source(SCORE_MODULE, SCORE_SCRIPT.to_owned());
+    if let Some(entities) = scripts.entities() {
+        let kept = without_classname(entities, "trigger_hurt");
+        scripts.set_entities(kept);
+    }
+}
+
+/// An entity string without the entities of `classname`.
+fn without_classname(entities: &str, classname: &str) -> String {
+    let mut out = String::with_capacity(entities.len());
+    let mut block = String::new();
+    let (mut depth, mut quoted) = (0usize, false);
+    for c in entities.chars() {
+        if depth == 0 && c != '{' {
+            out.push(c);
+            continue;
+        }
+        block.push(c);
+        match c {
+            '"' => quoted = !quoted,
+            '{' if !quoted => depth += 1,
+            '}' if !quoted => {
+                depth -= 1;
+                if depth == 0 {
+                    let wanted = format!("\"{classname}\"");
+                    let dropped = block.lines().any(|line| {
+                        let line = line.trim();
+                        line.starts_with("\"classname\"") && line["\"classname\"".len()..].trim() == wanted
+                    });
+                    if !dropped {
+                        out.push_str(&block);
+                    }
+                    block.clear();
+                }
+            }
+            _ => {}
+        }
+    }
+    out.push_str(&block);
+    out
+}
