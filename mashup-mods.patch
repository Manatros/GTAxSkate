+//! Writes every HUD sprite onto one sheet (`sprite_sheet.png`), tinted as
+//! the HUD tints them, to look them over.
+use skate_modes::sprites::{Image, Sprite};
+
+fn main() {
+    let sprites = Sprite::all();
+    let cell = 140u32;
+    let cols = 10u32;
+    let rows = (sprites.len() as u32).div_ceil(cols);
+    let (w, h) = (cols * cell, rows * cell);
+    let mut sheet = vec![0u8; (w * h * 4) as usize];
+    for (i, p) in sheet.chunks_mut(4).enumerate() {
+        let (x, y) = (i as u32 % w, i as u32 / w);
+        let checker = ((x / 10) + (y / 10)) % 2 == 0;
+        let v = if checker { 70 } else { 90 };
+        p.copy_from_slice(&[v, v + 10, v + 30, 255]);
+    }
+    for (i, sprite) in sprites.iter().enumerate() {
+        let img = sprite.paint();
+        let tint: [f32; 3] = match sprite {
+            Sprite::Bone(_) => [1., 0.42, 0.12],
+            Sprite::Splat | Sprite::Flash => [0.92, 0.12, 0.1],
+            Sprite::MedalKill => [1., 0.78, 0.18],
+            Sprite::MedalOwn => [0.85, 0.88, 0.95],
+            Sprite::Pin | Sprite::Camera => [1., 0.78, 0.18],
+            Sprite::Vignette | Sprite::Fisheye => [0., 0., 0.],
+            _ => [1., 1., 1.],
+        };
+        let scale = (img.width.max(img.height) as f32 / (cell - 12) as f32).max(1.);
+        let (dw, dh) = ((img.width as f32 / scale) as u32, (img.height as f32 / scale) as u32);
+        let (ox, oy) = ((i as u32 % cols) * cell + (cell - dw) / 2, (i as u32 / cols) * cell + (cell - dh) / 2);
+        for y in 0..dh {
+            for x in 0..dw {
+                let sx = ((x as f32 * scale) as u32).min(img.width - 1);
+                let sy = ((y as f32 * scale) as u32).min(img.height - 1);
+                let s = &img.rgba[((sy * img.width + sx) * 4) as usize..][..4];
+                let a = f32::from(s[3]) / 255.;
+                let d = &mut sheet[(((oy + y) * w + ox + x) * 4) as usize..][..4];
+                for c in 0..3 {
+                    let src = f32::from(s[c]) * tint[c];
+                    d[c] = (src * a + f32::from(d[c]) * (1. - a)).round() as u8;
+                }
+            }
+        }
+    }
+    let png = Image { width: w, height: h, rgba: sheet }.png().unwrap();
+    let out = std::env::args().nth(1).unwrap_or_else(|| "sprite_sheet.png".into());
+    std::fs::write(&out, png).unwrap();
+    println!("{out}");
+}
