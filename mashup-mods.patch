+        let kept = without_classname(text, "trigger_hurt");
+        assert!(!kept.contains("trigger_hurt"));
+        assert!(kept.contains("worldspawn") && kept.contains("heli_start") && kept.contains("{not a brace}"));
+        assert_eq!(kept.matches('{').count(), 3, "two entities and the quoted brace: {kept}");
+    }
