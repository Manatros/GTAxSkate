@@ -0,0 +1,477 @@
+//! The replay editor, as Skate 3's: the clip plays (or scrubs with the
+//! triggers), the camera is set with keyframes along a timeline, each
+//! stretch at its own speed, a look laid over the picture, the clip
+//! trimmed and saved.
+
+use crate::filmer::{self, Key, LOOKS, Shot};
+use crate::hud::{self, Align, Anchor, Control, Item, Labels, buttons};
+use crate::replay::{Camera, Clip, Pose};
+use crate::sprites::{GRAINS, Sprite};
+
+/// The controller as the editor reads it this frame.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Pad {
+    pub pressed: u16,
+    pub held: u16,
+    pub released: u16,
+    pub lt: f32,
+    pub rt: f32,
+    pub left: [f32; 2],
+    pub right: [f32; 2],
+}
+
+/// The question on leaving.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Dialog {
+    Leave,
+}
+
+/// What the editor asks of its owner.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Request {
+    None,
+    /// Save the clip (the owner picks the file), then leave.
+    SaveAndLeave,
+    Leave,
+}
+
+/// One frame of the editor.
+pub struct Frame {
+    pub items: Vec<Item>,
+    pub camera: Camera,
+    pub pose: Option<Pose>,
+    pub request: Request,
+    /// A UI sound to play.
+    pub click: bool,
+    /// The look's colour filters.
+    pub mono: bool,
+    pub sepia: bool,
+}
+
+pub struct Editor {
+    pub clip: Clip,
+    pub t: f32,
+    pub playing: bool,
+    preview: Option<Key>,
+    /// Real seconds: when the editor opened, and when input last came.
+    opened: f64,
+    touched: f64,
+    dialog: Option<Dialog>,
+    toast: Option<(String, f64)>,
+    looks: Vec<u8>,
+    /// LB went down (for taps against LB + trigger trims) and was used.
+    lb_since: Option<f64>,
+    lb_used: bool,
+    frame: u32,
+}
+
+/// Keys this close are the same key.
+const SAME: f32 = 1. / 30.;
+const HIDE_AFTER: f64 = 2.5;
+
+impl Editor {
+    /// Opens on `clip` at its end's last seconds (the moment just skated).
+    pub fn new(clip: Clip, now: f64, colour: bool) -> Self {
+        let start = clip.trim.0;
+        let mut looks = filmer::looks(colour);
+        if !looks.contains(&clip.look) {
+            looks.push(clip.look.min(LOOKS.len() as u8 - 1));
+            looks.sort_unstable();
+            looks.dedup();
+        }
+        Self {
+            t: start,
+            playing: true,
+            clip,
+            preview: None,
+            opened: now,
+            touched: now,
+            dialog: None,
+            toast: None,
+            looks,
+            lb_since: None,
+            lb_used: false,
+            frame: 0,
+        }
+    }
+
+    fn key_index_at(&self, t: f32) -> Option<usize> {
+        self.clip.keys.iter().position(|k| (k.t - t).abs() <= SAME)
+    }
+
+    /// The framing in force now: the one being set, or the keys'.
+    pub fn current(&self) -> Key {
+        self.preview.unwrap_or_else(|| filmer::key_at(&self.clip.keys, self.t))
+    }
+
+    pub fn camera(&self) -> Camera {
+        filmer::shot(&self.clip, self.t, &self.current())
+    }
+
+    fn toast(&mut self, text: impl Into<String>, now: f64) {
+        self.toast = Some((text.into(), now));
+    }
+
+    fn put_key(&mut self, key: Key) {
+        match self.key_index_at(key.t) {
+            Some(i) => self.clip.keys[i] = key,
+            None => {
+                self.clip.keys.push(key);
+                self.clip.keys.sort_by(|a, b| a.t.total_cmp(&b.t));
+            }
+        }
+    }
+
+    /// One frame: `dt` real seconds, `now` the real clock.
+    pub fn update(&mut self, pad: Pad, dt: f32, now: f64, labels: &dyn Labels) -> Frame {
+        self.frame = self.frame.wrapping_add(1);
+        let mut request = Request::None;
+        let mut click = false;
+        let active = pad.pressed != 0 || pad.lt > 0.1 || pad.rt > 0.1 || pad.left.iter().chain(&pad.right).any(|v| v.abs() > 0.2);
+        if active {
+            self.touched = now;
+        }
+        let (start, end) = (self.clip.trim.0.max(0.), self.clip.trim.1.min(self.clip.length()).max(self.clip.trim.0));
+
+        if let Some(Dialog::Leave) = self.dialog {
+            if pad.pressed & buttons::A != 0 {
+                request = Request::SaveAndLeave;
+                click = true;
+            } else if pad.pressed & buttons::B != 0 {
+                request = Request::Leave;
+                click = true;
+            } else if pad.pressed & buttons::Y != 0 {
+                self.dialog = None;
+                click = true;
+            }
+        } else {
+            // LB: a tap jumps to the previous key; held with a trigger, it
+            // trims.
+            if pad.pressed & buttons::LB != 0 {
+                self.lb_since = Some(now);
+                self.lb_used = false;
+            }
+            let lb_held = pad.held & buttons::LB != 0;
+            if lb_held && (pad.lt > 0.5 || pad.rt > 0.5) {
+                if !self.lb_used {
+                    if pad.lt > 0.5 {
+                        self.clip.trim.0 = self.t.min(end - 0.1).max(0.);
+                        self.toast("Clip starts here", now);
+                    } else {
+                        self.clip.trim.1 = self.t.max(start + 0.1).min(self.clip.length());
+                        self.toast("Clip ends here", now);
+                    }
+                    click = true;
+                }
+                self.lb_used = true;
+            }
+            if pad.released & buttons::LB != 0 {
+                if !self.lb_used {
+                    let prev = self.clip.keys.iter().rev().find(|k| k.t < self.t - SAME).map(|k| k.t);
+                    self.t = prev.unwrap_or(start);
+                    self.playing = false;
+                    self.preview = None;
+                    click = true;
+                }
+                self.lb_since = None;
+            }
+            if pad.pressed & buttons::RB != 0 {
+                let next = self.clip.keys.iter().find(|k| k.t > self.t + SAME).map(|k| k.t);
+                self.t = next.unwrap_or(end);
+                self.playing = false;
+                self.preview = None;
+                click = true;
+            }
+            if pad.pressed & buttons::A != 0 {
+                self.playing = !self.playing;
+                if self.playing && self.t >= end - 1e-3 {
+                    self.t = start;
+                }
+                self.preview = None;
+                click = true;
+            }
+            // Scrubbing (not while trimming).
+            if !lb_held && (pad.lt > 0.05 || pad.rt > 0.05) {
+                let push = pad.rt * pad.rt - pad.lt * pad.lt;
+                self.t = (self.t + push * (1. + 3. * pad.rt.max(pad.lt)) * dt).clamp(0., self.clip.length());
+                self.playing = false;
+                self.preview = None;
+            }
+            if self.playing {
+                let speed = filmer::key_at(&self.clip.keys, self.t).speed.max(0.05);
+                self.t += dt * speed;
+                if self.t >= end {
+                    self.t = start;
+                }
+            }
+            if pad.pressed & buttons::X != 0 {
+                let key = Key { t: self.t, ..self.current() };
+                self.put_key(key);
+                self.preview = None;
+                self.toast("Keyframe set", now);
+                click = true;
+            }
+            if pad.pressed & buttons::BACK != 0 {
+                match self.key_index_at(self.t) {
+                    Some(i) => {
+                        self.clip.keys.remove(i);
+                        self.toast("Keyframe removed", now);
+                    }
+                    None => self.toast("No keyframe here", now),
+                }
+                self.preview = None;
+                click = true;
+            }
+            if pad.pressed & buttons::Y != 0 {
+                let here = self.key_index_at(self.t);
+                let base = here.map(|i| self.clip.keys[i]).unwrap_or_else(|| self.current());
+                let mut key = base.with_shot(base.shot.next());
+                key.t = self.t;
+                if key.shot == Shot::Free {
+                    key = Key { speed: base.speed, ..filmer::free_from(&self.camera(), self.t) };
+                }
+                match here {
+                    Some(i) => self.clip.keys[i] = key,
+                    None => self.preview = Some(key),
+                }
+                self.playing = false;
+                click = true;
+            }
+            if pad.pressed & buttons::LS != 0 {
+                let here = self.key_index_at(self.t);
+                let mut key = here.map(|i| self.clip.keys[i]).unwrap_or_else(|| self.current());
+                key.speed = filmer::next_speed(key.speed);
+                key.t = self.t;
+                match here {
+                    Some(i) => self.clip.keys[i] = key,
+                    None => self.preview = Some(key),
+                }
+                self.toast(format!("Speed {}", filmer::speed_name(key.speed)), now);
+                click = true;
+            }
+            if pad.pressed & buttons::RS != 0 && !self.looks.is_empty() {
+                let i = self.looks.iter().position(|l| *l == self.clip.look).unwrap_or(0);
+                self.clip.look = self.looks[(i + 1) % self.looks.len()];
+                self.toast(format!("Look: {}", LOOKS[usize::from(self.clip.look)].name), now);
+                click = true;
+            }
+            // The sticks set the framing while paused.
+            let moving = pad.left.iter().chain(&pad.right).any(|v| v.abs() > 0.15);
+            if moving && !self.playing {
+                let mut key = self.current();
+                key.t = self.t;
+                filmer::steer(&mut key, pad.left, pad.right, dt);
+                self.preview = Some(key);
+            }
+            if pad.pressed & buttons::B != 0 {
+                self.dialog = Some(Dialog::Leave);
+                self.playing = false;
+                click = true;
+            }
+        }
+
+        let camera = self.camera();
+        let pose = self.clip.pose(self.t);
+        let look = LOOKS[usize::from(self.clip.look).min(LOOKS.len() - 1)];
+        let items = self.draw(now, labels);
+        Frame { items, camera, pose, request, click, mono: look.mono, sepia: look.sepia }
+    }
+
+    fn draw(&self, now: f64, labels: &dyn Labels) -> Vec<Item> {
+        let mut items = Vec::new();
+        let look = LOOKS[usize::from(self.clip.look).min(LOOKS.len() - 1)];
+        let key = self.current();
+        // The look's overlays.
+        if look.barrel && key.shot == Shot::Fisheye {
+            items.push(Item::Screen { sprite: Sprite::Fisheye, color: hud::BLACK });
+        }
+        if look.vignette > 0. {
+            items.push(Item::Screen { sprite: Sprite::Vignette, color: [0., 0., 0., look.vignette] });
+        }
+        if look.grain > 0. {
+            let g = (self.frame / 2 % u32::from(GRAINS)) as u8;
+            items.push(Item::Screen { sprite: Sprite::Grain(g), color: [1., 1., 1., look.grain] });
+        }
+        if look.letterbox > 0. {
+            let bar = 480. * look.letterbox;
+            items.push(Item::rect(Anchor::Center, -2000., 0., 4000., bar, hud::BLACK));
+            items.push(Item::rect(Anchor::Center, -2000., 480. - bar, 4000., bar, hud::BLACK));
+        }
+        if look.rec {
+            let c = [1., 1., 1., 0.85];
+            for (i, (anchor, x, y)) in [(Anchor::Left, 24., 20.), (Anchor::Right, -56., 20.), (Anchor::Left, 24., 428.), (Anchor::Right, -56., 428.)]
+                .into_iter()
+                .enumerate()
+            {
+                items.push(Item::sprite(Sprite::Corner(i as u8), anchor, x, y, 32., 32., c));
+            }
+            if (now * 1.2).fract() < 0.6 {
+                items.push(Item::sprite(Sprite::Dot, Anchor::Left, 46., 38., 12., 12., [1., 0.1, 0.1, 1.]));
+            }
+            items.push(Item::digits("REC", Anchor::Left, 62., 37., 14., Align::Left, c));
+            items.push(Item::digits("SP", Anchor::Right, -50., 37., 14., Align::Right, c));
+            items.push(Item::digits(format!("00:{}", hud::timecode(self.t)), Anchor::Right, -50., 410., 14., Align::Right, c));
+        }
+
+        // The editor's panel hides while playing undisturbed.
+        let idle = (now - self.touched) as f32;
+        let shown = if self.playing && self.dialog.is_none() { 1. - ((idle - HIDE_AFTER as f32) / 0.4).clamp(0., 1.) } else { 1. };
+        let open = ((now - self.opened) as f32 / 0.25).clamp(0., 1.);
+        let a = shown * open;
+        if a > 0. {
+            let mut ui = Vec::new();
+            ui.push(Item::sprite(Sprite::Camera, Anchor::Left, 26., 62., 28., 28., hud::SKATE_YELLOW));
+            ui.push(Item::title("REPLAY EDITOR", Anchor::Left, 60., 66., 20., Align::Left, hud::SKATE_YELLOW));
+            let (px, py, pw, ph) = (-410., 380., 820., 96.);
+            ui.push(Item::rect(Anchor::Center, px, py, pw, ph, hud::PANEL));
+            // Shot, speed and look.
+            let state = if self.playing { Sprite::Play } else { Sprite::Pause };
+            ui.push(Item::sprite(state, Anchor::Center, px + 12., py + 8., 18., 18., hud::WHITE));
+            let mut what = format!("{}   {}   {}", key.shot.name(), filmer::speed_name(key.speed), look.name);
+            if self.preview.is_some() {
+                what.push_str("   (X to keep)");
+            }
+            ui.push(Item::text(what, Anchor::Center, px + 38., py + 10., 13., Align::Left, hud::WHITE));
+            ui.push(Item::digits(
+                format!("{} / {}", hud::timecode(self.t), hud::timecode(self.clip.length())),
+                Anchor::Center,
+                px + pw - 12.,
+                py + 9.,
+                14.,
+                Align::Right,
+                hud::WHITE,
+            ));
+            // The timeline: the clip, the part kept, keys, the playhead.
+            let (tx, ty, tw, th) = (px + 14., py + 36., pw - 28., 10.);
+            let length = self.clip.length().max(0.01);
+            let at = |t: f32| tx + tw * (t / length).clamp(0., 1.);
+            ui.push(Item::rect(Anchor::Center, tx, ty, tw, th, [1., 1., 1., 0.12]));
+            let (s, e) = self.clip.trim;
+            ui.push(Item::rect(Anchor::Center, at(s), ty, at(e) - at(s), th, [1., 0.78, 0.18, 0.35]));
+            for k in &self.clip.keys {
+                let color = match k.shot {
+                    Shot::Follow => hud::WHITE,
+                    Shot::Fisheye => hud::SKATE_YELLOW,
+                    Shot::LongLens => hud::COOL_BLUE,
+                    Shot::Tripod => hud::GOOD_GREEN,
+                    Shot::Free => [0.9, 0.5, 1., 1.],
+                    Shot::Game => [0.7, 0.7, 0.7, 1.],
+                };
+                ui.push(Item::sprite(Sprite::Diamond, Anchor::Center, at(k.t) - 6., ty - 1., 12., 12., color));
+            }
+            ui.push(Item::rect(Anchor::Center, at(self.t) - 1., ty - 6., 2., th + 12., hud::WHITE));
+            ui.push(Item::sprite(Sprite::Playhead, Anchor::Center, at(self.t) - 7., ty - 18., 14., 14., hud::WHITE));
+            let hints: Vec<(Control, &str)> = if self.playing {
+                vec![
+                    (Control::Button(buttons::A), "Pause"),
+                    (Control::RightTrigger, "Scrub"),
+                    (Control::Button(buttons::Y), "Camera"),
+                    (Control::Button(buttons::RS), "Look"),
+                    (Control::Button(buttons::B), "Done"),
+                ]
+            } else {
+                vec![
+                    (Control::Button(buttons::A), "Play"),
+                    (Control::RightStick, "Aim"),
+                    (Control::LeftStick, "Zoom/Fly"),
+                    (Control::Button(buttons::X), "Key"),
+                    (Control::Button(buttons::Y), "Camera"),
+                    (Control::Button(buttons::LS), "Speed"),
+                    (Control::Button(buttons::LB), "Prev"),
+                    (Control::Button(buttons::RB), "Next"),
+                    (Control::Button(buttons::BACK), "Delete"),
+                ]
+            };
+            ui.extend(hud::hints(labels, &hints, Anchor::Center, 0., py + 58., 11.));
+            if !self.playing {
+                ui.push(Item::text("Hold LB + LT / RT: clip starts / ends here", Anchor::Center, 0., py + 78., 9., Align::Center, [0.8, 0.8, 0.85, 1.]));
+            }
+            items.extend(ui.into_iter().map(|i| i.faded(a)));
+        }
+        if let Some((text, at)) = &self.toast {
+            let age = (now - at) as f32;
+            if age < 1.6 {
+                items.push(Item::title(text.clone(), Anchor::Center, 0., 340., 16., Align::Center, hud::alpha(hud::SKATE_YELLOW, hud::fade(age, 1.6))));
+            }
+        }
+        if self.dialog == Some(Dialog::Leave) {
+            items.push(Item::rect(Anchor::Center, -180., 170., 360., 110., hud::PANEL));
+            items.push(Item::rect(Anchor::Center, -180., 170., 360., 4., hud::SKATE_YELLOW));
+            items.push(Item::title("SAVE THIS CLIP?", Anchor::Center, 0., 188., 20., Align::Center, hud::WHITE));
+            items.extend(hud::hints(
+                labels,
+                &[(Control::Button(buttons::A), "Save"), (Control::Button(buttons::B), "Don't save"), (Control::Button(buttons::Y), "Keep editing")],
+                Anchor::Center,
+                0.,
+                240.,
+                12.,
+            ));
+        }
+        items
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::hud::PadLabels;
+    use crate::replay::tests::rolling;
+
+    fn press(b: u16) -> Pad {
+        Pad { pressed: b, held: b, ..Default::default() }
+    }
+
+    #[test]
+    fn plays_scrubs_keys_trims_and_leaves() {
+        let clip = rolling(4.).clip("").unwrap();
+        let mut e = Editor::new(clip, 0., false);
+        let f = e.update(Pad::default(), 0.5, 0.1, &PadLabels);
+        assert!(e.playing && (e.t - 0.5).abs() < 1e-4);
+        assert!(f.pose.is_some());
+        // Pause, scrub forward, set a fisheye key at 1.5 s.
+        e.update(press(buttons::A), 0.016, 0.2, &PadLabels);
+        assert!(!e.playing);
+        let before = e.t;
+        e.update(Pad { rt: 1., ..Default::default() }, 0.25, 0.3, &PadLabels);
+        assert!(e.t > before + 0.9);
+        e.t = 1.5;
+        e.update(press(buttons::Y), 0.016, 0.4, &PadLabels);
+        assert_eq!(e.current().shot, Shot::Fisheye);
+        e.update(press(buttons::X), 0.016, 0.5, &PadLabels);
+        assert_eq!(e.clip.keys.len(), 1);
+        assert_eq!(e.clip.keys[0].shot, Shot::Fisheye);
+        // Speed on the key, then aim it.
+        e.update(press(buttons::LS), 0.016, 0.6, &PadLabels);
+        assert_eq!(e.clip.keys[0].speed, 0.5);
+        e.update(Pad { right: [1., 0.], ..Default::default() }, 0.1, 0.7, &PadLabels);
+        assert!(e.current().yaw != 0.);
+        // Trim with LB held and the left trigger.
+        e.t = 1.;
+        e.update(Pad { pressed: buttons::LB, held: buttons::LB, ..Default::default() }, 0.016, 0.8, &PadLabels);
+        e.update(Pad { held: buttons::LB, lt: 1., ..Default::default() }, 0.016, 0.81, &PadLabels);
+        e.update(Pad { released: buttons::LB, ..Default::default() }, 0.016, 0.82, &PadLabels);
+        assert_eq!(e.clip.trim.0, 1.);
+        assert_eq!(e.t, 1., "trimming does not jump to a key");
+        // RB goes to the next key; Back deletes it.
+        e.update(press(buttons::RB), 0.016, 0.9, &PadLabels);
+        assert!((e.t - 1.5).abs() < 1e-4);
+        e.update(press(buttons::BACK), 0.016, 1.0, &PadLabels);
+        assert!(e.clip.keys.is_empty());
+        // B asks, A saves.
+        e.update(press(buttons::B), 0.016, 1.1, &PadLabels);
+        let f = e.update(press(buttons::A), 0.016, 1.2, &PadLabels);
+        assert_eq!(f.request, Request::SaveAndLeave);
+    }
+
+    #[test]
+    fn the_panel_hides_while_playing() {
+        let clip = rolling(10.).clip("").unwrap();
+        let mut e = Editor::new(clip, 0., true);
+        let early = e.update(Pad::default(), 0.016, 1., &PadLabels).items.len();
+        let late = e.update(Pad::default(), 0.016, 5., &PadLabels).items.len();
+        assert!(late < early);
+        e.clip.look = 1;
+        let filmer = e.update(Pad::default(), 0.016, 5.1, &PadLabels).items;
+        assert!(filmer.iter().any(|i| matches!(i, Item::Text { text, .. } if text == "REC")));
+    }
+}
diff --git a/crates/skate_modes/src/filmer.rs b/crates/skate_modes/src/filmer.rs
new file mode 100644
index 0000000..55c2aff
--- /dev/null
+++ b/crates/skate_modes/src/filmer.rs
@@ -0,0 +1,355 @@
+//! The replay editor's cameras: the shots a skate filmer takes (following
+//! behind, the low fisheye beside the board, a long lens from across the
+//! street, a tripod, a free camera, or the game's own camera), keyframed
+//! along the clip, with the playback speed of each stretch and the looks
+//! laid over the picture.
+
+use crate::math::{self, V3, add, direction, lerp, lerp_angle, lerp_f, look_basis, normalize_or, scale, smooth, sub, yaw_pitch};
+use crate::replay::{Camera, Clip, Reader, put_f32};
+
+/// A kind of shot.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Shot {
+    Follow,
+    Fisheye,
+    LongLens,
+    Tripod,
+    Free,
+    Game,
+}
+
+impl Shot {
+    pub const ALL: [Self; 6] = [Self::Follow, Self::Fisheye, Self::LongLens, Self::Tripod, Self::Free, Self::Game];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Follow => "FOLLOW CAM",
+            Self::Fisheye => "FISHEYE",
+            Self::LongLens => "LONG LENS",
+            Self::Tripod => "TRIPOD",
+            Self::Free => "FREE CAM",
+            Self::Game => "GAME CAM",
+        }
+    }
+
+    pub fn next(self) -> Self {
+        let i = Self::ALL.iter().position(|s| *s == self).unwrap_or(0);
+        Self::ALL[(i + 1) % Self::ALL.len()]
+    }
+
+    fn code(self) -> u8 {
+        Self::ALL.iter().position(|s| *s == self).unwrap_or(0) as u8
+    }
+
+    fn from_code(code: u8) -> Option<Self> {
+        Self::ALL.get(usize::from(code)).copied()
+    }
+
+    /// The pitch a shot starts with (radians; up is positive).
+    fn pitch(self) -> f32 {
+        match self {
+            Self::Follow => 0.28,
+            Self::Fisheye => -0.22,
+            Self::LongLens => 0.06,
+            Self::Tripod => 0.12,
+            Self::Free | Self::Game => 0.,
+        }
+    }
+}
+
+/// A keyframe: from time `t` the camera takes this shot, its stretch plays
+/// at `speed`, and with `blend` the camera eases into the next key (of the
+/// same shot) rather than cutting.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Key {
+    pub t: f32,
+    pub shot: Shot,
+    pub speed: f32,
+    /// Orbit about the skater (follow, fisheye, long lens, tripod), or the
+    /// look direction (free cam).
+    pub yaw: f32,
+    pub pitch: f32,
+    /// Distance (or the long lens's reach) scale.
+    pub zoom: f32,
+    /// Where a free camera (or a placed tripod) stands.
+    pub position: Option<V3>,
+    pub blend: bool,
+}
+
+impl Key {
+    pub fn new(t: f32, shot: Shot) -> Self {
+        Self { t, shot, speed: 1., yaw: 0., pitch: shot.pitch(), zoom: 1., position: None, blend: true }
+    }
+
+    /// The key with another shot, its framing reset.
+    pub fn with_shot(self, shot: Shot) -> Self {
+        Self { shot, pitch: shot.pitch(), yaw: 0., zoom: 1., position: None, ..self }
+    }
+
+    pub(crate) fn write(&self, out: &mut Vec<u8>) {
+        put_f32(out, self.t);
+        out.push(self.shot.code());
+        put_f32(out, self.speed);
+        put_f32(out, self.yaw);
+        put_f32(out, self.pitch);
+        put_f32(out, self.zoom);
+        match self.position {
+            None => out.push(0),
+            Some(p) => {
+                out.push(1);
+                for v in p {
+                    put_f32(out, v);
+                }
+            }
+        }
+        out.push(u8::from(self.blend));
+    }
+
+    pub(crate) fn read(r: &mut Reader<'_>) -> Option<Self> {
+        let t = r.f32()?;
+        let shot = Shot::from_code(r.u8()?)?;
+        let speed = r.f32()?;
+        let yaw = r.f32()?;
+        let pitch = r.f32()?;
+        let zoom = r.f32()?;
+        let position = match r.u8()? {
+            0 => None,
+            _ => Some([r.f32()?, r.f32()?, r.f32()?]),
+        };
+        let blend = r.u8()? != 0;
+        Some(Self { t, shot, speed, yaw, pitch, zoom, position, blend })
+    }
+
+    /// This key eased `f` of the way to `next`.
+    fn mix(&self, next: &Self, f: f32) -> Self {
+        Self {
+            t: self.t,
+            shot: self.shot,
+            speed: lerp_f(self.speed, next.speed, f),
+            yaw: lerp_angle(self.yaw, next.yaw, f),
+            pitch: lerp_f(self.pitch, next.pitch, f),
+            zoom: lerp_f(self.zoom, next.zoom, f),
+            position: match (self.position, next.position) {
+                (Some(a), Some(b)) => Some(lerp(a, b, f)),
+                (a, b) => a.or(b),
+            },
+            blend: self.blend,
+        }
+    }
+}
+
+/// The speeds a stretch can play at.
+pub const SPEEDS: [f32; 6] = [1., 0.5, 0.25, 0.1, 2., 4.];
+
+pub fn next_speed(speed: f32) -> f32 {
+    let i = SPEEDS.iter().position(|s| (s - speed).abs() < 1e-3).unwrap_or(0);
+    SPEEDS[(i + 1) % SPEEDS.len()]
+}
+
+/// "0.25x".
+pub fn speed_name(speed: f32) -> String {
+    if (speed - speed.round()).abs() < 1e-3 { format!("{speed:.0}x") } else { format!("{speed}x") }
+}
+
+/// A look laid over the picture.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Look {
+    pub name: &'static str,
+    pub vignette: f32,
+    pub letterbox: f32,
+    pub grain: f32,
+    /// A camcorder's frame: corners, REC and the timecode.
+    pub rec: bool,
+    /// The fisheye's barrel on fisheye shots.
+    pub barrel: bool,
+    /// Colour filters only one game can draw.
+    pub mono: bool,
+    pub sepia: bool,
+}
+
+pub const LOOKS: [Look; 5] = [
+    Look { name: "CLEAN", vignette: 0., letterbox: 0., grain: 0., rec: false, barrel: false, mono: false, sepia: false },
+    Look { name: "FILMER", vignette: 0.45, letterbox: 0., grain: 0.3, rec: true, barrel: true, mono: false, sepia: false },
+    Look { name: "CINEMA", vignette: 0.35, letterbox: 0.12, grain: 0.1, rec: false, barrel: false, mono: false, sepia: false },
+    Look { name: "OLD FILM", vignette: 0.85, letterbox: 0., grain: 0.7, rec: false, barrel: true, mono: false, sepia: true },
+    Look { name: "BLACK & WHITE", vignette: 0.55, letterbox: 0., grain: 0.35, rec: false, barrel: true, mono: true, sepia: false },
+];
+
+/// The looks a game can show (without colour filters, the ones needing
+/// them are left out).
+pub fn looks(colour: bool) -> Vec<u8> {
+    (0..LOOKS.len() as u8).filter(|i| colour || !(LOOKS[usize::from(*i)].mono || LOOKS[usize::from(*i)].sepia)).collect()
+}
+
+/// The key in force at `t` (eased towards the next), or the default
+/// follow camera.
+pub fn key_at(keys: &[Key], t: f32) -> Key {
+    let Some(first) = keys.first() else { return Key::new(0., Shot::Follow) };
+    let i = keys.partition_point(|k| k.t <= t);
+    if i == 0 {
+        return *first;
+    }
+    let k = keys[i - 1];
+    match keys.get(i) {
+        Some(n) if n.shot == k.shot && k.blend && n.t > k.t => k.mix(n, smooth((t - k.t) / (n.t - k.t))),
+        _ => k,
+    }
+}
+
+/// The subject averaged over `window` seconds, so a camera does not shake
+/// with every trick.
+fn steady(clip: &Clip, t: f32, window: f32) -> Option<V3> {
+    let mut sum = [0.; 3];
+    for k in -2..=2 {
+        sum = add(sum, clip.subject(t + k as f32 * window / 4.)?);
+    }
+    Some(scale(sum, 0.2))
+}
+
+/// The way the skater travels at `t` (yaw about Skate's up).
+fn travel(clip: &Clip, t: f32) -> f32 {
+    let v = clip.velocity(t, 1.2);
+    if v[0].hypot(v[2]) > 0.4 {
+        return v[0].atan2(v[2]);
+    }
+    // Standing still: along the clip's overall travel.
+    let whole = sub(clip.subject(clip.length()).unwrap_or([0.; 3]), clip.subject(0.).unwrap_or([0.; 3]));
+    if whole[0].hypot(whole[2]) > 0.4 { whole[0].atan2(whole[2]) } else { 0. }
+}
+
+fn looking(position: V3, target: V3, fov: f32) -> Camera {
+    Camera { position, basis: look_basis(sub(target, position)), fov }
+}
+
+/// Where the camera is at clip time `t` for `key`.
+pub fn shot(clip: &Clip, t: f32, key: &Key) -> Camera {
+    let up = [0., 1., 0.];
+    let subject = steady(clip, t, 0.3).unwrap_or([0.; 3]);
+    let target = add(subject, scale(up, 0.25));
+    match key.shot {
+        Shot::Follow => {
+            let yaw = travel(clip, t) + std::f32::consts::PI + key.yaw;
+            let position = add(target, scale(direction(yaw, key.pitch), 3.6 * key.zoom));
+            looking(position, target, 62.)
+        }
+        Shot::Fisheye => {
+            let close = steady(clip, t, 0.15).unwrap_or(subject);
+            let yaw = travel(clip, t) + std::f32::consts::PI * 0.68 + key.yaw;
+            let position = add(close, scale(direction(yaw, key.pitch), 1.9 * key.zoom));
+            looking(position, add(close, scale(up, -0.1)), 108.)
+        }
+        Shot::LongLens | Shot::Tripod => {
+            let position = key.position.unwrap_or_else(|| {
+                let at = steady(clip, key.t, 1.).unwrap_or(subject);
+                let (side, reach, rise) = match key.shot {
+                    Shot::LongLens => (std::f32::consts::FRAC_PI_2, 18., 1.2),
+                    _ => (std::f32::consts::PI * 0.75, 6., 0.6),
+                };
+                let yaw = travel(clip, key.t) + side + key.yaw;
+                add(add(at, scale(direction(yaw, key.pitch), reach * key.zoom)), scale(up, rise))
+            });
+            let fov = match key.shot {
+                Shot::LongLens => (2. * (1.8 / math::distance(position, target).max(1.)).atan()).to_degrees().clamp(6., 40.),
+                _ => 55.,
+            };
+            looking(position, target, fov)
+        }
+        Shot::Free => {
+            let position = key.position.unwrap_or_else(|| add(target, [0., 1.5, -4.]));
+            let forward = direction(key.yaw, key.pitch);
+            Camera { position, basis: look_basis(forward), fov: (60. / key.zoom.max(0.3)).clamp(20., 110.) }
+        }
+        Shot::Game => clip
+            .pose(t)
+            .and_then(|p| p.camera)
+            .unwrap_or_else(|| shot(clip, t, &Key { shot: Shot::Follow, pitch: Shot::Follow.pitch(), ..*key })),
+    }
+}
+
+/// A free camera's key from where a camera is now.
+pub fn free_from(camera: &Camera, t: f32) -> Key {
+    let (yaw, pitch) = yaw_pitch(camera.basis[2]);
+    Key { position: Some(camera.position), yaw, pitch, zoom: 1., ..Key::new(t, Shot::Free) }
+}
+
+/// Moves a key's framing by the sticks for `dt` seconds: the right stick
+/// orbits (or looks), the left stick zooms (or flies a free camera).
+pub fn steer(key: &mut Key, left: [f32; 2], right: [f32; 2], dt: f32) {
+    key.yaw = math::wrap_angle(key.yaw - right[0] * 1.8 * dt);
+    key.pitch = (key.pitch + right[1] * 1.2 * dt).clamp(-1.3, 1.3);
+    match key.shot {
+        Shot::Free => {
+            if let Some(p) = key.position.as_mut() {
+                let [r, _, f] = look_basis(direction(key.yaw, key.pitch));
+                let fly = add(scale(f, left[1]), scale(r, left[0]));
+                *p = add(*p, scale(normalize_or(fly, [0.; 3]), fly.iter().map(|v| v * v).sum::<f32>().sqrt().min(1.) * 5. * dt));
+            }
+        }
+        _ => key.zoom = (key.zoom * (-left[1] * 1.2 * dt).exp()).clamp(0.35, 3.5),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::math::distance;
+    use crate::replay::tests::rolling;
+
+    #[test]
+    fn shots_frame_the_skater() {
+        let clip = rolling(4.).clip("").unwrap();
+        let t = 2.;
+        let subject = clip.subject(t).unwrap();
+        for s in Shot::ALL {
+            let cam = shot(&clip, t, &Key::new(t, s));
+            let to = normalize_or(sub(subject, cam.position), [0., 0., 1.]);
+            if s != Shot::Free {
+                assert!(crate::math::dot(to, cam.basis[2]) > 0.9, "{s:?} looks at the skater");
+            }
+            assert!(cam.fov > 5. && cam.fov < 120.);
+        }
+        // Following sits behind (the skater rolls along +z).
+        let follow = shot(&clip, t, &Key::new(t, Shot::Follow));
+        assert!(follow.position[2] < subject[2] - 2.);
+        // The fisheye is close and low.
+        let fish = shot(&clip, t, &Key::new(t, Shot::Fisheye));
+        assert!(distance(fish.position, subject) < 2.5 && fish.position[1] < subject[1]);
+        // A tripod stays put while the skater rolls by.
+        let key = Key::new(1., Shot::Tripod);
+        assert_eq!(shot(&clip, 1.5, &key).position, shot(&clip, 3., &key).position);
+        // The game camera is the recorded one.
+        assert!((shot(&clip, t, &Key::new(t, Shot::Game)).position[1] - 2.).abs() < 1e-3);
+    }
+
+    #[test]
+    fn keys_ease_and_cut() {
+        let mut a = Key::new(0., Shot::Follow);
+        a.speed = 1.;
+        let mut b = Key::new(2., Shot::Follow);
+        b.speed = 0.5;
+        let c = Key::new(3., Shot::Fisheye);
+        let keys = [a, b, c];
+        assert_eq!(key_at(&keys, -1.).speed, 1.);
+        let mid = key_at(&keys, 1.);
+        assert!((mid.speed - 0.75).abs() < 1e-3);
+        assert_eq!(key_at(&keys, 2.5).shot, Shot::Follow);
+        assert_eq!(key_at(&keys, 3.5).shot, Shot::Fisheye);
+        assert_eq!(key_at(&[], 3.).shot, Shot::Follow);
+        assert_eq!(next_speed(0.1), 2.);
+        assert_eq!(speed_name(0.25), "0.25x");
+        assert_eq!(speed_name(2.), "2x");
+        assert_eq!(looks(false), vec![0, 1, 2]);
+    }
+
+    #[test]
+    fn steering_moves_and_free_keys_start_where_the_camera_is() {
+        let mut k = Key::new(0., Shot::Follow);
+        steer(&mut k, [0., 1.], [1., 0.], 0.5);
+        assert!(k.zoom < 1. && k.yaw != 0.);
+        let cam = Camera { position: [1., 2., 3.], basis: look_basis([1., 0., 0.]), fov: 60. };
+        let mut free = free_from(&cam, 1.);
+        assert_eq!(free.position, Some([1., 2., 3.]));
+        steer(&mut free, [0., 1.], [0., 0.], 1.);
+        assert!(free.position.unwrap()[0] > 5.5);
+    }
+}
diff --git a/crates/skate_modes/src/hud.rs b/crates/skate_modes/src/hud.rs
new file mode 100644
index 0000000..d8c79cb
--- /dev/null
+++ b/crates/skate_modes/src/hud.rs
@@ -0,0 +1,317 @@
+//! What the modes put on screen, for either game to draw: text, flat
+//! boxes and the sprites of [`crate::sprites`], laid out on a screen 480
+//! units high. Across, each item hangs from the left edge, the centre or
+//! the right edge, so the layout keeps its shape on any aspect ratio (a
+//! 16:9 screen is about 853 wide).
+
+use crate::sprites::Sprite;
+
+/// Where an item's `x` is measured from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Anchor {
+    Left,
+    Center,
+    Right,
+}
+
+/// How text sits on its `x`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Align {
+    Left,
+    Center,
+    Right,
+}
+
+/// The faces the HUD asks for; each game picks its nearest.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Font {
+    /// Big, bold headings (trick names, banners).
+    Title,
+    /// Everything else.
+    Body,
+    /// Numbers that tick (timecodes, scores).
+    Digits,
+}
+
+pub type Rgba = [f32; 4];
+
+pub const WHITE: Rgba = [1., 1., 1., 1.];
+pub const BLACK: Rgba = [0., 0., 0., 1.];
+/// Skate 3's orange-yellow.
+pub const SKATE_YELLOW: Rgba = [1., 0.78, 0.18, 1.];
+pub const MEAT_RED: Rgba = [0.92, 0.12, 0.1, 1.];
+pub const GOOD_GREEN: Rgba = [0.45, 1., 0.45, 1.];
+pub const COOL_BLUE: Rgba = [0.5, 0.85, 1., 1.];
+pub const PANEL: Rgba = [0.02, 0.02, 0.03, 0.72];
+
+pub fn alpha(c: Rgba, a: f32) -> Rgba {
+    [c[0], c[1], c[2], c[3] * a.clamp(0., 1.)]
+}
+
+/// One thing to draw, in 480-high screen units (`y` down from the top;
+/// text sits with its top at `y`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum Item {
+    Rect { anchor: Anchor, x: f32, y: f32, w: f32, h: f32, color: Rgba },
+    Sprite { sprite: Sprite, anchor: Anchor, x: f32, y: f32, w: f32, h: f32, color: Rgba },
+    Text { text: String, anchor: Anchor, x: f32, y: f32, size: f32, align: Align, color: Rgba, font: Font },
+    /// A sprite stretched over the whole screen (vignettes, grain, flashes).
+    Screen { sprite: Sprite, color: Rgba },
+}
+
+impl Item {
+    pub fn text(text: impl Into<String>, anchor: Anchor, x: f32, y: f32, size: f32, align: Align, color: Rgba) -> Self {
+        Self::Text { text: text.into(), anchor, x, y, size, align, color, font: Font::Body }
+    }
+
+    pub fn title(text: impl Into<String>, anchor: Anchor, x: f32, y: f32, size: f32, align: Align, color: Rgba) -> Self {
+        Self::Text { text: text.into(), anchor, x, y, size, align, color, font: Font::Title }
+    }
+
+    pub fn digits(text: impl Into<String>, anchor: Anchor, x: f32, y: f32, size: f32, align: Align, color: Rgba) -> Self {
+        Self::Text { text: text.into(), anchor, x, y, size, align, color, font: Font::Digits }
+    }
+
+    pub fn rect(anchor: Anchor, x: f32, y: f32, w: f32, h: f32, color: Rgba) -> Self {
+        Self::Rect { anchor, x, y, w, h, color }
+    }
+
+    pub fn sprite(sprite: Sprite, anchor: Anchor, x: f32, y: f32, w: f32, h: f32, color: Rgba) -> Self {
+        Self::Sprite { sprite, anchor, x, y, w, h, color }
+    }
+
+    /// The same item faded by `a`.
+    pub fn faded(mut self, a: f32) -> Self {
+        match &mut self {
+            Self::Rect { color, .. } | Self::Sprite { color, .. } | Self::Text { color, .. } | Self::Screen { color, .. } => {
+                *color = alpha(*color, a)
+            }
+        }
+        self
+    }
+
+    /// The same item moved by `dx`, `dy`.
+    pub fn moved(mut self, dx: f32, dy: f32) -> Self {
+        match &mut self {
+            Self::Rect { x, y, .. } | Self::Sprite { x, y, .. } | Self::Text { x, y, .. } => {
+                *x += dx;
+                *y += dy;
+            }
+            Self::Screen { .. } => {}
+        }
+        self
+    }
+}
+
+/// Where an item's left edge lands across a screen `width` units wide.
+pub fn screen_x(anchor: Anchor, x: f32, width: f32) -> f32 {
+    match anchor {
+        Anchor::Left => x,
+        Anchor::Center => width * 0.5 + x,
+        Anchor::Right => width + x,
+    }
+}
+
+/// A rough width of `text` at `size`, for laying out text the games
+/// measure only when drawing.
+pub fn text_width(text: &str, size: f32) -> f32 {
+    text.chars()
+        .map(|c| match c {
+            'i' | 'l' | 'I' | '.' | ',' | ':' | ';' | '!' | '\'' | '|' => 0.26,
+            ' ' => 0.3,
+            'm' | 'w' | 'M' | 'W' => 0.78,
+            c if c.is_ascii_uppercase() || c.is_ascii_digit() => 0.58,
+            _ => 0.5,
+        })
+        .sum::<f32>()
+        * size
+}
+
+/// "12,450".
+pub fn points(value: f32) -> String {
+    let digits = (value.max(0.).round() as u64).to_string();
+    let mut out = String::new();
+    for (i, c) in digits.chars().enumerate() {
+        if i > 0 && (digits.len() - i) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(c);
+    }
+    out
+}
+
+/// "1:05.40" (minutes, seconds, hundredths).
+pub fn timecode(seconds: f32) -> String {
+    let s = seconds.max(0.);
+    let minutes = (s / 60.).floor() as u32;
+    let rest = s - minutes as f32 * 60.;
+    format!("{minutes}:{rest:05.2}")
+}
+
+/// "1:42" (minutes, seconds).
+pub fn clock(seconds: f32) -> String {
+    let s = seconds.max(0.).ceil() as u32;
+    format!("{}:{:02}", s / 60, s % 60)
+}
+
+/// The controller's buttons as Skate's input packs them.
+pub mod buttons {
+    pub const DPAD_UP: u16 = 0x0001;
+    pub const DPAD_DOWN: u16 = 0x0002;
+    pub const DPAD_LEFT: u16 = 0x0004;
+    pub const DPAD_RIGHT: u16 = 0x0008;
+    pub const START: u16 = 0x0010;
+    pub const BACK: u16 = 0x0020;
+    pub const LS: u16 = 0x0040;
+    pub const RS: u16 = 0x0080;
+    pub const LB: u16 = 0x0100;
+    pub const RB: u16 = 0x0200;
+    pub const A: u16 = 0x1000;
+    pub const B: u16 = 0x2000;
+    pub const X: u16 = 0x4000;
+    pub const Y: u16 = 0x8000;
+}
+
+/// A control as a hint shows it: a button, a trigger or a stick.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Control {
+    Button(u16),
+    LeftTrigger,
+    RightTrigger,
+    LeftStick,
+    RightStick,
+}
+
+/// What a hint names a control by: the controller's glyph, or the key the
+/// player has it on.
+pub trait Labels {
+    /// Whether the controller is what the player last used.
+    fn pad(&self) -> bool;
+    /// The keyboard key (or keys) for `control`, as the player bound it.
+    fn key(&self, control: Control) -> String;
+}
+
+/// Labels for a controller only (and tests).
+pub struct PadLabels;
+
+impl Labels for PadLabels {
+    fn pad(&self) -> bool {
+        true
+    }
+    fn key(&self, _control: Control) -> String {
+        String::new()
+    }
+}
+
+/// A row of control hints ("[A] Play   [B] Exit"), centred on `x`, as
+/// glyphs on a controller or key names on the keyboard. Nothing is drawn
+/// over a sprite (one game draws sprites above all text).
+pub fn hints(labels: &dyn Labels, list: &[(Control, &str)], anchor: Anchor, x: f32, y: f32, size: f32) -> Vec<Item> {
+    let pad = labels.pad();
+    let gap = size * 1.2;
+    let h = size * 1.3;
+    // Each hint: its label (a glyph, or the key in brackets), then its text.
+    let parts: Vec<(Option<Sprite>, String, f32, &str, f32)> = list
+        .iter()
+        .map(|(control, text)| {
+            let letters = glyph_letters(*control);
+            let glyph = crate::sprites::glyph_index(letters).filter(|_| pad).map(Sprite::Glyph);
+            let (label, label_w) = match glyph {
+                Some(sprite) => {
+                    let (w, hh) = sprite.size();
+                    (String::new(), h * w as f32 / hh as f32)
+                }
+                None => {
+                    let key = if pad { letters.to_owned() } else { labels.key(*control) };
+                    let key = format!("[{key}]");
+                    let w = text_width(&key, size);
+                    (key, w)
+                }
+            };
+            let w = label_w + size * 0.35 + text_width(text, size);
+            (glyph, label, label_w, *text, w)
+        })
+        .collect();
+    let total: f32 = parts.iter().map(|p| p.4).sum::<f32>() + gap * parts.len().saturating_sub(1) as f32;
+    let mut left = x - total * 0.5;
+    let mut items = Vec::new();
+    for (glyph, label, label_w, text, w) in parts {
+        match glyph {
+            Some(sprite) => items.push(Item::sprite(sprite, anchor, left, y - (h - size) * 0.5, label_w, h, WHITE)),
+            None => items.push(Item::text(label, anchor, left, y, size, Align::Left, SKATE_YELLOW)),
+        }
+        items.push(Item::text(text, anchor, left + label_w + size * 0.35, y, size, Align::Left, [1., 1., 1., 0.92]));
+        left += w + gap;
+    }
+    items
+}
+
+/// The letters a control's glyph carries.
+pub fn glyph_letters(control: Control) -> &'static str {
+    use buttons::*;
+    match control {
+        Control::Button(A) => "A",
+        Control::Button(B) => "B",
+        Control::Button(X) => "X",
+        Control::Button(Y) => "Y",
+        Control::Button(LB) => "LB",
+        Control::Button(RB) => "RB",
+        Control::Button(BACK) => "BACK",
+        Control::Button(START) => "START",
+        Control::Button(LS) => "LS",
+        Control::Button(RS) => "RS",
+        Control::Button(DPAD_UP) => "^",
+        Control::Button(DPAD_DOWN) => "v",
+        Control::Button(DPAD_LEFT) => "<",
+        Control::Button(DPAD_RIGHT) => ">",
+        Control::Button(_) => "?",
+        Control::LeftTrigger => "LT",
+        Control::RightTrigger => "RT",
+        Control::LeftStick => "LS",
+        Control::RightStick => "RS",
+    }
+}
+
+/// Seconds-old `age` of something that lasts `lasting`, as its opacity: full,
+/// then fading over the last quarter.
+pub fn fade(age: f32, lasting: f32) -> f32 {
+    1. - ((age - lasting * 0.75) / (lasting * 0.25)).clamp(0., 1.)
+}
+
+/// A pop-in scale for something `age` seconds old: overshoots, then settles.
+pub fn pop(age: f32) -> f32 {
+    let t = (age / 0.25).clamp(0., 1.);
+    1. + 0.35 * (1. - t) * (t * std::f32::consts::PI).sin() + 0.25 * (1. - t) * (1. - t)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn numbers_and_times() {
+        assert_eq!(points(1234567.4), "1,234,567");
+        assert_eq!(points(-3.), "0");
+        assert_eq!(timecode(65.4), "1:05.40");
+        assert_eq!(clock(102.2), "1:43");
+        assert!((fade(0., 2.) - 1.).abs() < 1e-6 && fade(2., 2.) == 0.);
+        assert!(pop(0.) > 1. && (pop(1.) - 1.).abs() < 1e-6);
+    }
+
+    #[test]
+    fn hints_lay_out_centred() {
+        let items = hints(&PadLabels, &[(Control::Button(buttons::A), "Play"), (Control::Button(buttons::B), "Exit")], Anchor::Center, 0., 400., 14.);
+        assert!(items.iter().any(|i| matches!(i, Item::Sprite { sprite: Sprite::Glyph(0), .. })));
+        let lefts: Vec<f32> = items
+            .iter()
+            .filter_map(|i| match i {
+                Item::Sprite { x, .. } => Some(*x),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(lefts.len(), 2);
+        assert!(lefts[0] < 0. && lefts[1] > 0.);
+        assert!(items.iter().any(|i| matches!(i, Item::Text { text, .. } if text == "Exit")));
+        assert_eq!(screen_x(Anchor::Right, -10., 853.), 843.);
+    }
+}
