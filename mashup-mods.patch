+/// Places `item` as the row after `last` in the column `previous` and
+/// `last` form, moving that column's items from there down by a row.
+fn insert_row(
+    items: &mut [MenuItem],
+    item: &mut MenuItem,
+    previous: &crate::MenuRect,
+    last: &crate::MenuRect,
+) -> Result<(), String> {
+    let pitch = last.y - previous.y;
+    if !(pitch.is_finite() && pitch > 0.0) {
+        return Err("row_after needs rows going down".into());
+    }
+    item.rect.x = last.x;
+    item.rect.y = last.y + pitch;
+    let (left, right) = (item.rect.x, item.rect.x + item.rect.w);
+    for other in items.iter_mut() {
+        let r = &mut other.rect;
+        let same_frame = r.horz_align == item.rect.horz_align && r.vert_align == item.rect.vert_align;
+        let overlaps = r.x < right && r.x + r.w > left;
+        if same_frame && overlaps && r.y >= item.rect.y - 0.5 {
+            r.y += pitch;
+        }
+    }
+    Ok(())
+}
