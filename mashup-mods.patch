+/// Aiming from the board. Not aiming, the MW2 aim follows the camera, so
+/// the first shot goes where the skater looks; firing or aiming down the
+/// sights turns the camera to follow the aim instead (over the shoulder, or
+/// from the eyes in first person) until a moment after the last shot.
+fn aim(
+    host: &mut Host,
+    mode: &mut SkateMode,
+    ps: Option<&playerstate_iw4::PlayerState>,
+    look: &mut net::LookState,
+    cmd: &playerstate_iw4::UserCmd,
+    dt: f32,
