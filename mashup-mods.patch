+fn skate_buttons(combat: &skate_rules::Combat, held_item: bool) -> u32 {
+    use playerstate_iw4::buttons as b;
+    let mut mask = 0;
+    if combat.guns {
+        mask |= b::ATTACK | b::ADS | b::RELOAD | b::USE_RELOAD | b::BREATH | b::FRAG | b::SMOKE | b::THROW
+            | b::OFFHAND_HOLD_CANCEL;
