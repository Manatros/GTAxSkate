+/// Dropped objects: count, then kind, position and facing each.
+fn put_skate_park(out: &mut WireWriter, objects: &[skate_park::ParkObject]) {
+    let objects = &objects[..objects.len().min(skate_park::MAX_OBJECTS)];
+    out.put_u8(objects.len() as u8);
+    for object in objects {
+        out.put_u8(object.kind);
+        for value in object.at {
+            out.put_f32(value);
+        }
+        out.put_f32(object.yaw);
+    }
+}
+
+fn get_skate_park(input: &mut WireReader<'_>) -> Result<Vec<skate_park::ParkObject>, WireError> {
+    let count = usize::from(input.get_u8()?);
+    if count > skate_park::MAX_OBJECTS {
+        return Err(WireError::Malformed("too many dropped objects"));
+    }
+    let mut objects = Vec::with_capacity(count);
+    for _ in 0..count {
+        let object = skate_park::ParkObject {
+            kind: input.get_u8()?,
+            at: [input.get_f32()?, input.get_f32()?, input.get_f32()?],
+            yaw: input.get_f32()?,
+        };
+        if !object.valid() {
+            return Err(WireError::Malformed("bad dropped object"));
+        }
+        objects.push(object);
+    }
+    Ok(objects)
+}
