diff --git a/crates/render_anim/src/room_probe.rs b/crates/render_anim/src/room_probe.rs
new file mode 100644
index 0000000..be83346
--- /dev/null
+++ b/crates/render_anim/src/room_probe.rs
@@ -0,0 +1,145 @@
+//! Listens to the space around the camera: rays go out from it against the
+//! map's collision, a few each frame, and what they find (how far the walls
+//! are, whether there is a ceiling, what the surfaces are made of) becomes
+//! the room the match's sound plays in (`audio::set_room`).
+
+use bevy::prelude::*;
+use render_scene::FlyCamera;
+
+use crate::occupancy::dyn_ent::DynEntPhysClip;
+
+/// Rays round the camera, and how many go out each frame.
+const RAYS: usize = 48;
+const PER_FRAME: usize = 8;
+/// How far a ray looks, in inches (about 60 m).
+const REACH: f32 = 2400.;
+/// Solid world geometry.
+const MASK_SOLID: u32 = 1;
+
+/// How much of the highs each IW4 surface type swallows (`SURF_TYPE`, the
+/// surface flags' bits 20 to 24), 0 hard to 1 soft.
+const ABSORB: [f32; 31] = [
+    0.10, // default
+    0.30, // bark
+    0.05, // brick
+    0.60, // carpet
+    0.50, // cloth
+    0.03, // concrete
+    0.40, // dirt
+    0.50, // flesh
+    0.60, // foliage
+    0.03, // glass
+    0.60, // grass
+    0.40, // gravel
+    0.02, // ice
+    0.02, // metal
+    0.50, // mud
+    0.30, // paper
+    0.05, // plaster
+    0.04, // rock
+    0.50, // sand
+    0.70, // snow
+    0.02, // water
+    0.12, // wood
+    0.05, // asphalt
+    0.02, // ceramic
+    0.06, // plastic
+    0.40, // rubber
+    0.60, // cushion
+    0.50, // fruit
+    0.03, // paintedmetal
+    0.03, // riotshield
+    0.50, // slush
+];
+
+/// What one ray found: how far it went (inches; `REACH` for nothing) and
+/// how soft the surface it struck is.
+#[derive(Clone, Copy, Default)]
+struct Hit {
+    distance: f32,
+    absorb: f32,
+    struck: bool,
+}
+
+#[derive(Resource)]
+struct Probe {
+    directions: Vec<Vec3>,
+    hits: Vec<Hit>,
+    next: usize,
+    filled: bool,
+    /// The collision sounds are muffled by (handed to the audio).
+    heard_through: Option<std::sync::Arc<asset_world::ClipCollision>>,
+}
+
+impl Default for Probe {
+    fn default() -> Self {
+        // Evenly round the sphere (a Fibonacci spiral), z up.
+        let golden = std::f32::consts::PI * (3. - 5f32.sqrt());
+        let directions = (0..RAYS)
+            .map(|i| {
+                let z = 1. - 2. * (i as f32 + 0.5) / RAYS as f32;
+                let r = (1. - z * z).sqrt();
+                let a = golden * i as f32;
+                Vec3::new(r * a.cos(), r * a.sin(), z)
+            })
+            .collect();
+        Self { directions, hits: vec![Hit::default(); RAYS], next: 0, filled: false, heard_through: None }
+    }
+}
+
+pub fn register(app: &mut App) {
+    app.init_resource::<Probe>().add_systems(Update, probe_room);
+}
+
+fn probe_room(
+    clip: Res<DynEntPhysClip>,
+    cameras: Query<&GlobalTransform, With<FlyCamera>>,
+    mut probe: ResMut<Probe>,
+) {
+    // Sounds are muffled by this map's walls.
+    let same = match (&probe.heard_through, &clip.0) {
+        (Some(a), Some(b)) => std::sync::Arc::ptr_eq(a, b),
+        (None, None) => true,
+        _ => false,
+    };
+    if !same {
+        probe.heard_through = clip.0.clone();
+        audio::set_occlusion_test(clip.0.clone().map(|world| {
+            std::sync::Arc::new(move |a: [f32; 3], b: [f32; 3]| world.box_sight_clear(a, b, MASK_SOLID)) as audio::SightTest
+        }));
+    }
+    let (Some(clip), Some(camera)) = (clip.0.as_deref(), cameras.iter().next()) else {
+        audio::set_room(audio::Room::OPEN);
+        probe.filled = false;
+        probe.next = 0;
+        return;
+    };
+    let eye = camera.translation();
+    for _ in 0..PER_FRAME {
+        let i = probe.next;
+        let end = eye + probe.directions[i] * REACH;
+        let hit = clip.sweep_box(eye.to_array(), end.to_array(), [0.; 3], [0.; 3], MASK_SOLID);
+        probe.hits[i] = if hit.startsolid {
+            // In a wall (a camera clipping through): heard as before.
+            probe.hits[i]
+        } else if hit.fraction < 1. {
+            let kind = ((hit.surface_flags >> 20) & 0x1f) as usize;
+            Hit { distance: hit.fraction * REACH, absorb: ABSORB.get(kind).copied().unwrap_or(0.1), struck: true }
+        } else {
+            Hit { distance: REACH, absorb: 1., struck: false }
+        };
+        probe.next = (i + 1) % RAYS;
+        if probe.next == 0 {
+            probe.filled = true;
+        }
+    }
+    if probe.filled {
+        let rays: Vec<(Vec3, Option<(f32, f32)>)> = probe
+            .directions
+            .iter()
+            .zip(&probe.hits)
+            .map(|(d, h)| (*d, h.struck.then_some((h.distance, h.absorb))))
+            .collect();
+        audio::set_room(audio::room_from_rays(&rays));
+    }
+}
