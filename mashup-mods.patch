diff --git a/crates/audio/src/occlusion.rs b/crates/audio/src/occlusion.rs
new file mode 100644
index 0000000..6ef1d80
--- /dev/null
+++ b/crates/audio/src/occlusion.rs
@@ -0,0 +1,42 @@
+//! Whether a sound is heard through a wall: a test the world's collision
+//! answers (set by the renderer once a map is loaded), asked as sounds are
+//! placed each frame.
+
+use std::sync::{Arc, RwLock};
+
+use bevy::math::Vec3;
+
+/// True when the straight line between two points (map inches) is clear.
+pub type SightTest = Arc<dyn Fn([f32; 3], [f32; 3]) -> bool + Send + Sync>;
+
+static TEST: RwLock<Option<SightTest>> = RwLock::new(None);
+
+/// The world to hear through from now on (`None` between maps).
+pub fn set_occlusion_test(test: Option<SightTest>) {
+    if let Ok(mut slot) = TEST.write() {
+        *slot = test;
+    }
+}
+
+/// How muffled a sound at `at` is for an ear at `ear`, 0 to 1: two lines
+/// go to it, one straight and one over the top (a sound just behind a low
+/// wall or a car is only half muffled).
+pub(crate) fn muffle(ear: Vec3, at: Vec3) -> f32 {
+    let Ok(slot) = TEST.read() else { return 0. };
+    let Some(test) = slot.as_ref() else { return 0. };
+    // Right beside the ear nothing is in the way.
+    if ear.distance_squared(at) < 48. * 48. {
+        return 0.;
+    }
+    // From just off the sound, so the floor or wall it sits on does not count.
+    let toward = (ear - at).normalize_or_zero();
+    let from = at + toward * 8. + Vec3::Z * 4.;
+    let mut blocked = 0.;
+    if !test(ear.to_array(), from.to_array()) {
+        blocked += 0.6;
+    }
+    if !test(ear.to_array(), (from + Vec3::Z * 40.).to_array()) {
+        blocked += 0.4;
+    }
+    blocked
+}
