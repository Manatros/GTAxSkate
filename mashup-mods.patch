+
+/// A source of sine wave sound
+#[derive(Asset, Debug, Clone, TypePath)]
+pub struct Pitch {
+    /// Frequency at which sound will be played
+    pub frequency: f32,
+    /// Duration for which sound will be played
+    pub duration: core::time::Duration,
+}
+
+impl Pitch {
+    /// Creates a new note
