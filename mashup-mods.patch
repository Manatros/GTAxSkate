+pub fn hide_for_first_person(dobj: &xmodel_runtime::DObj, skate: &mut [Mat4]) {
+    let find = |name: &str| dobj.bones.iter().position(|b| b.name == name);
+    let roots: Vec<usize> = ["j_clavicle_le", "j_clavicle_ri", "j_neck"].iter().filter_map(|n| find(n)).collect();
+    for root in roots {
+        let Some(base) = skate.get(root).copied() else { continue };
+        let pivot = base.w_axis.truncate();
+        let squash = Mat4::from_translation(pivot) * Mat4::from_scale(Vec3::splat(0.001)) * Mat4::from_translation(-pivot);
+        for i in 0..dobj.bones.len().min(skate.len()) {
+            if under(dobj, i, root) {
+                skate[i] = squash * skate[i];
+            }
+        }
+    }
+}
