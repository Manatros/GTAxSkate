+/// Converts Skate 3's skateboard catalog (decks, trucks, wheels) for the
+/// class editor's Skateboard slot, once. Optional: on any failure the game
+/// plays with the default board.
+fn prepare_board_catalog(root: &Path, assets: &Path, env: &mut EnvFile, env_path: &Path) {
+    if skate_boards::Library::exists(assets) || env.get(BOARDS_SWITCH) == Some("off") {
+        return;
+    }
+    let converter = root.join("skate").join("iw4l-skate-convert.exe");
+    if !converter.is_file() {
+        return;
+    }
+    let game = match env
+        .get(SKATE_GAME)
+        .map(PathBuf::from)
+        .filter(|game| skate_boards::convert::is_game_folder(game))
+    {
+        Some(game) => game,
+        None => {
+            let answer = MessageDialog::new()
+                .set_title(TITLE)
+                .set_description(
+                    "New: customise your skateboard in Create-a-Class with Skate 3's own \
+                     decks, trucks and wheels.\n\n\
+                     The catalog comes from your Skate 3 files, so select your Skate 3 \
+                     default.xex once more (the data folder beside it is read). This takes \
+                     a few minutes, once.\n\n\
+                     Choose No to keep the default board.",
+                )
+                .set_buttons(MessageButtons::YesNo)
+                .show();
+            if answer != MessageDialogResult::Yes {
+                env.set_value(BOARDS_SWITCH, "off");
+                let _ = env.write(env_path);
+                return;
+            }
+            let Some(game) = rfd::FileDialog::new()
+                .set_title("Select your Skate 3 default.xex")
+                .add_filter("Skate 3 default.xex", &["xex"])
+                .pick_file()
+                .and_then(|xex| xex.parent().map(Path::to_path_buf))
+            else {
+                env.set_value(BOARDS_SWITCH, "off");
+                let _ = env.write(env_path);
+                return;
+            };
+            env.set(SKATE_GAME, &game);
+            let _ = env.write(env_path);
+            game
+        }
+    };
+    println!("Preparing Skate 3's skateboard catalog from {}", game.display());
+    if let Err(error) = skate_boards::convert::prepare(&converter, &game, assets, |line| println!("  {line}")) {
+        env.set_value(BOARDS_SWITCH, "off");
+        let _ = env.write(env_path);
+        inform(&format!(
+            "The skateboard catalog could not be prepared:\n\n{error}\n\n\
+             The game plays with the default board. To try again, delete the line \
+             {BOARDS_SWITCH}=off from the .env file beside iw4l.exe."
+        ));
+    }
 }
 
