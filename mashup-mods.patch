+            let input = skate_key(name).unwrap_or_else(|| panic!("{name}"));
+            assert_eq!(skate_key_name(input), Some(*name));
+        }
+        assert_eq!(SKATE_KEY_CODES.len(), skate_input::keys::KEYS.len());
+    }
