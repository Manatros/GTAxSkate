+/// Falls waiting to hurt: client and damage in percent of full health.
+static FALLS: std::sync::Mutex<Vec<(u32, u32)>> = std::sync::Mutex::new(Vec::new());
+/// Clients with Commando Pro (`specialty_falldamage`), who take none.
+static NO_FALL_DAMAGE: std::sync::Mutex<Vec<u32>> = std::sync::Mutex::new(Vec::new());
+
+/// A fall for `client`, in percent of full health, from movement outside
+/// the sim (a skater's landing).
+pub fn push_fall_damage(client: u32, percent: u32) {
+    if percent > 0
+        && let Ok(mut falls) = FALLS.lock()
+    {
+        falls.push((client, percent));
+    }
+}
+
+pub(crate) fn set_no_fall_damage(client: ClientId, on: bool) {
+    if let Ok(mut list) = NO_FALL_DAMAGE.lock() {
+        list.retain(|&c| c != client.0);
+        if on {
+            list.push(client.0);
+        }
+    }
+}
+
+/// MW2's fall damage for a landing from `height` inches, in percent of
+/// full health (`bg_fallDamageMinHeight` 128, `bg_fallDamageMaxHeight` 300).
+pub fn mw2_fall_percent(height: f32) -> u32 {
+    const MIN: f32 = 128.;
+    const MAX: f32 = 300.;
+    if !height.is_finite() || height <= MIN {
+        return 0;
+    }
+    (((height - MIN) / (MAX - MIN)) * 100.).ceil() as u32
+}
+
+/// Applies this tick's falls: MOD_FALLING damage with no attacker, so a
+/// deadly one is a suicide with MW2's death screen.
+pub(crate) fn apply_fall_damage(world: &mut FrameWorld, tick: Tick) {
+    let falls = FALLS.lock().map(|mut f| std::mem::take(&mut *f)).unwrap_or_default();
+    if !world.publishes_snapshot() {
+        return;
+    }
+    let immune = NO_FALL_DAMAGE.lock().map(|l| l.clone()).unwrap_or_default();
+    for (client, percent) in falls {
+        if immune.contains(&client) {
+            continue;
+        }
+        let target = ClientId(client);
+        let Some(meta) = world.client_meta(target) else { continue };
+        if meta.lifecycle != ClientLifecycle::Alive {
+            continue;
+        }
+        let life = meta.life_sequence;
