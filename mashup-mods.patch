+//! The class editor's skateboard picker shows the whole board in 3D, as
+//! Skate 3's customiser does: deck, trucks and wheels with their finishes
+//! (the hovered part on it), either held by Skate's skater standing on foot
+//! and slowly turning, or floating alone and turning over (`skate preview`).
+//! It is drawn in software (`skate_boards::preview`) off the frame, into a
+//! runtime image the menu shows like any other.
+
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+use bevy::tasks::{AsyncComputeTaskPool, Task, futures_lite::future};
+
+use crate::images::HudImages;
+
+/// The runtime image the 3D board preview draws into.
+pub const BOARD_PREVIEW_3D: &str = "iw4l_board_preview_3d";
+/// Its size, wide like the picker's weapon pictures.
+const WIDTH: u32 = 320;
+const HEIGHT: u32 = 160;
+
+/// Skate's skater on foot with the board in hand, posed once by a Skate
+/// session of its own (it takes seconds; the board alone shows meanwhile).
+struct Showroom {
+    names: Vec<String>,
+    bones: Vec<Mat4>,
+    body: skate_boards::Board,
+}
+
+fn showroom() -> Option<&'static Showroom> {
+    static POSE: std::sync::OnceLock<Option<Showroom>> = std::sync::OnceLock::new();
+    static STARTED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    if let Some(pose) = POSE.get() {
+        return pose.as_ref();
+    }
+    if !STARTED.swap(true, std::sync::atomic::Ordering::Relaxed) {
+        let _ = std::thread::Builder::new()
+            .name("skate-showroom".into())
+            .stack_size(32 * 1024 * 1024)
+            .spawn(|| {
+                let pose = pose_skater().map_err(|e| diag::warn!(Ui, "board preview skater: {e}")).ok();
+                let _ = POSE.set(pose);
+            });
+    }
+    None
+}
+
+/// Runs a Skate session on a small floor until the skater stands holding
+/// their board, and keeps that pose.
+fn pose_skater() -> Result<Showroom, String> {
+    use skate_host::bridge::{Controls, Session};
+    let root = std::path::PathBuf::from(std::env::var_os("IW4L_SKATE_ASSETS").ok_or("no Skate data")?);
+    let (a, b, c, d) = ([-3., 0., -3.], [3., 0., -3.], [3., 0., 3.], [-3., 0., 3.]);
+    let mut session = Session::new(&root, vec![[a, d, c], [a, c, b]], vec![], [0.; 3], 0.)?;
+    session.activate_on_foot([0., 0., 0.], 0.)?;
+    // Let the skater settle into standing.
+    for _ in 0..90 {
+        session.tick(Controls::default())?;
+    }
+    let pose = session.pose();
+    let body = skate_boards::Board::default_skater(&root, 256)?;
+    Ok(Showroom { names: pose.names, bones: pose.bones, body })
+}
+
+/// The board in the skater's hands, as Skate's customiser shows it.
+fn posed(showroom: &Showroom, board: &skate_boards::Board) -> Option<skate_boards::preview::Preview> {
+    // The converter's bones turned to Skate's, as the mashup skins boards.
+    let rb = Mat4::from_cols(Vec4::X, -Vec4::Z, Vec4::Y, Vec4::W);
+    let world = |name: &str| {
+        let i = showroom.names.iter().position(|n| n == name)?;
+        Some((showroom.bones.get(i)? * rb).to_cols_array())
+    };
+    skate_boards::preview::Preview::posed(&[&showroom.body, board], &world)
+}
+
+/// Whether the class picker is open, as the menus last drew.
+static PICKER_OPEN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn set_picker_open(open: bool) {
+    PICKER_OPEN.store(open, std::sync::atomic::Ordering::Relaxed);
+}
+
+#[derive(Default)]
+pub(crate) struct Previews {
+    image: Option<Handle<Image>>,
+    /// The board shown and its mesh, ready or being built.
+    board: Option<String>,
+    building: Option<(String, Task<Option<skate_boards::preview::Preview>>)>,
+    preview: Option<std::sync::Arc<skate_boards::preview::Preview>>,
+    drawing: Option<Task<skate_boards::Texture>>,
+    /// When the preview opened, for the turn.
+    since: f32,
+}
+
+pub(crate) fn load_board_previews(
+    time: Res<Time>,
+    mode: Option<Res<frame::SkateMode>>,
+    dvars: Option<Res<frame::UiMenuDvars>>,
+    mut previews: Local<Previews>,
+    mut hud_images: ResMut<HudImages>,
+    mut images: ResMut<Assets<Image>>,
+) {
+    let shown = PICKER_OPEN.load(std::sync::atomic::Ordering::Relaxed)
+        && dvars
+            .as_ref()
+            .is_some_and(|dvars| dvars.get("ui_class_preview").is_some_and(|name| name == BOARD_PREVIEW_3D));
+    if !shown {
+        // Nothing to draw: let go of the work, keep the image.
+        previews.building = None;
+        previews.drawing = None;
+        previews.board = None;
+        previews.preview = None;
+        return;
+    }
+    let now = time.elapsed_secs();
+    let image = previews
+        .image
+        .get_or_insert_with(|| {
+            let image = Image::new(
+                Extent3d { width: WIDTH, height: HEIGHT, depth_or_array_layers: 1 },
+                TextureDimension::D2,
+                vec![0; (WIDTH * HEIGHT * 4) as usize],
+                TextureFormat::Rgba8UnormSrgb,
+                RenderAssetUsages::default(),
+            );
+            images.add(image)
+        })
+        .clone();
+    hud_images.insert_runtime(BOARD_PREVIEW_3D, image.clone());
+    // The skater holding it, once posed, unless the board alone is wanted.
+    let skater = mode.as_ref().is_none_or(|m| m.settings.preview_skater);
+    let showroom = if skater { showroom() } else { None };
+    let wanted = dvars.as_ref().and_then(|d| d.get("ui_board_preview")).unwrap_or_default().to_owned();
+    let key = format!("{}|{wanted}", if showroom.is_some() { "skater" } else { "board" });
+    // A new board: build its mesh off the frame.
+    if previews.board.as_deref() != Some(key.as_str())
+        && previews.building.as_ref().is_none_or(|(text, _)| *text != key)
+    {
+        let text = wanted.clone();
+        let task = AsyncComputeTaskPool::get().spawn(async move {
+            let choice = skate_boards::BoardChoice::from_text(&text);
+            let held = showroom.and_then(|showroom| match assets::bot_model::assemble_skate_board(&choice) {
+                Ok(board) => {
+                    let held = posed(showroom, &board);
+                    if held.is_none() {
+                        diag::warn!(Ui, "board preview: the skater could not be posed with the board; showing the board alone");
+                    }
+                    held
+                }
+                Err(e) => {
+                    diag::warn!(Ui, "board preview: {e}");
+                    None
+                }
+            });
+            // The board alone when the skater cannot hold it.
+            held.or_else(|| {
+                assets::bot_model::skate_board_preview(&choice)
+                    .map_err(|e| diag::warn!(Ui, "board preview: {e}"))
+                    .ok()
+            })
+        });
+        if previews.board.is_none() {
+            previews.since = now;
+        }
+        previews.building = Some((key, task));
+    }
+    if let Some((text, task)) = previews.building.as_mut()
+        && let Some(result) = future::block_on(future::poll_once(task))
+    {
+        previews.board = Some(std::mem::take(text));
+        previews.preview = result.map(std::sync::Arc::new);
+        previews.building = None;
+    }
+    // Each finished drawing goes up; the next turn is drawn meanwhile.
+    if let Some(task) = previews.drawing.as_mut()
+        && let Some(texture) = future::block_on(future::poll_once(task))
+    {
+        previews.drawing = None;
+        if let Some(mut target) = images.get_mut(&image)
+            && texture.width == WIDTH
+            && texture.height == HEIGHT
+        {
+            target.data = Some(texture.rgba);
+        }
+    }
+    if previews.drawing.is_none()
+        && let Some(preview) = previews.preview.clone()
+    {
+        let seconds = now - previews.since;
+        // The skater turns slowly round, a little either way, as in the shop.
+        let angle = if preview.upright() {
+            (seconds * 0.6).sin() * 0.9
+        } else {
+            skate_boards::preview::angle_at(seconds)
+        };
+        previews.drawing = Some(AsyncComputeTaskPool::get().spawn(async move { preview.render(angle, WIDTH, HEIGHT) }));
+    }
+}
