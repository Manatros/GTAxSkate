+use crate::skate_game::{self, Attempt, Game, Outcome, Phase, Player, PlayerId};
+use crate::spots::{self, Kind, Medal, Run, Spots};
+use crate::sprites::Sprite;
+use crate::wire::Signal;
+
+/// The controller this frame (keyboard folded in by the game).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Pad {
+    pub buttons: u16,
+    pub lt: f32,
+    pub rt: f32,
+    pub left: [f32; 2],
+    pub right: [f32; 2],
+}
+
+/// Skate 3's score as the modes need it.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Score {
+    /// The trick last named, as the HUD shows it (stance included).
+    pub trick: String,
+    pub tricks: u32,
+    pub landings: u32,
+    pub bailed: bool,
+    pub line: f32,
+    pub completed: f32,
+}
+
+/// The skater this frame, in Skate space (metres, y up).
+pub struct Skater<'a> {
+    /// The session's clock (ticks times the period), seconds.
+    pub time: f64,
+    pub names: &'a [String],
+    pub root: M4,
+    pub bones: &'a [M4],
+    pub velocity: V3,
+    pub state: &'a str,
