+/// What a skater's board does (for its sounds) and which board it is.
+fn put_skate_cue(out: &mut WireWriter, cue: sim::SkateCue) {
+    out.put_u8(cue.state);
+    out.put_u8(cue.speed);
+    out.put_i8(cue.vertical);
+    out.put_u8(cue.surface);
+    out.put_u8(cue.wheels);
+}
+
+fn get_skate_cue(input: &mut WireReader<'_>) -> Result<sim::SkateCue, WireError> {
+    Ok(sim::SkateCue {
+        state: input.get_u8()?,
+        speed: input.get_u8()?,
+        vertical: input.get_i8()?,
+        surface: input.get_u8()?,
+        wheels: input.get_u8()?,
+    })
+}
+
+fn put_skate_board(out: &mut WireWriter, text: &str) {
+    let text = if text.len() <= sim::SKATE_BOARD_TEXT { text } else { "" };
+    out.put_u8(text.len() as u8);
+    for byte in text.bytes() {
+        out.put_u8(byte);
+    }
+}
+
+fn get_skate_board(input: &mut WireReader<'_>) -> Result<String, WireError> {
+    let len = usize::from(input.get_u8()?);
+    if len > sim::SKATE_BOARD_TEXT {
+        return Err(WireError::Malformed("skate board text too long"));
+    }
+    let mut bytes = Vec::with_capacity(len);
+    for _ in 0..len {
+        bytes.push(input.get_u8()?);
+    }
+    String::from_utf8(bytes)
+        .ok()
+        .filter(|text| text.is_ascii())
+        .ok_or(WireError::Malformed("skate board text is not ASCII"))
+}
+
+/// A skater's bones: count, then name, position and rotation each.
+fn put_skate_bones(out: &mut WireWriter, bones: &[sim::SkateBone]) {
+    out.put_u8(bones.len() as u8);
+    for bone in bones {
+        out.put_u32(bone.name);
+        for value in bone.position {
+            out.put_f32(value);
+        }
+        for value in bone.rotation {
+            out.put_u16(value as u16);
+        }
+    }
+}
+
+fn get_skate_bones(input: &mut WireReader<'_>) -> Result<Vec<sim::SkateBone>, WireError> {
+    let count = usize::from(input.get_u8()?);
+    if count > sim::SKATE_POSE_BONES {
+        return Err(WireError::Malformed("too many skate bones"));
+    }
+    let mut bones = Vec::with_capacity(count);
+    for _ in 0..count {
+        let name = input.get_u32()?;
+        let position = [input.get_f32()?, input.get_f32()?, input.get_f32()?];
+        if !position.iter().all(|v| v.is_finite()) {
+            return Err(WireError::Malformed("nonfinite skate bone"));
+        }
+        let mut rotation = [0i16; 4];
+        for value in &mut rotation {
+            *value = input.get_u16()? as i16;
+        }
+        bones.push(sim::SkateBone { name, position, rotation });
     }
+    Ok(bones)
 }
 
