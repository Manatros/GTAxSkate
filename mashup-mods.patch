+}
+
+/// Another player.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Peer {
+    pub id: PlayerId,
+    pub name: String,
+    pub world: Option<V3>,
+    pub skating: bool,
+    /// Their modes line (see `wire`).
+    pub signal: String,
+}
+
+pub struct Input<'a> {
+    /// The real clock, seconds.
+    pub now: f64,
+    /// Real seconds since the last frame.
+    pub dt: f32,
+    pub pad: Pad,
+    pub labels: &'a dyn Labels,
+    pub me: PlayerId,
+    pub my_name: &'a str,
+    pub skater: Option<Skater<'a>>,
+    pub peers: &'a [Peer],
+    /// A name for where the skater is (a street), for new spots.
+    pub place: &'a str,
+}
+
+/// What the game can do.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Host {
+    /// Colour filters (black and white, sepia) for the replay's looks.
+    pub colour: bool,
+    /// Slowing the game down (bails in slow motion).
+    pub time_scale: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Sound {
+    Nav,
+    Select,
+    Back,
+    Good,
+    Bad,
+    Letter,
+    Win,
+    Lose,
+    Medal,
+    Meat,
+}
+
+/// The replay showing now: the pose to put on the skater, in the clip's
+/// Skate space (its `origin` is the game's offset).
+pub struct ReplayView {
+    pub pose: Pose,
+    pub origin: V3,
+}
+
+#[derive(Default)]
+pub struct Output {
+    pub items: Vec<Item>,
+    pub replay: Option<ReplayView>,
+    /// The camera, in the replay's Skate space.
+    pub camera: Option<Camera>,
+    /// The skater waits (menus, the editor): no stepping, no input.
+    pub hold: bool,
+    /// Buttons the modes used this frame: the skater must not see them.
+    pub swallow: u16,
+    pub mono: bool,
+    pub sepia: bool,
+    /// How fast the game should run (1 normal).
+    pub time_scale: f32,
+    /// A shake for the camera, 0 to 1.
+    pub shake: f32,
+    pub sounds: Vec<Sound>,
+    pub notes: Vec<String>,
+    /// This skater's line for the others.
+    pub signal: String,
+    pub markers: Vec<spots::Marker>,
+}
+
+/// When the Hall of Meat shows a bail.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MeatShow {
+    Always,
+    Big,
+    Off,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Settings {
+    pub meat: MeatShow,
+    pub slowmo: bool,
+    /// Damage scale of impacts.
+    pub sensitivity: f32,
+}
+
+impl Default for Settings {
+    fn default() -> Self {
+        Self { meat: MeatShow::Always, slowmo: true, sensitivity: 1. }
+    }
+}
+
+impl Settings {
+    fn load(path: &Path) -> Self {
+        let mut s = Self::default();
+        for line in std::fs::read_to_string(path).unwrap_or_default().lines() {
+            let Some((k, v)) = line.split_once('=') else { continue };
+            match (k.trim(), v.trim()) {
+                ("meat", "always") => s.meat = MeatShow::Always,
+                ("meat", "big") => s.meat = MeatShow::Big,
+                ("meat", "off") => s.meat = MeatShow::Off,
+                ("slowmo", v) => s.slowmo = v != "off",
+                ("sensitivity", v) => s.sensitivity = v.parse::<f32>().unwrap_or(1.).clamp(0.2, 5.),
+                _ => {}
+            }
+        }
+        s
+    }
+
+    fn save(&self, path: &Path) {
+        let meat = match self.meat {
+            MeatShow::Always => "always",
+            MeatShow::Big => "big",
+            MeatShow::Off => "off",
+        };
+        let text = format!(
+            "# Skate modes: meat = always | big | off, slowmo = on | off, sensitivity = 0.2 to 5\nmeat = {meat}\nslowmo = {}\nsensitivity = {}\n",
+            if self.slowmo { "on" } else { "off" },
+            self.sensitivity
+        );
+        let _ = std::fs::write(path, text);
+    }
+}
+
+/// Hall of Meat records per map.
+#[derive(Clone, Debug, Default, PartialEq)]
+struct Records {
+    by_map: HashMap<String, (f32, f32, u32)>,
+}
+
+impl Records {
+    fn load(path: &Path) -> Self {
+        let mut by_map = HashMap::new();
+        for line in std::fs::read_to_string(path).unwrap_or_default().lines() {
+            let f: Vec<&str> = line.split('|').collect();
+            if f.len() == 4
+                && let (Ok(best), Ok(total), Ok(bails)) = (f[1].parse(), f[2].parse(), f[3].parse())
+            {
+                by_map.insert(f[0].to_owned(), (best, total, bails));
+            }
+        }
+        Self { by_map }
+    }
+
+    fn save(&self, path: &Path) {
+        let mut text = String::new();
+        for (map, (best, total, bails)) in &self.by_map {
+            text.push_str(&format!("{map}|{best}|{total}|{bails}\n"));
+        }
+        let _ = std::fs::write(path, text);
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Page {
+    Main,
+    Skate,
+    Spots,
+    Clips,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum Action {
+    Replay,
+    Clips,
+    OpenClip(usize),
+    Page(Page),
+    MeatShow,
+    SlowMo,
+    Close,
+    Back,
+    VsCpu,
+    VsNearby,
+    Join,
+    StartGame,
+    QuitGame,
+    StartSpot,
+    StopRun,
+    NewSpot(Kind),
+    Target(bool),
+    DeleteSpot,
+}
+
+struct MenuState {
+    page: Page,
+    cursor: Cursor,
+    opened: f64,
+    clips: Vec<PathBuf>,
+}
+
+/// A Game of S.K.A.T.E. this player is in.
+struct Playing {
+    game: Game,
+    /// The owner's id; this player runs it when it is theirs.
+    owner: PlayerId,
+    seen_seq: u32,
+    outcome_at: f64,
+    /// When the turn came to this player (to skip a sequence already under way).
+    turn_at: f64,
+    my_turn: bool,
+    cpu_due: Option<f64>,
+    /// The owner: when each player was last heard, and the turn of theirs
+    /// already counted.
+    heard: HashMap<PlayerId, f64>,
+    counted: HashMap<PlayerId, u32>,
+    /// A guest: the answer to send, and when the owner was last heard.
+    attempt: Option<(u32, u32, Option<Vec<String>>)>,
+    owner_heard: f64,
+    joined: bool,
+    over_at: Option<f64>,
+    /// This player runs the game.
+    mine: bool,
+}
+
+pub struct Modes {
+    dir: PathBuf,
+    map: String,
+    host: Host,
+    pub settings: Settings,
+    recorder: Recorder,
+    editor: Option<Editor>,
+    menu: Option<MenuState>,
+    prev: u16,
+    level: u8,
+    // The Hall of Meat.
+    tracker: Option<Tracker>,
+    calm_since: Option<f64>,
+    panel: Option<(Report, f64, bool)>,
+    records: Records,
+    // Own the Spot.
+    spots: Spots,
+    run: Option<Run>,
+    finish: Option<(spots::Spot, Run, Medal, f64)>,
+    entered: Option<(u32, f64)>,
+    // The Game of S.K.A.T.E.
+    playing: Option<Playing>,
+    // The sequence in progress, from the score's counters.
+    tricks_seen: Option<u32>,
+    landings_seen: Option<u32>,
+    sequence: Vec<String>,
+    toast: Option<(String, f64)>,
+}
+
+impl Modes {
+    /// Modes keeping their files in `dir`, on map `map` ("" for GTA).
+    pub fn new(dir: &Path, map: &str, host: Host) -> Self {
+        let settings = Settings::load(&dir.join("skate-modes.txt"));
+        let records = Records::load(&dir.join("skate-records.txt"));
+        Self {
+            dir: dir.to_owned(),
+            map: map.to_owned(),
+            host,
+            settings,
+            recorder: Recorder::new(60.),
+            editor: None,
+            menu: None,
+            prev: 0,
+            level: 1,
+            tracker: None,
+            calm_since: None,
+            panel: None,
+            records,
+            spots: Spots::load(&spots_path(dir, map)),
+            run: None,
+            finish: None,
+            entered: None,
+            playing: None,
+            tricks_seen: None,
+            landings_seen: None,
+            sequence: Vec::new(),
+            toast: None,
+        }
+    }
+
+    /// Another map: its spots and records.
+    pub fn set_map(&mut self, map: &str) {
+        if map != self.map {
+            self.map = map.to_owned();
+            self.spots = Spots::load(&spots_path(&self.dir, map));
+            self.run = None;
+            self.recorder.clear();
+        }
+    }
+
+    /// The replay's bone names (for the pose of [`ReplayView`]).
+    pub fn replay_names(&self) -> Option<&[String]> {
+        self.editor.as_ref().map(|e| e.clip.names.as_slice())
+    }
+
+    /// The replay's board (its parts as text).
+    pub fn replay_board(&self) -> Option<&str> {
+        self.editor.as_ref().map(|e| e.clip.board.as_str())
+    }
+
+    /// Whether the replay editor is open.
+    pub fn replaying(&self) -> bool {
+        self.editor.is_some()
+    }
+
+    /// Whether anything of the modes wants the controller.
+    pub fn busy(&self) -> bool {
+        self.editor.is_some() || self.menu.is_some()
+    }
+
+    fn meat_best(&self) -> f32 {
+        self.records.by_map.get(&self.map).map_or(0., |r| r.0)
+    }
+
+    fn replays_dir(&self) -> PathBuf {
+        let map = if self.map.is_empty() { "gta".to_owned() } else { safe(&self.map) };
+        self.dir.join("replays").join(map)
+    }
+
+    fn toast(&mut self, text: impl Into<String>, now: f64) {
+        self.toast = Some((text.into(), now));
+    }
+
+    /// One frame.
+    pub fn update(&mut self, input: &Input<'_>) -> Output {
+        let mut out = Output { time_scale: 1., ..Default::default() };
+        let now = input.now;
+        let held = input.pad.buttons;
+        let pressed = held & !self.prev;
+        let released = self.prev & !held;
+        self.prev = held;
+
+        // The replay editor takes the whole screen.
+        if self.editor.is_some() {
+            self.editor_frame(input, pressed, released, &mut out);
+            out.signal = self.signal().encode();
+            return out;
+        }
+
+        let skating = input.skater.is_some();
+        if let Some(skater) = &input.skater {
+            self.recorder.push(skater.time, skater.names, &skater.root, skater.bones, skater.cue, skater.camera, skater.board, skater.origin);
+        } else {
+            self.tricks_seen = None;
+            self.landings_seen = None;
+            self.sequence.clear();
+        }
+
+        // Opening: LB + Back for the menu, LB + right stick click for the
+        // instant replay.
+        if skating && self.menu.is_none() && held & buttons::LB != 0 {
+            if pressed & buttons::BACK != 0 {
+                self.open_menu(Page::Main, now);
+                out.sounds.push(Sound::Select);
+                out.swallow |= buttons::BACK | buttons::LB;
+            } else if pressed & buttons::RS != 0 {
+                out.swallow |= buttons::RS | buttons::LB;
+                if self.open_replay(now) {
+                    out.sounds.push(Sound::Select);
+                    self.editor_frame(input, 0, 0, &mut out);
+                    out.signal = self.signal().encode();
+                    return out;
+                }
+            }
+        }
+
+        // What the skater did since last frame.
+        let ended = input.skater.as_ref().and_then(|s| self.sequence_end(&s.score));
+
+        if let Some(skater) = &input.skater {
+            self.meat_frame(skater, now, &mut out);
+            self.spot_frame(skater, now, input.dt, &mut out);
+        } else {
+            self.tracker = None;
+        }
+        self.game_frame(input, ended, &mut out);
+
+        if self.menu.is_some() {
+            self.menu_frame(input, pressed, &mut out);
+        }
+        if self.editor.is_some() {
+            // Opened from the menu.
+            self.editor_frame(input, 0, 0, &mut out);
+            out.signal = self.signal().encode();
+            return out;
+        }
+        if let Some((text, at)) = &self.toast {
+            let age = (now - at) as f32;
+            if age < 2.2 {
+                out.items.push(Item::title(text.clone(), Anchor::Center, 0., 300., 15., Align::Center, hud::alpha(hud::SKATE_YELLOW, hud::fade(age, 2.2))));
+            }
+        }
+        if let Some(world) = input.skater.as_ref().map(|s| s.world) {
+            out.markers = self
+                .spots
+                .list
+                .iter()
+                .filter(|s| distance(s.center, world) < 400.)
+                .map(|s| spots::Marker {
+                    center: s.center,
+                    radius: s.radius,
+                    label: s.name.clone(),
+                    kind: s.kind,
+                    medal: s.medal(s.best),
+                    active: self.run.as_ref().is_some_and(|r| r.spot == s.id),
+                })
+                .collect();
+        }
+        if self.menu.is_some() {
+            out.hold = true;
+            out.swallow = u16::MAX;
+        }
+        out.signal = self.signal().encode();
+        out
+    }
+
+    /// Follows the score's counters: a sequence's tricks, and its end.
+    fn sequence_end(&mut self, score: &Score) -> Option<Attempt> {
+        let mut ended = None;
+        if let Some(seen) = self.tricks_seen
+            && score.tricks != seen
+            && !score.trick.is_empty()
+        {
+            self.sequence.push(score.trick.clone());
+        }
+        if let Some(seen) = self.landings_seen
+            && score.landings != seen
+        {
+            ended = Some(if score.bailed { Attempt::Bailed } else { Attempt::Landed(std::mem::take(&mut self.sequence)) });
+            self.sequence.clear();
+        }
+        self.tricks_seen = Some(score.tricks);
+        self.landings_seen = Some(score.landings);
+        ended
+    }
+
+    fn signal(&self) -> Signal {
+        let mut s = Signal { meat_best: Some(self.meat_best()).filter(|b| *b > 0.), ..Default::default() };
+        if let Some(p) = &self.playing {
+            if p.is_owner() {
+                s.game = Some(p.game.clone());
+            } else {
+                s.attempt = p.attempt.clone();
+                if p.joined {
+                    s.joined = Some(p.game.id);
+                }
+            }
+        }
+        s
+    }
+
+    // --- The replay -------------------------------------------------------
+
+    fn open_replay(&mut self, now: f64) -> bool {
+        let Some(mut clip) = self.recorder.clip(&self.map) else {
+            self.toast("Nothing recorded yet", now);
+            return false;
+        };
+        // Opens on the last ten seconds, the whole minute a scrub away.
+        let length = clip.length();
+        clip.trim = ((length - 10.).max(0.), length);
+        self.editor = Some(Editor::new(clip, now, self.host.colour));
+        self.menu = None;
+        true
+    }
+
+    fn editor_frame(&mut self, input: &Input<'_>, pressed: u16, released: u16, out: &mut Output) {
+        let Some(editor) = self.editor.as_mut() else { return };
+        let pad = editor::Pad {
+            pressed,
+            held: input.pad.buttons,
+            released,
+            lt: input.pad.lt,
+            rt: input.pad.rt,
+            left: input.pad.left,
+            right: input.pad.right,
+        };
+        let frame = editor.update(pad, input.dt, input.now, input.labels);
+        out.items = frame.items;
+        out.camera = Some(frame.camera);
+        out.replay = frame.pose.map(|pose| ReplayView { pose, origin: editor.clip.origin });
+        out.hold = true;
+        out.swallow = u16::MAX;
+        out.mono = frame.mono;
+        out.sepia = frame.sepia;
+        if frame.click {
+            out.sounds.push(Sound::Nav);
+        }
+        match frame.request {
+            editor::Request::None => {}
+            editor::Request::Leave => self.editor = None,
+            editor::Request::SaveAndLeave => {
+                let name = format!("replay-{}.skrp", stamp());
+                let path = self.replays_dir().join(&name);
+                if let Some(editor) = self.editor.take() {
+                    match editor.clip.save(&path) {
+                        Ok(()) => {
+                            out.notes.push(format!("saved replay {}", path.display()));
+                            self.toast(format!("Replay saved: {name}"), input.now);
+                            out.sounds.push(Sound::Good);
+                        }
+                        Err(e) => {
+                            out.notes.push(format!("replay not saved: {e}"));
+                            self.toast("The replay could not be saved", input.now);
+                            out.sounds.push(Sound::Bad);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    fn saved_clips(&self) -> Vec<PathBuf> {
+        let mut list: Vec<(std::time::SystemTime, PathBuf)> = std::fs::read_dir(self.replays_dir())
+            .map(|dir| {
+                dir.filter_map(|e| e.ok())
+                    .map(|e| e.path())
+                    .filter(|p| p.extension().is_some_and(|x| x == "skrp"))
+                    .map(|p| (std::fs::metadata(&p).and_then(|m| m.modified()).unwrap_or(std::time::UNIX_EPOCH), p))
+                    .collect()
+            })
+            .unwrap_or_default();
+        list.sort_by(|a, b| b.0.cmp(&a.0));
+        list.into_iter().take(12).map(|(_, p)| p).collect()
+    }
+
+    // --- The Hall of Meat --------------------------------------------------
+
+    fn meat_frame(&mut self, skater: &Skater<'_>, now: f64, out: &mut Output) {
+        let wiping = skater.state == "WipeoutGround";
+        let positions: Vec<V3> = skater.bones.iter().map(translation).collect();
+        let parts = Tracker::parts(skater.names, &positions);
+        let speed = length(skater.velocity);
+        if wiping && self.tracker.is_none() {
+            let hips = parts[6].map_or(translation(&skater.root)[1], |p| p[1]);
+            self.tracker = Some(Tracker::new(skater.time, speed, hips, self.settings.sensitivity));
+            self.calm_since = None;
+        }
+        let Some(tracker) = self.tracker.as_mut() else {
+            self.meat_panel(now, out);
+            return;
+        };
+        tracker.update(skater.time, &parts, speed);
+        let since_hit = (skater.time - tracker.last_hit) as f32;
+        if self.settings.slowmo && self.host.time_scale && since_hit < 0.7 && tracker.meat() > 0. {
+            out.time_scale = 0.35;
+        }
+        if since_hit < 0.3 && tracker.meat() > 0. {
+            out.shake = (1. - since_hit / 0.3) * 0.6;
+        }
+        if wiping {
+            self.calm_since = None;
+        } else if self.calm_since.is_none() {
+            self.calm_since = Some(skater.time);
+        }
+        let done = self.calm_since.is_some_and(|t| skater.time - t > 0.4) || skater.time - tracker.started() > 10.;
+        let show = self.settings.meat != MeatShow::Off;
+        if show {
+            // The live count and the injuries as they happen.
+            let meat = tracker.meat();
+            if meat > 0. {
+                let flash = (1. - since_hit / 0.35).clamp(0., 1.);
+                if flash > 0. {
+                    out.items.push(Item::Screen { sprite: Sprite::Flash, color: [0.85, 0.05, 0.03, 0.55 * flash] });
+                }
+                out.items.push(Item::sprite(Sprite::Splat, Anchor::Right, -190., 96., 70., 70., hud::alpha(hud::MEAT_RED, 0.9)));
+                out.items.push(Item::title("MEAT", Anchor::Right, -40., 104., 12., Align::Right, hud::WHITE));
+                out.items.push(Item::digits(hud::points(meat), Anchor::Right, -40., 118., 26., Align::Right, hud::WHITE));
+            }
+            let fresh: Vec<(f64, usize, meat::Severity)> =
+                tracker.fresh.iter().filter(|(t, _, _)| skater.time - t < 2.5).copied().collect();
+            for (k, (t, region, severity)) in fresh.iter().rev().take(5).enumerate() {
+                let age = (skater.time - t) as f32;
+                let s = hud::pop(age);
+                out.items.push(
+                    Item::title(meat::injury_name(*region, *severity).to_uppercase(), Anchor::Right, -40., 152. + k as f32 * 20., 14. * s, Align::Right, severity.color())
+                        .faded(hud::fade(age, 2.5)),
+                );
+            }
+        }
+        if done {
+            let report = tracker.report(skater.time);
+            self.tracker = None;
+            self.calm_since = None;
+            self.bail_done(report, now, out);
+        }
+        self.meat_panel(now, out);
+    }
+
+    fn bail_done(&mut self, report: Report, now: f64, out: &mut Output) {
+        if report.meat <= 0. {
+            return;
+        }
+        let entry = self.records.by_map.entry(self.map.clone()).or_insert((0., 0., 0));
+        let new_best = report.meat > entry.0;
+        entry.0 = entry.0.max(report.meat);
+        entry.1 += report.meat;
+        entry.2 += 1;
+        self.records.save(&self.dir.join("skate-records.txt"));
+        // A Hall of Meat spot run counts it.
+        if let Some(run) = self.run.as_mut()
+            && run.done.is_none()
+            && run.outside <= 0.
+            && self.spots.get(run.spot).is_some_and(|s| s.kind == Kind::Meat)
+        {
+            run.best = run.best.max(report.meat);
+        }
+        let big = report.meat >= 3000. || report.broken() > 0;
+        let in_meat_run = self.run.as_ref().is_some_and(|r| self.spots.get(r.spot).is_some_and(|s| s.kind == Kind::Meat));
+        let show = match self.settings.meat {
+            MeatShow::Always => true,
+            MeatShow::Big => big,
+            MeatShow::Off => in_meat_run,
+        };
+        if show {
+            self.panel = Some((report, now, new_best));
+            out.sounds.push(Sound::Meat);
+        }
+    }
+
+    fn meat_panel(&mut self, now: f64, out: &mut Output) {
+        if let Some((report, at, new_best)) = &self.panel {
+            let age = (now - at) as f32;
+            if age > 6. {
+                self.panel = None;
+            } else {
+                let best = self.meat_best();
+                out.items.extend(meat::panel(report, best, *new_best, age).into_iter().map(|i| i.faded(hud::fade(age, 6.))));
+            }
+        }
+    }
+
+    // --- Own the Spot -----------------------------------------------------
+
+    fn spot_frame(&mut self, skater: &Skater<'_>, now: f64, dt: f32, out: &mut Output) {
+        // A prompt on coming into a spot.
+        let near = self.spots.list.iter().find(|s| s.inside(skater.world)).map(|s| s.id);
+        match (near, self.entered) {
+            (Some(id), Some((was, _))) if id == was => {}
+            (Some(id), _) => self.entered = Some((id, now)),
+            (None, _) => self.entered = None,
+        }
+        if self.run.is_none()
+            && self.menu.is_none()
+            && let Some((id, at)) = self.entered
+            && now - at < 4.
+            && let Some(spot) = self.spots.get(id)
+        {
+            let a = hud::fade((now - at) as f32, 4.);
+            out.items.push(Item::sprite(Sprite::Pin, Anchor::Center, -150., 40., 22., 22., hud::alpha(hud::SKATE_YELLOW, a)));
+            out.items.push(Item::title(format!("{}: {}", spot.kind.name(), spot.name.to_uppercase()), Anchor::Center, -122., 42., 14., Align::Left, hud::alpha(hud::SKATE_YELLOW, a)));
+            out.items.push(Item::text("Skate menu (LB + Back) to take it on", Anchor::Center, 0., 64., 11., Align::Center, hud::alpha(hud::WHITE, a)));
+        }
+        let Some(run) = self.run.as_mut() else {
+            self.finish_frame(now, out);
+            return;
+        };
+        let Some(spot) = self.spots.get(run.spot).cloned() else {
+            self.run = None;
+            return;
+        };
+        let inside = spot.inside(skater.world);
+        if inside {
+            run.outside = 0.;
+        } else {
+            run.outside += dt;
+            run.void = true;
+        }
+        let banked = *run.banked.get_or_insert(skater.score.completed);
+        if spot.kind == Kind::Line {
+            if skater.score.completed > banked + 0.5 {
+                let line = skater.score.completed - banked;
+                if !run.void {
+                    run.best = run.best.max(line);
+                }
+                run.banked = Some(skater.score.completed);
+                run.void = !inside;
+            } else if skater.score.completed < banked {
+                run.banked = Some(skater.score.completed);
+            }
+            if skater.score.line <= 0. && inside {
+                // A new line starts clean once back inside.
+                run.void = false;
+            }
+        }
+        let live = if run.void { 0. } else { skater.score.line };
+        out.items.extend(spots::run_hud(&spot, run, now, live));
+        if run.left(now) <= 0. {
+            let medal = spot.medal(run.best);
+            let finished = run.clone();
+            if let Some(s) = self.spots.get_mut(spot.id) {
+                s.best = s.best.max(finished.best);
+            }
+            let _ = self.spots.save();
+            out.sounds.push(if medal > Medal::None { Sound::Medal } else { Sound::Bad });
+            self.finish = Some((spot, finished, medal, now));
+            self.run = None;
+        }
+        self.finish_frame(now, out);
+    }
+
+    fn finish_frame(&mut self, now: f64, out: &mut Output) {
+        if let Some((spot, run, medal, at)) = &self.finish {
+            let age = (now - at) as f32;
+            if age > 5. {
+                self.finish = None;
+            } else {
+                out.items.extend(spots::finish_hud(spot, run, *medal, age));
+            }
+        }
+    }
+
+    // --- The Game of S.K.A.T.E. --------------------------------------------
+
+    fn game_frame(&mut self, input: &Input<'_>, ended: Option<Attempt>, out: &mut Output) {
+        let now = input.now;
+        let signals: Vec<(PlayerId, Signal)> = input.peers.iter().map(|p| (p.id, Signal::decode(&p.signal))).collect();
+        let Some(p) = self.playing.as_mut() else {
+            // An invitation shows until answered.
+            if let Some((owner, game)) = invitation(&signals, input.me)
+                && self.menu.is_none()
+            {
+                let name = game.players.iter().find(|pl| pl.id == owner).map_or("A skater", |pl| pl.name.as_str()).to_owned();
+                out.items.push(Item::title(format!("{name} challenges you to S.K.A.T.E.!"), Anchor::Center, 0., 40., 15., Align::Center, hud::SKATE_YELLOW));
+                out.items.push(Item::text("Skate menu (LB + Back) to join", Anchor::Center, 0., 60., 11., Align::Center, hud::WHITE));
+            }
+            return;
+        };
+        let me = input.me;
+        if p.is_owner() {
+            // Joins, attempts and departures from the others.
+            for (id, s) in &signals {
+                p.heard.insert(*id, now);
+                let Some(i) = p.game.index_of(*id) else { continue };
+                if p.game.phase == Phase::Lobby && s.joined == Some(p.game.id) {
+                    p.game.players[i].joined = true;
+                }
+                if let Some((gid, seq, result)) = &s.attempt
+                    && *gid == p.game.id
+                    && *seq == p.game.seq
+                    && p.counted.get(id) != Some(seq)
+                    && p.game.turn() == Some(i)
+                {
+                    p.counted.insert(*id, *seq);
+                    let attempt = match result {
+                        Some(tricks) => Attempt::Landed(tricks.clone()),
+                        None => Attempt::Bailed,
+                    };
+                    p.game.attempt(i, attempt);
+                }
+            }
+            let gone: Vec<usize> = p
+                .game
+                .players
+                .iter()
+                .enumerate()
+                .filter(|(_, pl)| pl.cpu.is_none() && pl.id != me && now - p.heard.get(&pl.id).copied().unwrap_or(now) > 6.)
+                .map(|(i, _)| i)
+                .collect();
+            for i in gone.into_iter().rev() {
+                p.game.remove(i);
+            }
+            // This player's own attempt.
+            if let (Some(attempt), Some(i)) = (ended.clone(), p.game.index_of(me))
+                && p.game.turn() == Some(i)
+                && now - p.turn_at > 1.
+            {
+                p.game.attempt(i, attempt);
+            }
+            // The computer's turn, after a moment to watch.
+            match p.game.turn().and_then(|i| p.game.players[i].cpu.map(|level| (i, level))) {
+                Some((i, level)) => match p.cpu_due {
+                    None => p.cpu_due = Some(now + 3.),
+                    Some(due) if now >= due => {
+                        let attempt = skate_game::cpu_attempt(&p.game, level, p.game.seq.wrapping_mul(31).wrapping_add(p.game.id));
+                        p.game.attempt(i, attempt);
+                        p.cpu_due = None;
+                    }
+                    Some(_) => {}
+                },
+                None => p.cpu_due = None,
+            }
+        } else {
+            match signals.iter().find(|(id, _)| *id == p.owner).and_then(|(_, s)| s.game.clone()).filter(|g| g.id == p.game.id) {
+                Some(game) => {
+                    p.game = game;
+                    p.owner_heard = now;
+                }
+                None if now - p.owner_heard > 6. => {
+                    self.playing = None;
+                    self.toast("The S.K.A.T.E. game ended", now);
+                    return;
+                }
+                None => {}
+            }
+            if let (Some(attempt), Some(i)) = (ended.clone(), p.game.index_of(me))
+                && p.game.turn() == Some(i)
+                && now - p.turn_at > 1.
+                && p.attempt.as_ref().is_none_or(|(_, seq, _)| *seq != p.game.seq)
+            {
+                let result = match attempt {
+                    Attempt::Landed(tricks) => Some(tricks),
+                    Attempt::Bailed => None,
+                };
+                p.attempt = Some((p.game.id, p.game.seq, result));
+            }
+        }
+        // What changed, for banners and sounds.
+        let my_index = p.game.index_of(me);
+        if p.game.seq != p.seen_seq {
+            p.seen_seq = p.game.seq;
+            p.outcome_at = now;
+            match &p.game.last {
+                Some(Outcome::Letter(i)) => out.sounds.push(if Some(*i) == my_index { Sound::Letter } else { Sound::Good }),
+                Some(Outcome::Won(i)) => out.sounds.push(if Some(*i) == my_index { Sound::Win } else { Sound::Lose }),
+                Some(Outcome::Set(..)) | Some(Outcome::Matched(..)) => out.sounds.push(Sound::Good),
+                Some(_) => out.sounds.push(Sound::Bad),
+                None => {}
+            }
+        }
+        let my_turn = my_index.is_some() && p.game.turn() == my_index;
+        if my_turn && !p.my_turn {
+            p.turn_at = now;
+        }
+        p.my_turn = my_turn;
+        if matches!(p.game.phase, Phase::Over { .. }) && p.over_at.is_none() {
+            p.over_at = Some(now);
+        }
+        // The HUD: letters, whose go, the banner.
+        let age = (now - p.outcome_at) as f32;
+        if p.game.phase != Phase::Lobby {
+            out.items.extend(skate_game::board(&p.game, my_index, now as f32, age));
+        }
+        let prompt = match &p.game.phase {
+            Phase::Lobby => {
+                let joined = p.game.players.iter().filter(|pl| pl.joined).count();
+                Some(if p.is_owner() {
+                    format!("S.K.A.T.E.: {joined} in. Start it from the Skate menu")
+                } else {
+                    "S.K.A.T.E.: waiting for the game to start".to_owned()
+                })
+            }
+            Phase::Set { setter } if Some(*setter) == my_index => Some("YOUR SET: land one trick".to_owned()),
+            Phase::Set { setter } => Some(format!("{} IS SETTING", p.game.players[*setter].name.to_uppercase())),
+            Phase::Match { matcher, trick, .. } if Some(*matcher) == my_index => Some(format!("MATCH IT: {}", trick.to_uppercase())),
+            Phase::Match { matcher, trick, .. } => Some(format!("{} MATCHING {}", p.game.players[*matcher].name.to_uppercase(), trick.to_uppercase())),
+            Phase::Over { .. } => None,
+        };
+        if let Some(prompt) = prompt
+            && age > 1.2
+        {
+            let color = if my_turn { hud::SKATE_YELLOW } else { hud::WHITE };
+            let y = 30. + p.game.players.len() as f32 * 24. + 18.;
+            out.items.push(Item::title(prompt, Anchor::Center, 0., y, 15., Align::Center, color));
+        }
+        if let Some((title, sub, color)) = skate_game::banner(&p.game, my_index, age) {
+            let s = hud::pop(age);
+            let a = hud::fade(age, 3.5);
+            out.items.push(Item::rect(Anchor::Center, -2000., 196., 4000., 70., [0., 0., 0., 0.55 * a]));
+            out.items.push(Item::title(title, Anchor::Center, 0., 204., 26. * s, Align::Center, hud::alpha(color, a)));
+            out.items.push(Item::title(sub, Anchor::Center, 0., 238., 16., Align::Center, hud::alpha(hud::WHITE, a)));
+        }
+        if p.over_at.is_some_and(|t| now - t > 6.) {
+            self.playing = None;
+        }
+    }
+
+    fn start_cpu_game(&mut self, me: PlayerId, name: &str, now: f64) {
+        let level = self.level.min(2);
+        let players = vec![
+            Player { id: me, name: name.to_owned(), letters: 0, cpu: None, joined: true },
+            Player {
+                id: skate_game::CPU_BASE + u32::from(level),
+                name: format!("{} ({})", skate_game::CPU_NAMES[usize::from(level)], skate_game::CPU_LEVELS[usize::from(level)]),
+                letters: 0,
+                cpu: Some(level),
+                joined: true,
+            },
+        ];
+        let game = Game::new(game_id(me, now), players, false);
+        self.playing = Some(Playing::new(game, me, now, true));
+    }
+
+    fn start_lobby(&mut self, input: &Input<'_>, skater_world: V3) -> usize {
+        let mut players = vec![Player { id: input.me, name: input.my_name.to_owned(), letters: 0, cpu: None, joined: true }];
+        for peer in nearby(input.peers, skater_world) {
+            players.push(Player { id: peer.id, name: peer.name.clone(), letters: 0, cpu: None, joined: false });
+        }
+        let invited = players.len() - 1;
+        if invited > 0 {
+            let game = Game::new(game_id(input.me, input.now), players, true);
+            self.playing = Some(Playing::new(game, input.me, input.now, true));
+        }
+        invited
+    }
+
+    // --- The menu -----------------------------------------------------------
+
+    fn open_menu(&mut self, page: Page, now: f64) {
+        let clips = if page == Page::Clips { self.saved_clips() } else { Vec::new() };
+        self.menu = Some(MenuState { page, cursor: Cursor::default(), opened: now, clips });
+    }
+
+    fn rows(&self, input: &Input<'_>) -> (String, Vec<Row<Action>>) {
+        let Some(menu) = &self.menu else { return (String::new(), Vec::new()) };
+        let world = input.skater.as_ref().map(|s| s.world);
+        match menu.page {
+            Page::Main => {
+                let mut rows = vec![
+                    Row::new("Replay editor", Action::Replay).off(self.recorder.is_empty()),
+                    Row::new("Saved replays", Action::Clips),
+                    Row::new("Game of S.K.A.T.E.", Action::Page(Page::Skate)),
+                    Row::new("Own the Spot", Action::Page(Page::Spots)),
+                    Row::new("Hall of Meat", Action::MeatShow).value(match self.settings.meat {
+                        MeatShow::Always => "Every bail",
+                        MeatShow::Big => "Big bails",
+                        MeatShow::Off => "Off",
+                    }),
+                ];
+                if self.host.time_scale {
+                    rows.push(Row::new("Bail slow motion", Action::SlowMo).value(if self.settings.slowmo { "On" } else { "Off" }));
+                }
+                rows.push(Row::new("Close", Action::Close));
+                ("SKATE".into(), rows)
+            }
+            Page::Skate => {
+                let mut rows = Vec::new();
+                match &self.playing {
+                    Some(p) if p.is_owner() && p.game.phase == Phase::Lobby => {
+                        let joined = p.game.players.iter().filter(|pl| pl.joined).count() - 1;
+                        rows.push(Row::new(format!("Start the game ({joined} joined)"), Action::StartGame).off(joined == 0));
+                        rows.push(Row::new("Call it off", Action::QuitGame));
+                    }
+                    Some(_) => rows.push(Row::new("Quit the game", Action::QuitGame)),
+                    None => {
+                        let signals: Vec<(PlayerId, Signal)> = input.peers.iter().map(|p| (p.id, Signal::decode(&p.signal))).collect();
+                        if let Some((owner, game)) = invitation(&signals, input.me) {
+                            let name = game.players.iter().find(|pl| pl.id == owner).map_or("their", |pl| pl.name.as_str());
+                            rows.push(Row::new(format!("Join {name}'s game"), Action::Join));
+                        }
+                        rows.push(Row::new("Against the computer", Action::VsCpu).value(skate_game::CPU_LEVELS[usize::from(self.level.min(2))]));
+                        let count = world.map_or(0, |w| nearby(input.peers, w).len());
+                        rows.push(Row::new(format!("Against skaters nearby ({count})"), Action::VsNearby).off(count == 0));
+                    }
+                }
+                rows.push(Row::new("Back", Action::Back));
+                ("S.K.A.T.E.".into(), rows)
+            }
+            Page::Spots => {
+                let mut rows = Vec::new();
+                let nearest = world.and_then(|w| self.spots.nearest(w, 60.));
+                if self.run.is_some() {
+                    rows.push(Row::new("Stop the run", Action::StopRun));
+                }
+                match nearest {
+                    Some(spot) => {
+                        rows.push(Row::new(format!("Take on {}", spot.name), Action::StartSpot).off(self.run.is_some()));
+                        rows.push(Row::new("Own target", Action::Target(false)).value(hud::points(spot.own)));
+                        rows.push(Row::new("Kill target", Action::Target(true)).value(hud::points(spot.kill)));
+                        rows.push(Row::new(format!("Delete {}", spot.name), Action::DeleteSpot));
+                    }
+                    None => rows.push(Row::new("No spot near here", Action::Back).off(true)),
+                }
+                rows.push(Row::new("New spot here: best line", Action::NewSpot(Kind::Line)));
+                rows.push(Row::new("New spot here: Hall of Meat", Action::NewSpot(Kind::Meat)));
+                rows.push(Row::new("Back", Action::Back));
+                ("OWN THE SPOT".into(), rows)
+            }
+            Page::Clips => {
+                let mut rows: Vec<Row<Action>> = menu
+                    .clips
+                    .iter()
+                    .enumerate()
+                    .map(|(i, p)| Row::new(p.file_stem().map_or_else(|| "replay".into(), |s| s.to_string_lossy().into_owned()), Action::OpenClip(i)))
+                    .collect();
+                if rows.is_empty() {
+                    rows.push(Row::new("No saved replays yet", Action::Back).off(true));
+                }
+                rows.push(Row::new("Back", Action::Back));
+                ("SAVED REPLAYS".into(), rows)
+            }
+        }
+    }
+
+    fn menu_frame(&mut self, input: &Input<'_>, pressed: u16, out: &mut Output) {
+        let now = input.now;
+        let (title, rows) = self.rows(input);
+        let Some(menu) = self.menu.as_mut() else { return };
+        let nav = Nav { pressed, held: input.pad.buttons, stick: input.pad.left };
+        let before = menu.cursor.row;
+        let choice = menu.cursor.update(&rows, nav, input.dt);
+        if menu.cursor.row != before {
+            out.sounds.push(Sound::Nav);
+        }
+        let age = (now - menu.opened) as f32;
+        let page = menu.page;
+        let drawn = menu::draw(&title, &rows, &menu.cursor, input.labels, age);
+        out.items.extend(drawn);
+        let world = input.skater.as_ref().map(|s| s.world);
+        match choice {
+            Choice::None => {}
+            Choice::Back => {
+                out.sounds.push(Sound::Back);
+                if page == Page::Main {
+                    self.menu = None;
+                } else {
+                    self.open_menu(Page::Main, now);
+                }
+            }
+            Choice::Change(action, step) => {
+                out.sounds.push(Sound::Nav);
+                self.change(action, step, world);
+            }
+            Choice::Pick(action) => {
+                out.sounds.push(Sound::Select);
+                self.pick(action, input, world, out);
+            }
+        }
+    }
+
+    fn change(&mut self, action: Action, step: i32, world: Option<V3>) {
+        match action {
+            Action::MeatShow => {
+                let order = [MeatShow::Always, MeatShow::Big, MeatShow::Off];
+                let i = order.iter().position(|m| *m == self.settings.meat).unwrap_or(0) as i32;
+                self.settings.meat = order[(i + step).rem_euclid(3) as usize];
+                self.settings.save(&self.dir.join("skate-modes.txt"));
+            }
+            Action::SlowMo => {
+                self.settings.slowmo = !self.settings.slowmo;
+                self.settings.save(&self.dir.join("skate-modes.txt"));
+            }
+            Action::VsCpu => self.level = (i32::from(self.level) + step).rem_euclid(3) as u8,
+            Action::Target(kill) => {
+                if let Some(id) = world.and_then(|w| self.spots.nearest(w, 60.)).map(|s| s.id)
+                    && let Some(spot) = self.spots.get_mut(id)
+                {
+                    let unit = if spot.kind == Kind::Meat { 1_000. } else { 5_000. };
+                    if kill {
+                        spot.kill = (spot.kill + unit * step as f32).max(spot.own + unit);
+                    } else {
+                        spot.own = (spot.own + unit * step as f32).clamp(unit, spot.kill - unit);
+                    }
+                    let _ = self.spots.save();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn pick(&mut self, action: Action, input: &Input<'_>, world: Option<V3>, out: &mut Output) {
+        let now = input.now;
+        match action {
+            Action::Replay => {
+                self.open_replay(now);
+            }
+            Action::Clips => self.open_menu(Page::Clips, now),
+            Action::OpenClip(i) => {
+                let path = self.menu.as_ref().and_then(|m| m.clips.get(i)).cloned();
+                if let Some(path) = path {
+                    match Clip::load(&path) {
+                        Ok(clip) if clip.map == self.map || self.map.is_empty() => {
+                            self.editor = Some(Editor::new(clip, now, self.host.colour));
+                            self.menu = None;
+                        }
+                        Ok(_) => self.toast("That replay is from another map", now),
+                        Err(e) => {
+                            out.notes.push(e);
+                            self.toast("That replay could not be read", now);
+                        }
+                    }
+                }
+            }
+            Action::Page(page) => self.open_menu(page, now),
+            Action::MeatShow | Action::SlowMo | Action::Target(_) => self.change(action, 1, world),
+            Action::Close => self.menu = None,
+            Action::Back => self.open_menu(Page::Main, now),
+            Action::VsCpu => {
+                self.start_cpu_game(input.me, input.my_name, now);
+                self.menu = None;
+            }
+            Action::VsNearby => {
+                if let Some(world) = world {
+                    let n = self.start_lobby(input, world);
+                    self.toast(format!("Challenge sent to {n} skater{}", if n == 1 { "" } else { "s" }), now);
+                }
+                self.menu = None;
+            }
+            Action::Join => {
+                let signals: Vec<(PlayerId, Signal)> = input.peers.iter().map(|p| (p.id, Signal::decode(&p.signal))).collect();
+                if let Some((owner, game)) = invitation(&signals, input.me) {
+                    let mut playing = Playing::new(game, owner, now, false);
+                    playing.joined = true;
+                    self.playing = Some(playing);
+                }
+                self.menu = None;
+            }
+            Action::StartGame => {
+                if let Some(p) = self.playing.as_mut()
+                    && p.game.start()
+                {
+                    p.turn_at = now;
+                }
+                self.menu = None;
+            }
+            Action::QuitGame => {
+                self.playing = None;
+                self.menu = None;
+            }
+            Action::StartSpot => {
+                if let Some(id) = world.and_then(|w| self.spots.nearest(w, 60.)).map(|s| s.id) {
+                    self.run = Some(Run { spot: id, started: now, seconds: spots::RUN_SECONDS, best: 0., outside: 0., banked: None, void: false, done: None });
+                    self.finish = None;
+                }
+                self.menu = None;
+            }
+            Action::StopRun => {
+                self.run = None;
+                self.menu = None;
+            }
+            Action::NewSpot(kind) => {
+                if let Some(world) = world {
+                    let id = self.spots.create(kind, world, input.place);
+                    let _ = self.spots.save();
+                    let name = self.spots.get(id).map(|s| s.name.clone()).unwrap_or_default();
+                    self.toast(format!("New spot: {name}"), now);
+                }
+                self.open_menu(Page::Spots, now);
+            }
+            Action::DeleteSpot => {
+                if let Some(id) = world.and_then(|w| self.spots.nearest(w, 60.)).map(|s| s.id) {
+                    self.spots.remove(id);
+                    let _ = self.spots.save();
+                    if self.run.as_ref().is_some_and(|r| r.spot == id) {
+                        self.run = None;
+                    }
+                }
+                self.open_menu(Page::Spots, now);
+            }
+        }
+    }
+}
+
+impl Playing {
+    fn new(game: Game, owner: PlayerId, now: f64, mine: bool) -> Self {
+        Self {
+            mine,
+            seen_seq: game.seq,
+            game,
+            owner,
+            outcome_at: now - 10.,
+            turn_at: now,
+            my_turn: false,
+            cpu_due: None,
+            heard: HashMap::new(),
+            counted: HashMap::new(),
+            attempt: None,
+            owner_heard: now,
+            joined: true,
+            over_at: None,
+        }
+    }
+
+    fn is_owner(&self) -> bool {
+        self.mine
+    }
+}
+
+/// A game someone invited `me` to: its owner and the game.
+fn invitation(signals: &[(PlayerId, Signal)], me: PlayerId) -> Option<(PlayerId, Game)> {
+    signals.iter().find_map(|(id, s)| {
+        let game = s.game.as_ref()?;
+        (game.phase == Phase::Lobby && game.players.first().is_some_and(|p| p.id == *id) && game.index_of(me).is_some()).then(|| (*id, game.clone()))
+    })
+}
+
+/// Skating players within 60 metres.
+fn nearby(peers: &[Peer], at: V3) -> Vec<&Peer> {
+    peers.iter().filter(|p| p.skating && p.world.is_some_and(|w| distance(w, at) < 60.)).take(5).collect()
+}
+
+fn game_id(me: PlayerId, now: f64) -> u32 {
+    me.wrapping_mul(2_654_435_761) ^ ((now * 1000.) as u64 as u32)
+}
+
+fn spots_path(dir: &Path, map: &str) -> PathBuf {
+    let name = if map.is_empty() { "skate-spots.txt".to_owned() } else { format!("skate-spots-{}.txt", safe(map)) };
+    dir.join(name)
+}
+
+/// A name safe for a file.
+fn safe(text: &str) -> String {
+    text.chars().map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' { c } else { '_' }).collect()
+}
+
+/// "2026-10-07-1830-15" for now, from the system clock.
+fn stamp() -> String {
+    let secs = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs()) as i64;
+    let days = secs.div_euclid(86_400);
+    let rest = secs.rem_euclid(86_400);
+    // Days to a civil date (Howard Hinnant's algorithm).
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = yoe + era * 400 + i64::from(m <= 2);
+    format!("{y:04}-{m:02}-{d:02}-{:02}{:02}-{:02}", rest / 3600, rest % 3600 / 60, rest % 60)
+}
diff --git a/crates/skate_modes/src/replay.rs b/crates/skate_modes/src/replay.rs
new file mode 100644
index 0000000..84cb24b
--- /dev/null
+++ b/crates/skate_modes/src/replay.rs
@@ -0,0 +1,478 @@
+//! The replay: the last minute of skating kept frame by frame (the skater's
+//! pose, the board's sounds and the game's camera), cut into clips the
+//! editor films and saves.
+
+use std::collections::VecDeque;
+use std::io::{Read, Write};
+use std::path::Path;
+
+use crate::filmer::Key;
+use crate::math::{M4, Quat, V3, lerp, lerp_f, matrix, quat_from_matrix, slerp, translation};
+
+/// A bone as a replay keeps it: where it is, and its rotation packed small.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Bone {
+    pub p: V3,
+    pub q: [i16; 4],
+}
+
+impl Bone {
+    pub fn from_matrix(m: &M4) -> Self {
+        let q = quat_from_matrix(m);
+        Self { p: translation(m), q: q.map(|v| (v.clamp(-1., 1.) * 32767.).round() as i16) }
+    }
+
+    pub fn rotation(&self) -> Quat {
+        crate::math::quat_normalize(self.q.map(|v| f32::from(v) / 32767.))
+    }
+
+    pub fn matrix(&self) -> M4 {
+        matrix(self.rotation(), self.p)
+    }
+
+    pub fn lerp(&self, other: &Self, t: f32) -> M4 {
+        matrix(slerp(self.rotation(), other.rotation(), t), lerp(self.p, other.p, t))
+    }
+}
+
+/// What the board does, for its sounds (see `skate_sound`).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Cue {
+    pub state: u8,
+    pub speed: f32,
+    pub vertical: f32,
+    pub surface: u8,
+    pub wheels: u8,
+}
+
+/// A camera in Skate space: position, basis (right, up, forward) and
+/// vertical field of view in degrees.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Camera {
+    pub position: V3,
+    pub basis: [V3; 3],
+    pub fov: f32,
+}
+
+/// One frame of a replay.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Sample {
+    /// Seconds of the session's clock.
+    pub time: f64,
+    pub root: Bone,
+    pub bones: Vec<Bone>,
+    pub cue: Cue,
+    pub camera: Option<Camera>,
+}
+
+/// A skater pose a replay gives back: the root and every bone, in Skate
+/// space, as matrices.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Pose {
+    pub root: M4,
+    pub bones: Vec<M4>,
+    pub cue: Cue,
+    pub camera: Option<Camera>,
+}
+
+/// Keeps the last stretch of skating.
+#[derive(Clone, Debug)]
+pub struct Recorder {
+    pub seconds: f32,
+    names: Vec<String>,
+    board: String,
+    origin: V3,
+    samples: VecDeque<Sample>,
+}
+
+impl Recorder {
+    pub fn new(seconds: f32) -> Self {
+        Self { seconds, names: Vec::new(), board: String::new(), origin: [0.; 3], samples: VecDeque::new() }
+    }
+
+    pub fn clear(&mut self) {
+        self.samples.clear();
+    }
+
+    pub fn len_seconds(&self) -> f32 {
+        match (self.samples.front(), self.samples.back()) {
+            (Some(a), Some(b)) => (b.time - a.time) as f32,
+            _ => 0.,
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.samples.len() < 2
+    }
+
+    /// Keeps a frame. A different skeleton or world offset starts over: a
+    /// replay is one stretch of one skater.
+    #[allow(clippy::too_many_arguments)]
+    pub fn push(&mut self, time: f64, names: &[String], root: &M4, bones: &[M4], cue: Cue, camera: Option<Camera>, board: &str, origin: V3) {
+        if names != self.names.as_slice() || origin != self.origin {
+            self.samples.clear();
+            self.names = names.to_vec();
+            self.origin = origin;
+        }
+        if self.samples.back().is_some_and(|s| time <= s.time) {
+            // The same frame again (or the clock went back: a new session).
+            if self.samples.back().is_some_and(|s| time < s.time - 1.) {
+                self.samples.clear();
+            } else {
+                return;
+            }
+        }
+        if board != self.board {
+            self.board = board.to_owned();
+        }
+        self.samples.push_back(Sample {
+            time,
+            root: Bone::from_matrix(root),
+            bones: bones.iter().map(Bone::from_matrix).collect(),
+            cue,
+            camera,
+        });
+        while self.samples.front().is_some_and(|s| time - s.time > f64::from(self.seconds)) {
+            self.samples.pop_front();
+        }
+    }
+
+    /// What was recorded, as a clip.
+    pub fn clip(&self, map: &str) -> Option<Clip> {
+        if self.is_empty() {
+            return None;
+        }
+        let start = self.samples.front()?.time;
+        let samples: Vec<Sample> = self
+            .samples
+            .iter()
+            .map(|s| Sample { time: s.time - start, ..s.clone() })
+            .collect();
+        let length = samples.last()?.time as f32;
+        Some(Clip {
+            names: self.names.clone(),
+            board: self.board.clone(),
+            map: map.to_owned(),
+            origin: self.origin,
+            samples,
+            keys: Vec::new(),
+            trim: (0., length),
+            look: 0,
+        })
+    }
+}
+
+/// A replay cut from the recorder, with the editor's cameras.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Clip {
+    pub names: Vec<String>,
+    pub board: String,
+    /// The map it was skated on (the mashup), empty for GTA's one world.
+    pub map: String,
+    /// The game's offset of Skate space when it was recorded (GTA).
+    pub origin: V3,
+    /// Times from 0.
+    pub samples: Vec<Sample>,
+    pub keys: Vec<Key>,
+    /// The part kept: start and end seconds.
+    pub trim: (f32, f32),
+    /// The look (see `filmer::LOOKS`).
+    pub look: u8,
+}
+
+impl Clip {
+    pub fn length(&self) -> f32 {
+        self.samples.last().map_or(0., |s| s.time as f32)
+    }
+
+    /// The samples either side of `t` and how far between.
+    fn around(&self, t: f32) -> Option<(&Sample, &Sample, f32)> {
+        if self.samples.is_empty() {
+            return None;
+        }
+        let t = f64::from(t.clamp(0., self.length()));
+        let i = self.samples.partition_point(|s| s.time <= t);
+        let b = self.samples.get(i.min(self.samples.len() - 1))?;
+        let a = self.samples.get(i.saturating_sub(1))?;
+        let span = (b.time - a.time) as f32;
+        let f = if span > 1e-6 { ((t - a.time) as f32 / span).clamp(0., 1.) } else { 0. };
+        Some((a, b, f))
+    }
+
+    /// The pose at `t` seconds, between the frames either side.
+    pub fn pose(&self, t: f32) -> Option<Pose> {
+        let (a, b, f) = self.around(t)?;
+        let bones = a.bones.iter().zip(&b.bones).map(|(x, y)| x.lerp(y, f)).collect();
+        let cue = if f < 0.5 { a.cue } else { b.cue };
+        let camera = match (a.camera, b.camera) {
+            (Some(x), Some(y)) => Some(Camera {
+                position: lerp(x.position, y.position, f),
+                basis: [0, 1, 2].map(|k| crate::math::normalize_or(lerp(x.basis[k], y.basis[k], f), x.basis[k])),
+                fov: lerp_f(x.fov, y.fov, f),
+            }),
+            (x, y) => x.or(y),
+        };
+        Some(Pose { root: a.root.lerp(&b.root, f), bones, cue, camera })
+    }
+
+    /// Where bone `name` is at `t`, or the root.
+    pub fn point(&self, t: f32, name: &str) -> Option<V3> {
+        let (a, b, f) = self.around(t)?;
+        match self.names.iter().position(|n| n.eq_ignore_ascii_case(name)) {
+            Some(i) => Some(lerp(a.bones.get(i)?.p, b.bones.get(i)?.p, f)),
+            None => Some(lerp(a.root.p, b.root.p, f)),
+        }
+    }
+
+    /// The skater's middle (hips, or the root) at `t`.
+    pub fn subject(&self, t: f32) -> Option<V3> {
+        self.point(t, "HIPS")
+    }
+
+    /// The subject's average velocity over `window` seconds about `t`.
+    pub fn velocity(&self, t: f32, window: f32) -> V3 {
+        let a = (t - window * 0.5).max(0.);
+        let b = (t + window * 0.5).min(self.length());
+        match (self.subject(a), self.subject(b)) {
+            (Some(p), Some(q)) if b - a > 1e-3 => crate::math::scale(crate::math::sub(q, p), 1. / (b - a)),
+            _ => [0.; 3],
+        }
+    }
+
+    /// Saves the clip.
+    pub fn save(&self, path: &Path) -> Result<(), String> {
+        let mut out = Vec::new();
+        out.extend_from_slice(MAGIC);
+        put_u32(&mut out, VERSION);
+        put_str(&mut out, &self.map);
+        put_str(&mut out, &self.board);
+        for v in self.origin {
+            put_f32(&mut out, v);
+        }
+        put_f32(&mut out, self.trim.0);
+        put_f32(&mut out, self.trim.1);
+        out.push(self.look);
+        put_u32(&mut out, self.names.len() as u32);
+        for name in &self.names {
+            put_str(&mut out, name);
+        }
+        put_u32(&mut out, self.keys.len() as u32);
+        for key in &self.keys {
+            key.write(&mut out);
+        }
+        put_u32(&mut out, self.samples.len() as u32);
+        for s in &self.samples {
+            put_f64(&mut out, s.time);
+            put_bone(&mut out, &s.root);
+            for i in 0..self.names.len() {
+                put_bone(&mut out, s.bones.get(i).unwrap_or(&s.root));
+            }
+            out.push(s.cue.state);
+            put_f32(&mut out, s.cue.speed);
+            put_f32(&mut out, s.cue.vertical);
+            out.push(s.cue.surface);
+            out.push(s.cue.wheels);
+            match s.camera {
+                None => out.push(0),
+                Some(c) => {
+                    out.push(1);
+                    for v in c.position.iter().chain(c.basis.iter().flatten()) {
+                        put_f32(&mut out, *v);
+                    }
+                    put_f32(&mut out, c.fov);
+                }
+            }
+        }
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+        }
+        let mut file = std::fs::File::create(path).map_err(|e| format!("{}: {e}", path.display()))?;
+        file.write_all(&out).map_err(|e| format!("{}: {e}", path.display()))
+    }
+
+    /// Loads a saved clip.
+    pub fn load(path: &Path) -> Result<Self, String> {
+        let mut bytes = Vec::new();
+        std::fs::File::open(path)
+            .and_then(|mut f| f.read_to_end(&mut bytes))
+            .map_err(|e| format!("{}: {e}", path.display()))?;
+        Self::from_bytes(&bytes).ok_or_else(|| format!("{} is not a Skate replay", path.display()))
+    }
+
+    fn from_bytes(bytes: &[u8]) -> Option<Self> {
+        let mut r = Reader { bytes, at: 0 };
+        if r.take(4)? != MAGIC || r.u32()? != VERSION {
+            return None;
+        }
+        let map = r.string()?;
+        let board = r.string()?;
+        let origin = [r.f32()?, r.f32()?, r.f32()?];
+        let trim = (r.f32()?, r.f32()?);
+        let look = r.u8()?;
+        let count = r.u32()? as usize;
+        if count > 4096 {
+            return None;
+        }
+        let names = (0..count).map(|_| r.string()).collect::<Option<Vec<_>>>()?;
+        let key_count = r.u32()? as usize;
+        if key_count > 10_000 {
+            return None;
+        }
+        let keys = (0..key_count).map(|_| Key::read(&mut r)).collect::<Option<Vec<_>>>()?;
+        let sample_count = r.u32()? as usize;
+        if sample_count > 1_000_000 {
+            return None;
+        }
+        let mut samples = Vec::with_capacity(sample_count);
+        for _ in 0..sample_count {
+            let time = r.f64()?;
+            let root = r.bone()?;
+            let bones = (0..count).map(|_| r.bone()).collect::<Option<Vec<_>>>()?;
+            let cue = Cue { state: r.u8()?, speed: r.f32()?, vertical: r.f32()?, surface: r.u8()?, wheels: r.u8()? };
+            let camera = match r.u8()? {
+                0 => None,
+                _ => {
+                    let mut v = [0f32; 13];
+                    for x in &mut v {
+                        *x = r.f32()?;
+                    }
+                    Some(Camera {
+                        position: [v[0], v[1], v[2]],
+                        basis: [[v[3], v[4], v[5]], [v[6], v[7], v[8]], [v[9], v[10], v[11]]],
+                        fov: v[12],
+                    })
+                }
+            };
+            samples.push(Sample { time, root, bones, cue, camera });
+        }
+        Some(Self { names, board, map, origin, samples, keys, trim, look })
+    }
+}
+
+const MAGIC: &[u8; 4] = b"SKRP";
+const VERSION: u32 = 1;
+
+pub(crate) fn put_u32(out: &mut Vec<u8>, v: u32) {
+    out.extend_from_slice(&v.to_le_bytes());
+}
+pub(crate) fn put_f32(out: &mut Vec<u8>, v: f32) {
+    out.extend_from_slice(&v.to_le_bytes());
+}
+fn put_f64(out: &mut Vec<u8>, v: f64) {
+    out.extend_from_slice(&v.to_le_bytes());
+}
+fn put_str(out: &mut Vec<u8>, s: &str) {
+    put_u32(out, s.len() as u32);
+    out.extend_from_slice(s.as_bytes());
+}
+fn put_bone(out: &mut Vec<u8>, b: &Bone) {
+    for v in b.p {
+        put_f32(out, v);
+    }
+    for v in b.q {
+        out.extend_from_slice(&v.to_le_bytes());
+    }
+}
+
+pub(crate) struct Reader<'a> {
+    bytes: &'a [u8],
+    at: usize,
+}
+
+impl Reader<'_> {
+    fn take(&mut self, n: usize) -> Option<&[u8]> {
+        let out = self.bytes.get(self.at..self.at.checked_add(n)?)?;
+        self.at += n;
+        Some(out)
+    }
+    pub(crate) fn u8(&mut self) -> Option<u8> {
+        Some(self.take(1)?[0])
+    }
+    pub(crate) fn u32(&mut self) -> Option<u32> {
+        Some(u32::from_le_bytes(self.take(4)?.try_into().ok()?))
+    }
+    pub(crate) fn f32(&mut self) -> Option<f32> {
+        let v = f32::from_le_bytes(self.take(4)?.try_into().ok()?);
+        v.is_finite().then_some(v)
+    }
+    fn f64(&mut self) -> Option<f64> {
+        let v = f64::from_le_bytes(self.take(8)?.try_into().ok()?);
+        v.is_finite().then_some(v)
+    }
+    fn string(&mut self) -> Option<String> {
+        let n = self.u32()? as usize;
+        if n > 4096 {
+            return None;
+        }
+        String::from_utf8(self.take(n)?.to_vec()).ok()
+    }
+    fn bone(&mut self) -> Option<Bone> {
+        let p = [self.f32()?, self.f32()?, self.f32()?];
+        let mut q = [0i16; 4];
+        for v in &mut q {
+            *v = i16::from_le_bytes(self.take(2)?.try_into().ok()?);
+        }
+        Some(Bone { p, q })
+    }
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+    use crate::math::matrix;
+
+    /// A recorder with a skater rolling along +z at 5 m/s for `seconds`.
+    pub(crate) fn rolling(seconds: f32) -> Recorder {
+        let names: Vec<String> = ["HIPS", "HEAD"].iter().map(|s| s.to_string()).collect();
+        let mut r = Recorder::new(60.);
+        let frames = (seconds * 60.) as usize;
+        for i in 0..=frames {
+            let t = i as f64 / 60.;
+            let z = t as f32 * 5.;
+            let root = matrix([0., 0., 0., 1.], [0., 0., z]);
+            let bones = [matrix([0., 0., 0., 1.], [0., 1., z]), matrix([0., 0., 0., 1.], [0., 1.7, z])];
+            let camera = Camera { position: [0., 2., z - 4.], basis: [[1., 0., 0.], [0., 1., 0.], [0., 0., 1.]], fov: 60. };
+            r.push(100. + t, &names, &root, &bones, Cue { state: 1, speed: 5., ..Default::default() }, Some(camera), "deck=x", [1., 2., 3.]);
+        }
+        r
+    }
+
+    #[test]
+    fn records_interpolates_and_trims_to_its_length() {
+        let mut r = rolling(2.);
+        assert!((r.len_seconds() - 2.).abs() < 1e-3);
+        let clip = r.clip("mp_rust").unwrap();
+        assert_eq!(clip.samples[0].time, 0.);
+        let pose = clip.pose(1.005).unwrap();
+        assert!((pose.bones[0][14] - 5.025).abs() < 1e-3, "{}", pose.bones[0][14]);
+        assert!((clip.subject(1.).unwrap()[2] - 5.).abs() < 1e-3);
+        assert!((clip.velocity(1., 0.5)[2] - 5.).abs() < 1e-2);
+        assert!(clip.pose(-1.).is_some() && clip.pose(99.).is_some());
+        // A new skeleton starts over; the oldest frames fall off the end.
+        r.seconds = 1.;
+        let names = vec!["HIPS".to_string()];
+        let m = matrix([0., 0., 0., 1.], [0.; 3]);
+        r.push(200., &names, &m, &[m], Cue::default(), None, "", [1., 2., 3.]);
+        assert!(r.is_empty());
+    }
+
+    #[test]
+    fn clips_save_and_load() {
+        let mut clip = rolling(0.5).clip("mp_rust").unwrap();
+        clip.keys.push(Key::new(0.2, crate::filmer::Shot::Fisheye));
+        clip.trim = (0.1, 0.4);
+        clip.look = 2;
+        let dir = std::env::temp_dir().join(format!("skate-modes-test-{}", std::process::id()));
+        let path = dir.join("clip.skrp");
+        clip.save(&path).unwrap();
+        let back = Clip::load(&path).unwrap();
+        assert_eq!(back.names, clip.names);
+        assert_eq!(back.keys, clip.keys);
+        assert_eq!(back.samples.len(), clip.samples.len());
+        assert_eq!(back.samples[3], clip.samples[3]);
+        assert_eq!((back.trim, back.look, back.origin), ((0.1, 0.4), 2, [1., 2., 3.]));
+        std::fs::write(&path, b"nope").unwrap();
+        assert!(Clip::load(&path).is_err());
+        let _ = std::fs::remove_dir_all(dir);
+    }
+}
