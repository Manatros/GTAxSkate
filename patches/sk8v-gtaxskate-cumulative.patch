+
+    fn model(id: &str) -> Value {
+        json!({"id": id, "name": id, "flags": {}, "lods": []})
+    }
+
+    #[test]
+    fn keeps_board_parts_and_the_default_skater_only() {
+        let mut components = vec![
+            json!({"slot": "SkateBoard", "models": [model("aa"), model("bb")]}),
+            json!({"slot": "Misc", "models": [model("cc")]}),
+            json!({"slot": "Hat", "models": [model("dd")]}),
+        ];
+        for (slot, asset) in DEFAULT_SKATER {
+            if slot == "SkateBoard" {
+                components[0]["models"].as_array_mut().unwrap().push(model(asset));
+                continue;
+            }
+            components.push(json!({"slot": slot, "models": [model(asset), model("ee")]}));
+        }
+        let full = json!({"version": 1, "materials": {}, "components": components});
+        let boards = board_catalog(&full).unwrap();
+        let slots: Vec<&str> = boards["components"].as_array().unwrap().iter().map(|c| c["slot"].as_str().unwrap()).collect();
+        assert!(!slots.contains(&"Misc") && !slots.contains(&"Hat"));
+        assert_eq!(slots.len(), 10);
+        let deck = &boards["components"][0];
+        assert_eq!(deck["models"].as_array().unwrap().len(), 3, "every deck is kept");
+        let arm = boards["components"].as_array().unwrap().iter().find(|c| c["slot"] == "Arm").unwrap();
+        assert_eq!(arm["models"].as_array().unwrap().len(), 1, "only the default arm");
+        assert_eq!(boards["materials"], json!({}));
+    }
+
+    #[test]
+    fn the_character_catalog_keeps_only_the_default_board() {
+        let full = json!({"materials": {}, "components": [
+            {"slot": "SkateBoard", "models": [model("aa"), model("a841a65d5c4dd593")]},
+            {"slot": "Hair", "models": [model("bb"), model("cc")]},
+            {"slot": "Pants", "models": [model("dd")]},
+        ]});
+        let parts = character_catalog(&full).unwrap();
+        let slots: Vec<&str> = parts["components"].as_array().unwrap().iter().map(|c| c["slot"].as_str().unwrap()).collect();
+        assert_eq!(slots, ["SkateBoard", "Hair", "Pants"]);
+        let decks: Vec<&str> = parts["components"][0]["models"].as_array().unwrap().iter().map(|m| m["id"].as_str().unwrap()).collect();
+        assert_eq!(decks, ["a841a65d5c4dd593"], "only the default skater's deck");
+        assert!(character_catalog(&json!({"components": [{"slot": "SkateWheel", "models": []}]})).is_err());
+        let missing = default_skater_missing(&parts);
+        assert!(missing.contains(&"Arm af71f8ae8ef28d10".to_owned()) && !missing.iter().any(|m| m.starts_with("SkateBoard")));
+    }
+
+    #[test]
+    fn a_catalog_without_the_default_skater_is_refused() {
+        let full = json!({"components": [{"slot": "SkateBoard", "models": [model("aa")]}]});
+        assert!(board_catalog(&full).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn runs_both_converter_tasks() {
+        use std::os::unix::fs::PermissionsExt;
+        let root = std::env::temp_dir().join(format!("skate-boards-run-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let game = root.join("game");
+        let assets = root.join("assets");
+        std::fs::create_dir_all(game.join("data/content")).unwrap();
+        std::fs::write(game.join("data/content/createacharacter.big"), b"").unwrap();
+        std::fs::create_dir_all(&assets).unwrap();
+        let mut components: Vec<Value> = DEFAULT_SKATER
+            .iter()
+            .map(|(slot, asset)| json!({"slot": slot, "models": [model(asset)]}))
+            .collect();
+        components.push(json!({"slot": "Hat", "models": [model("aa")]}));
+        let catalog = json!({"materials": {}, "components": components}).to_string();
+        let library = r#"{"models":{"d":{"slot":"SkateBoard","name":"Deck","materials":["m"],"scene":"x"}},"materials":{"m":{"name":"Flames","diffuse":"m.png"}}}"#;
+        let script = format!(
+            "#!/bin/sh\nif [ \"$2\" = \"{CATALOG_TASK}\" ]; then mkdir -p \"$6\"; printf '%s' '{catalog}' > \"$6/catalog.json\"; echo '{{}}' > \"$6/native.json\"; echo CAC_CATALOG_READY; exit 0; fi\n\
+             dir=$(dirname \"$3\"); test -f \"$dir/catalog.json\" || exit 3; grep -q Hat \"$dir/catalog.json\" && exit 4; printf '%s' '{library}' > \"$dir/library.json\"; echo LIBRARY_READY\n"
+        );
+        let converter = root.join("convert.sh");
+        std::fs::write(&converter, script).unwrap();
+        std::fs::set_permissions(&converter, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let mut lines = Vec::new();
+        let count = prepare(&converter, &game, &assets, |line| lines.push(line.to_owned())).unwrap();
+        assert_eq!(count, 1);
+        assert!(lines.iter().any(|l| l == "LIBRARY_READY"), "{lines:?}");
+        assert!(crate::Library::exists(&assets));
+
+        let failing = root.join("fail.sh");
+        std::fs::write(&failing, "#!/bin/sh\necho working\necho 'ValueError: no catalog' >&2\nexit 1\n").unwrap();
+        std::fs::set_permissions(&failing, std::fs::Permissions::from_mode(0o755)).unwrap();
+        assert_eq!(prepare(&failing, &game, &assets, |_| {}).unwrap_err(), "ValueError: no catalog");
+        assert!(prepare(&converter, &root, &assets, |_| {}).is_err(), "not a game folder");
+        let _ = std::fs::remove_dir_all(&root);
+    }
+}
diff --git a/rust/skate-boards/src/glb.rs b/rust/skate-boards/src/glb.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2ff364aad4bfcf266f9b14f88516c9e3c7692208
--- /dev/null
+++ b/rust/skate-boards/src/glb.rs
@@ -0,0 +1,189 @@
+//! Just enough of glTF's binary container to read the skinned meshes the
+//! Skate 3 converter writes: accessors, skins and embedded PNG images.
+
+use serde_json::{Map, Value};
+
+pub struct Glb<'a> {
+    pub json: Value,
+    blob: &'a [u8],
+}
+
+pub fn index(value: &Value) -> Result<usize, String> {
+    value
+        .as_u64()
+        .map(|v| v as usize)
+        .ok_or_else(|| format!("expected an index, found {value}"))
+}
+
+impl<'a> Glb<'a> {
+    pub fn parse(bytes: &'a [u8]) -> Result<Self, String> {
+        let word = |at: usize| -> Result<usize, String> {
+            bytes
+                .get(at..at + 4)
+                .map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]) as usize)
+                .ok_or_else(|| "truncated GLB".to_owned())
+        };
+        if bytes.get(..4) != Some(b"glTF") {
+            return Err("not a GLB file".into());
+        }
+        let json_len = word(12)?;
+        let json_bytes = bytes.get(20..20 + json_len).ok_or("truncated GLB JSON")?;
+        let json = serde_json::from_slice(json_bytes).map_err(|error| error.to_string())?;
+        let blob = if bytes.len() > 20 + json_len {
+            let blob_len = word(20 + json_len)?;
+            let blob_start = 28 + json_len;
+            bytes
+                .get(blob_start..blob_start + blob_len)
+                .ok_or("truncated GLB binary chunk")?
+        } else {
+            &[]
+        };
+        Ok(Self { json, blob })
+    }
+
+    fn view(&self, view: usize) -> Result<(&'a [u8], Option<usize>), String> {
+        let view = &self.json["bufferViews"][view];
+        let offset = view["byteOffset"].as_u64().unwrap_or(0) as usize;
+        let length = index(&view["byteLength"])?;
+        let bytes = self
+            .blob
+            .get(offset..offset + length)
+            .ok_or("buffer view outside the GLB")?;
+        Ok((bytes, view["byteStride"].as_u64().map(|s| s as usize)))
+    }
+
+    /// Every component of an accessor, widened to `f64`.
+    pub fn components(&self, accessor: usize) -> Result<Vec<f64>, String> {
+        let accessor: &Map<String, Value> = self.json["accessors"][accessor]
+            .as_object()
+            .ok_or("missing accessor")?;
+        let count = index(&accessor["count"])?;
+        let width = match accessor["type"].as_str() {
+            Some("SCALAR") => 1,
+            Some("VEC2") => 2,
+            Some("VEC3") => 3,
+            Some("VEC4") => 4,
+            Some("MAT4") => 16,
+            other => return Err(format!("unsupported accessor type {other:?}")),
+        };
+        let (size, read): (usize, fn(&[u8]) -> f64) = match accessor["componentType"].as_u64() {
+            Some(5121) => (1, |b| f64::from(b[0])),
+            Some(5123) => (2, |b| f64::from(u16::from_le_bytes([b[0], b[1]]))),
+            Some(5125) => (4, |b| f64::from(u32::from_le_bytes([b[0], b[1], b[2], b[3]]))),
+            Some(5126) => (4, |b| f64::from(f32::from_le_bytes([b[0], b[1], b[2], b[3]]))),
+            other => return Err(format!("unsupported component type {other:?}")),
+        };
+        let (bytes, stride) = self.view(index(&accessor["bufferView"])?)?;
+        let start = accessor.get("byteOffset").and_then(Value::as_u64).unwrap_or(0) as usize;
+        let stride = stride.unwrap_or(size * width);
+        let mut out = Vec::with_capacity(count * width);
+        for element in 0..count {
+            for component in 0..width {
+                let at = start + element * stride + component * size;
+                let field = bytes.get(at..at + size).ok_or("accessor outside its view")?;
+                out.push(read(field));
+            }
+        }
+        Ok(out)
+    }
+
+    pub fn floats(&self, accessor: usize) -> Result<Vec<f32>, String> {
+        Ok(self.components(accessor)?.into_iter().map(|v| v as f32).collect())
+    }
+
+    pub fn integers(&self, accessor: usize) -> Result<Vec<u32>, String> {
+        Ok(self.components(accessor)?.into_iter().map(|v| v as u32).collect())
+    }
+
+    /// The bytes of an image stored in the binary chunk.
+    pub fn image_bytes(&self, image: usize) -> Result<&'a [u8], String> {
+        let view = index(&self.json["images"][image]["bufferView"])?;
+        Ok(self.view(view)?.0)
+    }
+}
+
+#[cfg(test)]
+pub(crate) mod build {
+    //! Writes small GLBs for the tests.
+    use serde_json::{Value, json};
+
+    #[derive(Default)]
+    pub struct Writer {
+        pub blob: Vec<u8>,
+        pub views: Vec<Value>,
+        pub accessors: Vec<Value>,
+    }
+
+    impl Writer {
+        fn push(&mut self, bytes: &[u8]) -> usize {
+            while self.blob.len() % 4 != 0 {
+                self.blob.push(0);
+            }
+            let offset = self.blob.len();
+            self.blob.extend_from_slice(bytes);
+            self.views.push(json!({"buffer": 0, "byteOffset": offset, "byteLength": bytes.len()}));
+            self.views.len() - 1
+        }
+
+        pub fn floats(&mut self, values: &[f32], kind: &str) -> usize {
+            let bytes: Vec<u8> = values.iter().flat_map(|v| v.to_le_bytes()).collect();
+            let width = match kind {
+                "SCALAR" => 1,
+                "VEC2" => 2,
+                "VEC3" => 3,
+                "VEC4" => 4,
+                _ => 16,
+            };
+            let view = self.push(&bytes);
+            self.accessors.push(json!({"bufferView": view, "componentType": 5126,
+                "count": values.len() / width, "type": kind}));
+            self.accessors.len() - 1
+        }
+
+        pub fn shorts(&mut self, values: &[u16], kind: &str) -> usize {
+            let bytes: Vec<u8> = values.iter().flat_map(|v| v.to_le_bytes()).collect();
+            let width = if kind == "VEC4" { 4 } else { 1 };
+            let view = self.push(&bytes);
+            self.accessors.push(json!({"bufferView": view, "componentType": 5123,
+                "count": values.len() / width, "type": kind}));
+            self.accessors.len() - 1
+        }
+
+        pub fn ints(&mut self, values: &[u32]) -> usize {
+            let bytes: Vec<u8> = values.iter().flat_map(|v| v.to_le_bytes()).collect();
+            let view = self.push(&bytes);
+            self.accessors.push(json!({"bufferView": view, "componentType": 5125,
+                "count": values.len(), "type": "SCALAR"}));
+            self.accessors.len() - 1
+        }
+
+        pub fn image(&mut self, png: &[u8]) -> usize {
+            self.push(png)
+        }
+
+        pub fn finish(mut self, mut document: Value) -> Vec<u8> {
+            while self.blob.len() % 4 != 0 {
+                self.blob.push(0);
+            }
+            document["buffers"] = json!([{"byteLength": self.blob.len()}]);
+            document["bufferViews"] = Value::Array(self.views);
+            document["accessors"] = Value::Array(self.accessors);
+            let mut text = serde_json::to_vec(&document).unwrap();
+            while text.len() % 4 != 0 {
+                text.push(b' ');
+            }
+            let total = 12 + 8 + text.len() + 8 + self.blob.len();
+            let mut out = Vec::with_capacity(total);
+            out.extend_from_slice(b"glTF");
+            out.extend_from_slice(&2u32.to_le_bytes());
+            out.extend_from_slice(&(total as u32).to_le_bytes());
+            out.extend_from_slice(&(text.len() as u32).to_le_bytes());
+            out.extend_from_slice(b"JSON");
+            out.extend_from_slice(&text);
+            out.extend_from_slice(&(self.blob.len() as u32).to_le_bytes());
+            out.extend_from_slice(b"BIN\0");
+            out.extend_from_slice(&self.blob);
+            out
+        }
+    }
+}
diff --git a/rust/skate-boards/src/grips.rs b/rust/skate-boards/src/grips.rs
new file mode 100644
index 0000000000000000000000000000000000000000..873e46154c819b5007aac3abcd4ba160fa7485b2
--- /dev/null
+++ b/rust/skate-boards/src/grips.rs
@@ -0,0 +1,100 @@
+//! Griptapes to choose apart from the deck. Skate 3 has none of its own:
+//! every deck's finish is see-through over its grip side, and the game lays
+//! one plain black grip under it. These are made from Skate 3's own pieces
+//! instead: its grip grain in plain colours, a checkerboard, and grips
+//! printed with a deck's graphic, as real print griptapes are.
+
+use crate::{Library, Part, PartRef};
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum GripLook {
+    /// The grain in one colour.
+    Solid([u8; 3]),
+    /// Squares of two colours, this many across the board's width.
+    Checker([u8; 3], [u8; 3], u32),
+    /// A deck's graphic printed on the grain.
+    Print(PartRef),
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Grip {
+    /// Short and file-name safe: the models are `sk3_g_<deck>_<id>`.
+    pub id: String,
+    pub name: String,
+    pub look: GripLook,
+}
+
+/// Decks whose graphic is printed on a grip: every this many of the new
+/// decks, so the prints spread over the catalog.
+const PRINT_EVERY: usize = 24;
+
+/// Every griptape on sale, the same for the exporter and the plugin.
+pub fn catalog(library: Option<&Library>) -> Vec<Grip> {
+    let solid = |id: &str, name: &str, rgb: [u8; 3]| Grip { id: id.into(), name: name.into(), look: GripLook::Solid(rgb) };
+    let mut grips = vec![
+        solid("black", "Black", [38, 38, 40]),
+        solid("grey", "Grey", [110, 112, 116]),
+        solid("white", "White", [220, 220, 216]),
+        solid("red", "Red", [170, 30, 34]),
+        solid("blue", "Blue", [34, 70, 170]),
+        solid("green", "Green", [40, 140, 60]),
+        solid("yellow", "Yellow", [220, 190, 40]),
+        solid("orange", "Orange", [220, 110, 30]),
+        solid("purple", "Purple", [110, 50, 150]),
+        solid("pink", "Pink", [225, 110, 170]),
+        solid("teal", "Teal", [30, 150, 150]),
+        Grip { id: "checker".into(), name: "Checker".into(), look: GripLook::Checker([235, 235, 230], [30, 30, 32], 4) },
+        Grip { id: "checkerred".into(), name: "Checker Red".into(), look: GripLook::Checker([180, 30, 34], [30, 30, 32], 4) },
+        Grip { id: "checkerfine".into(), name: "Checker Fine".into(), look: GripLook::Checker([235, 235, 230], [30, 30, 32], 8) },
+    ];
+    if let Some(library) = library {
+        for item in library.new_items(Part::Deck).into_iter().step_by(PRINT_EVERY) {
+            grips.push(Grip {
+                id: format!("p{}", item.material.to_ascii_lowercase()),
+                name: format!("Print: {}", item.label),
+                look: GripLook::Print(item.part_ref()),
+            });
+        }
+    }
+    grips
+}
+
+/// The deck shape a grip model is cut for: the first four letters of the
+/// deck's model, `dflt` for the default skater's deck.
+pub fn deck_key(deck: Option<&PartRef>) -> String {
+    match deck {
+        None => "dflt".to_owned(),
+        Some(d) if d.asset == crate::paints::ASSET => crate::paints::DECK_KEY.to_owned(),
+        Some(d) => d.asset.chars().take(4).collect::<String>().to_ascii_lowercase(),
+    }
+}
+
+/// The model of grip `id` on `deck`.
+pub fn grip_model(deck: Option<&PartRef>, id: &str) -> String {
+    format!("sk3_g_{}_{}", deck_key(deck), id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_painted_deck_takes_its_base_decks_grips() {
+        let painted = crate::paints::catalog()[0].part_ref();
+        assert_eq!(deck_key(Some(&painted)), crate::paints::DECK_KEY);
+        assert_eq!(grip_model(Some(&painted), "black"), format!("sk3_g_{}_black", crate::paints::DECK_KEY));
+    }
+
+    #[test]
+    fn grips_have_distinct_safe_ids_and_models_per_deck_shape() {
+        let grips = catalog(None);
+        let mut ids: Vec<&str> = grips.iter().map(|g| g.id.as_str()).collect();
+        ids.sort_unstable();
+        ids.dedup();
+        assert_eq!(ids.len(), grips.len());
+        assert!(grips.iter().all(|g| g.id.chars().all(|c| c.is_ascii_alphanumeric())));
+        let deck = PartRef::new("f2c517ee8b8359da", "2c7f381700171a56");
+        assert_eq!(grip_model(Some(&deck), "red"), "sk3_g_f2c5_red");
+        assert_eq!(grip_model(None, "red"), "sk3_g_dflt_red");
+    }
+}
diff --git a/rust/skate-boards/src/lib.rs b/rust/skate-boards/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..aaaa5900111e66010b34a7a3ee998fdbb2dd3044
--- /dev/null
+++ b/rust/skate-boards/src/lib.rs
@@ -0,0 +1,1053 @@
+//! Skate 3's skateboard catalog: the decks, trucks and wheels the game's
+//! Create-a-Skater offers, read from the board library the Skate 3 converter
+//! writes into the player's own converted Skate 3 data, and the board meshes
+//! built from a chosen set of parts.
+//!
+//! Nothing here ships Skate 3 content. The library, its part meshes and its
+//! textures exist only on the player's machine, converted from their disc.
+
+pub mod convert;
+pub mod glb;
+pub mod grips;
+pub mod paints;
+pub mod preview;
+pub mod stickers;
+pub mod wear;
+
+use std::collections::{BTreeMap, HashMap};
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+
+/// Where the board library lives inside the Skate 3 data folder.
+pub const LIBRARY_DIR: &str = "private/boards";
+const LIBRARY_FILE: &str = "library.json";
+
+pub fn library_path(assets: &Path) -> PathBuf {
+    assets.join(LIBRARY_DIR).join(LIBRARY_FILE)
+}
+
+/// The player's own decks (`skate-ped --import-decks`), beside Skate's:
+/// `custom.json` and their textures, relative to the assets.
+pub const CUSTOM_DIR: &str = "private/boards/custom";
+
+pub fn custom_dir(assets: &Path) -> PathBuf {
+    assets.join(CUSTOM_DIR)
+}
+
+/// `custom.json`: new finishes of one of Skate's models.
+#[derive(Deserialize)]
+struct RawCustom {
+    model: String,
+    materials: BTreeMap<String, RawMaterial>,
+    #[serde(default)]
+    decks: Vec<String>,
+}
+
+/// A part of the board, as Skate 3's catalog sorts them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum Part {
+    Deck,
+    Trucks,
+    Wheels,
+}
+
+impl Part {
+    pub const ALL: [Self; 3] = [Self::Deck, Self::Trucks, Self::Wheels];
+
+    /// The catalog's component slot.
+    pub fn slot(self) -> &'static str {
+        match self {
+            Self::Deck => "SkateBoard",
+            Self::Trucks => "SkateTruck",
+            Self::Wheels => "SkateWheel",
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Deck => "Deck",
+            Self::Trucks => "Trucks",
+            Self::Wheels => "Wheels",
+        }
+    }
+
+    pub fn index(self) -> usize {
+        self as usize
+    }
+
+    pub fn from_index(index: usize) -> Option<Self> {
+        Self::ALL.get(index).copied()
+    }
+
+    /// The part a material or slot name belongs to.
+    pub fn from_name(name: &str) -> Option<Self> {
+        Self::ALL.into_iter().find(|part| name.contains(part.slot()))
+    }
+}
+
+/// One catalog entry: a part model in one of its finishes.
+#[derive(Clone, Debug, PartialEq, Eq, Hash, Default, PartialOrd, Ord)]
+pub struct PartRef {
+    pub asset: String,
+    pub material: String,
+}
+
+impl PartRef {
+    pub fn new(asset: &str, material: &str) -> Self {
+        Self {
+            asset: asset.to_owned(),
+            material: material.to_owned(),
+        }
+    }
+
+    fn to_text(&self) -> String {
+        format!("{}:{}", self.asset, self.material)
+    }
+
+    fn from_text(text: &str) -> Option<Self> {
+        let (asset, material) = text.split_once(':')?;
+        // Skate's ids are hex; painted parts are `paint:paint_<colour>`.
+        let id = |s: &str| !s.is_empty() && s.len() <= 32 && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_');
+        (id(asset) && id(material)).then(|| Self::new(&asset.to_ascii_lowercase(), &material.to_ascii_lowercase()))
+    }
+}
+
+/// A board: a chosen deck, trucks and wheels, each part left out keeping the
+/// default skater's own.
+#[derive(Clone, Debug, PartialEq, Eq, Hash, Default)]
+pub struct BoardChoice {
+    pub parts: [Option<PartRef>; 3],
+}
+
+impl BoardChoice {
+    pub fn get(&self, part: Part) -> Option<&PartRef> {
+        self.parts[part.index()].as_ref()
+    }
+
+    pub fn set(&mut self, part: Part, value: Option<PartRef>) {
+        self.parts[part.index()] = value;
+    }
+
+    pub fn is_default(&self) -> bool {
+        self.parts.iter().all(Option::is_none)
+    }
+
+    /// `deck,trucks,wheels`, each `asset:material` or empty for the default.
+    pub fn to_text(&self) -> String {
+        if self.is_default() {
+            return String::new();
+        }
+        self.parts
+            .iter()
+            .map(|part| part.as_ref().map(PartRef::to_text).unwrap_or_default())
+            .collect::<Vec<_>>()
+            .join(",")
+    }
+
+    /// Reads [`Self::to_text`]; anything unreadable is the default board.
+    pub fn from_text(text: &str) -> Self {
+        let mut choice = Self::default();
+        let text = text.trim();
+        if text.is_empty() {
+            return choice;
+        }
+        let fields: Vec<&str> = text.split(',').collect();
+        if fields.len() != 3 {
+            return choice;
+        }
+        for (slot, field) in choice.parts.iter_mut().zip(fields) {
+            *slot = PartRef::from_text(field.trim());
+        }
+        choice
+    }
+}
