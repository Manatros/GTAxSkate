+            for off in [-side_off, side_off] {
+                let r = top(off);
+                if r.is_finite() { *rail.entry((r * 100.0).round() as i32).or_default() += 1; }
+            }
+        }
+        println!("centre (5 cm bins): {:?}", centre.iter().map(|(k, n)| format!("{:+.2}:{n}", *k as f32 / 20.0)).collect::<Vec<_>>());
