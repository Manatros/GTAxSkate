+std::vector<Item> ScoreMilestones() {
+    std::vector<Item> out;
+    for (const ScoreMilestone& m : ScoreMilestoneTable()) {
+        Item it;
+        it.id = m.id;
+        it.kind = Kind::Part;
+        it.place = m.place;
