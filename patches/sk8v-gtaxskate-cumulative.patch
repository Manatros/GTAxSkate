+        for (int i = 0; i < 3; ++i) g_orient[0][i] = -g_orient[0][i], g_orient[2][i] = -g_orient[2][i];  // half a turn about its length
+}
+
+void ShowPreview() {
+    FaceOffer();
+    if (Call<BOOL>(IS_DISABLED_CONTROL_PRESSED, 0, 24)) {
