+void ActionCamera(Session& s, const SvOutput& o, const Config& cfg) {
+    const float at[3] = {o.skater_position.x, o.skater_position.y, o.skater_position.z};
+    const float velocity[3] = {o.velocity.x, o.velocity.y, o.velocity.z};
+    float shot[7];
+    if (!s.cam || !g_runtime.ActionCam(s.action, at, velocity, Call<float>(gta::GET_FRAME_TIME), shot)) return;
+    float eye[3] = {shot[0], shot[1], shot[2]};
+    const float look[3] = {shot[3], shot[4], shot[5]};
+    auto ray = [&](const float (&from)[3], const float (&to)[3], Vector3& end, Vector3& normal) {
+        const int test = Call<int>(gta::START_EXPENSIVE_SYNCHRONOUS_SHAPE_TEST_LOS_PROBE, from[0], from[1], from[2], to[0], to[1],
+                                   to[2], 1 | 16, s.ped, 7);
+        BOOL hit = 0;
+        Entity entity = 0;
+        return Call<int>(gta::GET_SHAPE_TEST_RESULT, test, &hit, &end, &normal, &entity) == 2 && hit;
+    };
+    // The film shot may look at the feet. Cast from the actual skater's
+    // chest, not a ground-level look target which can begin inside a ramp.
+    const float anchor[3] = {o.skater_position.x, o.skater_position.y, o.skater_position.z + 1.25f};
+    ConstrainCameraEye(s, anchor, eye, 1 | 16);
+    Vector3 end{}, normal{};
+    const float above[3] = {eye[0], eye[1], eye[2] + 1.0f}, below[3] = {eye[0], eye[1], eye[2] - 2.0f};
+    // A downward ray can also hit a ceiling or the top of a roof above the
+    // safe eye. Do not lift the camera through it. Recheck only when lifted.
+    if (ray(above, below, end, normal) && normal.z > 0.5f && end.z <= eye[2] + 0.3f && eye[2] < end.z + 0.3f) {
+        eye[2] = end.z + 0.3f;
+        ConstrainCameraEye(s, anchor, eye, 1 | 16);
+    }
+    const float dx = look[0] - eye[0], dy = look[1] - eye[1], dz = look[2] - eye[2];
+    const float flat = std::sqrt(dx * dx + dy * dy);
+    Call<void>(gta::SET_CAM_COORD, s.cam, eye[0], eye[1], eye[2]);
+    const Vector3 previous = Call<Vector3>(gta::GET_CAM_ROT, s.cam, 2);
+    const float yaw = std::atan2(-dx, dy) * 57.29578f, pitch = std::atan2(dz, flat) * 57.29578f;
+    LogCameraTurn(s.action == 1 ? "cinematic shot / obstruction" : "filmer shot / obstruction", previous.z, yaw, previous.x, pitch);
+    Call<void>(gta::SET_CAM_ROT, s.cam, pitch, 0.0f, yaw, 2);
+    Call<void>(gta::SET_CAM_FOV, s.cam, std::clamp(shot[6], 10.0f, 120.0f));
+    FilmLook(s, cfg, s.action, std::sqrt(dx * dx + dy * dy + dz * dz));
+}
