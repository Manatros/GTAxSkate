+    fn middle_at(snapped: &[Vec<Vec3>], x: f32) -> f32 {
+        let at = |l: &Vec<Vec3>| l.iter().min_by(|a, b| (a.x - x).abs().total_cmp(&(b.x - x).abs())).unwrap().y;
+        snapped.iter().map(at).sum::<f32>() / snapped.len() as f32
+    }
