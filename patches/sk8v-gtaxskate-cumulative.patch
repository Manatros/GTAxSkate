+        let d: Vec<f32> = std::env::var("DIR").unwrap().split_whitespace().map(|s| s.parse().unwrap()).collect();
+        let l = (d[0] * d[0] + d[1] * d[1]).sqrt();
+        let side = [-d[1] / l, d[0] / l];
+        let mut off = -1.5f32;
+        while off <= 1.5 {
