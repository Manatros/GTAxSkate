diff --git a/host/src/shop_hours.h b/host/src/shop_hours.h
new file mode 100644
index 0000000000000000000000000000000000000000..f581f934131afb19b590853c1c99edf90fb59636
--- /dev/null
+++ b/host/src/shop_hours.h
@@ -0,0 +1,40 @@
+#pragma once
+// The Skate Shop's opening hours (design 2026-11-02-skate-shop-consistency):
+// INI SkateShopHours "open-close" in game hours; 0-24 is always open and a
+// range may cross midnight (20-4).
+#include <cstdio>
+#include <string>
+
+namespace shophours {
+
+struct Hours {
+    int open = 8, close = 22;
+    bool always() const { return close - open >= 24 || open == close; }
+};
+
+// "8-22" -> {8, 22}; false (and always open) on anything else.
+inline bool Parse(const std::string& text, Hours& out) {
+    int a = -1, b = -1;
+    char tail = 0;
+    if (std::sscanf(text.c_str(), " %d - %d %c", &a, &b, &tail) != 2 || a < 0 || a > 24 || b < 0 || b > 24) {
+        out = Hours{0, 24};
+        return false;
+    }
+    out = Hours{a, b};
+    return true;
+}
+
+inline bool OpenAt(int hour, const Hours& h) {
+    if (h.always()) return true;
+    if (h.open < h.close) return hour >= h.open && hour < h.close;
+    return hour >= h.open || hour < h.close;  // across midnight
+}
+
+// "08:00-22:00", for the closed sign.
+inline std::string Text(const Hours& h) {
+    char buf[32];
+    std::snprintf(buf, sizeof(buf), "%02d:00-%02d:00", h.open % 24, h.close % 24);
+    return buf;
+}
+
+} // namespace shophours
diff --git a/host/src/shop_stall.h b/host/src/shop_stall.h
new file mode 100644
index 0000000000000000000000000000000000000000..38670670fca8398e83c9f22b2a989aff54638648
--- /dev/null
+++ b/host/src/shop_stall.h
@@ -0,0 +1,160 @@
+#pragma once
+// The Vespucci Skate Shop stall (design 2026-11-07-skate-shop-rework): its
+// outline, the seller's spot and presence rule, and the inspect flight of a
+// rack board. Pure helpers, tested in host/tests/shop_stall_tests.cpp.
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace shopstall {
+
+// The stall's outline (GTA's vb_29_stall_02/marketwalls, measured 2026-11-07).
+inline constexpr float kOutline[4][2] = {
+    {-1230.3f, -1437.0f}, {-1227.0f, -1443.0f}, {-1222.6f, -1440.3f}, {-1225.8f, -1435.0f}};
+// The seller's default spot: behind the register, in the glass counter's U
+// (collision of vb_29_0.ybn, material 55, panes floor to 6.41 m, so the player
+// cannot walk in; measured 2026-11-08 with the bake probe). The register's arm
+// runs (-1225.75,-1438.35)..(-1224.55,-1437.55); 0.85 m in from its middle,
+// facing out over it (0.55 m stood too far forward, Manatros 2026-11-09 03:51).
+inline constexpr float kSeller[4] = {-1225.62f, -1437.24f, 3.34f, 213.5f};
+inline constexpr float kCounter[4][2] = {
+    {-1227.80f, -1437.00f}, {-1226.95f, -1438.20f}, {-1225.75f, -1438.35f}, {-1224.55f, -1437.55f}};
+inline constexpr float kBackWall[2][2] = {{-1230.0f, -1439.65f}, {-1222.5f, -1434.37f}};
+inline constexpr float kSellerNear = 60.0f;  // wanted within this of the anchor
+inline constexpr float kSellerFar = 80.0f;   // removed beyond this
+inline constexpr float kFlightSeconds = 0.35f;
+
+// Inside the outline grown by `grow` metres (convex quad, either winding).
+inline bool InStall(float x, float y, float grow = 0.5f) {
+    float area = 0.0f;
+    for (int i = 0; i < 4; ++i) {
+        const float* a = kOutline[i];
+        const float* b = kOutline[(i + 1) % 4];
+        area += a[0] * b[1] - b[0] * a[1];
+    }
+    const float sign = area > 0.0f ? 1.0f : -1.0f;
+    for (int i = 0; i < 4; ++i) {
+        const float* a = kOutline[i];
+        const float* b = kOutline[(i + 1) % 4];
+        const float ex = b[0] - a[0], ey = b[1] - a[1];
+        const float len = std::sqrt(ex * ex + ey * ey);
+        // Signed distance to the edge's line, positive inside.
+        const float d = sign * (ex * (y - a[1]) - ey * (x - a[0])) / len;
+        if (d < -grow) return false;
+    }
+    return true;
+}
+
+// "x,y,z,heading" -> spot; false (spot unchanged) on bad text.
+inline bool ParseSpot(const std::string& text, float (&spot)[4]) {
+    float v[4];
+    char tail = 0;
+    if (std::sscanf(text.c_str(), " %f , %f , %f , %f %c", &v[0], &v[1], &v[2], &v[3], &tail) != 4) return false;
+    for (float f : v)
+        if (!std::isfinite(f)) return false;
+    for (int i = 0; i < 4; ++i) spot[i] = v[i];
+    return true;
+}
+
+// Whether a seller should be made: open hours and near. Being in the stall
+// never makes one (none appears at night), it only keeps one (SellerGoes).
+inline bool SellerWanted(bool openNow, float anchorDistance, bool /*inStall*/) {
+    return openNow && anchorDistance <= kSellerNear;
+}
+// Whether an existing seller goes: not wanted, and either far away or closed
+// with the player outside the stall.
+inline bool SellerGoes(bool openNow, float anchorDistance, bool inStall) {
+    if (inStall || SellerWanted(openNow, anchorDistance, inStall)) return false;
+    return anchorDistance > kSellerFar || (!openNow && !inStall);
+}
+
+inline float Smoothstep(float t) {
+    t = t < 0.0f ? 0.0f : t > 1.0f ? 1.0f : t;
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// Quaternion (x, y, z, w) of a rotation in `m` (column-major 4x4: columns
+// 0..2 are the axes, as the runtime's board matrices).
+inline void ToQuat(const float (&m)[16], float (&q)[4]) {
+    const float m00 = m[0], m11 = m[5], m22 = m[10];
+    const float tr = m00 + m11 + m22;
+    if (tr > 0.0f) {
+        const float s = std::sqrt(tr + 1.0f) * 2.0f;
+        q[3] = 0.25f * s, q[0] = (m[6] - m[9]) / s, q[1] = (m[8] - m[2]) / s, q[2] = (m[1] - m[4]) / s;
+    } else if (m00 > m11 && m00 > m22) {
+        const float s = std::sqrt(1.0f + m00 - m11 - m22) * 2.0f;
+        q[3] = (m[6] - m[9]) / s, q[0] = 0.25f * s, q[1] = (m[4] + m[1]) / s, q[2] = (m[8] + m[2]) / s;
+    } else if (m11 > m22) {
+        const float s = std::sqrt(1.0f + m11 - m00 - m22) * 2.0f;
+        q[3] = (m[8] - m[2]) / s, q[0] = (m[4] + m[1]) / s, q[1] = 0.25f * s, q[2] = (m[9] + m[6]) / s;
+    } else {
+        const float s = std::sqrt(1.0f + m22 - m00 - m11) * 2.0f;
+        q[3] = (m[1] - m[4]) / s, q[0] = (m[8] + m[2]) / s, q[1] = (m[9] + m[6]) / s, q[2] = 0.25f * s;
+    }
+    const float n = std::sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+    for (float& c : q) c /= n;
+}
+
+inline void FromQuat(const float (&q)[4], float (&m)[16]) {
+    const float x = q[0], y = q[1], z = q[2], w = q[3];
+    m[0] = 1 - 2 * (y * y + z * z), m[1] = 2 * (x * y + z * w), m[2] = 2 * (x * z - y * w), m[3] = 0;
+    m[4] = 2 * (x * y - z * w), m[5] = 1 - 2 * (x * x + z * z), m[6] = 2 * (y * z + x * w), m[7] = 0;
+    m[8] = 2 * (x * z + y * w), m[9] = 2 * (y * z - x * w), m[10] = 1 - 2 * (x * x + y * y), m[11] = 0;
+}
+
+// The pose a rack board has `t` (0..1, smoothstepped) of the way from its
+// rack `a` to the inspect pose `b`: position lerped, rotation slerped.
+inline void Flight(const float (&a)[16], const float (&b)[16], float t, float (&out)[16]) {
+    t = Smoothstep(t);
+    float qa[4], qb[4];
+    ToQuat(a, qa), ToQuat(b, qb);
+    float dot = qa[0] * qb[0] + qa[1] * qb[1] + qa[2] * qb[2] + qa[3] * qb[3];
+    if (dot < 0.0f) {
+        for (float& c : qb) c = -c;
+        dot = -dot;
+    }
+    float q[4];
+    if (dot > 0.9995f) {
+        for (int i = 0; i < 4; ++i) q[i] = qa[i] + (qb[i] - qa[i]) * t;
+    } else {
+        const float th = std::acos(dot), s = std::sin(th);
+        const float wa = std::sin((1 - t) * th) / s, wb = std::sin(t * th) / s;
+        for (int i = 0; i < 4; ++i) q[i] = qa[i] * wa + qb[i] * wb;
+    }
+    const float n = std::sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+    for (float& c : q) c /= n;
+    FromQuat(q, out);
+    for (int i = 12; i < 15; ++i) out[i] = a[i] + (b[i] - a[i]) * t;
+    out[15] = 1.0f;
+}
+
+// Index of the rack board the highlighted offer is, -1 for none: first one
+// whose models all appear in the offer with the same deck first, else the
+// first with the same deck (the offer wears the player's own griptape and
+// truck paint, peer review 2026-11-07).
+inline bool SameBoard(const std::vector<std::string>& rack, const std::vector<std::string>& offer);
+inline int RackFor(const std::vector<std::vector<std::string>>& racks, const std::vector<std::string>& offer) {
+    for (std::size_t i = 0; i < racks.size(); ++i)
+        if (SameBoard(racks[i], offer)) return static_cast<int>(i);
+    for (std::size_t i = 0; i < racks.size(); ++i)
+        if (!racks[i].empty() && !offer.empty() && racks[i].front() == offer.front()) return static_cast<int>(i);
+    return -1;
+}
+
+// Whether the highlighted offer (its models, as the menu lists them) is the
+// rack board with `rack` models: the same deck first, and every rack model in
+// the offer (the rack list drops models the game lacks; the offer may not).
+inline bool SameBoard(const std::vector<std::string>& rack, const std::vector<std::string>& offer) {
+    if (rack.empty() || offer.empty() || rack.front() != offer.front()) return false;
+    for (const std::string& m : rack) {
+        bool found = false;
+        for (const std::string& o : offer) found = found || o == m;
+        if (!found) return false;
+    }
+    // An offer model the rack lacks is one the game lacks (the rack list was
+    // filtered by availability): a different part would differ in the rack's.
+    return true;
+}
+
+}  // namespace shopstall
diff --git a/host/src/skate_map.cpp b/host/src/skate_map.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5103db0b687207cfab8400dd3755e3c88aca3718
--- /dev/null
+++ b/host/src/skate_map.cpp
@@ -0,0 +1,153 @@
+#include "skate_map.h"
+#include "natives.h"
+#include <windows.h>
+#include <vector>
+
+namespace skatemap {
+namespace {
+using namespace gta;
+
+// GTA's skate spots, found in its map data: the parks' collision (vb_34_skate,
+// ...) and where its ymaps place the prop_skate_* ramps.
+struct Spot {
+    const char* name;
+    float x, y;
+};
+constexpr Spot kSpots[] = {
+    {"Vespucci Beach Skatepark", -1374.0f, -1396.0f},
+    {"Hawick Skate Spot", 280.0f, -206.0f},
+    {"Little Seoul Skate Spot", -950.0f, -786.0f},
+    {"Strawberry Halfpipe", -266.0f, -1571.0f},
+    {"La Mesa Rails", 718.0f, -1231.0f},
+};
+constexpr int kSpotSprite = 1;  // the plain circle, short range like GTA's activities
+constexpr int kSpotColour = 5;  // yellow
+constexpr int kWaypointSprite = 8;
+
+std::vector<int> g_spots;
+// The boardwalk's board shop (board_shop.cpp kBeachShop): always on the map,
+// not short range, so it can be found (Manatros 2026-10-26: "set a marker to
+// the shop so I know where to go").
+constexpr float kShopX = -1224.45f, kShopY = -1442.68f;
+constexpr int kShopSprite = 73, kShopColour = 5;
+int g_shop = 0;
+
+void ShopBlip(bool on) {
+    if (!on) {
+        if (g_shop && Call<BOOL>(DOES_BLIP_EXIST, g_shop)) Call<void>(REMOVE_BLIP, &g_shop);
+        g_shop = 0;
+        return;
+    }
+    if (g_shop && Call<BOOL>(DOES_BLIP_EXIST, g_shop)) return;
+    g_shop = Call<int>(ADD_BLIP_FOR_COORD, kShopX, kShopY, 0.0f);
+    if (!g_shop) return;
+    Call<void>(SET_BLIP_SPRITE, g_shop, kShopSprite);
+    Call<void>(SET_BLIP_COLOUR, g_shop, kShopColour);
+    Call<void>(SET_BLIP_AS_SHORT_RANGE, g_shop, FALSE);
+    Call<void>(BEGIN_TEXT_COMMAND_SET_BLIP_NAME, "STRING");
+    Call<void>(ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME, "Skate Shop");
+    Call<void>(END_TEXT_COMMAND_SET_BLIP_NAME, g_shop);
+}
+bool g_route = false;
+float g_routeX = 0.0f, g_routeY = 0.0f;
+DWORD g_nextCheck = 0;
+
+void SetRoute(bool on, float x = 0.0f, float y = 0.0f, float z = 0.0f, int colour = 0) {
+    Call<void>(CLEAR_GPS_MULTI_ROUTE);
+    if (on) {
+        Call<void>(START_GPS_MULTI_ROUTE, colour, TRUE, TRUE);
+        Call<void>(ADD_POINT_TO_GPS_MULTI_ROUTE, x, y, z);
+        Call<void>(SET_GPS_MULTI_ROUTE_RENDER, TRUE);
+    }
+    g_route = on;
+    g_routeX = x;
+    g_routeY = y;
+}
+
+void Spots(bool on) {
+    bool all = !g_spots.empty();
+    for (const int b : g_spots) all = all && Call<BOOL>(DOES_BLIP_EXIST, b);
+    if (on && all) return;
+    for (const int b : g_spots)
+        if (Call<BOOL>(DOES_BLIP_EXIST, b)) {
+            int handle = b;
+            Call<void>(REMOVE_BLIP, &handle);
+        }
+    g_spots.clear();
+    if (!on) return;
+    for (const Spot& s : kSpots) {
+        const int b = Call<int>(ADD_BLIP_FOR_COORD, s.x, s.y, 0.0f);
+        if (!b) continue;
+        Call<void>(SET_BLIP_SPRITE, b, kSpotSprite);
+        Call<void>(SET_BLIP_COLOUR, b, kSpotColour);
+        Call<void>(SET_BLIP_AS_SHORT_RANGE, b, TRUE);
+        Call<void>(BEGIN_TEXT_COMMAND_SET_BLIP_NAME, "STRING");
+        Call<void>(ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME, s.name);
+        Call<void>(END_TEXT_COMMAND_SET_BLIP_NAME, b);
+        g_spots.push_back(b);
+    }
+}
+
+} // namespace
+
+void Tick(bool skating, bool gps, bool spots, bool shop) {
+    const DWORD now = GetTickCount();
+    if (static_cast<LONG>(now - g_nextCheck) < 0) return;
+    g_nextCheck = now + 1000;  // once a second is plenty for both
+    Spots(spots);
+    ShopBlip(shop);
+    // GTA draws the route to the waypoint only on foot or in a vehicle; in
+    // Skate mode the player is neither, so it is drawn here (as a vehicle's).
+    if (gps && skating && Call<BOOL>(IS_WAYPOINT_ACTIVE)) {
+        const int blip = Call<int>(GET_FIRST_BLIP_INFO_ID, kWaypointSprite);
+        if (blip) {
+            const Vector3 at = Call<Vector3>(GET_BLIP_INFO_ID_COORD, blip);
+            const float dx = at.x - g_routeX, dy = at.y - g_routeY;
+            if (!g_route || dx * dx + dy * dy > 4.0f)
+                SetRoute(true, at.x, at.y, at.z, Call<int>(GET_BLIP_HUD_COLOUR, blip));
+            return;
+        }
+    }
+    if (g_route) SetRoute(false);
+}
+
+Vector3 Me() { return Call<Vector3>(GET_ENTITY_COORDS, Call<int>(PLAYER_PED_ID), 0); }
+
+const char* RouteToClothingStore() {
+    // GTA's own clothing store blips (sprite 73: Binco, Discount Store, Suburban, Ponsonbys).
+    const Vector3 me = Me();
+    float best = 1e12f, x = 0.0f, y = 0.0f;
+    for (int b = Call<int>(GET_FIRST_BLIP_INFO_ID, 73); Call<BOOL>(DOES_BLIP_EXIST, b); b = Call<int>(GET_NEXT_BLIP_INFO_ID, 73)) {
+        const Vector3 at = Call<Vector3>(GET_BLIP_INFO_ID_COORD, b);
+        const float d = (at.x - me.x) * (at.x - me.x) + (at.y - me.y) * (at.y - me.y);
+        if (d < best) best = d, x = at.x, y = at.y;
+    }
+    if (best >= 1e12f) return "No clothing store on the map";
+    Call<void>(SET_NEW_WAYPOINT, x, y);
+    return "GPS: nearest clothing store (Skate 3 boards)";
+}
+
+const char* RouteToSkateSpot() {
+    const Vector3 me = Me();
+    float best = 1e12f, x = 0.0f, y = 0.0f;
+    for (const Spot& s : kSpots) {
+        const float d = (s.x - me.x) * (s.x - me.x) + (s.y - me.y) * (s.y - me.y);
+        if (d < best) best = d, x = s.x, y = s.y;
+    }
+    Call<void>(SET_NEW_WAYPOINT, x, y);
+    return "GPS: nearest skate spot";
+}
+
+const char* ClearRoute() {
+    Call<void>(SET_WAYPOINT_OFF);
+    return "GPS: waypoint removed";
+}
+
+void Clear() {
+    if (g_route) SetRoute(false);
+    Spots(false);
+    if (g_shop && Call<BOOL>(DOES_BLIP_EXIST, g_shop)) Call<void>(REMOVE_BLIP, &g_shop);
+    g_shop = 0;
+}
+
+} // namespace skatemap
diff --git a/host/src/skate_map.h b/host/src/skate_map.h
new file mode 100644
index 0000000000000000000000000000000000000000..3cd4aa6ed579d07c45d357cf76b4d1e93bb47f5b
