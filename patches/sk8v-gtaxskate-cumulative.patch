+#pragma once
+// The board shop's parts (contributed by GTAxSkate): decks, griptapes, trucks
+// and wheels built by tools/prepare-board-parts.py with the native board's
+// seven-bone skeleton. The chosen ones are registered from loose files when
+// first needed and posed like the native board, which they then replace.
+#include <string>
+#include <vector>
+#include "skatev_runtime.h"
+
+namespace boardparts {
+
+// Call on the script thread. Reads <dataRoot>\private\board-parts.
+bool Start(const std::wstring& dataRoot, void (*log)(const char*));
+
+// The models to show (file stems without extension, e.g. skatev_d_default).
+// Empty: the native board shows.
+void SetLoadout(const std::vector<std::string>& models);
+const std::vector<std::string>& Loadout();
+bool Available(const std::string& model);
+// Glowing wheels: wheel parts show their emissive `<name>_glow` copies (built
+// by tools/make-glow-wheels.ps1) while on; boards swap like any loadout change.
+// colour: "" = the wheels' own texture (<name>_glow), else a fixed colour's
+// tinted copy <name>_glow_<colour> (lower case, as GlowColours) when built.
+void SetGlowWheels(bool on, const std::string& colour = {});
+
+// True while a custom board is shown; the caller then hides the native board.
+// Loadout changes retain and pose the old objects until a replacement is ready.
+// Not skating: removes the objects.
+bool Tick(bool skating, const SvBoardPose& pose);
+
+// The store's preview: `models` posed by `pose` (a rest pose from the
+// runtime). Unloaded selections wait for 400 ms; loaded ones show at once.
+// Empty `models` removes it.
+bool Preview(const std::vector<std::string>& models, const SvBoardPose& pose);
+
+// Neighbours paired by distance (1..3), scroll direction first in each pair.
+// Requests only, never objects. Empty clears the store's prefetch requests.
+void Prefetch(const std::vector<std::vector<std::string>>& neighbours);
+
+// The store's boards on show: board `index` (0..7) as `models` at rest in
+// `pose`. ClearDisplay removes them all.
+bool Display(int index, const std::vector<std::string>& models, const SvBoardPose& pose);
+void ClearDisplay();
+
+// The board in hand (GTA mode, the board picked in the weapon wheel) as
+// `models` in `pose`; empty `models` removes it.
+bool Hand(const std::vector<std::string>& models, const SvBoardPose& pose);
+
+// A crew member's board (AI skater `slot`, 0..3) as `models` in `pose`;
+// empty `models` removes it.
+bool Crew(int slot, const std::vector<std::string>& models, const SvBoardPose& pose);
+
+// Every part object shown (riding and preview): presentation only, never collision.
+std::vector<int> Entities();
+
+void Stop();
+
+} // namespace boardparts
diff --git a/host/src/board_parts_logic.h b/host/src/board_parts_logic.h
new file mode 100644
index 0000000000000000000000000000000000000000..aa828fb10a427955e139c783c4f2aebdc47b49bc
--- /dev/null
+++ b/host/src/board_parts_logic.h
@@ -0,0 +1,71 @@
+#pragma once
+#include <utility>
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <unordered_set>
+
+namespace boardpartslogic {
+// `reserve` registrations stay for the ridden board; preloading shrinks early
+// (a browsed entry's neighbours cost three times its own registrations).
+inline int PrefetchRadius(int registered, int limit, int reserve = 0) {
+    const int remaining = limit - reserve - registered;
+    return remaining < 20 ? 0 : remaining < 80 ? 1 : 3;
+}
+
+// Entries are paired by distance, with the scroll direction first. Empty
+// entries preserve distances at list boundaries and on group rows.
+template<class Registered, class Request>
+std::unordered_set<std::string> PrefetchModels(
+    const std::vector<std::vector<std::string>>& neighbours, int limit,
+    Registered registered, Request request, int reserve = 0) {
+    std::unordered_set<std::string> wanted;
+    for (std::size_t i = 0; i < neighbours.size() && i < 6; ++i) {
+        if (static_cast<int>(i / 2) >= PrefetchRadius(registered(), limit, reserve)) break;
+        for (const auto& name : neighbours[i]) {
+            if (!PrefetchRadius(registered(), limit, reserve)) break;
+            if (!name.empty() && wanted.insert(name).second) request(name);
+        }
+    }
+    return wanted;
+}
+
+// Candidates remain invisible across frames until their skeletons can be posed.
+// Creation failure releases partial objects; the current board stays intact.
+template<class Item, class Create, class Pose, class Publish, class Remove>
+bool Replace(std::vector<Item>& current, std::vector<Item>& pending,
+             const std::vector<std::string>& models,
+             Create create, Pose pose, Publish publish, Remove remove) {
+    if (pending.empty()) {
+        for (const auto& name : models) {
+            Item item;
+            if (!create(name, item)) {
+                for (auto& partial : pending) remove(partial);
+                pending.clear();
+                return false;
+            }
+            pending.push_back(std::move(item));
+        }
+    }
+    if (!pose(pending)) return false;
+    for (auto& item : pending) publish(item);
+    for (auto& item : current) remove(item);
+    current = std::move(pending);
+    pending.clear();
+    return true;
+}
+
+struct Selection {
+    std::vector<std::string> models;
+    std::uint64_t changed = 0;
+
+    bool Update(const std::vector<std::string>& next, std::uint64_t now) {
+        if (next == models) return false;
+        models = next;
+        changed = now;
+        return true;
+    }
+    bool Settled(std::uint64_t now) const { return now - changed >= 400; }
+    bool CanPreview(std::uint64_t now, bool loaded) const { return loaded || Settled(now); }
+};
+} // namespace boardpartslogic
diff --git a/host/src/board_pose_diagnostics.h b/host/src/board_pose_diagnostics.h
new file mode 100644
index 0000000000000000000000000000000000000000..422b491a17464a3c8dbc3cdce11b78d1678cb31a
--- /dev/null
+++ b/host/src/board_pose_diagnostics.h
@@ -0,0 +1,71 @@
+#pragma once
+// Developer observations only: no pose correction, allocation or game access.
+#include "pose_math.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace boardnative::diagnostics {
+using posemath::M;
+struct State {
+    bool active = false, previous = false, priorWrite = false;
+    std::uint64_t lastMs = 0, lastTick = 0;
+    unsigned samples = 0;
+    M written[7]{}, sampled[7]{};
+    float motion[6]{}, beforeWritten[6]{};
+    float localError = 0, objectError = 0;
+};
+inline bool ShouldSample(State& s, bool enabled, std::uint64_t tick, std::uint64_t now) {
+    if (!enabled) { s.active = false; return false; }
+    if (!s.active) { s = State{}; s.active = true; }
+    if (s.previous && (tick == s.lastTick || now - s.lastMs < 250)) return false;
+    return true;
+}
+inline float RotationDegrees(const M& a, const M& b) {
+    float trace = 0;
+    for (int r = 0; r < 3; ++r) {
+        float aa = 0, bb = 0, ab = 0;
+        for (int c = 0; c < 3; ++c) { aa += a.r[r][c] * a.r[r][c]; bb += b.r[r][c] * b.r[r][c]; ab += a.r[r][c] * b.r[r][c]; }
+        if (!(aa > 1e-12f && bb > 1e-12f) || !std::isfinite(ab)) return 180.0f;
+        trace += ab / std::sqrt(aa * bb);
+    }
+    return std::acos(std::clamp((trace - 1) * 0.5f, -1.0f, 1.0f)) * 57.2957795f;
+}
+inline float RotationElementError(const M& a, const M& b) {
+    float error = 0;
+    for (int r = 0; r < 3; ++r) for (int c = 0; c < 3; ++c) {
+        const float delta = std::fabs(a.r[r][c] - b.r[r][c]);
+        if (!std::isfinite(delta)) return 1e9f;
+        error = std::max(error, delta);
+    }
+    return error;
+}
+// intended and observed locals are parent-relative, so board/world motion is
+// not counted as wheel or truck motion. beforeWritten is an observation, not
+// evidence identifying which game system changed the matrices between calls.
+inline void Sample(State& s, std::uint64_t tick, std::uint64_t now,
+                   const M (&intended)[7], const M (&before)[7], const M (&after)[7],
+                   const M (&objects)[7], const M (&objectsAfter)[7]) {
+    for (int i = 1; i < 7; ++i) {
+        if (s.previous) {
+            s.motion[i - 1] = std::max(s.motion[i - 1], RotationDegrees(intended[i], s.sampled[i]));
+        }
+        if (s.priorWrite) s.beforeWritten[i - 1] = std::max(s.beforeWritten[i - 1], RotationDegrees(before[i], s.written[i]));
+        s.localError = std::max(s.localError, RotationElementError(intended[i], after[i]));
+        s.objectError = std::max(s.objectError, RotationElementError(objects[i], objectsAfter[i]));
+    }
+    for (int i = 0; i < 7; ++i) s.sampled[i] = intended[i];
+    s.previous = true; s.lastTick = tick; s.lastMs = now;
+    if (s.samples != UINT32_MAX) ++s.samples;
+}
+// Keep the actual last write separate from the slower motion sampling: using
+// the last sampled pose here would mislabel ordinary animation as a change.
+inline void Written(State& s, const M (&intended)[7]) {
+    for (int i = 0; i < 7; ++i) s.written[i] = intended[i];
+    s.priorWrite = true;
+}
+inline void ClearWindow(State& s) {
+    for (int i = 0; i < 6; ++i) s.motion[i] = s.beforeWritten[i] = 0;
+    s.samples = 0; s.localError = s.objectError = 0;
+}
+} // namespace boardnative::diagnostics
diff --git a/host/src/board_shop.cpp b/host/src/board_shop.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7750a484a7043ed90efe13d29f60581a43292863
--- /dev/null
+++ b/host/src/board_shop.cpp
@@ -0,0 +1,607 @@
+#include "board_shop.h"
+#include "board_native.h"
+#include "board_parts.h"
+#include "host_util.h"
+#include "menu.h"
+#include "natives.h"
+#include "runtime_bridge.h"
+#include <windows.h>
+#include <cmath>
+#include <cstring>
+#include <cwchar>
+#include <filesystem>
+#include <cstdlib>
+#include <cstdio>
+#include <sstream>
+#include <vector>
+#include <utility>
+
+namespace boardshop {
+namespace {
+using namespace gta;
+
+// GTA's controls: G (INPUT_DETONATE, D-pad left) opens the boards; E stays
+// the store's own clothing counter. The menu reads the frontend group.
+constexpr int kOpen = 47;
+constexpr int kUp = 172, kDown = 173, kLeft = 174, kRight = 175, kAccept = 201, kCancel = 202, kReset = 203;
+
+RuntimeBridge* g_rt = nullptr;
+void (*g_log)(const char*) = nullptr;
+void (*g_wheels)(float) = nullptr;
+bool g_ready = false, g_open = false;
+std::uint32_t g_model = 0;
+int g_tierShown = -1;
+bool g_partView = false;  // Tab: the offer's part alone, or the whole board
+bool g_scrollUp = false;
+
+void Log(const std::string& s) {
+    if (g_log) g_log(s.c_str());
+}
+
+// The Vespucci boardwalk's closed skateboarding shop Manatros marked (2026-10-26
+// 19:21 recording, mark 1; it was the surfboard storefront at -1302.7 -1369.2 first,
+// prop_venice_board_01/02; design 2026-10-26-shops-step1): store kind 3.
+constexpr float kBeachShop[2] = {-1224.45f, -1442.68f};
+constexpr float kBeachReach = 4.0f, kBeachShow = 30.0f;
+// The boardwalk's height there when GTA has not streamed its ground yet.
+constexpr float kBeachGround = 4.3f;
+
+float BeachDistance(const Vector3& p) {
+    const float dx = p.x - kBeachShop[0], dy = p.y - kBeachShop[1];
+    return std::sqrt(dx * dx + dy * dy);
+}
+
+unsigned GameDay() {
+    return static_cast<unsigned>(Call<int>(GET_CLOCK_MONTH) * 31 + Call<int>(GET_CLOCK_DAY_OF_MONTH));
+}
+
+// Binco and the Discount Store (0), Suburban (1); Ponsonbys (2) sells no boards.
+int TierHere(int ped) {
+    const int interior = Call<int>(GET_INTERIOR_FROM_ENTITY, ped);
+    if (!interior) return -1;
+    Vector3 at{};
+    std::uint32_t hash = 0;
+    Call<void>(GET_INTERIOR_LOCATION_AND_NAMEHASH, interior, &at, &hash);
+    if (hash == util::Joaat("v_clotheslo")) return 0;
+    if (hash == util::Joaat("v_clothesmid")) return 1;
+    if (hash == util::Joaat("v_clotheshi")) return 2;
+    return -1;
+}
+
+// Michael, Franklin and Trevor by model (each keeps their own boards and cash).
+const char* Who(std::uint32_t model) {
+    if (model == util::Joaat("player_zero")) return "michael";
+    if (model == util::Joaat("player_one")) return "franklin";
+    if (model == util::Joaat("player_two")) return "trevor";
+    return nullptr;
+}
+
+std::uint32_t CashStat(std::uint32_t model) {
+    if (model == util::Joaat("player_zero")) return util::Joaat("SP0_TOTAL_CASH");
+    if (model == util::Joaat("player_one")) return util::Joaat("SP1_TOTAL_CASH");
+    if (model == util::Joaat("player_two")) return util::Joaat("SP2_TOTAL_CASH");
+    return 0;
+}
+
+std::vector<std::string> Split(const std::string& text, char by) {
+    std::vector<std::string> out;
+    std::string item;
+    std::istringstream in(text);
+    while (std::getline(in, item, by))
+        if (!item.empty()) out.push_back(item);
+    return out;
+}
+
+// The boards on show in the store the player is in (found once per store and
+// kept by the runtime; tried again every 1.5 s until a place is found).
+struct OnShow {
+    float at[16];
+    std::vector<std::string> models;
+};
+std::vector<OnShow> g_onShow;
+std::uint32_t g_showStore = 0;  // the interior they are for
+DWORD g_showRetry = 0;
+unsigned g_showDay = 0;  // the game day the boards on show are for
+bool g_showMissed = false;  // "no place yet" logged for this store
+
+std::uint32_t __cdecl Probe(void* ctx, const float* from, const float* to, float* hit) {
+    const int test = Call<int>(START_EXPENSIVE_SYNCHRONOUS_SHAPE_TEST_LOS_PROBE, from[0], from[1], from[2], to[0], to[1], to[2],
+                               1 | 16, static_cast<int>(reinterpret_cast<std::intptr_t>(ctx)), 7);
+    BOOL any = 0;
+    Vector3 end{}, normal{};
+    Entity entity = 0;
+    if (Call<int>(GET_SHAPE_TEST_RESULT, test, &any, &end, &normal, &entity) != 2 || !any) return 0;
+    hit[0] = end.x, hit[1] = end.y, hit[2] = end.z;
+    return 1;
+}
+
+// The store's clerk standing near (s_f_y_shop_low/mid, the mask shop's).
+int Clerk(int ped) {
+    static int peds[256];
+    const int n = worldGetAllPeds(peds, 256);
+    const Vector3 me = Call<Vector3>(GET_ENTITY_COORDS, ped, 0);
+    int best = 0;
+    float bestD = 20.0f * 20.0f;
+    for (int i = 0; i < n; ++i) {
+        const int p = peds[i];
+        if (p == ped || Call<BOOL>(IS_ENTITY_DEAD, p, 0)) continue;
+        const std::uint32_t m = Call<std::uint32_t>(GET_ENTITY_MODEL, p);
+        if (m != util::Joaat("s_f_y_shop_low") && m != util::Joaat("s_f_y_shop_mid") && m != util::Joaat("s_m_y_shop_mask")) continue;
+        const Vector3 c = Call<Vector3>(GET_ENTITY_COORDS, p, 0);
+        const float d = (c.x - me.x) * (c.x - me.x) + (c.y - me.y) * (c.y - me.y) + (c.z - me.z) * (c.z - me.z);
+        if (d < bestD) bestD = d, best = p;
+    }
+    return best;
+}
+
+void ClearShow() {
+    if (!g_onShow.empty()) boardparts::ClearDisplay();
+    g_onShow.clear();
+    g_showStore = 0;
+}
+
+// The store's point: its interior's location, or the board shop's anchor.
+Vector3 StorePoint(int ped, int tier) {
+    if (tier == 3) {
+        // The ground at the anchor, not the player's height (peer review
+        // 2026-10-26: the wall found first is kept for good).
+        Vector3 v = Call<Vector3>(GET_ENTITY_COORDS, ped, 0);
+        float ground = 0.0f;
+        v.x = kBeachShop[0], v.y = kBeachShop[1];
+        v.z = Call<BOOL>(GET_GROUND_Z_FOR_3D_COORD, v.x, v.y, 30.0f, &ground, FALSE, FALSE) ? ground : kBeachGround;
+        return v;
+    }
+    Vector3 place{};
+    std::uint32_t hash = 0;
+    Call<void>(GET_INTERIOR_LOCATION_AND_NAMEHASH, Call<int>(GET_INTERIOR_FROM_ENTITY, ped), &place, &hash);
+    return place;
+}
+
+// Boards on show: placed once, then kept posed at rest every frame.
+void ShowBoards(int ped, int tier) {
+    const int interior = Call<int>(GET_INTERIOR_FROM_ENTITY, ped);
+    const Vector3 place = StorePoint(ped, tier);
+    // Outdoors there is no interior: the board shop keys on its own number.
+    const std::uint32_t key = tier == 3 ? 0xB0A4D5u : static_cast<std::uint32_t>(interior);
+    // A new game day while in the store: today's boards, as the menu sells
+    // (peer review 2026-10-26).
+    if (key != g_showStore || GameDay() != g_showDay) ClearShow(), g_showStore = key, g_showDay = GameDay(), g_showRetry = 0, g_showMissed = false;
+    if (g_onShow.empty() && static_cast<LONG>(GetTickCount() - g_showRetry) >= 0) {
+        g_showRetry = GetTickCount() + 1500;
+        const Vector3 me = Call<Vector3>(GET_ENTITY_COORDS, ped, 0);
+        const float at[3] = {place.x, place.y, place.z};
+        // The board shop's wall is searched from its anchor, not from wherever the player stands.
+        const float eye[3] = {tier == 3 ? kBeachShop[0] : me.x, tier == 3 ? kBeachShop[1] : me.y, tier == 3 ? place.z + 1.5f : me.z + 0.3f};
+        float clerk[6];
+        const int c = tier == 3 ? 0 : Clerk(ped);
+        if (c) {
+            const Vector3 p = Call<Vector3>(GET_ENTITY_COORDS, c, 0), f = Call<Vector3>(GET_ENTITY_FORWARD_VECTOR, c);
+            clerk[0] = p.x, clerk[1] = p.y, clerk[2] = p.z, clerk[3] = f.x, clerk[4] = f.y, clerk[5] = f.z;
+        }
+        const unsigned day = GameDay();
+        float out[8 * 16];
+        std::vector<std::string> models;
+        const int n = g_rt->ShopDisplay(tier, at, eye, c ? clerk : nullptr, day, Probe,
+                                        reinterpret_cast<void*>(static_cast<std::intptr_t>(ped)), out, 8, models);
+        for (int i = 0; i < n; ++i) {
+            OnShow b;
+            std::memcpy(b.at, out + i * 16, sizeof(b.at));
+            b.models = Split(models[static_cast<std::size_t>(i)], ',');
+            g_onShow.push_back(b);
+        }
+        if (n) Log("board shop: " + std::to_string(n) + " boards on show (" + (c ? "a clerk near: behind the till" : "on a wall") + ")");
+        else if (!g_showMissed) g_showMissed = true, Log("board shop: no place for boards on show found yet (tried again every 1.5 s)");
+    }
+    for (std::size_t i = 0; i < g_onShow.size(); ++i) {
+        SvBoardPose pose{};
+        if (g_rt->ShopRestPose(g_onShow[i].at, pose)) boardparts::Display(static_cast<int>(i), g_onShow[i].models, pose);
+    }
+}
+
+// Looking at the boards on show from up to 3.5 m (the camera within 25
+// degrees of them): E opens the shop there, as at the store's other goods.
+// Looking elsewhere (the counter, the clerk) E stays the store's own.
+bool LookingAtShow(int ped) {
+    if (g_onShow.empty()) return false;
+    float c[3] = {0, 0, 0};
+    for (const OnShow& b : g_onShow)
+        for (int i = 0; i < 3; ++i) c[i] += b.at[12 + i] / static_cast<float>(g_onShow.size());
+    const Vector3 me = Call<Vector3>(GET_ENTITY_COORDS, ped, 0);
+    const float dx = c[0] - me.x, dy = c[1] - me.y;
+    if (dx * dx + dy * dy > 3.5f * 3.5f) return false;
+    const Vector3 cam = Call<Vector3>(GET_GAMEPLAY_CAM_COORD);
+    const Vector3 rot = Call<Vector3>(GET_GAMEPLAY_CAM_ROT, 2);
+    const float yaw = rot.z * 0.017453292f, pitch = rot.x * 0.017453292f;
+    const float f[3] = {-std::sin(yaw) * std::cos(pitch), std::cos(yaw) * std::cos(pitch), std::sin(pitch)};
+    float to[3] = {c[0] - cam.x, c[1] - cam.y, c[2] - cam.z};
+    const float len = std::sqrt(to[0] * to[0] + to[1] * to[1] + to[2] * to[2]);
+    if (len < 0.1f) return true;
+    return (f[0] * to[0] + f[1] * to[1] + f[2] * to[2]) / len > std::cos(25.0f * 0.017453292f);
+}
