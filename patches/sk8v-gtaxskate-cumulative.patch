@@ -0,0 +1,41 @@
+#pragma once
+// Skate 3's replay editor in GTA, phase 1 (design 2026-11-02-replay-editor):
+// the last seconds of skating (skater, board, camera) recorded once per
+// Skate tick; Back opens a replay with the world frozen, five cameras,
+// speeds and scrubbing; leaving continues play exactly where it stopped.
+// The recording and playhead logic is replay_logic (unit-tested).
+#include <cstdint>
+#include <string>
+#include "replay_logic.h"
+#include "skatev_runtime.h"
+
+namespace replay {
+
+// INI: Replay, ReplaySeconds (10-60), ReplayWorldTimeScale (0-1).
+void Configure(bool enabled, double seconds, float worldTimeScale, void (*log)(const char*));
+bool Enabled();
+
+// Once per new Skate tick while skating and not in a replay: the output,
+// where the ped was placed (3 floats, null: the skater root), the published bone matrices (`count` x 16 floats, GTA world) and the
+// board pose (null when the board is not drawn).
+void Record(const SvOutput& o, const float* placed, const float* bones, int count, const SvBoardPose* board);
+// A new session: the old recording goes.
+void Clear();
+// Enough recorded to replay (one second).
+bool Ready();
+
+// Starts the replay: time scale, own camera, controls and HUD off, Skate's
+// sound paused. False when not ready.
+bool Enter(int ped);
+bool Active();
+// One script frame (`dt` real seconds): input, playhead, presentation and the
+// on-screen help. False when the player asked to leave (B or Back).
+bool Tick(int ped, const SvPad& pad, float dt);
+// Ends a running replay (idempotent): time scale, camera (the caller makes
+// its own camera render again), controls, Skate's sound. The caller puts the
+// ped back where play stopped.
+void Exit();
+// Status for the help line ("1/2x  Follow  12.3 / 30.0 s").
+std::string Status();
+
+}  // namespace replay
diff --git a/host/src/replay_logic.cpp b/host/src/replay_logic.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..42673eb13d5025a95926a0ff0cffe715c211288f
--- /dev/null
+++ b/host/src/replay_logic.cpp
@@ -0,0 +1,102 @@
+#include "replay_logic.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+
+namespace replay {
+
+void Recording::SetWindow(double seconds) {
+    window_ = std::clamp(seconds, 1.0, 120.0);
+}
+
+void Recording::Reserve(double seconds, double rate, int bones) {
+    SetWindow(seconds);
+    const std::size_t n = static_cast<std::size_t>(std::ceil(window_ * std::max(rate, 1.0))) + 1;
+    slots_.assign(n, Frame{});
+    for (Frame& f : slots_) f.bones.reserve(static_cast<std::size_t>(std::max(bones, 0)) * 16);
+    Clear();
+}
+
+void Recording::Clear() {
+    head_ = count_ = 0;
+    clock_ = 0.0;
+}
+
+double Recording::Start() const { return count_ ? At(std::size_t{0}).time : 0.0; }
+double Recording::End() const { return count_ ? At(count_ - 1).time : 0.0; }
+
+void Recording::Add(const Frame& f, double dt) {
+    if (count_ && At(std::size_t{0}).bones.size() != f.bones.size()) Clear();
+    clock_ += count_ && dt > 0.0 && dt < 1.0 ? dt : 0.0;
+    // Drop frames older than the window, keeping one before it for scrubs.
+    while (count_ > 1 && At(std::size_t{1}).time <= clock_ - window_) {
+        head_ = (head_ + 1) % slots_.size();
+        --count_;
+    }
+    if (slots_.empty()) return;  // Reserve first
+    if (count_ == slots_.size()) {  // full: the oldest frame goes
+        head_ = (head_ + 1) % slots_.size();
+        --count_;
+    }
+    Frame& slot = slots_[(head_ + count_) % slots_.size()];
+    static_cast<FrameData&>(slot) = f;  // the bones into the slot's own room
+    slot.bones.assign(f.bones.begin(), f.bones.end());
+    slot.time = clock_;
+    ++count_;
+}
+
+Recording::Sample Recording::At(double time) const {
+    Sample s;
+    if (!count_) return s;
+    // Binary search over the ring by time.
+    std::size_t lo = 0, hi = count_ - 1;
+    if (time <= At(lo).time) {
+        s.a = s.b = &At(lo);
+        return s;
+    }
+    if (time >= At(hi).time) {
+        s.a = s.b = &At(hi);
+        return s;
+    }
+    while (hi - lo > 1) {
+        const std::size_t mid = (lo + hi) / 2;
+        (At(mid).time <= time ? lo : hi) = mid;
+    }
+    s.a = &At(lo);
+    s.b = At(hi).cut ? s.a : &At(hi);
+    const double span = At(hi).time - At(lo).time;
+    s.t = s.b == s.a || span <= 0.0 ? 0.0f : static_cast<float>((time - At(lo).time) / span);
+    return s;
+}
+
+void Playhead::Advance(double dt, double start, double end) {
+    if (playing && dt > 0.0 && dt < 1.0) time += (reverse ? -dt : dt) * kSpeeds[speed];
+    if (time <= start) {
+        time = start;
+        if (reverse) playing = false;
+    } else if (time >= end) {
+        time = end;
+        if (!reverse) playing = false;
+    }
+}
+
+bool Tap::Update(bool down, bool otherDown, unsigned nowMs) {
+    if (down && !down_) {
+        down_ = true;
+        spoiled_ = otherDown;
+        since_ = nowMs;
+        return false;
+    }
+    if (down) {
+        if (otherDown || nowMs - since_ > tapMs_) spoiled_ = true;
+        return false;
+    }
+    if (down_) {
+        down_ = false;
+        return !spoiled_ && nowMs - since_ <= tapMs_;
+    }
+    return false;
+}
+
+}  // namespace replay
diff --git a/host/src/replay_logic.h b/host/src/replay_logic.h
new file mode 100644
index 0000000000000000000000000000000000000000..8136adb50e22afa06e399587f20497167bc01a44
--- /dev/null
+++ b/host/src/replay_logic.h
@@ -0,0 +1,93 @@
+#pragma once
+// Replay (design 2026-11-02-replay-editor): the rolling recording of what
+// skating showed (skater root, bone matrices, board, camera) and the
+// playhead over it. No GTA calls here, so it can be unit-tested.
+#include <cstdint>
+#include <vector>
+
+namespace replay {
+
+// One presented frame. Bone and board matrices: 16 floats each, GTA world
+// space, RAGE row layout (as posehook::PublishPose takes them).
+struct FrameData {
+    double time = 0.0;           // seconds since the recording began
+    bool cut = false;            // a teleport or respawn led into this frame
+    float root[3] = {};          // skater root (ped placement)
+    float heading = 0.0f;        // skater heading, degrees
+    float velocity[3] = {};
+    float camera[7] = {};        // position, rotation (pitch, roll, yaw), fov
+    bool board = false;          // board matrices valid
+    float boardEntity[16] = {};
+    float boardWorld[7][16] = {};
+};
+struct Frame : FrameData {
+    std::vector<float> bones;    // bones x 16
+};
+
+// The last `seconds` of frames. Slots are reused (no allocation once full).
+class Recording {
+public:
+    explicit Recording(double seconds = 30.0) : window_(seconds) {}
+    void SetWindow(double seconds);
+    // Makes the slots once: `seconds` at `rate` frames a second (plus one),
+    // each with room for `bones`; when full, the oldest frame is overwritten.
+    void Reserve(double seconds, double rate, int bones);
+    std::size_t Capacity() const { return slots_.size(); }
+    // Appends a frame `dt` seconds after the previous one. A different bone
+    // count than the frames held clears them first (a new skeleton).
+    void Add(const Frame& f, double dt);
+    void Clear();
+    std::size_t Size() const { return count_; }
+    double Start() const;
+    double End() const;
+    double Length() const { return Size() ? End() - Start() : 0.0; }
+    // The frame at or just before `time` and the one after, with the fraction
+    // between them (0 at `a`); `b` is `a` across a cut or at the ends.
+    struct Sample {
+        const Frame* a = nullptr;
+        const Frame* b = nullptr;
+        float t = 0.0f;
+    };
+    Sample At(double time) const;
+    const Frame& Last() const { return At(count_ - 1); }
+
+private:
+    const Frame& At(std::size_t i) const { return slots_[(head_ + i) % slots_.size()]; }
+    std::vector<Frame> slots_;
+    std::size_t head_ = 0, count_ = 0;
+    double window_;
+    double clock_ = 0.0;
+};
+
+// Playback speeds, slowest first (Skate's editor steps).
+inline constexpr float kSpeeds[] = {0.25f, 0.5f, 1.0f, 2.0f};
+inline constexpr int kNormalSpeed = 2;
+
+// The replay's playhead: time within [start, end], speed step, direction.
+struct Playhead {
+    double time = 0.0;
+    int speed = kNormalSpeed;
+    bool playing = true;
+    bool reverse = false;
+    // Advances by `dt` real seconds; stops (paused) at either end.
+    void Advance(double dt, double start, double end);
+    void Faster() { if (speed + 1 < static_cast<int>(std::size(kSpeeds))) ++speed; }
+    void Slower() { if (speed > 0) --speed; }
+};
+
+// Back: a tap (pressed and released within `tapMs`, nothing else pressed
+// meanwhile) opens the replay; held longer it stays the gun button.
+class Tap {
+public:
+    explicit Tap(unsigned tapMs = 250) : tapMs_(tapMs) {}
+    // Returns true on the release that completes a tap.
+    bool Update(bool down, bool otherDown, unsigned nowMs);
+    // The press now held (or the next release) is no tap: leaving the replay.
+    void Block() { down_ = spoiled_ = true; }
+private:
+    unsigned tapMs_;
+    bool down_ = false, spoiled_ = false;
+    unsigned since_ = 0;
+};
+
+}  // namespace replay
