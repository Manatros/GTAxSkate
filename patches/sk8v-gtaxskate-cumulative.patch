+/// One input: 0 up, 1 down, 2 left, 3 right, 4 accept, 5 back, 6 default board.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn sv_shop_input(_rt: *mut c_void, input: u32, cash: i64, out: *mut SvShopResult) -> u32 {
+    crate::guard(0, || {
+        let input = match input {
+            0 => Input::Up,
+            1 => Input::Down,
+            2 => Input::Left,
+            3 => Input::Right,
+            4 => Input::Accept,
+            5 => Input::Back,
+            6 => Input::Reset,
+            _ => return 0,
