+        let mut seen = rustc_hash::FxHashSet::default();
+        for x in self.grid.cell_of(lo.x)..=self.grid.cell_of(hi.x) {
+            for y in self.grid.cell_of(lo.y)..=self.grid.cell_of(hi.y) {
+                for &i in self.grid.cell(x, y) {
+                    if !seen.insert(i) { continue; }
+                    let (origin, end, planes) = &self.planes[i as usize];
+                    // A cylinder contains the 0.3 m capsule and is contained
+                    // by the sqrt(2)*0.3 m capsule. Exact distance rejects or
+                    // accepts almost all faces without constructing clip planes.
+                    let distance = segment_triangle_distance_squared(*origin, *end, t);
+                    if distance <= 0.3 * 0.3 { return true; }
+                    if distance > 2.0 * 0.302 * 0.302 { continue; }
+                    let planes = planes.get_or_init(|| Self::clip_planes(*origin, *end));
+                    if Self::clipped(*origin, planes, t) { return true; }
+                }
+            }
+        }
+        false
+    }
+}
+
+/// Exact segment/triangle distance: plane intersection, endpoints and edges.
+fn segment_triangle_distance_squared(a: Vec3, b: Vec3, t: &[Vec3; 3]) -> f32 {
+    let n = (t[1] - t[0]).cross(t[2] - t[0]);
+    let d = b - a;
+    let den = n.dot(d);
+    if den.abs() > 1e-12 {
+        let s = n.dot(t[0] - a) / den;
+        if (0.0..=1.0).contains(&s) {
+            let p = a + s * d;
+            if closest_on_triangle(p, t).distance_squared(p) < 1e-10 { return 0.; }
+        }
+    }
+    let mut best = closest_on_triangle(a, t).distance_squared(a).min(closest_on_triangle(b, t).distance_squared(b));
+    for k in 0..3 {
+        let (c, e) = (t[k], t[(k + 1) % 3] - t[k]);
+        let r = a - c;
+        let (dd, ee, de, dr, er) = (d.length_squared(), e.length_squared(), d.dot(e), d.dot(r), e.dot(r));
+        if ee < 1e-12 { continue; }
+        let denom = dd * ee - de * de;
+        let mut s = if denom > 1e-12 { ((de * er - dr * ee) / denom).clamp(0., 1.) } else { 0. };
+        let u = ((de * s + er) / ee).clamp(0., 1.);
+        if dd > 1e-12 { s = ((de * u - dr) / dd).clamp(0., 1.); }
+        best = best.min((a + d * s).distance_squared(c + e * u));
+    }
+    best
+}
+
+/// A track line point looks this far either side for GTA's rail (metres) ...
+const RAIL_SEARCH: f32 = 0.08;
+/// ... and this high above the track bed.
+const RAIL_SEARCH_UP: f32 = 0.35;
+/// The line rides this much over the rail collision's top (metres).
+const RAIL_CLEAR: f32 = 0.01;
+/// Design 2026-11-03-metro-rail-snap: GTA's rail strip is looked for this far
+/// either side (m; M17: the strips lie 11-17 cm off the node line), every
+/// RAIL_SAMPLE m ...
+const RAIL_REACH: f32 = 0.25;
+const RAIL_SAMPLE: f32 = 0.01;
+/// ... as a head at most this wide (m) ...
+const RAIL_HEAD_MAX: f32 = 0.15;
+/// ... with nothing or something this much lower beside it (m) ...
+const RAIL_DROP: f32 = 0.02;
+/// ... and at most this far across from the previous point's head (m).
+const RAIL_STEP: f32 = 0.05;
+/// Design 2026-11-07-track-steel: a line already on its steel follows it this
+/// far from the node line (m; the La Mesa switch curves lie up to 0.47 m off
+/// their node polyline); a line starts only within RAIL_REACH.
+const RAIL_WIDE: f32 = 0.6;
+
+/// Rail heads in a row of floor heights across the track (`RAIL_SAMPLE`
+/// apart, index 0 at -RAIL_REACH): a run is neighbouring samples that step
+/// less than `RAIL_DROP` (a rail's head on its foot is one run, a gap or a
+/// drop ends it); its head is the samples within 1 cm of its top, as the
+/// +-8 cm rule takes them. (middle offset, width, top) of each head piece
+/// (neighbouring head samples) of a run that does not touch either end of the
+/// row, has nothing or something lower beside it (a groove beside a rail or a
+/// curb is no rail) and is at most `RAIL_HEAD_MAX` wide.
+#[cfg(test)]
+fn rail_heads(row: &[Option<f32>]) -> Vec<(f32, f32, f32)> {
+    rail_heads_within(row, RAIL_REACH)
+}
+
+/// `rail_heads` of a row reaching `reach` either side.
+fn rail_heads_within(row: &[Option<f32>], reach: f32) -> Vec<(f32, f32, f32)> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < row.len() {
+        if row[i].is_none() { i += 1; continue; }
+        let start = i;
+        i += 1;
+        while let (Some(z), Some(before)) = (row.get(i).copied().flatten(), row[i - 1]) {
+            if (z - before).abs() >= RAIL_DROP { break; }
+            i += 1;
+        }
+        let end = i - 1;
+        if start == 0 || end + 1 == row.len() { continue; }
+        let top = row[start..=end].iter().flatten().fold(f32::MIN, |m, &z| m.max(z));
+        let higher = |k: usize| row[k].is_some_and(|z| z > top - RAIL_DROP);
+        if higher(start - 1) || higher(end + 1) { continue; }
+        let mut k = start;
+        while k <= end {
+            if !row[k].is_some_and(|z| z >= top - 0.01) { k += 1; continue; }
+            let lo = k;
+            while k + 1 <= end && row[k + 1].is_some_and(|z| z >= top - 0.01) { k += 1; }
+            let width = (k - lo) as f32 * RAIL_SAMPLE;
+            if width <= RAIL_HEAD_MAX {
+                out.push(((lo + k) as f32 * 0.5 * RAIL_SAMPLE - reach, width, top));
+            }
+            k += 1;
+        }
+    }
+    out
+}
+
+/// Track lines snapped onto GTA's rail collision: each point takes the
+/// highest surface within `RAIL_SEARCH` either side (across the track, from
+/// the bed up to `RAIL_SEARCH_UP`) and moves over the middle of it. The
+/// rails' height differs between lines (0.13-0.17 m); a fixed one put the
+/// line 2-4 cm inside the metro's rail boxes, the board clipped in and
+/// slipped under (2026-10-20). Points with nothing there keep the default.
+pub fn onto_rail_boxes(lines: Vec<Vec<Vec3>>, gta: &[[Vec3; 3]]) -> Vec<Vec<Vec3>> {
+    let grid = crate::grid::XyGrid::triangles(1.0, gta);
+    onto_rail_boxes_indexed(lines, gta, &grid)
+}
+
+fn onto_rail_boxes_indexed(lines: Vec<Vec<Vec3>>, gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid) -> Vec<Vec<Vec3>> {
+    if lines.is_empty() {
+        return lines;
+    }
+    let floor = |x: f32, y: f32, lo: f32, hi: f32| -> Option<f32> {
+        grid.at(x, y)
+            .iter()
+            .filter_map(|&i| {
+                let t = gta[i as usize];
+                let n = (t[1] - t[0]).cross(t[2] - t[0]);
+                if n.z.abs() < 1e-6 || n.normalize_or_zero().z.abs() < 0.7 {
+                    return None;
+                }
+                let tri = svwc::Tri { v: t.map(|p| p.to_array()), material: 0 };
+                svwc::clean::floor_at(&tri, [x, y]).filter(|z| *z >= lo && *z <= hi)
+            })
+            .fold(None, |m: Option<f32>, z| Some(m.map_or(z, |m| m.max(z))))
+    };
+    lines
+        .into_iter()
+        .flat_map(|line| {
+            if line.len() < 2 { return Vec::new(); }
+            // Design 2026-11-07-track-steel: each point is snapped in a pass
+            // along the line and in a pass back, so a line that starts (or
+            // restarts after a gap) beside its steel still finds it from the
+            // other side; heads win over the 8 cm rule, and a drifted pass's
+            // "interpolate" wins over the other pass's fallback.
+            // (point, kind: 2 head, 1 fallback, 0 interpolate, width, locked:
+            // the pass was following steel there)
+            let pass = |order: &mut dyn Iterator<Item = usize>| -> Vec<(Option<Vec3>, u8, f32, bool)> {
+                let mut out = vec![(None, 0u8, 0.0f32, false); line.len()];
+                // The last two points that found a rail head, and their offsets.
+                // (node-line point, offset, steel point) of the last head, and
+                // the steel point of the one before.
+                let mut previous: Option<(Vec3, f32, bevy_math::Vec2)> = None;
+                // (node-line point, steel point) of the heads over the last
+                // 2.5 m: the steel's heading is taken over this whole stretch
+                // (freight trial t8: two heads 0.5 m apart with 1-2 cm of
+                // noise gave a heading 10-15 degrees off, the prediction
+                // missed by 12 cm and the line never found its rail again).
+                let mut trail: std::collections::VecDeque<(Vec3, bevy_math::Vec2)> = std::collections::VecDeque::new();
+                // The last head's offset at any distance: a line that drifted
+                // with its steel is not pulled back onto the node line after
+                // a gap either (peer review 2026-11-07).
+                let mut drift: Option<f32> = None;
+                for i in order {
+                    let p = line[i];
+                    let (a, b) = (line[i.saturating_sub(1)], line[(i + 1).min(line.len() - 1)]);
+                    let along = (b - a).truncate().normalize_or_zero();
+                    let side = bevy_math::Vec2::new(-along.y, along.x);
+                    let bed = p.z - crate::tracks::RAIL_TOP;
+                    // GTA's rail head, keeping to the steel the line was on
+                    // (design 2026-11-03-metro-rail-snap); the row reaches
+                    // RAIL_WIDE so a line follows its steel where the node
+                    // polyline cuts a curve; it starts only within RAIL_REACH.
+                    let steps = (RAIL_WIDE / RAIL_SAMPLE).round() as i32;
+                    let row: Vec<Option<f32>> = (-steps..=steps).map(|k| {
+                        let q = p.truncate() + side * (k as f32 * RAIL_SAMPLE);
+                        floor(q.x, q.y, bed + 0.03, bed + RAIL_SEARCH_UP)
+                    }).collect();
+                    let want = previous.filter(|(q, _, _)| q.distance(p) < 2.0).map(|(q, w, s)| (q, w, s));
+                    // The steel goes on along its own heading over the last two
+                    // heads, not the node polyline's: across a node vertex the
+                    // offset from the polyline turns by c/R (13 m chord, 50 m
+                    // radius: 6.5 cm per 0.5 m; Goldfish 2026-11-07).
+                    while trail.front().is_some_and(|(n, _)| n.distance(p) > 2.5) { trail.pop_front(); }
+                    let aim = want.map(|(q, w, steel)| {
+                        match trail.front().map(|t| t.1).filter(|r| r.distance(steel) > 0.4) {
+                            Some(r) => {
+                                let heading = (steel - r).normalize_or_zero();
+                                let ahead = steel + heading * q.truncate().distance(p.truncate());
+                                (ahead - p.truncate()).dot(side).clamp(-RAIL_WIDE, RAIL_WIDE)
+                            }
+                            None => w,
+                        }
+                    });
+                    let last = want.map(|(_, w, _)| w);
+                    let heads = rail_heads_within(&row, RAIL_WIDE);
+                    // Heads the old 25 cm window saw whole (it rejected runs
+                    // touching its ends): only they send a point to
+                    // interpolation instead of the 8 cm rule (freight trial t6:
+                    // switch blades lost their lines).
+                    let near = heads.iter().any(|h| h.0.abs() + h.1 * 0.5 + RAIL_SAMPLE < RAIL_REACH);
+                    let centre = aim.unwrap_or(0.0);
+                    let head = heads.iter().copied()
+                        .filter(|h| match (aim, last) {
+                            // Near the prediction or near the last head's offset.
+                            (Some(w), Some(l)) => (h.0 - w).abs() <= RAIL_STEP || (h.0 - l).abs() <= RAIL_STEP,
+                            _ => h.0.abs() <= RAIL_REACH,
+                        })
+                        .min_by(|x, y| (x.0 - centre).abs().total_cmp(&(y.0 - centre).abs()).then(x.0.abs().total_cmp(&y.0.abs())));
+                    // A line that followed another leg away from its node
+                    // line (beyond RAIL_REACH) and lost it takes its own steel
+                    // again where a head lies on the node line itself; the
+                    // split below ends the drifted piece (freight trial t9:
+                    // 6 m of the straight rail at two switch blades had no line).
+                    let head = head.or_else(|| last.filter(|l| l.abs() > RAIL_REACH).and_then(|_| heads.iter().copied()
+                        .filter(|h| h.0.abs() <= RAIL_STEP).min_by(|x, y| x.0.abs().total_cmp(&y.0.abs()))));
+                    if let Some((middle, width, top)) = head {
+                        let q = p.truncate() + side * middle;
+                        if want.is_none() { trail.clear(); }
+                        trail.push_back((p, q));
+                        previous = Some((p, middle, q));
+                        drift = Some(middle);
+                        out[i] = (Some(Vec3::new(q.x, q.y, top + RAIL_CLEAR)), 2, width, true);
+                        continue;
+                    }
+                    out[i].3 = want.is_some();
+                    // Heads, but none on this line's steel (a frog, a joint):
+                    // interpolated, not the +-8 cm rule that may take the other one.
+                    if want.is_some() && near { continue; }
+                    // A line that drifted with its steel is never pulled back
+                    // onto the node line by the 8 cm rule.
+                    if drift.is_some_and(|w| w.abs() > RAIL_REACH) { continue; }
+                    // No rail head: today's rule.
+                    // Highest surface across the rail, and where it is.
+                    let samples: Vec<(f32, f32)> = (-8..=8)
+                        .filter_map(|k| {
+                            let off = k as f32 * RAIL_SEARCH / 8.0;
+                            let q = p.truncate() + side * off;
+                            floor(q.x, q.y, bed + 0.03, bed + RAIL_SEARCH_UP).map(|z| (off, z))
+                        })
+                        .collect();
+                    let Some(top) = samples.iter().map(|s| s.1).fold(None, |m: Option<f32>, z| Some(m.map_or(z, |m| m.max(z)))) else { continue };
+                    let on_top: Vec<f32> = samples.iter().filter(|s| s.1 >= top - 0.01).map(|s| s.0).collect();
+                    let middle = on_top.iter().sum::<f32>() / on_top.len() as f32;
+                    let (lo, hi) = on_top.iter().fold((f32::MAX, f32::MIN), |(a, b), &o| (a.min(o), b.max(o)));
+                    let q = p.truncate() + side * middle;
+                    out[i] = (Some(Vec3::new(q.x, q.y, top + RAIL_CLEAR)), 1, hi - lo, want.is_some());
+                }
+                out
+            };
+            let forward = pass(&mut (0..line.len()));
+            let back = pass(&mut (0..line.len()).rev());
+            // (kind, width) per kept point, for each piece's edge width.
+            let mut meta: Vec<(u8, f32)> = Vec::with_capacity(line.len());
+            let snapped: Vec<Option<Vec3>> = forward.iter().zip(&back).map(|(f, b)| {
+                // The pass back only fills where the pass along had not yet
+                // found its steel (a line start beside it): at a switch the
+                // two passes may follow different legs (freight junction trial).
+                let pick = if f.1 == 2 { f } else if b.1 == 2 && !f.3 { b } else if f.1 == 0 || b.1 == 0 { meta.push((0, 0.0)); return None } else { f };
+                meta.push((pick.1, pick.2));
+                pick.0
+            }).collect();
+            let finish = |snapped: &[Option<Vec3>], meta: &[(u8, f32)]| -> Vec<Vec<Vec3>> {
+                // Both edges of the rail head grindable (Manatros 2026-10-24/25:
+                // "the track rails should have 2 separate grindable edges"); a
+                // head narrower than EDGE_MIN keeps one line on its middle.
+                // Head widths alone, per piece: a line on a rail takes its
+                // edges from the heads, not from fallback slabs (peer reviews
+                // 2026-11-03 and 2026-11-07).
+                let mut w: Vec<f32> = meta.iter().filter(|m| m.0 == 2).map(|m| m.1).collect();
+                if w.is_empty() { w = meta.iter().filter(|m| m.0 == 1).map(|m| m.1).collect(); }
+                w.sort_by(f32::total_cmp);
+                let half = w.get(w.len() / 2).copied().unwrap_or(0.0) * 0.5;
+                let (Some(first), Some(last)) = (snapped.iter().position(|s| s.is_some()), snapped.iter().rposition(|s| s.is_some())) else { return Vec::new() };
+                if first >= last { return Vec::new(); }
+                let mut result = Vec::with_capacity(last - first + 1);
+                for i in first..=last {
+                    if let Some(p) = snapped[i] {
+                        result.push(p);
+                    } else {
+                        let prev = (first..i).rev().find(|&k| snapped[k].is_some()).unwrap();
+                        let next = (i + 1..=last).find(|&k| snapped[k].is_some()).unwrap();
+                        let t = (i - prev) as f32 / (next - prev) as f32;
+                        result.push(snapped[prev].unwrap().lerp(snapped[next].unwrap(), t));
+                    }
+                }
+                if result.len() < 2 { return Vec::new(); }
+                if half * 2.0 < EDGE_MIN { return vec![result]; }
+                let side = |i: usize| {
+                    let (a, b) = (result[i.saturating_sub(1)], result[(i + 1).min(result.len() - 1)]);
+                    let along = (b - a).truncate().normalize_or_zero();
+                    Vec3::new(-along.y, along.x, 0.0)
+                };
+                let left = (0..result.len()).map(|i| result[i] + side(i) * half).collect();
+                let right = (0..result.len()).map(|i| result[i] - side(i) * half).collect();
+                vec![left, right]
+            };
+            // Design 2026-11-07-track-steel: where neighbouring points lie on
+            // different steel (the passes there and back took the two legs
+            // of a switch), the line ends instead of crossing the ballast:
+            // a jump over RAIL_REACH (or RAIL_STEP per sample between kept
+            // points, whichever is more; peer review 2026-11-07: steel
+            // drifts 2-5 cm per sample); smaller steps at a frog stay one line.
+            let offset = |i: usize, q: Vec3| {
+                let (a, b) = (line[i.saturating_sub(1)], line[(i + 1).min(line.len() - 1)]);
+                let along = (b - a).truncate().normalize_or_zero();
+                (q - line[i]).truncate().dot(bevy_math::Vec2::new(-along.y, along.x))
+            };
+            let mut out = Vec::new();
+            let mut start = 0;
+            let mut last: Option<(usize, f32)> = None;
+            for i in 0..snapped.len() {
+                let Some(q) = snapped[i] else { continue };
+                let o = offset(i, q);
+                if let Some((j, oj)) = last {
+                    if (o - oj).abs() > RAIL_REACH.max(RAIL_STEP * (i - j) as f32) {
+                        out.extend(finish(&snapped[start..=j], &meta[start..=j]));
+                        start = i;
+                    }
+                }
+                last = Some((i, o));
+            }
+            out.extend(finish(&snapped[start..], &meta[start..]));
+            out
+        })
+        .collect()
+}
+
+/// Headroom (metres) a grind line needs: a surface closer above buries it.
+const HEADROOM: f32 = 1.2;
+
+/// Rails without `HEADROOM` over them, cut out in 0.25 m steps; pieces under
+/// 0.5 m go. Measured on the Vespucci bowl rim (2026-10-25): lines at 5.16,
+/// 4.6 and 3.7 m under a 5.8 m cap ("edges that interrupt", stacked grinds).
+fn off_buried(rails: Vec<Vec<Vec3>>, gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid) -> Vec<Vec<Vec3>> {
+    let covered = |p: Vec3, _: Vec3| grid.at(p.x, p.y).iter().any(|&i| {
+        let t = gta[i as usize];
+        let n = (t[1] - t[0]).cross(t[2] - t[0]);
+        if n.length_squared() < 1e-12 { return false; }
+        let tri = svwc::Tri { v: t.map(|q| q.to_array()), material: 0 };
+        svwc::clean::floor_at(&tri, [p.x, p.y]).is_some_and(|z| z > p.z + 0.08 && z < p.z + HEADROOM)
+    });
+    cut_where(rails, covered)
+}
+
+/// How far to each side a grind line's surface is looked at (metres): both
+/// distances must show an edge-less surface for a stretch to go, so a line
+/// on a ledge or wall top narrower than twice the outer one keeps it.
+const FLUSH_SIDES: [f32; 2] = [0.12, 0.35];
+/// A surface whose two sides average less than this below the line's own
+/// surface drops away: an edge (metres).
+const FLUSH_DROP: f32 = 0.03;
+
+/// A grind line needs an edge (Manatros 2026-10-25, mark 5: a seam of the
+/// bean bowl's visible model climbing the wall became a rail; earlier "a
+/// grind line in the floor"). Stretches where the collision runs on at the
+/// line's height on both sides (flush, or a concave crease) go, cut out as
+/// `off_buried` does. Copings, curbs, ledges and stair noses drop away on a
+/// side; free-standing rails have no surface at the line and stay.
+fn off_flush(rails: Vec<Vec<Vec3>>, gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid) -> Vec<Vec<Vec3>> {
+    cut_where(rails, |p, along| flush_at(gta, grid, p, along))
+}
+
+/// Whether the collision runs on at `p`'s height on both sides of a line
+/// running `along` (no lip there; `off_flush`).
+fn flush_at(gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid, p: Vec3, along: Vec3) -> bool {
+    // The surface nearest `near` in height (walkable or steeper up to 78 deg).
+    let surface = |x: f32, y: f32, near: f32, below: f32, above: f32| {
+        grid.at(x, y).iter().filter_map(|&i| {
+            let tri = svwc::Tri { v: gta[i as usize].map(|q| q.to_array()), material: 0 };
+            svwc::clean::surface_at(&tri, [x, y], 0.2)
+        }).filter(|&z| z >= near - below && z <= near + above).min_by(|a, b| (a - near).abs().total_cmp(&(b - near).abs()))
+    };
+    let flush = |p: Vec3, along: Vec3| {
+        let side = Vec3::new(-along.y, along.x, 0.0).normalize_or_zero();
+        if side == Vec3::ZERO { return false; }
+        let Some(z0) = surface(p.x, p.y, p.z, 0.08, 0.08) else { return false };
+        let [near, far] = FLUSH_SIDES;
+        [side, -side].iter().map(|&s| {
+            let (a, b) = (p + s * near, p + s * far);
+            surface(a.x, a.y, z0, 0.6, 0.3).zip(surface(b.x, b.y, z0, 0.6, 0.3))
+        }).collect::<Option<Vec<_>>>().is_some_and(|sides| {
+            // Each side runs on smoothly (Codex 2026-10-25: a 10 cm drop
+            // beside rising ground averaged out to flush) ...
+            let smooth = sides.iter().all(|&(a, b)| ((b - z0) - (a - z0) * far / near).abs() <= 0.04);
+            // ... and together they do not fall away (a convex edge).
+            let (l, r) = (sides[0], sides[1]);
+            smooth && (l.0 + r.0) * 0.5 >= z0 - FLUSH_DROP && (l.1 + r.1) * 0.5 >= z0 - FLUSH_DROP
+        })
+    };
+    flush(p, along)
+}
+
+/// Where the high-res parks' visible surface folds by at least this much
+/// along a grind line found on GTA's own park collision, that line stays
+/// (cos 30 deg).
+const PARK_FOLD_COS: f32 = 0.866;
+
+/// The visible park model's chamfered and rounded edges hide from the rail
+/// finder (each fold under its 45 deg seam limit, or its top face counted
+/// as a roof). Stretches of `gta_rails` (Skate space, found on GTA's own
+/// park collision) that `area` has no line within 15 cm of are added where,
+/// over two thirds of every 10 cm, the area's surface folds by 30 deg or
+/// more along them (within 6 cm aside and 8 cm in height, edge running the
+/// same way within 25 deg). A smooth visible hump has no such fold, so
+/// GTA's facet creases (2026-10-25 M12, 2026-10-26 M2) stay out. Returns
+/// how many lines were added.
+pub fn park_edge_lines(area: &mut Area, gta_rails: &[Vec<[f32; 3]>]) -> usize {
+    let g = |p: [f32; 3]| coords::from_skate(Vec3::from_array(p));
+    let tris: Vec<[Vec3; 3]> = area.triangles.iter().map(|t| t.map(g)).collect();
+    // Folds: edges shared by two faces (vertex keys, 1 mm) at 30 deg or more.
+    let key = |v: Vec3| v.to_array().map(|x| (x * 1000.0).round() as i64);
+    let mut by_edge: std::collections::HashMap<([i64; 3], [i64; 3]), Vec<usize>> = Default::default();
+    for (i, t) in tris.iter().enumerate() {
+        for k in 0..3 {
+            let (a, b) = (key(t[k]), key(t[(k + 1) % 3]));
+            by_edge.entry(if a < b { (a, b) } else { (b, a) }).or_default().push(i);
+        }
+    }
+    let normal = |t: &[Vec3; 3]| (t[1] - t[0]).cross(t[2] - t[0]).normalize_or_zero();
+    let mut folds: Vec<(Vec3, Vec3)> = Vec::new();
+    for faces in by_edge.values().filter(|f| f.len() == 2) {
+        let (t, u) = (&tris[faces[0]], &tris[faces[1]]);
+        if normal(t).dot(normal(u)) > PARK_FOLD_COS { continue; }
+        // The shared edge's two vertices.
+        let shared: Vec<Vec3> = t.iter().copied().filter(|p| u.iter().any(|q| key(*q) == key(*p))).collect();
+        if shared.len() == 2 { folds.push((shared[0], shared[1])); }
+    }
+    let mut grid: std::collections::HashMap<(i32, i32), Vec<u32>> = Default::default();
+    for (i, (a, b)) in folds.iter().enumerate() {
+        let (lo, hi) = (a.min(*b) - Vec3::splat(0.1), a.max(*b) + Vec3::splat(0.1));
+        for x in lo.x.floor() as i32..=hi.x.floor() as i32 {
+            for y in lo.y.floor() as i32..=hi.y.floor() as i32 {
+                grid.entry((x, y)).or_default().push(i as u32);
+            }
+        }
+    }
+    // A rounded edge turns 30 deg over several shallow faces and has no single
+    // fold (design 2026-11-09-visible-owner, Goldfish 10): faces within
+    // PARK_ROUND of the point that differ by the fold angle count too.
+    const PARK_ROUND: f32 = 0.10;
+    let mut face_grid: std::collections::HashMap<(i32, i32), Vec<u32>> = Default::default();
+    for (i, t) in tris.iter().enumerate() {
+        let (lo, hi) = (t[0].min(t[1]).min(t[2]) - Vec3::splat(PARK_ROUND), t[0].max(t[1]).max(t[2]) + Vec3::splat(PARK_ROUND));
+        if hi.x - lo.x > 64.0 || hi.y - lo.y > 64.0 { continue; }
+        for x in lo.x.floor() as i32..=hi.x.floor() as i32 {
+            for y in lo.y.floor() as i32..=hi.y.floor() as i32 {
+                face_grid.entry((x, y)).or_default().push(i as u32);
+            }
+        }
+    }
+    let rounded = |p: Vec3, dir: Vec3| {
+        let near: Vec<Vec3> = face_grid.get(&(p.x.floor() as i32, p.y.floor() as i32)).map_or(Vec::new(), |list| list.iter()
+            .map(|&i| &tris[i as usize])
+            .filter(|t| closest_on_triangle(p, t).distance(p) <= PARK_ROUND)
+            .map(normal).filter(|n| *n != Vec3::ZERO).collect());
+        // The turn's axis must run along the line; opposite normals (a slab's
+        // top and bottom) have none.
+        near.iter().enumerate().any(|(i, a)| near[i + 1..].iter().any(|b| a.dot(*b) <= PARK_FOLD_COS
+            && a.cross(*b).normalize_or_zero().dot(dir).abs() >= 25f32.to_radians().cos()))
+    };
+    let on_fold = |p: Vec3, dir: Vec3| grid.get(&(p.x.floor() as i32, p.y.floor() as i32)).is_some_and(|list| list.iter().any(|&i| {
+        let (a, b) = folds[i as usize];
+        let ab = b - a;
+        let l2 = ab.length_squared();
+        if l2 < 1e-8 || (ab / l2.sqrt()).dot(dir).abs() < 25f32.to_radians().cos() { return false; }
+        let q = a + ab * ((p - a).dot(ab) / l2).clamp(0.0, 1.0);
+        (q - p).truncate().length() <= 0.06 && (q.z - p.z).abs() <= 0.08
+    })) || rounded(p, dir);
+    // Lines the area already has, as segments.
+    let have: Vec<(Vec3, Vec3)> = area.rails.iter().flat_map(|r| r.windows(2).map(|w| (g(w[0]), g(w[1])))).collect();
+    let covered = |p: Vec3| have.iter().any(|&(a, b)| {
+        let ab = b - a;
+        let q = a + ab * ((p - a).dot(ab) / ab.length_squared().max(1e-12)).clamp(0.0, 1.0);
+        q.distance(p) <= 0.15
+    });
+    let mut added = 0;
+    // A run of missing 10 cm samples ends where the line is covered or after
+    // 30 cm off any fold (peer review 2026-10-26: a 4 m line on a fold for
+    // 3 m must not bring its smooth metre back); it keeps up to its last
+    // folded sample.
+    const OFF_FOLD: usize = 3;
+    for r in gta_rails {
+        let r: Vec<Vec3> = r.iter().map(|&p| g(p)).collect();
+        let mut run: Vec<Vec3> = Vec::new();
+        let (mut on, mut total, mut misses) = (0usize, 0usize, 0usize);
+        let mut last_on: Option<usize> = None;
+        let mut flush = |run: &mut Vec<Vec3>, on: &mut usize, total: &mut usize, last_on: &mut Option<usize>, area: &mut Area| {
+            if let Some(k) = *last_on {
+                *total -= run.len() - (k + 1);
+                run.truncate(k + 1);
+                let len: f32 = run.windows(2).map(|w| w[0].distance(w[1])).sum();
+                if run.len() >= 2 && len >= 0.5 && *on * 3 >= *total * 2 {
+                    area.rails.push(run.iter().map(|&p| coords::to_skate(p).to_array()).collect());
+                    added += 1;
+                }
+            }
+            run.clear();
+            *on = 0;
+            *total = 0;
+            *last_on = None;
+        };
+        for w in r.windows(2) {
+            let (a, b) = (w[0], w[1]);
+            let dir = (b - a).normalize_or_zero();
+            let n = ((a.distance(b) / 0.1).ceil() as usize).max(1);
+            for k in 0..=n {
+                let p = a.lerp(b, k as f32 / n as f32);
+                if covered(p) {
+                    flush(&mut run, &mut on, &mut total, &mut last_on, area);
+                    misses = 0;
+                    continue;
+                }
+                if run.last().is_some_and(|q: &Vec3| q.distance(p) < 1e-4) { continue; }
+                if on_fold(p, dir) {
+                    run.push(p);
+                    total += 1;
+                    on += 1;
+                    last_on = Some(run.len() - 1);
+                    misses = 0;
+                } else if run.is_empty() {
+                    continue;
+                } else {
+                    misses += 1;
+                    if misses > OFF_FOLD {
+                        flush(&mut run, &mut on, &mut total, &mut last_on, area);
+                        misses = 0;
+                    } else {
+                        run.push(p);
+                        total += 1;
+                    }
+                }
+            }
+        }
+        flush(&mut run, &mut on, &mut total, &mut last_on, area);
+    }
+    if added > 0 {
+        let mut gta: Vec<Vec<Vec3>> = area.rails.iter().map(|r| r.iter().map(|&p| g(p)).collect()).collect();
+        crate::rails::join_ends(&mut gta);
+        crate::rails::straighten(&mut gta, STRAIGHT);
+        area.rails = gta.into_iter().map(|r| r.into_iter().map(|p| coords::to_skate(p).to_array()).collect()).collect();
+    }
+    added
+}
+
+/// A ramp's side rims in a park get a line from where they stand clear of the floor
+/// up to the coping (design 2026-11-09-see-through). `at_floor`: whether a rim's foot
+/// stands at a park's riding level (no roofs). A rim rising less than `RIM_RISE` is a
+/// curb's end. Returns how many.
+pub fn ramp_rim_lines(area: &mut Area, near_park: &dyn Fn(Vec3) -> bool, at_floor: &dyn Fn(Vec3) -> bool) -> usize {
+    const RIM_RISE: f32 = 0.50;
+    const RIM_COVERED: f32 = 0.15;
+    const RIM_STEP: f32 = 0.10;
+    const RIM_RUN: f32 = 0.50;
+    use crate::live::{RAMP_TAG, STEP_TAG, URAMP_TAG, USTEP_TAG, VISBAR_TAG};
+    let g = |p: [f32; 3]| coords::from_skate(Vec3::from_array(p));
+    // Stairs and railings keep their own rules (Goldfish 2026-11-09): no rim on them.
+    let not_ramp = skate_host::bridge::NO_GRIND_TAG | RAMP_TAG | STEP_TAG | URAMP_TAG | USTEP_TAG | VISBAR_TAG;
+    let tris: Vec<[Vec3; 3]> = area.triangles.iter().zip(&area.tags).filter(|(_, tag)| *tag & not_ramp == 0)
+        .map(|(t, _)| t.map(g)).filter(|t| near_park((t[0] + t[1] + t[2]) / 3.0)).collect();
+    if tris.is_empty() { return 0; }
+    let have: Vec<(Vec3, Vec3)> = area.rails.iter().flat_map(|r| r.windows(2).map(|w| (g(w[0]), g(w[1])))).collect();
+    let covered = |p: Vec3| have.iter().any(|&(a, b)| {
+        let d = b - a;
+        let t = ((p - a).dot(d) / d.length_squared().max(1e-9)).clamp(0.0, 1.0);
+        (a + d * t).distance(p) <= RIM_COVERED
+    });
+    let mut added: Vec<Vec<Vec3>> = Vec::new();
+    for rim in crate::rails::find_rims_metres(&tris) {
+        let rise = rim.iter().map(|p| p.z).fold(f32::MIN, f32::max) - rim.iter().map(|p| p.z).fold(f32::MAX, f32::min);
+        let foot = rim.iter().copied().min_by(|a, b| a.z.total_cmp(&b.z)).unwrap_or(Vec3::ZERO);
+        if rise < RIM_RISE || !at_floor(foot) { continue; }
+        // Only what no line has yet, every 10 cm: a lower stretch an ordinary lip
+        // already found must not be doubled (duplicates multiply the catches).
+        let mut run: Vec<Vec3> = Vec::new();
+        let mut runs: Vec<Vec<Vec3>> = Vec::new();
+        for w in rim.windows(2) {
+            let n = ((w[0].distance(w[1]) / RIM_STEP).ceil() as usize).max(1);
+            for k in 0..=n {
+                let p = w[0].lerp(w[1], k as f32 / n as f32);
+                if covered(p) {
+                    if !run.is_empty() { runs.push(std::mem::take(&mut run)); }
+                } else if run.last().is_none_or(|q| q.distance(p) > 1e-4) {
+                    run.push(p);
+                }
+            }
+        }
+        if !run.is_empty() { runs.push(run); }
+        for run in runs {
+            let length: f32 = run.windows(2).map(|w| w[0].distance(w[1])).sum();
+            if length < RIM_RUN { continue; }
+            added.push(run);
+        }
+    }
+    // Straight stretches as one segment, as the other park lines: 10 cm samples would
+    // spend the tile's segment budget.
+    crate::rails::straighten(&mut added, 0.01);
+    let count = added.len();
+    area.rails.extend(added.iter().map(|r| r.iter().map(|&p| coords::to_skate(p).to_array()).collect::<Vec<_>>()));
+    count
+}
+
+/// Visible railings (design 2026-10-25-visible-bar-collision, revision 8.3):
+/// GTA's railing box carried the finder's line on its top; with the box
+/// replaced by the visible bars, that line comes back on the bar's top
+/// wherever the area has no line yet (the visible-rail export misses the
+/// top bar at bends and posts). `slab_rails`: the lines of the same area
+/// built with the replaced boxes back (Skate space); `slabs`: those boxes
+/// (GTA space). Every 10 cm of such a line that lies on a box's top face,
+/// has no area line within 15 cm and a bar within 20 cm aside moves onto the
+/// highest bar point there; runs of 0.5 m or more are added. Then lower
+/// bars under the new lines go (only a railing's top bar is grindable).
+/// Returns how many lines were added.
+pub fn bar_top_lines(area: &mut Area, slab_rails: &[Vec<[f32; 3]>], slabs: &[[[f32; 3]; 3]]) -> usize {
+    let g = |p: [f32; 3]| coords::from_skate(Vec3::from_array(p));
+    let bars: Vec<[Vec3; 3]> = area.triangles.iter().zip(&area.tags)
+        .filter(|(_, tag)| *tag & crate::live::VISBAR_TAG != 0).map(|(t, _)| t.map(g)).collect();
+    let tops: Vec<[Vec3; 3]> = slabs.iter().map(|t| t.map(Vec3::from_array)).filter(|t| {
+        let n = (t[1] - t[0]).cross(t[2] - t[0]);
+        n.z >= 0.5 * n.length().max(1e-9)
+    }).collect();
+    if bars.is_empty() || tops.is_empty() { return 0; }
+    let (bar_grid, top_grid) = (crate::grid::XyGrid::triangles(1.0, &bars), crate::grid::XyGrid::triangles(1.0, &tops));
+    let near = |grid: &crate::grid::XyGrid, p: Vec3, r: f32| -> Vec<u32> {
+        let mut v = Vec::new();
+        for x in grid.cell_of(p.x - r)..=grid.cell_of(p.x + r) {
+            for y in grid.cell_of(p.y - r)..=grid.cell_of(p.y + r) { v.extend_from_slice(grid.cell(x, y)); }
+        }
+        v.sort_unstable(); v.dedup(); v
+    };
+    let on_box_top = |p: Vec3| top_grid.at(p.x, p.y).iter()
+        .any(|&i| crate::grid::height(&tops[i as usize], p.x, p.y).is_some_and(|z| (z - p.z).abs() <= 0.05));
+    // The bar's crown: its long upward faces (peer review 2026-11-01: the
+    // nearest point of any face sat beside the crown, and post caps made the
+    // line jog). The highest such point near the sample.
+    let crown: Vec<bool> = bars.iter().map(|t| {
+        let n = (t[1] - t[0]).cross(t[2] - t[0]);
+        let long = (0..3).map(|k| (t[k] - t[(k + 1) % 3]).truncate().length()).fold(0.0f32, f32::max) >= 0.15;
+        long && n.z >= 0.5 * n.length().max(1e-9)
+    }).collect();
+    let bar_top = |p: Vec3| near(&bar_grid, p, 0.20).into_iter().filter(|&i| crown[i as usize])
+        .map(|i| closest_on_triangle(p, &bars[i as usize]))
+        .filter(|q| (*q - p).truncate().length() <= 0.20 && q.z >= p.z - 0.20 && q.z <= p.z + 0.05)
+        .max_by(|a, b| a.z.total_cmp(&b.z));
+    let mut have: Vec<(Vec3, Vec3)> = area.rails.iter().flat_map(|r| r.windows(2).map(|w| (g(w[0]), g(w[1])))).collect();
+    let covered = |have: &[(Vec3, Vec3)], p: Vec3| have.iter().any(|&(a, b)| {
+        let ab = b - a;
+        let q = a + ab * ((p - a).dot(ab) / ab.length_squared().max(1e-12)).clamp(0.0, 1.0);
+        q.distance(p) <= 0.15
+    });
+    let mut added: Vec<Vec<Vec3>> = Vec::new();
+    for r in slab_rails {
+        let r: Vec<Vec3> = r.iter().map(|&p| g(p)).collect();
+        let mut run: Vec<Vec3> = Vec::new();
+        let mut flush = |run: &mut Vec<Vec3>, have: &mut Vec<(Vec3, Vec3)>| {
+            if run.windows(2).map(|w| w[0].distance(w[1])).sum::<f32>() >= 0.5 {
+                have.extend(run.windows(2).map(|w| (w[0], w[1])));
+                added.push(std::mem::take(run));
+            }
+            run.clear();
+        };
+        for w in r.windows(2) {
+            let n = ((w[0].distance(w[1]) / 0.1).ceil() as usize).max(1);
+            for k in 0..=n {
+                let p = w[0].lerp(w[1], k as f32 / n as f32);
+                // Both long edges of a box top land on the same bar: the second is covered there.
+                let q = if on_box_top(p) && !covered(&have, p) { bar_top(p).filter(|&q| !covered(&have, q)) } else { None };
+                match q {
+                    Some(q) if !run.last().is_some_and(|l: &Vec3| l.distance(q) < 0.01) => run.push(q),
+                    Some(_) => {}
+                    None => flush(&mut run, &mut have),
+                }
+            }
+        }
+        flush(&mut run, &mut have);
+    }
+    let count = added.len();
+    if count > 0 {
+        // Only the new lines are joined and straightened, and only lines
+        // under them are cut (peer review 2026-11-01: tracks and park edges
+        // already carry their own processing).
+        crate::rails::join_ends(&mut added);
+        crate::rails::straighten(&mut added, STRAIGHT);
+        let old: Vec<Vec<Vec3>> = area.rails.iter().map(|r| r.iter().map(|&p| g(p)).collect()).collect();
+        let mut gta = off_stacked_under(old, &added);
+        gta.extend(added);
+        area.rails = gta.into_iter().map(|r| r.into_iter().map(|p| coords::to_skate(p).to_array()).collect()).collect();
+    }
+    count
+}
+
+/// Gap a grind line may be bridged across when the collision has an edge
+/// all along it (m).
+const EDGE_JOIN: f32 = 1.3;
+
+/// Grind lines broken along one clean edge are one line (Manatros
+/// 2026-10-26: "more connected and less fractured, especially where the
+/// geometry is clean"; the Vespucci pool rim came out in pieces where the
+/// rounded coping's facets meet): two ends up to `EDGE_JOIN` apart join when
+/// every 5 cm of the gap lies within 2 cm of a triangle edge running the
+/// same way (25 deg) and the gap is no flush seam. A real opening (a gap
+/// in a railing) has no edge across it and stays open.
+fn join_along_edges(rails: &mut Vec<Vec<Vec3>>, gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid) {
+    let on_edge = |s: Vec3, dir: Vec3| grid.at(s.x, s.y).iter().any(|&i| {
+        let t = &gta[i as usize];
+        (0..3).any(|k| {
+            let (a, b) = (t[k], t[(k + 1) % 3]);
+            let ab = b - a;
+            let len2 = ab.length_squared();
+            if len2 < 1e-6 || (ab / len2.sqrt()).dot(dir).abs() < 25f32.to_radians().cos() { return false; }
+            let u = ((s - a).dot(ab) / len2).clamp(0.0, 1.0);
+            (a + ab * u).distance(s) <= 0.02
+        })
+    });
+    let bridge = |p: Vec3, q: Vec3| {
+        let dir = (q - p).normalize_or_zero();
+        let steps = ((p.distance(q) / 0.05).ceil() as usize).max(2);
+        (1..steps).all(|k| on_edge(p.lerp(q, k as f32 / steps as f32), dir))
+            && [0.25, 0.5, 0.75].iter().all(|&f| !flush_at(gta, grid, p.lerp(q, f), dir))
+    };
+    crate::rails::join_ends_bridging(rails, EDGE_JOIN, &bridge);
+}
+
+/// How far under another rail a lower bar of the same railing lies
+/// (metres), and how far to the side at most.
+const STACK_BELOW: std::ops::RangeInclusive<f32> = 0.1..=0.8;
+const STACK_SIDE: f32 = 0.12;
+const STACK_TURN: f32 = 20.0 * std::f32::consts::PI / 180.0;
+
+/// Only a railing's top bar is grindable (Manatros 2026-10-25 mark 9: the
+/// metro handrail's lower bar made a second line 40 cm under the top one):
+/// stretches with another rail right above them go.
+fn off_stacked(rails: Vec<Vec<Vec3>>) -> Vec<Vec<Vec3>> {
+    let upper = rails.clone();
+    stacked_under(rails, &upper, true)
+}
+
+/// `off_stacked` for `rails` under the separate set `upper` only.
+fn off_stacked_under(rails: Vec<Vec<Vec3>>, upper: &[Vec<Vec3>]) -> Vec<Vec<Vec3>> {
+    stacked_under(rails, upper, false)
+}
+
+/// `same`: `upper` is `rails` itself (a rail never stacks under itself).
+fn stacked_under(rails: Vec<Vec<Vec3>>, upper: &[Vec<Vec3>], same: bool) -> Vec<Vec<Vec3>> {
+    // Every segment by 1 m cell, with its rail.
+    let mut cells: rustc_hash::FxHashMap<(i32, i32), Vec<(usize, Vec3, Vec3)>> = Default::default();
+    for (k, r) in upper.iter().enumerate() {
+        for w in r.windows(2) {
+            let (lo, hi) = (w[0].min(w[1]), w[0].max(w[1]));
+            for x in (lo.x - STACK_SIDE).floor() as i32..=(hi.x + STACK_SIDE).floor() as i32 {
+                for y in (lo.y - STACK_SIDE).floor() as i32..=(hi.y + STACK_SIDE).floor() as i32 {
+                    cells.entry((x, y)).or_default().push((k, w[0], w[1]));
+                }
+            }
+        }
+    }
+    let mut out = Vec::new();
+    for (k, rail) in rails.into_iter().enumerate() {
+        let under = |p: Vec3, along: Vec3| cells.get(&(p.x.floor() as i32, p.y.floor() as i32)).is_some_and(|list| list.iter().any(|&(j, a, b)| {
+            if same && j == k { return false; }
+            let ab = (b - a).truncate();
+            // Only a bar running the same way (Codex peer review: a crossing
+            // handrail cut the ledge line under it).
+            let (d, e) = (ab.normalize_or_zero(), along.truncate().normalize_or_zero());
+            if d != bevy_math::Vec2::ZERO && e != bevy_math::Vec2::ZERO && d.dot(e).abs() < STACK_TURN.cos() { return false; }
+            let t = if ab.length_squared() < 1e-8 { 0.0 } else { ((p.truncate() - a.truncate()).dot(ab) / ab.length_squared()).clamp(0.0, 1.0) };
+            let q = a.lerp(b, t);
+            q.truncate().distance(p.truncate()) <= STACK_SIDE && STACK_BELOW.contains(&(q.z - p.z))
+        }));
+        out.extend(cut_where(vec![rail], under));
+    }
+    out
+}
+
+/// Rails with the stretches where `cut(point, direction)` holds removed, in
+/// 0.25 m samples with 1 cm boundaries; pieces under 0.25 m go.
+fn cut_where(rails: Vec<Vec<Vec3>>, cut: impl Fn(Vec3, Vec3) -> bool) -> Vec<Vec<Vec3>> {
+    // The point between a kept `a` and a cut `b` (or the reverse) where
+    // the cut starts, to 1 cm (Codex 2026-10-25: cuts at the last 0.25 m
+    // sample lost up to 25 cm each side and every piece under 0.5 m).
+    let boundary = |a: Vec3, b: Vec3, a_clear: bool| {
+        let dir = (b - a).normalize_or_zero();
+        let (mut lo, mut hi) = (a, b);
+        for _ in 0..12 {
+            let mid = (lo + hi) * 0.5;
+            if cut(mid, dir) != a_clear { lo = mid; } else { hi = mid; }
+            if lo.distance(hi) < 0.01 { break; }
+        }
+        if a_clear { lo } else { hi }
+    };
+    let mut out = Vec::new();
+    for rail in rails {
+        // Samples every 0.25 m at most; a wholly kept line stays as it is.
+        let mut samples: Vec<(Vec3, bool)> = Vec::new();
+        for w in rail.windows(2) {
+            let dir = (w[1] - w[0]).normalize_or_zero();
+            let steps = ((w[1] - w[0]).length() / 0.25).ceil().max(1.0) as usize;
+            for k in 0..steps {
+                let p = w[0].lerp(w[1], k as f32 / steps as f32);
+                samples.push((p, cut(p, dir)));
+            }
+        }
+        if let (Some(&last), Some(w)) = (rail.last(), rail.windows(2).last()) {
+            samples.push((last, cut(last, (w[1] - w[0]).normalize_or_zero())));
+        }
+        if samples.iter().all(|s| !s.1) {
+            out.push(rail);
+            continue;
+        }
+        let mut piece: Vec<Vec3> = Vec::new();
+        for (k, &(p, is_cut)) in samples.iter().enumerate() {
+            let prev = k.checked_sub(1).map(|j| samples[j]);
+            match (prev, is_cut) {
+                (Some((q, false)), true) => {
+                    piece.push(boundary(q, p, true));
+                    let length: f32 = piece.windows(2).map(|w| w[0].distance(w[1])).sum();
+                    if piece.len() >= 2 && length >= 0.25 { out.push(std::mem::take(&mut piece)); } else { piece.clear(); }
+                }
+                (Some((q, true)), false) => { piece.push(boundary(q, p, false)); piece.push(p); }
+                (_, false) => { if piece.last() != Some(&p) { piece.push(p); } }
+                _ => {}
+            }
+        }
+        let length: f32 = piece.windows(2).map(|w| w[0].distance(w[1])).sum();
+        if piece.len() >= 2 && length >= 0.25 { out.push(piece); }
+    }
+    out
+}
+
+/// Narrowest rail head (metres) that gets a line on each edge.
+const EDGE_MIN: f32 = 0.03;
+/// Longest stretch without GTA rail collision boxed between found rail (m).
+const TRACK_GAP_MAX: f32 = 30.0;
+/// A track rail's box reaches this far under its grind line (m): GTA's rails
+/// stand 0.13-0.19 m over the bed, the line 1 cm over the rail; the rest is
+/// buried in the bed.
+const TRACK_BOX_DEPTH: f32 = 0.25;
+/// A rail head is walled when a steep face lies within TRACK_WALL_REACH of
+/// the point TRACK_WALL_DOWN under its line (m) ...
+const TRACK_WALL_DOWN: f32 = 0.08;
+const TRACK_WALL_REACH: f32 = 0.08;
+/// ... and it reaches up to this far under the line (m).
+const TRACK_WALL_TOP: f32 = 0.05;
+/// ... and a bare plate when nothing is at its height this far beside it (m).
+const TRACK_BESIDE: f32 = 0.15;
+
+/// Where a track edge line has no GTA surface just under it, between
+/// stretches that have one (a missing piece of a visible rail), a box keeps
+/// it solid (Manatros 2026-10-25: "partly solid rails, then no collision").
+/// Bare line ends and wholly bare lines get none: the node path may not
+/// follow a visible rail there.
+fn track_gap_boxes(tracks: &[Vec<Vec3>], gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid) -> Vec<[Vec3; 3]> {
+    let floor = |x: f32, y: f32| grid.at(x, y).iter().filter_map(|&i| {
+        let t = gta[i as usize];
+        let tri = svwc::Tri { v: t.map(|q| q.to_array()), material: 0 };
+        svwc::clean::floor_at(&tri, [x, y])
+    }).collect::<Vec<f32>>();
+    let supported = |p: Vec3| floor(p.x, p.y).into_iter().any(|z| z <= p.z + 0.005 && z >= p.z - 0.06);
+    // GTA's long straight metro pieces model the rail as a bare plate at
+    // rail height with no sides: the board lands on it but goes through
+    // (M17/M18, Manatros 2026-11-03: "the collision is still missing"). A
+    // plate is a head with no steep face under its edge and nothing at its
+    // height beside it (a level crossing's road is flush beside the rail).
+    // A side runs along the rail and reaches up to its head (a sleeper or
+    // chair under the rail is no side; peer review 2026-11-03).
+    let walled = |p: Vec3, side: bevy_math::Vec2| grid.at(p.x, p.y).iter().any(|&i| {
+        let t = gta[i as usize];
+        let n = (t[1] - t[0]).cross(t[2] - t[0]).normalize_or_zero();
+        let along = Vec3::new(side.y, -side.x, 0.0);
+        n.z.abs() < 0.5 && n.dot(along).abs() < 0.3 && t.iter().map(|q| q.z).fold(f32::MIN, f32::max) >= p.z - TRACK_WALL_TOP
+            && crate::world::closest_on_triangle(p - Vec3::Z * TRACK_WALL_DOWN, &t).distance(p - Vec3::Z * TRACK_WALL_DOWN) <= TRACK_WALL_REACH
+    });
+    let plate = |p: Vec3, side: bevy_math::Vec2| supported(p) && !walled(p, side) && [1.0f32, -1.0].iter().all(|s| {
+        let q = p.truncate() + side * (s * TRACK_BESIDE);
+        !floor(q.x, q.y).into_iter().any(|z| z >= p.z - 0.04 && z <= p.z + 0.05)
+    });
+    let mut gaps = Vec::new();
+    let mut plates = Vec::new();
+    for line in tracks {
+        let sides: Vec<bevy_math::Vec2> = (0..line.len()).map(|i| {
+            let (a, b) = (line[i.saturating_sub(1)], line[(i + 1).min(line.len() - 1)]);
+            let d = (b - a).truncate().normalize_or_zero();
+            bevy_math::Vec2::new(-d.y, d.x)
+        }).collect();
+        let bare: Vec<bool> = (0..line.len()).map(|i| plate(line[i], sides[i])).collect();
+        let mut i = 0;
+        while i < line.len() {
+            if !bare[i] { i += 1; continue; }
+            let start = i;
+            while i < line.len() && bare[i] { i += 1; }
+            // From halfway to the point before to halfway to the point after:
+            // a body never reaches into a level crossing beside the plate.
+            let mut run: Vec<Vec3> = Vec::new();
+            if start > 0 { run.push(line[start - 1].lerp(line[start], 0.5)); }
+            run.extend_from_slice(&line[start..i]);
+            if i < line.len() { run.push(line[i - 1].lerp(line[i], 0.5)); }
+            if run.len() >= 2 { plates.push(run); }
+        }
+        let ok: Vec<bool> = line.iter().map(|&p| supported(p)).collect();
+        let mut i = 0;
+        while i < line.len() {
+            if ok[i] { i += 1; continue; }
+            let start = i;
+            while i < line.len() && !ok[i] { i += 1; }
+            if start == 0 || i == line.len() { continue; }
+            let run: Vec<Vec3> = line[start - 1..=i].to_vec();
+            let length: f32 = run.windows(2).map(|w| w[0].distance(w[1])).sum();
+            if length <= TRACK_GAP_MAX { gaps.push(run); }
+        }
+    }
+    // Down to the bed: a 6 cm box hung 11 cm over it and a wheel went under
+    // (M18, 2026-11-02 measurement).
+    gaps.extend(plates);
+    // Fewer, longer boxes: the lines are sampled every 0.5 m (12 faces each).
+    crate::rails::straighten(&mut gaps, TRACK_STRAIGHT);
+    crate::visrails::boxes_deep(&gaps, Some(TRACK_BOX_DEPTH))
+}
+
+/// Rule 2 of design 2026-11-07-track-steel: a GTA rail head is an upward
+/// face at most RAIL_HEAD_MAX wide and ORPHAN_MIN_LEN long ...
+const ORPHAN_MIN_LEN: f32 = 0.4;
+/// ... standing 3.5-30 cm over a floor on both sides (sampled this far
+/// across, m) with nothing within 2 cm of its top there ...
+const ORPHAN_BESIDE: [f32; 2] = [0.12, 0.20];
+/// ... with a partner head this far across (centre to centre, m) ...
+const ORPHAN_GAUGE: (f32, f32) = (1.40, 1.70);
+/// ... parallel within 15 degrees (cosine) ...
+const ORPHAN_PARALLEL: f32 = 0.966;
+/// ... and chains shorter than this (m) give no line.
+const ORPHAN_CHAIN_MIN: f32 = 2.0;
+/// Head faces this near a snapped track line (m, 2D) are its steel already
+/// (a line on a head lies within 5 cm of its middle).
+const ORPHAN_COVERED: f32 = 0.10;
+
+/// Raw track lines (node-line form, for `onto_rail_boxes_indexed`) along
+/// GTA rail heads that no snapped track line covers.
+fn orphan_steel(gta: &[[Vec3; 3]], grid: &crate::grid::XyGrid, tracks: &[Vec<Vec3>], centre: [f32; 2], half: f32) -> Vec<Vec<Vec3>> {
+    use bevy_math::Vec2;
+    /// Head faces are cut into pieces at most this long (m): coverage,
+    /// pairing and chaining work per piece (peer review 2026-11-07: a long
+    /// face judged by its middle alone duplicated or dropped steel).
+    const PIECE: f32 = 0.5;
+    const CELL: f32 = 2.0;
+    let floors = |x: f32, y: f32| grid.at(x, y).iter().filter_map(|&i| {
+        let t = gta[i as usize];
+        let n = (t[1] - t[0]).cross(t[2] - t[0]);
+        if n.normalize_or_zero().z < 0.7 { return None; }
+        let tri = svwc::Tri { v: t.map(|q| q.to_array()), material: 0 };
+        svwc::clean::floor_at(&tri, [x, y])
+    }).collect::<Vec<f32>>();
+    // Ids in the cells around `p` (`reach` m), sorted and unique.
+    let near = |g: &crate::grid::XyGrid, p: Vec2, reach: f32| {
+        let mut ids = Vec::new();
+        for x in g.cell_of(p.x - reach)..=g.cell_of(p.x + reach) {
+            for y in g.cell_of(p.y - reach)..=g.cell_of(p.y + reach) {
+                ids.extend_from_slice(g.cell(x, y));
+            }
+        }
+        ids.sort_unstable();
+        ids.dedup();
+        ids
+    };
+    // Snapped track lines, for coverage.
+    let edges: Vec<(Vec2, Vec2)> = tracks.iter().flat_map(|l| l.windows(2).map(|w| (w[0].truncate(), w[1].truncate()))).collect();
+    let mut edge_grid = crate::grid::XyGrid::new(CELL);
+    for (i, &(a, b)) in edges.iter().enumerate() {
+        edge_grid.insert(i as u32, a.min(b).extend(0.0) - Vec3::splat(ORPHAN_COVERED), a.max(b).extend(0.0) + Vec3::splat(ORPHAN_COVERED));
+    }
+    let covered = |p: Vec2| edge_grid.at(p.x, p.y).iter().any(|&i| {
+        let (a, b) = edges[i as usize];
+        let d = b - a;
+        let t = if d.length_squared() > 1e-12 { ((p - a).dot(d) / d.length_squared()).clamp(0.0, 1.0) } else { 0.0 };
+        (a + d * t).distance(p) < ORPHAN_COVERED
+    });
+    // (start, end, bed + 0.10) of each uncovered piece of a head face, on
+    // the line through the face's centroid along its long edge, from its
+    // corners' extent along that line (peer review: a split quad's diagonal
+    // put the two triangles' ends 2w/3 apart across the head).
+    let mut pieces: Vec<(Vec2, Vec2, f32)> = Vec::new();
+    for t in gta {
+        let n = (t[1] - t[0]).cross(t[2] - t[0]);
+        if n.normalize_or_zero().z <= 0.7 { continue; }
+        let c = (t[0] + t[1] + t[2]) / 3.0;
+        if (c.x - centre[0]).abs() > half || (c.y - centre[1]).abs() > half { continue; }
+        let (a, b) = [(0, 1), (1, 2), (2, 0)].iter().map(|&(i, j)| (t[i].truncate(), t[j].truncate()))
+            .max_by(|x, y| x.0.distance(x.1).total_cmp(&y.0.distance(y.1))).unwrap();
+        let len = a.distance(b);
+        if len < ORPHAN_MIN_LEN { continue; }
+        let width = n.z.abs() / len;
+        if width > RAIL_HEAD_MAX { continue; }
+        let dir = (b - a) / len;
+        let perp = Vec2::new(-dir.y, dir.x);
+        let top = t.iter().map(|q| q.z).fold(f32::MIN, f32::max);
+        // The ground beside the head (the bed the snap measures from).
+        let mut bed = f32::MIN;
+        let proud = [1.0f32, -1.0].iter().all(|s| {
+            let mut ground = false;
+            for d in ORPHAN_BESIDE {
+                let q = c.truncate() + perp * (s * d);
+                let f = floors(q.x, q.y);
+                if f.iter().any(|&z| z >= top - 0.02 && z <= top + 0.05) { return false; }
+                for &z in f.iter().filter(|&&z| z >= top - 0.30 && z <= top - 0.035) { ground = true; bed = bed.max(z); }
+            }
+            ground
+        });
+        if !proud { continue; }
+        let along = t.iter().map(|q| (q.truncate() - c.truncate()).dot(dir));
+        let (lo, hi) = along.fold((f32::MAX, f32::MIN), |(l, h), s| (l.min(s), h.max(s)));
+        let steps = ((hi - lo) / PIECE).ceil().max(1.0) as usize;
+        for k in 0..steps {
+            let p = c.truncate() + dir * (lo + (hi - lo) * k as f32 / steps as f32);
+            let q = c.truncate() + dir * (lo + (hi - lo) * (k + 1) as f32 / steps as f32);
+            // Stored as bed + 0.10: the line point is bed + RAIL_TOP below.
+            if !covered((p + q) * 0.5) { pieces.push((p, q, bed + 0.10)); }
+        }
+    }
+    let mut piece_grid = crate::grid::XyGrid::new(CELL);
+    for (i, &(a, b, _)) in pieces.iter().enumerate() {
+        piece_grid.insert(i as u32, a.min(b).extend(0.0), a.max(b).extend(0.0));
+    }
+    // A track, not a ledge: a parallel partner head at the gauge.
+    let paired: Vec<bool> = pieces.iter().map(|&(a, b, z)| {
+        let dir = (b - a).normalize_or_zero();
+        let perp = Vec2::new(-dir.y, dir.x);
+        let mid = (a + b) * 0.5;
+        let half_len = a.distance(b) * 0.5;
+        near(&piece_grid, mid, ORPHAN_GAUGE.1 + PIECE).into_iter().any(|j| {
+            let (c, d, z2) = pieces[j as usize];
+            let dir2 = (d - c).normalize_or_zero();
+            let mid2 = (c + d) * 0.5;
+            let across = (mid2 - mid).dot(perp).abs();
+            dir.dot(dir2).abs() >= ORPHAN_PARALLEL && (z - z2).abs() <= 0.10
+                && across >= ORPHAN_GAUGE.0 && across <= ORPHAN_GAUGE.1
+                && (mid2 - mid).dot(dir).abs() <= half_len + c.distance(d) * 0.5
+        })
+    }).collect();
+    let mut used: Vec<bool> = paired.iter().map(|p| !p).collect();
+    // Longest first (ties in input order): a chain grows from its best piece.
+    let mut order: Vec<usize> = (0..pieces.len()).collect();
+    order.sort_by(|&x, &y| pieces[y].0.distance(pieces[y].1).total_cmp(&pieces[x].0.distance(pieces[x].1)));
+    // Chains through the pieces' middles, steered by the chain's own
+    // direction over its last points: one piece's direction can be 8-9
+    // degrees off the rail (a 0.6 m quad's diagonal, unit test). The next
+    // piece is the nearest unused parallel one ahead (5 cm to 1 m) within
+    // 4 cm + 10 % of the distance across; the snap centres the line on the
+    // head afterwards.
+    let mid = |k: usize| (pieces[k].0 + pieces[k].1) * 0.5;
+    let mut out = Vec::new();
+    for s in order {
+        if used[s] { continue; }
+        used[s] = true;
+        let (a0, b0, z0) = pieces[s];
+        let mut chain: Vec<(Vec2, f32)> = vec![(a0, z0), (mid(s), z0), (b0, z0)];
+        for _ in 0..2 {
+            // The far end of the last piece taken (the chain ends there).
+            let mut tip = chain.pop().unwrap();
+            loop {
+                let n = chain.len();
+                let end = chain[n - 1].0;
+                let back = chain[n.saturating_sub(6)].0;
+                let dir = if end.distance(back) > 0.2 { (end - back).normalize_or_zero() } else { (tip.0 - end).normalize_or_zero() };
+                if dir == Vec2::ZERO { break; }
+                let perp = Vec2::new(-dir.y, dir.x);
+                let mut best: Option<(usize, f32)> = None;
+                for k in near(&piece_grid, end, 1.0 + PIECE) {
+                    let k = k as usize;
+                    if used[k] { continue; }
+                    let (a, b, _) = pieces[k];
+                    if (b - a).normalize_or_zero().dot(dir).abs() < ORPHAN_PARALLEL { continue; }
+                    let along = (mid(k) - end).dot(dir);
+                    if along <= 0.05 || along > 1.0 { continue; }
+                    if (mid(k) - end).dot(perp).abs() > 0.04 + 0.1 * along { continue; }
+                    if best.is_none_or(|x| along < x.1) { best = Some((k, along)); }
+                }
+                let Some((k, _)) = best else { break };
+                used[k] = true;
+                let (a, b, z) = pieces[k];
+                chain.push((mid(k), z));
+                tip = if (a - end).dot(dir) > (b - end).dot(dir) { (a, z) } else { (b, z) };
+                // Parallel pieces beside the new stretch (the head quad's
+                // other triangle) are this chain's; a crossing rail's are not.
+                let m0 = chain[n - 1].0;
+                let d = mid(k) - m0;
+                for j in near(&piece_grid, (m0 + mid(k)) * 0.5, d.length() * 0.5 + PIECE) {
+                    let j = j as usize;
+                    if used[j] { continue; }
+                    let (a, b, _) = pieces[j];
+                    if (b - a).normalize_or_zero().dot(dir).abs() < ORPHAN_PARALLEL { continue; }
+                    let t = if d.length_squared() > 1e-12 { ((mid(j) - m0).dot(d) / d.length_squared()).clamp(0.0, 1.0) } else { 0.0 };
+                    if (m0 + d * t).distance(mid(j)) <= 0.10 { used[j] = true; }
+                }
+            }
+            // The chain reaches the last piece's far end, along its direction.
+            let n = chain.len();
+            let end = chain[n - 1].0;
+            let back = chain[n.saturating_sub(6)].0;
+            let dir = if end.distance(back) > 0.2 { (end - back).normalize_or_zero() } else { (tip.0 - end).normalize_or_zero() };
+            let reach = (tip.0 - end).dot(dir);
+            if reach > 0.01 { chain.push((end + dir * reach, tip.1)); }
+            chain.reverse();
+        }
+        let mut line = Vec::new();
+        for w in chain.windows(2) {
+            let steps = (w[0].0.distance(w[1].0) / 0.5).ceil().max(1.0) as usize;
+            for k in 0..steps {
+                let t = k as f32 / steps as f32;
+                let p = w[0].0.lerp(w[1].0, t);
+                let top = w[0].1 + (w[1].1 - w[0].1) * t;
+                line.push(Vec3::new(p.x, p.y, top - 0.10 + crate::tracks::RAIL_TOP));
+            }
+        }
+        let (last, top) = chain[chain.len() - 1];
+        line.push(Vec3::new(last.x, last.y, top - 0.10 + crate::tracks::RAIL_TOP));
+        out.push(line);
+    }
+    // Chains that met end to end (grown from different pieces) are one.
+    crate::rails::trim_overlaps(&mut out);
+    crate::rails::join_ends(&mut out);
+    out.retain(|l| l.windows(2).map(|w| w[0].truncate().distance(w[1].truncate())).sum::<f32>() >= ORPHAN_CHAIN_MIN);
+    out
+}
+
+fn authoritative_tracks(rails: Vec<Vec<Vec3>>, tracks: Vec<Vec<Vec3>>) -> Vec<Vec<Vec3>> {
+    if tracks.is_empty() { return rails; }
+    let mut rails = cut_track_slots(rails, &tracks);
+    rails.extend(tracks);
+    rails
+}
+
+/// Remove exact parameter intervals inside the finite track capsules. Testing
+/// just segment endpoints lets long slot edges survive bends and crossings.
+fn cut_track_slots(rails: Vec<Vec<Vec3>>, tracks: &[Vec<Vec3>]) -> Vec<Vec<Vec3>> {
+    let edges: Vec<_> = tracks.iter().flat_map(|r| r.windows(2).map(|w| (w[0],w[1]))).collect();
+    let mut grid = crate::grid::XyGrid::new(2.);
+    for (i,&(a,b)) in edges.iter().enumerate() {
+        grid.insert(i as u32,a.min(b)-Vec3::splat(TRACK_SIDE),a.max(b)+Vec3::splat(TRACK_SIDE));
+    }
+    // Intersect an interval with lo <= origin + slope*t <= hi.
+    let slab = |range: &mut (f32,f32), origin: f32, slope: f32, lo: f32, hi: f32| {
+        if slope.abs()<1e-9 { return origin>=lo && origin<=hi; }
+        let (a,b) = ((lo-origin)/slope,(hi-origin)/slope);
+        range.0=range.0.max(a.min(b)); range.1=range.1.min(a.max(b));
+        range.0<=range.1
+    };
+    let mut out = Vec::new();
+    for rail in rails {
+        let mut piece = Vec::new();
+        for w in rail.windows(2) {
+            let (p,delta)=(w[0],w[1]-w[0]);
+            let lo=w[0].min(w[1]); let hi=w[0].max(w[1]);
+            let mut candidates=std::collections::BTreeSet::new();
+            for x in grid.cell_of(lo.x)..=grid.cell_of(hi.x) {
+                for y in grid.cell_of(lo.y)..=grid.cell_of(hi.y) {
+                    candidates.extend(grid.cell(x,y).iter().copied());
+                }
+            }
+            let mut cuts=Vec::new();
+            for i in candidates {
+                let (a,b)=edges[i as usize]; let d=b-a;
+                let len=d.truncate().length();
+                if len<1e-6 { continue; }
+                let unit=d.truncate()/len;
+                let origin=(p-a).truncate().dot(unit);
+                let slope=delta.truncate().dot(unit);
+                // Middle of the capsule: bounded strip, height follows track.
+                let mut range=(0.,1.);
+                if slab(&mut range,origin,slope,0.,len) &&
+                    slab(&mut range,unit.perp_dot((p-a).truncate()),unit.perp_dot(delta.truncate()),-TRACK_SIDE,TRACK_SIDE) &&
+                    slab(&mut range,p.z-a.z-origin*d.z/len,delta.z-slope*d.z/len,-TRACK_UP,TRACK_UP) {
+                    cuts.push(range);
+                }
+                // Round caps: projection beyond either endpoint, disc in XY.
+                for (end,left) in [(a,true),(b,false)] {
+                    let mut range=(0.,1.);
+                    if !slab(&mut range,origin,slope,
+                        if left { f32::NEG_INFINITY } else { len },
+                        if left { 0. } else { f32::INFINITY }) ||
+                        !slab(&mut range,p.z-end.z,delta.z,-TRACK_UP,TRACK_UP) { continue; }
