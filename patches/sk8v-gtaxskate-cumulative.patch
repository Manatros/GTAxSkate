+            let hi = std::path::Path::new(&dir).join(format!("hi@{n}"));
+            let (a, b) = count(&normal, true);
+            let (c, d) = count(&hi, false);
+            println!("{n:28} normal(ped) tris {a:6} rail-head strips {b:4} | hi@ tris {c:6} strips {d:4}");
+        }
+    }
+}
