+        if (std::string(key) == w.key && g_config.*(w.value) != w.best)
+            Notify(s, std::string("World collision: ") + w.name + " changed from its best value (" +
+                   (w.best ? "on" : "off") + "). The status row at the top of World collision resets it.", 8000);
+}
