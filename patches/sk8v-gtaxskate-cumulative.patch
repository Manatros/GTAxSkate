+bool ApplyBulk(const std::string& name, const std::vector<std::pair<std::string, std::string>>& settings) {
+    ++g_bulkSettings;
+    const bool ok = menu::ApplySettings(name, settings);
+    --g_bulkSettings;
+    return ok;
+}
