+// Standalone: cl /std:c++20 /EHsc /W4 interaction_menu_tests.cpp
+#include "../src/interaction_menu_logic.h"
+#include <cassert>
+#include <iostream>
+
+int main() {
+    using namespace interactionmenu;
+    for (bool keyboard : {false, true}) {
