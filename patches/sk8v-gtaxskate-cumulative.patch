@@ -0,0 +1,64 @@
+#pragma once
+// The board shop's parts (contributed by GTAxSkate): decks, griptapes, trucks
+// and wheels built by tools/prepare-board-parts.py with the native board's
+// seven-bone skeleton. The chosen ones are registered from loose files when
+// first needed and posed like the native board, which they then replace.
+#include <string>
+#include <vector>
+#include "skatev_runtime.h"
+
+namespace boardparts {
+
+// Call on the script thread. Reads <dataRoot>\private\board-parts.
+bool Start(const std::wstring& dataRoot, void (*log)(const char*));
+
+// The models to show (file stems without extension, e.g. skatev_d_default).
+// Empty: the native board shows.
+void SetLoadout(const std::vector<std::string>& models);
+const std::vector<std::string>& Loadout();
+bool Available(const std::string& model);
+// Glowing wheels: wheel parts show their emissive `<name>_glow` copies (built
+// by tools/make-glow-wheels.ps1) while on; boards swap like any loadout change.
+// colour: "" = the wheels' own texture (<name>_glow), else a fixed colour's
+// tinted copy <name>_glow_<colour> (lower case, as GlowColours) when built.
+void SetGlowWheels(bool on, const std::string& colour = {});
+
+// True while a custom board is shown; the caller then hides the native board.
+// Loadout changes retain and pose the old objects until a replacement is ready.
+// Not skating: removes the objects.
+bool Tick(bool skating, const SvBoardPose& pose);
+
+// The store's preview: `models` posed by `pose` (a rest pose from the
+// runtime). Unloaded selections wait for 400 ms; loaded ones show at once.
+// Empty `models` removes it.
+bool Preview(const std::vector<std::string>& models, const SvBoardPose& pose);
+
+// Neighbours paired by distance (1..3), scroll direction first in each pair.
+// Requests only, never objects. Empty clears the store's prefetch requests.
+void Prefetch(const std::vector<std::vector<std::string>>& neighbours);
+
+// The store's boards on show: board `index` (0..7) as `models` at rest in
+// `pose`. ClearDisplay removes them all.
+bool Display(int index, const std::vector<std::string>& models, const SvBoardPose& pose);
+void ClearDisplay();
+
+// The board in hand (GTA mode, the board picked in the weapon wheel) as
+// `models` in `pose`; empty `models` removes it.
+bool Hand(const std::vector<std::string>& models, const SvBoardPose& pose);
+
+// A crew member's board (AI skater `slot`, 0..3) as `models` in `pose`;
+// empty `models` removes it.
+bool Crew(int slot, const std::vector<std::string>& models, const SvBoardPose& pose);
+
+// A collectible's item (design 2026-11-02-collectibles-v2), slot 0..3, as
+// `models` in `pose`; empty `models` removes it. ClearPickups removes all.
+// The collectibles own their lifetime (Stop() runs at every leave).
+bool Pickup(int slot, const std::vector<std::string>& models, const SvBoardPose& pose);
+void ClearPickups();
+
+// Every part object shown (riding and preview): presentation only, never collision.
+std::vector<int> Entities();
+
+void Stop();
+
+} // namespace boardparts
diff --git a/host/src/board_parts_logic.h b/host/src/board_parts_logic.h
new file mode 100644
index 0000000000000000000000000000000000000000..aa828fb10a427955e139c783c4f2aebdc47b49bc
--- /dev/null
+++ b/host/src/board_parts_logic.h
@@ -0,0 +1,71 @@
+#pragma once
+#include <utility>
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <unordered_set>
+
+namespace boardpartslogic {
+// `reserve` registrations stay for the ridden board; preloading shrinks early
+// (a browsed entry's neighbours cost three times its own registrations).
+inline int PrefetchRadius(int registered, int limit, int reserve = 0) {
+    const int remaining = limit - reserve - registered;
+    return remaining < 20 ? 0 : remaining < 80 ? 1 : 3;
+}
+
+// Entries are paired by distance, with the scroll direction first. Empty
+// entries preserve distances at list boundaries and on group rows.
+template<class Registered, class Request>
+std::unordered_set<std::string> PrefetchModels(
+    const std::vector<std::vector<std::string>>& neighbours, int limit,
+    Registered registered, Request request, int reserve = 0) {
+    std::unordered_set<std::string> wanted;
+    for (std::size_t i = 0; i < neighbours.size() && i < 6; ++i) {
+        if (static_cast<int>(i / 2) >= PrefetchRadius(registered(), limit, reserve)) break;
+        for (const auto& name : neighbours[i]) {
+            if (!PrefetchRadius(registered(), limit, reserve)) break;
+            if (!name.empty() && wanted.insert(name).second) request(name);
+        }
+    }
+    return wanted;
+}
+
+// Candidates remain invisible across frames until their skeletons can be posed.
+// Creation failure releases partial objects; the current board stays intact.
+template<class Item, class Create, class Pose, class Publish, class Remove>
+bool Replace(std::vector<Item>& current, std::vector<Item>& pending,
+             const std::vector<std::string>& models,
+             Create create, Pose pose, Publish publish, Remove remove) {
+    if (pending.empty()) {
+        for (const auto& name : models) {
+            Item item;
+            if (!create(name, item)) {
+                for (auto& partial : pending) remove(partial);
+                pending.clear();
+                return false;
+            }
+            pending.push_back(std::move(item));
+        }
+    }
+    if (!pose(pending)) return false;
+    for (auto& item : pending) publish(item);
+    for (auto& item : current) remove(item);
+    current = std::move(pending);
+    pending.clear();
+    return true;
+}
+
+struct Selection {
+    std::vector<std::string> models;
+    std::uint64_t changed = 0;
+
+    bool Update(const std::vector<std::string>& next, std::uint64_t now) {
+        if (next == models) return false;
+        models = next;
+        changed = now;
+        return true;
+    }
+    bool Settled(std::uint64_t now) const { return now - changed >= 400; }
+    bool CanPreview(std::uint64_t now, bool loaded) const { return loaded || Settled(now); }
+};
+} // namespace boardpartslogic
diff --git a/host/src/board_pose_diagnostics.h b/host/src/board_pose_diagnostics.h
new file mode 100644
index 0000000000000000000000000000000000000000..422b491a17464a3c8dbc3cdce11b78d1678cb31a
--- /dev/null
+++ b/host/src/board_pose_diagnostics.h
@@ -0,0 +1,71 @@
+#pragma once
+// Developer observations only: no pose correction, allocation or game access.
+#include "pose_math.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace boardnative::diagnostics {
+using posemath::M;
+struct State {
+    bool active = false, previous = false, priorWrite = false;
+    std::uint64_t lastMs = 0, lastTick = 0;
+    unsigned samples = 0;
+    M written[7]{}, sampled[7]{};
+    float motion[6]{}, beforeWritten[6]{};
+    float localError = 0, objectError = 0;
+};
+inline bool ShouldSample(State& s, bool enabled, std::uint64_t tick, std::uint64_t now) {
+    if (!enabled) { s.active = false; return false; }
+    if (!s.active) { s = State{}; s.active = true; }
+    if (s.previous && (tick == s.lastTick || now - s.lastMs < 250)) return false;
+    return true;
+}
+inline float RotationDegrees(const M& a, const M& b) {
+    float trace = 0;
+    for (int r = 0; r < 3; ++r) {
+        float aa = 0, bb = 0, ab = 0;
+        for (int c = 0; c < 3; ++c) { aa += a.r[r][c] * a.r[r][c]; bb += b.r[r][c] * b.r[r][c]; ab += a.r[r][c] * b.r[r][c]; }
+        if (!(aa > 1e-12f && bb > 1e-12f) || !std::isfinite(ab)) return 180.0f;
+        trace += ab / std::sqrt(aa * bb);
+    }
+    return std::acos(std::clamp((trace - 1) * 0.5f, -1.0f, 1.0f)) * 57.2957795f;
+}
+inline float RotationElementError(const M& a, const M& b) {
+    float error = 0;
+    for (int r = 0; r < 3; ++r) for (int c = 0; c < 3; ++c) {
+        const float delta = std::fabs(a.r[r][c] - b.r[r][c]);
+        if (!std::isfinite(delta)) return 1e9f;
+        error = std::max(error, delta);
+    }
+    return error;
+}
+// intended and observed locals are parent-relative, so board/world motion is
+// not counted as wheel or truck motion. beforeWritten is an observation, not
+// evidence identifying which game system changed the matrices between calls.
+inline void Sample(State& s, std::uint64_t tick, std::uint64_t now,
+                   const M (&intended)[7], const M (&before)[7], const M (&after)[7],
+                   const M (&objects)[7], const M (&objectsAfter)[7]) {
+    for (int i = 1; i < 7; ++i) {
+        if (s.previous) {
+            s.motion[i - 1] = std::max(s.motion[i - 1], RotationDegrees(intended[i], s.sampled[i]));
+        }
+        if (s.priorWrite) s.beforeWritten[i - 1] = std::max(s.beforeWritten[i - 1], RotationDegrees(before[i], s.written[i]));
+        s.localError = std::max(s.localError, RotationElementError(intended[i], after[i]));
+        s.objectError = std::max(s.objectError, RotationElementError(objects[i], objectsAfter[i]));
+    }
+    for (int i = 0; i < 7; ++i) s.sampled[i] = intended[i];
+    s.previous = true; s.lastTick = tick; s.lastMs = now;
+    if (s.samples != UINT32_MAX) ++s.samples;
+}
+// Keep the actual last write separate from the slower motion sampling: using
+// the last sampled pose here would mislabel ordinary animation as a change.
+inline void Written(State& s, const M (&intended)[7]) {
+    for (int i = 0; i < 7; ++i) s.written[i] = intended[i];
+    s.priorWrite = true;
+}
+inline void ClearWindow(State& s) {
+    for (int i = 0; i < 6; ++i) s.motion[i] = s.beforeWritten[i] = 0;
+    s.samples = 0; s.localError = s.objectError = 0;
+}
+} // namespace boardnative::diagnostics
