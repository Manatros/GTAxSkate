diff --git a/host/src/vehicle_survey.cpp b/host/src/vehicle_survey.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fae98924147ccccab11ce759ff8faf7f438c5f3a
--- /dev/null
+++ b/host/src/vehicle_survey.cpp
@@ -0,0 +1,119 @@
+#include "vehicle_survey.h"
+#include "natives.h"
+#include "runtime_bridge.h"
+#include <windows.h>
+#include <cstdint>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+namespace vehiclesurvey {
+namespace {
+constexpr float kReach = 20.0f;
+using namespace gta;
+
+// How the last survey's probes went: no result, nothing hit, another
+// vehicle hit, this one hit.
+struct Tally {
+    int vehicle = 0;
+    float min[3]{}, max[3]{};
+    int pending = 0, none = 0, other = 0, hits = 0;
+};
+
+// One probe against the surveyed vehicle, in its model space: from and to
+// become world points. A hit counts when it is that vehicle, or when its
+// point lies inside the vehicle's box (the line runs inside the box and meets
+// only vehicles, so it can only be this one's body).
+std::uint32_t __cdecl Probe(void* ctx, const float* from, const float* to, float* hit) {
+    Tally& t = *static_cast<Tally*>(ctx);
+    const Vector3 a = Call<Vector3>(GET_OFFSET_FROM_ENTITY_IN_WORLD_COORDS, t.vehicle, from[0], from[1], from[2]);
+    const Vector3 b = Call<Vector3>(GET_OFFSET_FROM_ENTITY_IN_WORLD_COORDS, t.vehicle, to[0], to[1], to[2]);
+    const int test = Call<int>(START_EXPENSIVE_SYNCHRONOUS_SHAPE_TEST_LOS_PROBE, a.x, a.y, a.z, b.x, b.y, b.z, 2 | 16,
+                               Call<int>(PLAYER_PED_ID), 7);
+    BOOL any = 0;
+    Vector3 end{}, normal{};
+    Entity entity = 0;
+    if (Call<int>(GET_SHAPE_TEST_RESULT, test, &any, &end, &normal, &entity) != 2) return ++t.pending, 0;
+    if (!any) return ++t.none, 0;
+    const Vector3 local = Call<Vector3>(GET_OFFSET_FROM_ENTITY_GIVEN_WORLD_COORDS, t.vehicle, end.x, end.y, end.z);
+    const bool inside = local.x > t.min[0] - 0.1f && local.x < t.max[0] + 0.1f && local.y > t.min[1] - 0.1f &&
+                        local.y < t.max[1] + 0.1f && local.z > t.min[2] - 0.1f && local.z < t.max[2] + 0.1f;
+    if (entity != t.vehicle && !inside) return ++t.other, 0;
+    ++t.hits;
+    hit[0] = local.x, hit[1] = local.y, hit[2] = local.z;
+    return 1;
+}
+
+} // namespace
+
+void Tick(RuntimeBridge& runtime, float radius, void (*log)(const char*)) {
+    if (!runtime.HasVehicleSurvey()) return;
+    // The pool scan twice a second is plenty: a model is surveyed only once.
+    static unsigned long s_next = 0;
+    const unsigned long now = GetTickCount();
+    if (static_cast<long>(now - s_next) < 0) return;
+    s_next = now + 500;
+    static int vehicles[256];
+    const int n = worldGetAllVehicles(vehicles, 256);
+    const int ped = Call<int>(PLAYER_PED_ID);
+    const Vector3 me = Call<Vector3>(GET_ENTITY_COORDS, ped, 0);
+    // GTA's shape tests met no vehicle farther than about 20 m (the first
+    // test: every far survey hit nothing, the same model close by did), so
+    // the nearest vehicle within that goes first.
+    const float reach = radius < kReach ? radius : kReach;
+    int v = 0;
+    std::uint32_t model = 0;
+    float best = reach * reach;
+    for (int pass = 0; pass < 8 && !v; ++pass) {
+        int pick = 0;
+        float pickD = best;
+        for (int i = 0; i < n; ++i) {
+            const Vector3 p = Call<Vector3>(GET_ENTITY_COORDS, vehicles[i], 0);
+            const float dx = p.x - me.x, dy = p.y - me.y, dz = p.z - me.z, d = dx * dx + dy * dy + dz * dz;
+            if (d < pickD && vehicles[i]) pick = i + 1, pickD = d;
+        }
+        if (!pick) break;
+        const int candidate = vehicles[pick - 1];
+        vehicles[pick - 1] = 0;  // not again this call
+        const std::uint32_t m = Call<std::uint32_t>(GET_ENTITY_MODEL, candidate);
+        if (!runtime.VehicleNeedsShape(m)) continue;
+        // A model whose skeleton gives non-finite bone positions is broken
+        // (IVPack cars on 3889: NaN bumper_r); GTA crashed twice right after
+        // such a car was surveyed (2026-10-17 23:20, 23:36). Never probed.
+        static std::vector<std::uint32_t> s_broken;
+        if (std::find(s_broken.begin(), s_broken.end(), m) != s_broken.end()) continue;
+        const int bone = Call<int>(GET_ENTITY_BONE_INDEX_BY_NAME, candidate, "bumper_r");
+        if (bone >= 0) {
+            const Vector3 b = Call<Vector3>(GET_WORLD_POSITION_OF_ENTITY_BONE, candidate, bone);
+            if (!(std::isfinite(b.x) && std::isfinite(b.y) && std::isfinite(b.z))) {
+                s_broken.push_back(m);
+                if (log) {
+                    char line[160];
+                    std::snprintf(line, sizeof(line), "vehicle shape: model %08x not surveyed (non-finite bone positions: broken add-on model)", m);
+                    log(line);
+                }
+                continue;
+            }
+        }
+        v = candidate, model = m;
+    }
+    if (!v) return;
+    {
+        Vector3 lo{}, hi{};
+        Call<void>(GET_MODEL_DIMENSIONS, model, &lo, &hi);
+        Tally t{v, {lo.x, lo.y, lo.z}, {hi.x, hi.y, hi.z}};
+        const int tris = runtime.VehicleSurvey(model, t.min, t.max, Probe, &t);
+        if (log) {
+            char line[240];
+            std::snprintf(line, sizeof(line),
+                          "vehicle shape: model %08x surveyed: %d triangles%s (%.1f x %.1f x %.1f m; probes: %d hit, %d other, %d "
+                          "nothing, %d no result)",
+                          model, tris, tris <= 10 ? " = its box" : "", hi.x - lo.x, hi.y - lo.y, hi.z - lo.z, t.hits, t.other,
+                          t.none, t.pending);
+            log(line);
+        }
+    }
+}
+
+} // namespace vehiclesurvey
diff --git a/host/src/vehicle_survey.h b/host/src/vehicle_survey.h
new file mode 100644
index 0000000000000000000000000000000000000000..a692b6650fae4efb8aebc7395e8acf9a51a70854
--- /dev/null
+++ b/host/src/vehicle_survey.h
@@ -0,0 +1,15 @@
+#pragma once
+// Vehicle shapes from probes (contributed by GTAxSkate): a vehicle model with
+// no extracted bound (most DLC cars) is surveyed once with ray probes down its
+// own up axis, so Skate gets a roof, hood and trunk to ride and a gap under
+// it to hippie jump, instead of the bounding box (vehicle_shapes.rs).
+
+class RuntimeBridge;
+
+namespace vehiclesurvey {
+
+// While skating: surveys at most one new model per call among the vehicles
+// within `radius` m of the player.
+void Tick(RuntimeBridge& runtime, float radius, void (*log)(const char*));
+
+} // namespace vehiclesurvey
diff --git a/host/tests/board_parts_tests.cpp b/host/tests/board_parts_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..513134263b1fbaad5f412d26451244352ec82ee9
--- /dev/null
+++ b/host/tests/board_parts_tests.cpp
@@ -0,0 +1,106 @@
+// cl /std:c++20 /EHsc /W4 board_parts_tests.cpp
+#include "../src/board_parts_logic.h"
+#include <cassert>
+
+struct Object { std::string name; };
+
+int main() {
+    using namespace boardpartslogic;
+    Selection selection;
+    assert(selection.Update({"deck", "wheels-a"}, 0));
+    assert(!selection.Settled(399));
+    assert(selection.Settled(400));
+    assert(!selection.Update({"deck", "wheels-a"}, 401));
+    assert(selection.Settled(401));
+    assert(selection.Update({"deck", "wheels-b"}, 450));
+    assert(!selection.Settled(849));
+    assert(selection.Update({"deck", "wheels-a"}, 849));
+    assert(!selection.Settled(1248));
+    assert(selection.Settled(1249));
+    selection = {};
+    assert(selection.Update({"deck"}, 2000));
+    assert(!selection.Settled(2399));
+    assert(selection.CanPreview(2000, true));
+    assert(!selection.CanPreview(2399, false));
+    assert(selection.CanPreview(2400, false));
+
+    assert(PrefetchRadius(160, 240) == 3);
+    assert(PrefetchRadius(161, 240) == 1);
+    assert(PrefetchRadius(220, 240) == 1);
+    assert(PrefetchRadius(221, 240) == 0);
+    assert(PrefetchRadius(240, 240) == 0);
+    // The ridden board's reserve comes off the preloading budget.
+    assert(PrefetchRadius(120, 240, 40) == 3);
+    assert(PrefetchRadius(121, 240, 40) == 1);
+    assert(PrefetchRadius(181, 240, 40) == 0);
+    const std::vector<std::vector<std::string>> neighbours{
+        {"next", "shared"}, {"previous", "shared"}, {"next2"}, {"previous2"}, {"next3"}, {"previous3"}};
+    std::vector<std::string> requested;
+    int registered = 0;
+    auto request = [&](const auto& name) { requested.push_back(name); ++registered; };
+    auto count = [&] { return registered; };
+    auto wanted = PrefetchModels(neighbours, 240, count, request);
+    assert((requested == std::vector<std::string>{"next", "shared", "previous", "next2", "previous2", "next3", "previous3"}));
+    assert(wanted.size() == 7);
+    requested.clear();
+    registered = 201;
+    wanted = PrefetchModels(neighbours, 240, count, request);
+    assert((requested == std::vector<std::string>{"next", "shared", "previous"}));
+    assert(wanted.size() == 3);
+    // Recheck the budget during requests, leaving registrations for selection.
+    requested.clear();
+    registered = 220;
+    wanted = PrefetchModels(neighbours, 240, count, request);
+    assert((requested == std::vector<std::string>{"next"}));
+    assert(registered == 221 && wanted.size() == 1);
+    requested.clear();
+    assert(PrefetchModels(neighbours, 240, count, request).empty());
+    assert(requested.empty());
+    registered = 0;
+    assert(PrefetchModels({}, 240, count, request).empty());
+    // Empty rows must not pull more distant entries inside the reduced radius.
+    registered = 201;
+    wanted = PrefetchModels({{}, {"previous"}, {"too-far"}}, 240, count, request);
+    assert(wanted == std::unordered_set<std::string>{"previous"});
+    auto upward = neighbours;
+    for (std::size_t i = 0; i < upward.size(); i += 2) std::swap(upward[i], upward[i + 1]);
+    registered = 0;
+    requested.clear();
+    wanted = PrefetchModels(upward, 240, count, request);
+    assert(requested.front() == "previous");
+    assert(wanted.count("next3") && wanted.count("previous3"));
+    // Moving away drops old neighbours while retaining shared models.
+    registered = 0;
+    wanted = PrefetchModels({{"new", "shared"}}, 240, count, request);
+    assert(wanted.size() == 2 && wanted.count("shared") && !wanted.count("previous"));
+
+    std::vector<Object> current{{"old-deck"}, {"old-wheels"}};
+    std::vector<Object> pending;
+    std::vector<std::string> removed, visible;
+    bool posed = false;
+    auto remove = [&](Object& object) { removed.push_back(object.name); };
+    auto publish = [&](Object& object) {
+        assert(posed && removed.empty()); // All new objects posed before old removal.
+        assert(current.front().name == "old-deck");
+        visible.push_back(object.name);
+    };
+    auto create = [](const std::string& name, Object& object) { object.name = name; return name != "missing"; };
+    auto pose = [&](std::vector<Object>& objects) { assert(objects.size() == 2); posed = true; return true; };
+    // Partial creation failure releases only the new partial board.
+    assert(!Replace(current, pending, {"new-deck", "missing"}, create, pose, publish, remove));
+    assert(current.size() == 2 && current.front().name == "old-deck");
+    assert(removed == std::vector<std::string>{"new-deck"} && visible.empty() && !posed);
+    removed.clear();
+    // Skeleton readiness may take multiple frames: retain invisible candidates.
+    assert(!Replace(current, pending, {"new-deck", "new-wheels"}, create,
+                    [](auto&) { return false; }, publish, remove));
+    assert(current.front().name == "old-deck" && visible.empty());
+    assert(removed.empty() && pending.size() == 2);
+    // Complete replacement publishes the whole new board, then retires the old.
+    assert(Replace(current, pending, {"new-deck", "new-wheels"},
+                   [](const auto&, auto&) { assert(false); return false; }, pose, publish, remove));
+    assert(pending.empty());
+    assert(posed && current.front().name == "new-deck");
+    assert((visible == std::vector<std::string>{"new-deck", "new-wheels"}));
+    assert((removed == std::vector<std::string>{"old-deck", "old-wheels"}));
+}
