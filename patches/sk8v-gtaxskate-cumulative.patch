+        assert_eq!(menu.first_visible(), 0);
+        assert_eq!(Tier::parse("Ponsonbys"), Some(Tier::High));
+    }
+
+    #[test]
+    fn parts_are_listed_by_maker_and_a_maker_opens_and_closes() {
+        let offer = |title: &str, group: &str| Offer {
