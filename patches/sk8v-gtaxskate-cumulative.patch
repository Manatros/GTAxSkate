+        let mut reasons: Vec<String> = crate::rails::take_rejected().iter().filter(|r| r.mid.z > 3.45).map(|r| format!("({:.2},{:.2},{:.2}) {:.2} m {}", r.mid.x, r.mid.y, r.mid.z, r.length, r.reason)).collect();
+        reasons.sort();
+        for r in reasons { println!("  rejected {r}"); }
+    }
