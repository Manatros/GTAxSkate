+    fn bed() -> Vec<[Vec3; 3]> {
+        let v = |x: f32, y: f32, z: f32| Vec3::new(x, y, z);
+        vec![[v(-5., -2., 0.), v(25., -2., 0.), v(25., 2., 0.)], [v(-5., -2., 0.), v(25., 2., 0.), v(-5., 2., 0.)]]
+    }
