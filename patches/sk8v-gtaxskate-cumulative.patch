+        hidden[i] = all_samples(&tris[i], &mut |p| covered(i, p, &|_| true));
+    }
+    let first = hidden.clone();
+    for i in 0..tris.len() {
+        if !first[i] { continue; }
+        hidden[i] = all_samples(&tris[i], &mut |p| covered(i, p, &|j| !first[j]));
+    }
+    let before = tris.len();
+    let mut k = 0;
+    tris.retain(|_| {
+        k += 1;
+        !hidden[k - 1]
+    });
