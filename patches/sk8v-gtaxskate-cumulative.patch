+//! Train tracks as grind rails (Manatros 2026-10-19: grinding train tracks
+//! the way his old SkateGTA plugin handled them). GTA's track nodes
+//! (`common.rpf` data/levels/gta5/trains1..12.dat, copied to
+//! `<cache>.tracks/`) lie on the track bed; its collision has a rail box
+//! 0.15 m tall at 0.7175 m either side (measured on the freight line: 517 of
+//! 700 samples). The finder's lines on those boxes came out on their edges
+//! or the bed; these lines run along the top of each steel rail.
+
+use bevy_math::{Vec2, Vec3};
+use std::path::Path;
+use std::sync::OnceLock;
+
+/// Rail centre to the track's centre line (metres): measured on GTA's own
+/// rails, freight line and metro alike (1.53 m centre to centre; the 1.435 m
+/// standard gauge is between the inner faces, 2026-10-20: lines 5 cm inside
+/// the rail).
+pub const HALF_GAUGE: f32 = 0.765;
+/// Rail top above the node height where no collision is found to snap to
+/// (metres): GTA's rail boxes stand 0.13-0.17 m, the visible rail 0.19 m.
+pub const RAIL_TOP: f32 = 0.17;
+/// Nodes farther apart than this are not one track (a jump in the file).
+const MAX_GAP: f32 = 40.0;
+
+/// GTAxSkate TrackRails (World page, default on).
+pub static ENABLED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// Every track's node line, GTA metres.
+static TRACKS: OnceLock<Vec<Vec<Vec3>>> = OnceLock::new();
+
+/// Reads a trains*.dat: a count line, then "x y z flag" per node.
+pub fn parse(text: &str) -> Vec<Vec3> {
+    text.lines()
+        .skip(1)
+        .filter_map(|l| {
+            let v: Vec<f32> = l.split_whitespace().take(3).filter_map(|s| s.parse().ok()).collect();
+            (v.len() == 3 && v.iter().all(|x| x.is_finite())).then(|| Vec3::new(v[0], v[1], v[2]))
+        })
+        .collect()
+}
+
+/// Loads trains1..12.dat from `dir`; returns how many tracks it found.
+pub fn load(dir: &Path) -> usize {
+    TRACKS
+        .get_or_init(|| {
+            (1..=12)
+                .filter_map(|n| std::fs::read_to_string(dir.join(format!("trains{n}.dat"))).ok())
+                .map(|t| parse(&t))
+                .filter(|t| t.len() >= 2)
+                .collect()
+        })
+        .len()
+}
+
+/// The two steel rails of every track within the area (`centre` +- `half`),
+/// GTA metres, as polylines.
+pub fn rails_in(centre: [f32; 2], half: f32) -> Vec<Vec<Vec3>> {
+    if !ENABLED.load(std::sync::atomic::Ordering::Relaxed) {
+        return Vec::new();
+    }
+    TRACKS.get().map_or_else(Vec::new, |tracks| rails_of(tracks, centre, half))
+}
+
+pub fn rails_of(tracks: &[Vec<Vec3>], centre: [f32; 2], half: f32) -> Vec<Vec<Vec3>> {
+    let mut out = Vec::new();
+    for nodes in tracks {
+        let mut left = Vec::new();
+        let mut right = Vec::new();
+        let flush = |left: &mut Vec<Vec3>, right: &mut Vec<Vec3>, out: &mut Vec<Vec<Vec3>>| {
+            for side in [left, right] {
+                out.extend(sample_in_area(side, centre, half));
+                side.clear();
+            }
+        };
+        for (i, &p) in nodes.iter().enumerate() {
+            let connected = |q: Vec3| p.is_finite() && q.is_finite() && q.distance(p) <= MAX_GAP;
+            let prev = i.checked_sub(1).map(|j| nodes[j]).filter(|q| connected(*q));
+            let next = nodes.get(i + 1).copied().filter(|q| connected(*q));
+            if prev.is_none() {
+                flush(&mut left, &mut right, &mut out);
+            }
+            if !p.is_finite() { continue; }
+            let along = (next.unwrap_or(p) - prev.unwrap_or(p)).truncate().normalize_or_zero();
+            if along == Vec2::ZERO { continue; }
+            let side = Vec3::new(-along.y, along.x, 0.0) * HALF_GAUGE;
+            let top = p + Vec3::Z * RAIL_TOP;
+            left.push(top + side);
+            right.push(top - side);
+        }
+        flush(&mut left, &mut right, &mut out);
+    }
+    out
+}
+
+/// Train nodes can be 6-12 metres apart. Give crown projection support along
+/// the entire span, including segments crossing an area with both nodes outside.
+/// Sampling preserves the authored polyline; it never smooths through real gaps.
+fn sample_in_area(line: &[Vec3], centre: [f32; 2], half: f32) -> Vec<Vec<Vec3>> {
+    const SAMPLE: f32 = 0.5;
+    let mut out = Vec::new();
+    let mut run: Vec<Vec3> = Vec::new();
+    for w in line.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let d = b - a;
+        let (mut lo, mut hi) = (0.0_f32, 1.0_f32);
+        for axis in 0..2 {
+            let min = centre[axis] - half;
+            let max = centre[axis] + half;
+            if d[axis].abs() < 1e-8 {
+                if a[axis] < min || a[axis] > max { hi = -1.0; break; }
+            } else {
+                let x = (min - a[axis]) / d[axis];
+                let y = (max - a[axis]) / d[axis];
+                lo = lo.max(x.min(y));
+                hi = hi.min(x.max(y));
+            }
+        }
+        if lo >= hi {
+            if run.len() >= 2 { out.push(std::mem::take(&mut run)); }
+            run.clear();
+            continue;
+        }
+        let start = a + d * lo;
+        let end = a + d * hi;
+        if run.last().is_some_and(|p| p.distance_squared(start) > 1e-8) {
+            if run.len() >= 2 { out.push(std::mem::take(&mut run)); }
+            run.clear();
+        }
+        if run.is_empty() { run.push(start); }
+        let steps = (start.distance(end) / SAMPLE).ceil().max(1.0) as usize;
+        for k in 1..=steps { run.push(start.lerp(end, k as f32 / steps as f32)); }
+    }
+    if run.len() >= 2 { out.push(run); }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_straight_track_gives_two_rails_on_top_either_side() {
+        let track = vec![Vec3::new(0., 0., 10.), Vec3::new(0., 10., 10.), Vec3::new(0., 20., 10.)];
+        let rails = rails_of(&[track], [0., 10.], 50.);
+        assert_eq!(rails.len(), 2);
+        for r in &rails {
+            assert!(r.windows(2).all(|w| w[0].distance(w[1]) <= 0.501));
+            assert!(r.iter().all(|p| (p.z - (10.0 + RAIL_TOP)).abs() < 1e-5 && (p.x.abs() - HALF_GAUGE).abs() < 1e-5));
+        }
+    }
+
+    #[test]
+    fn only_the_part_in_the_area_and_no_jumps() {
+        let track = vec![Vec3::new(0., 0., 0.), Vec3::new(0., 10., 0.), Vec3::new(0., 20., 0.), Vec3::new(500., 20., 0.), Vec3::new(500., 30., 0.)];
+        let rails = rails_of(&[track], [0., 5.], 12.);
+        assert_eq!(rails.len(), 2, "{rails:?}");
+        assert!(rails.iter().all(|r| r.iter().all(|p| p.y <= 17.0)));
+    }
+
+    #[test]
+    fn crossing_spans_survive_even_when_neither_node_is_inside() {
+        let rails = rails_of(&[vec![Vec3::new(-10.,0.,0.), Vec3::new(10.,0.,0.)]], [0.,0.], 2.);
+        assert_eq!(rails.len(), 2);
+        for r in rails {
+            assert!((r.first().unwrap().x + 2.).abs() < 1e-5);
+            assert!((r.last().unwrap().x - 2.).abs() < 1e-5);
+            assert!(r.windows(2).all(|w| w[0].distance(w[1]) <= 0.501));
+        }
+    }
+
+    #[test]
+    fn a_remote_track_after_a_gap_does_not_rotate_the_local_rail_end() {
+        let rails = rails_of(&[vec![Vec3::ZERO, Vec3::X*10., Vec3::new(500.,500.,0.), Vec3::new(510.,500.,0.)]], [5.,0.], 20.);
+        assert_eq!(rails.len(), 2);
+        assert!(rails.iter().flatten().all(|p| (p.y.abs()-HALF_GAUGE).abs() < 1e-5));
+    }
+
+    #[test]
+    fn invalid_nodes_split_runs_without_nonfinite_rails() {
+        let rails = rails_of(&[vec![Vec3::ZERO, Vec3::X, Vec3::NAN, Vec3::X*3., Vec3::X*4.]], [0.,0.], 20.);
+        assert_eq!(rails.len(), 4);
+        assert!(rails.iter().flatten().all(|p| p.is_finite()));
+    }
+
+    #[test]
+    fn reads_a_trains_dat() {
+        let nodes = parse("3\n1084.48 3231.45 39.2565 0 \n1080 3230 39.3 4\nbad line\n");
+        assert_eq!(nodes, vec![Vec3::new(1084.48, 3231.45, 39.2565), Vec3::new(1080., 3230., 39.3)]);
+    }
+}
diff --git a/rust/skatev-runtime/src/tubes.rs b/rust/skatev-runtime/src/tubes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dca6963bb607939851040b36a90fca0b7c64e08b
--- /dev/null
+++ b/rust/skatev-runtime/src/tubes.rs
@@ -0,0 +1,216 @@
+//! Grind rails from GTA's tubes (Manatros 2026-10-20: "the rails in this
+//! skatepark aren't grindable"; fixes as general rules). GTA builds coping,
+//! handrails and railing bars as capsule and cylinder polygons, mostly in its
+//! high-detail (`hi@`) collision: at Vespucci 207 capsules hold every coping
+//! tube and rail, while the walking collision only has a coarse slab there.
+//! A tube's top line (its axis raised by its radius) is exactly where a board
+//! grinds; the edge finder never sees it, a tube has no sharp edge.
+
+use bevy_math::Vec3;
+use std::collections::HashMap;
+
+/// GTAxSkate TubeRails (World page, default on).
+pub static ENABLED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// Thickest tube that is a rail (metres): coping and handrails are 2-8 cm.
+const MAX_RADIUS: f32 = 0.2;
+/// Shortest tube line kept (metres).
+const MIN_LENGTH: f32 = 0.5;
+/// Steepest tube, rise over length (rails.rs MAX_SLOPE).
+const MAX_SLOPE: f32 = 0.7;
+/// Tube ends this close (metres) join into one rail.
+const JOIN: f32 = 0.05;
+
+/// The rails of the latest area build (GTA metres).
+/// The latest tube rails and widths with an XY cell index: the offline bake
+/// sets every tube of the map at once, and scanning that whole list under a
+/// lock for each tile and rail box kept one bake thread busy while the others
+/// waited (2026-10-24). Read-only between `set` calls.
+#[derive(Default)]
+struct Latest {
+    rails: Vec<Vec<Vec3>>,
+    widths: Vec<(Vec3, Vec3, f32)>,
+    rail_cells: HashMap<(i32, i32), Vec<u32>>,
+    width_cells: HashMap<(i32, i32), Vec<u32>>,
+}
+static LATEST: std::sync::RwLock<Option<Latest>> = std::sync::RwLock::new(None);
+const INDEX_CELL: f32 = 32.0;
+fn index_cell(x: f32, y: f32) -> (i32, i32) {
+    ((x / INDEX_CELL).floor() as i32, (y / INDEX_CELL).floor() as i32)
+}
+/// Cells of the XY box from `lo` to `hi`, padded by `pad` metres.
+fn index_cells(lo: Vec3, hi: Vec3, pad: f32) -> impl Iterator<Item = (i32, i32)> {
+    let (a, b) = (index_cell(lo.x - pad, lo.y - pad), index_cell(hi.x + pad, hi.y + pad));
+    (a.0..=b.0).flat_map(move |x| (a.1..=b.1).map(move |y| (x, y)))
+}
+
+/// Preserve the authored tube diameter when making solid rail collision.
+pub(crate) fn half_width(a: Vec3, b: Vec3) -> f32 {
+    LATEST.read().unwrap_or_else(|e| e.into_inner()).as_ref().map_or(0.0, |l| l.half_width(a, b))
+}
+
+impl Latest {
+    fn new(rails: Vec<Vec<Vec3>>, widths: Vec<(Vec3, Vec3, f32)>) -> Self {
+        let mut latest = Latest::default();
+        for (i, r) in rails.iter().enumerate() {
+            let mut cells: Vec<(i32, i32)> = r.iter().map(|p| index_cell(p.x, p.y)).collect();
+            cells.sort_unstable();
+            cells.dedup();
+            for c in cells {
+                latest.rail_cells.entry(c).or_default().push(i as u32);
+            }
+        }
+        for (i, &(p, q, _)) in widths.iter().enumerate() {
+            // half_width matches within 2 cm of the segment.
+            for c in index_cells(p.min(q), p.max(q), 0.05) {
+                latest.width_cells.entry(c).or_default().push(i as u32);
+            }
+        }
+        latest.rails = rails;
+        latest.widths = widths;
+        latest
+    }
+
+    fn rails_in(&self, centre: [f32; 2], half: f32) -> Vec<Vec<Vec3>> {
+        let c = Vec3::new(centre[0], centre[1], 0.);
+        // Candidates from the cells the square touches, then the same test,
+        // in the original order.
+        let mut found: Vec<u32> = index_cells(c - Vec3::splat(half), c + Vec3::splat(half), 0.)
+            .filter_map(|cell| self.rail_cells.get(&cell)).flatten().copied().collect();
+        found.sort_unstable();
+        found.dedup();
+        found.into_iter().map(|i| &self.rails[i as usize])
+            .filter(|r| r.iter().any(|p| (p.x - centre[0]).abs() <= half && (p.y - centre[1]).abs() <= half))
+            .cloned()
+            .collect()
+    }
+
+    fn half_width(&self, a: Vec3, b: Vec3) -> f32 {
+    let mid = (a + b) * 0.5;
+    let Some(candidates) = self.width_cells.get(&index_cell(mid.x, mid.y)) else { return 0.0 };
+    candidates.iter().map(|&i| self.widths[i as usize]).filter_map(|(p, q, r)| {
+        let d = q - p;
+        let t = ((mid - p).dot(d) / d.length_squared().max(1e-9)).clamp(0.0, 1.0);
+        (mid.distance(p + d * t) < 0.02 && d.normalize_or_zero().dot((b-a).normalize_or_zero()).abs() > 0.99).then_some(r)
+    }).fold(0.0, f32::max)
+    }
+}
+
+/// Rails over the tubes `(end, end, radius)` (GTA metres, z up).
+pub fn rails_of(tubes: &[([f32; 3], [f32; 3], f32)]) -> Vec<Vec<Vec3>> {
+    let mut pieces: Vec<(Vec3, Vec3)> = tubes
+        .iter()
+        .filter(|(_, _, r)| *r <= MAX_RADIUS)
+        .filter_map(|&(a, b, r)| {
+            let (a, b) = (Vec3::from_array(a), Vec3::from_array(b));
+            let along = b - a;
+            let len = along.length();
+            (len >= 0.05 && (along.z / len).abs() <= MAX_SLOPE).then(|| (a + Vec3::Z * r, b + Vec3::Z * r))
+        })
+        .collect();
+    // The same tube decoded twice (overlapping bounds): once.
+    pieces.sort_by(|p, q| (p.0.x, p.0.y, p.0.z).partial_cmp(&(q.0.x, q.0.y, q.0.z)).unwrap_or(std::cmp::Ordering::Equal));
+    pieces.dedup_by(|p, q| p.0.distance(q.0) < 0.01 && p.1.distance(q.1) < 0.01);
+    let mut used = vec![false; pieces.len()];
+    let mut rails = Vec::new();
+    for start in 0..pieces.len() {
+        if used[start] {
+            continue;
+        }
+        used[start] = true;
+        let mut rail = vec![pieces[start].0, pieces[start].1];
+        for forward in [true, false] {
+            loop {
+                let end = if forward { rail[rail.len() - 1] } else { rail[0] };
+                let next = (0..pieces.len()).find(|&k| !used[k] && (pieces[k].0.distance(end) < JOIN || pieces[k].1.distance(end) < JOIN));
+                let Some(k) = next else { break };
+                used[k] = true;
+                let (a, b) = pieces[k];
+                let other = if a.distance(end) < JOIN { b } else { a };
+                if forward {
+                    rail.push(other);
+                } else {
+                    rail.insert(0, other);
+                }
+            }
+        }
+        let length: f32 = rail.windows(2).map(|w| w[0].distance(w[1])).sum();
+        if length >= MIN_LENGTH {
+            rails.push(rail);
+        }
+    }
+    rails
+}
+
+/// Keeps the rails of the tubes the latest map read decoded (`live.rs`).
+pub fn set(tubes: &[([f32; 3], [f32; 3], f32)]) -> usize {
+    let rails = if ENABLED.load(std::sync::atomic::Ordering::Relaxed) { rails_of(tubes) } else { Vec::new() };
+    let n = rails.len();
+    let widths: Vec<(Vec3, Vec3, f32)> = tubes.iter()
+        .filter(|(_, _, r)| r.is_finite() && *r > 0.0 && *r <= MAX_RADIUS)
+        .map(|&(a,b,r)| (Vec3::from_array(a) + Vec3::Z*r, Vec3::from_array(b) + Vec3::Z*r, r)).collect();
+    let latest = Latest::new(rails, widths);
+    *LATEST.write().unwrap_or_else(|e| e.into_inner()) = Some(latest);
+    n
+}
+
+/// The tube rails within the area (GTA metres).
+pub fn rails_in(centre: [f32; 2], half: f32) -> Vec<Vec<Vec3>> {
+    LATEST.read().unwrap_or_else(|e| e.into_inner()).as_ref().map_or_else(Vec::new, |l| l.rails_in(centre, half))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_handrail_of_three_capsules_is_one_rail_on_top_and_a_post_is_none() {
+        let r = 0.03;
+        let tubes = [
+            ([0., 0., 1.0], [2., 0., 1.0], r),
+            ([2., 0., 1.0], [4., 0., 1.5], r), // down a flight: 14 degrees
+            ([4., 0., 1.5], [6., 0., 1.5], r),
+            ([1., 1., 0.0], [1., 1., 1.0], r), // a post
+            ([0., 5., 0.5], [3., 5., 0.5], 0.6), // a fat bollard row
+        ];
+        let rails = rails_of(&tubes);
+        assert_eq!(rails.len(), 1, "{rails:?}");
+        assert_eq!(rails[0].len(), 4);
+        assert!((rails[0][0].z - 1.03).abs() < 1e-5, "on the top");
+    }
+
+    #[test]
+    fn indexed_lookups_equal_a_scan_of_every_tube() {
+        // Deterministic pseudo-random tubes over 600 m, some crossing cells.
+        let mut seed = 12345u64;
+        let mut rnd = || { seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407); ((seed >> 33) as f32) / (1u64 << 31) as f32 };
+        let tubes: Vec<([f32; 3], [f32; 3], f32)> = (0..3000).map(|_| {
+            let a = [rnd() * 600. - 300., rnd() * 600. - 300., rnd() * 5.];
+            let d = [rnd() * 40. - 20., rnd() * 40. - 20., rnd() * 0.5];
+            (a, [a[0] + d[0], a[1] + d[1], a[2] + d[2]], 0.01 + rnd() * 0.1)
+        }).collect();
+        let rails = rails_of(&tubes);
+        let widths: Vec<(Vec3, Vec3, f32)> = tubes.iter()
+            .map(|&(a, b, r)| (Vec3::from_array(a) + Vec3::Z * r, Vec3::from_array(b) + Vec3::Z * r, r)).collect();
+        let latest = Latest::new(rails.clone(), widths.clone());
+        for k in 0..40 {
+            let centre = [rnd() * 600. - 300., rnd() * 600. - 300.];
+            let half = 5. + k as f32 * 4.;
+            let scan: Vec<Vec<Vec3>> = rails.iter()
+                .filter(|r| r.iter().any(|p| (p.x - centre[0]).abs() <= half && (p.y - centre[1]).abs() <= half)).cloned().collect();
+            assert_eq!(latest.rails_in(centre, half), scan);
+        }
+        for &(p, q, r) in widths.iter().take(500) {
+            let (a, b) = (p.lerp(q, 0.3), p.lerp(q, 0.7));
+            let mid = (a + b) * 0.5;
+            let scan = widths.iter().filter_map(|&(p, q, r)| {
+                let d = q - p;
+                let t = ((mid - p).dot(d) / d.length_squared().max(1e-9)).clamp(0.0, 1.0);
+                (mid.distance(p + d * t) < 0.02 && d.normalize_or_zero().dot((b - a).normalize_or_zero()).abs() > 0.99).then_some(r)
+            }).fold(0.0, f32::max);
+            assert_eq!(latest.half_width(a, b), scan);
+            assert!(scan >= r);
+        }
+    }
+
+}
diff --git a/rust/skatev-runtime/src/vehicle_shapes.rs b/rust/skatev-runtime/src/vehicle_shapes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8e3c4d062e438ed86b22be00b187c136de2fe728
--- /dev/null
+++ b/rust/skatev-runtime/src/vehicle_shapes.rs
@@ -0,0 +1,376 @@
+//! Vehicle shapes from probes (contributed by GTAxSkate). SK8V's extracted
+//! model bounds miss many vehicles (most DLC cars), which then stand in as
+//! their bounding box: no roof to ride, no gap to hippie jump under. Such a
+//! model is surveyed once by the host with ray probes straight down its own
+//! up axis over a grid of its footprint (`sv_vehicle_survey`): the heights
+//! make a roof, hood and trunk to ride on, walled down to the wheels, which
+//! dynamic.rs then uses instead of the box.
+
+use bevy_math::{Vec2, Vec3};
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex, OnceLock};
+
+/// Spacing of the survey grid, metres.
+pub const SPACING: f32 = 0.3;
+/// The gap left under every vehicle, metres: a board (with its wheels about
+/// 0.1 m high) rolls on underneath while its rider hippie jumps the car.
+pub const UNDER: f32 = 0.2;
+/// Probes per model, at most (a long truck is surveyed more coarsely).
+const MAX_PROBES: usize = 500;
+
+/// A model's body in its own space (x right, y forward, z up): its top
+/// heights on a grid over the bounding box's footprint.
+#[derive(Clone, Debug)]
+pub struct Shape {
+    pub min: Vec3,
+    pub max: Vec3,
+    nx: usize,
+    ny: usize,
+    step: Vec2,
+    heights: Vec<Option<f32>>,
+}
+
+impl Shape {
+    /// True for [Shape::boxed]'s flat box (no probe met the body).
+    pub fn is_box(&self) -> bool {
+        self.nx == 2 && self.ny == 2 && self.heights.iter().all(|h| *h == Some(self.max.z))
+    }
+
+    /// The bounding box as the body: a flat top at its height.
+    pub fn boxed(min: Vec3, max: Vec3) -> Self {
+        let size = (max - min).truncate().max(Vec2::splat(0.1));
+        Self { min, max, nx: 2, ny: 2, step: size, heights: vec![Some(max.z); 4] }
+    }
+
+    fn at(&self, i: usize, j: usize) -> Option<f32> {
+        self.heights.get(j * self.nx + i).copied().flatten()
+    }
+
+    fn point(&self, i: usize, j: usize, z: f32) -> Vec3 {
+        Vec3::new(self.min.x + i as f32 * self.step.x, self.min.y + j as f32 * self.step.y, z)
+    }
+
+    /// The top's height above `p` (own space), if the body is there.
+    pub fn top_at(&self, p: Vec2) -> Option<f32> {
+        let u = (p.x - self.min.x) / self.step.x;
+        let v = (p.y - self.min.y) / self.step.y;
+        if u < -0.25 || v < -0.25 || u > (self.nx - 1) as f32 + 0.25 || v > (self.ny - 1) as f32 + 0.25 {
+            return None;
+        }
+        let i = (u.round().max(0.) as usize).min(self.nx - 1);
+        let j = (v.round().max(0.) as usize).min(self.ny - 1);
+        self.at(i, j)
+    }
+
+    /// Closes holes in the top: probes through the windows or the open top
+    /// of a convertible, or onto the driver, meet no body, and a walker
+    /// climbing over the door's edge stood inside the car. A missed cell
+    /// with body on both sides of it (along its row or its column) takes the
+    /// higher of the two nearest heights, so nothing steps down into it.
+    pub fn fill_holes(&mut self) {
+        let before = self.heights.clone();
+        let at = |i: usize, j: usize| before[j * self.nx + i];
+        for j in 0..self.ny {
+            for i in 0..self.nx {
+                if at(i, j).is_some() {
+                    continue;
+                }
+                let left = (0..i).rev().find_map(|k| at(k, j));
+                let right = (i + 1..self.nx).find_map(|k| at(k, j));
+                let back = (0..j).rev().find_map(|k| at(i, k));
+                let front = (j + 1..self.ny).find_map(|k| at(i, k));
+                let across = left.zip(right).map(|(a, b)| a.max(b));
+                let along = back.zip(front).map(|(a, b)| a.max(b));
+                if let Some(fill) = match (across, along) {
+                    (Some(a), Some(b)) => Some(a.max(b)),
+                    (a, b) => a.or(b),
+                } {
+                    self.heights[j * self.nx + i] = Some(fill);
+                }
+            }
+        }
+    }
+
+    /// Collision triangles (counterclockwise seen from outside) in own space:
+    /// the top, and walls down to [UNDER] above the bottom of the box.
+    pub fn triangles(&self) -> Vec<[Vec3; 3]> {
+        let mut out = Vec::new();
+        let present = |i: isize, j: isize| -> bool {
+            i >= 0
+                && j >= 0
+                && (i as usize) + 1 < self.nx
+                && (j as usize) + 1 < self.ny
+                && [(0, 0), (1, 0), (0, 1), (1, 1)].iter().all(|(a, b)| self.at(i as usize + a, j as usize + b).is_some())
+        };
+        let bottom = self.min.z + UNDER;
+        for j in 0..self.ny.saturating_sub(1) {
+            for i in 0..self.nx.saturating_sub(1) {
+                if !present(i as isize, j as isize) {
+                    continue;
+                }
+                let h = |a: usize, b: usize| self.at(i + a, j + b).unwrap_or(self.max.z);
+                let (p00, p10, p11, p01) =
+                    (self.point(i, j, h(0, 0)), self.point(i + 1, j, h(1, 0)), self.point(i + 1, j + 1, h(1, 1)), self.point(i, j + 1, h(0, 1)));
+                out.push([p00, p10, p11]);
+                out.push([p00, p11, p01]);
+                // Walls where the body ends, facing out.
+                let (ii, jj) = (i as isize, j as isize);
+                for (neighbour, a, b, facing) in [
+                    ((ii, jj - 1), p00, p10, Vec2::NEG_Y),
+                    ((ii + 1, jj), p10, p11, Vec2::X),
+                    ((ii, jj + 1), p11, p01, Vec2::Y),
+                    ((ii - 1, jj), p01, p00, Vec2::NEG_X),
+                ] {
+                    if present(neighbour.0, neighbour.1) {
+                        continue;
+                    }
+                    let (a0, b0) = (Vec3::new(a.x, a.y, bottom), Vec3::new(b.x, b.y, bottom));
+                    let quad = [a0, b0, b, a];
+                    let normal = (quad[1] - quad[0]).cross(quad[2] - quad[0]);
+                    if normal.truncate().dot(facing) >= 0. {
+                        out.push([quad[0], quad[1], quad[2]]);
+                        out.push([quad[0], quad[2], quad[3]]);
+                    } else {
+                        out.push([quad[0], quad[2], quad[1]]);
+                        out.push([quad[0], quad[3], quad[2]]);
+                    }
+                }
+            }
+        }
+        out
+    }
+
+    /// Grind rails along the top's edges (own space): down each side over
+    /// hood, roof and trunk, and across the front and the back, split where
+    /// the top steps more than a hand's height.
+    pub fn rails(&self) -> Vec<Vec<Vec3>> {
+        const SPLIT: f32 = 0.15;
+        const MIN_LENGTH: f32 = 0.8;
+        let mut rails = Vec::new();
+        let mut finish = |rail: &mut Vec<Vec3>| {
+            let length: f32 = rail.windows(2).map(|w| w[0].distance(w[1])).sum();
+            if length >= MIN_LENGTH {
+                rails.push(std::mem::take(rail));
+            }
+            rail.clear();
+        };
+        // Each edge: the outermost top point of every row (or column).
+        let edges: [(usize, usize, bool, bool); 4] = [
+            (self.ny, self.nx, false, false), // left side, along the length
+            (self.ny, self.nx, false, true),  // right side
+            (self.nx, self.ny, true, false),  // back, across
+            (self.nx, self.ny, true, true),   // front
+        ];
+        for (rows, cells, across, far) in edges {
+            let mut rail = Vec::new();
+            for row in 0..rows {
+                let mut order: Vec<usize> = (0..cells).collect();
+                if far {
+                    order.reverse();
+                }
+                let edge = order.into_iter().find_map(|cell| {
+                    let (i, j) = if across { (row, cell) } else { (cell, row) };
+                    self.at(i, j).map(|h| self.point(i, j, h))
+                });
+                match edge {
+                    Some(p) if rail.last().is_none_or(|q: &Vec3| (q.z - p.z).abs() <= SPLIT) => rail.push(p),
+                    Some(p) => {
+                        finish(&mut rail);
+                        rail.push(p);
+                    }
+                    None => finish(&mut rail),
+                }
+            }
+            finish(&mut rail);
+        }
+        rails
+    }
+}
+
+/// A model's survey, a few probes a frame.
+#[derive(Clone, Debug)]
+pub struct Survey {
+    shape: Shape,
+    next: usize,
+    hits: usize,
+}
+
+impl Survey {
+    pub fn new(min: Vec3, max: Vec3) -> Self {
+        let size = (max - min).truncate().max(Vec2::splat(0.2));
+        let mut spacing = SPACING;
+        while ((size.x / spacing).ceil() as usize + 1) * ((size.y / spacing).ceil() as usize + 1) > MAX_PROBES {
+            spacing *= 1.25;
+        }
+        let nx = (size.x / spacing).ceil() as usize + 1;
+        let ny = (size.y / spacing).ceil() as usize + 1;
+        let step = Vec2::new(size.x / (nx - 1) as f32, size.y / (ny - 1) as f32);
+        Self { shape: Shape { min, max, nx, ny, step, heights: vec![None; nx * ny] }, next: 0, hits: 0 }
+    }
+
+    pub fn done(&self) -> bool {
+        self.next >= self.shape.heights.len()
+    }
+
+    /// The next probe: from above the box to its bottom, in own space.
+    pub fn next_probe(&self) -> Option<(Vec3, Vec3)> {
+        (!self.done()).then(|| {
+            let (i, j) = (self.next % self.shape.nx, self.next / self.shape.nx);
+            // Just inside the edges, so the outermost probes meet the body.
+            let p = self.shape.point(i, j, 0.);
+            let inset = |v: f32, lo: f32, hi: f32| v.clamp(lo + 0.03, hi - 0.03);
+            let (x, y) = (inset(p.x, self.shape.min.x, self.shape.max.x), inset(p.y, self.shape.min.y, self.shape.max.y));
+            (Vec3::new(x, y, self.shape.max.z + 0.5), Vec3::new(x, y, self.shape.min.z))
+        })
+    }
+
+    /// The last probe's hit height (own space), or none.
+    pub fn record(&mut self, height: Option<f32>) {
+        if let Some(slot) = self.shape.heights.get_mut(self.next) {
+            // Something a hand's width above the bottom: the wheels' lower
+            // edges are not a roof.
+            *slot = height.filter(|z| *z > self.shape.min.z + 0.15).map(|z| z.min(self.shape.max.z));
+            if slot.is_some() {
+                self.hits += 1;
+            }
+        }
+        self.next += 1;
+    }
+
+    /// The surveyed body, or the box when the probes met too little of it.
+    pub fn finish(mut self) -> Shape {
+        if self.hits * 4 < self.shape.heights.len() {
+            Shape::boxed(self.shape.min, self.shape.max)
+        } else {
+            self.shape.fill_holes();
+            self.shape
+        }
+    }
+}
+
+
+/// Where SK8V's extracted model bounds are (dynamic.rs `Templates::new`).
+pub static TEMPLATE_DIR: OnceLock<PathBuf> = OnceLock::new();
+/// Surveyed models' triangles (model space) and the models already asked about.
+static SURVEYED: Mutex<Option<HashMap<u32, Arc<Vec<svwc::Tri>>>>> = Mutex::new(None);
+static ASKED: Mutex<Option<HashMap<u32, u8>>> = Mutex::new(None);
+/// Surveys per model before it stays SK8V's box (one that met too little of
+/// the body, as when its collision was not loaded yet, is tried again).
+const TRIES: u8 = 8;
+
+/// The surveyed body of `model`, if there is one.
+pub fn surveyed(model: u32) -> Option<Arc<Vec<svwc::Tri>>> {
+    SURVEYED.lock().ok()?.as_ref()?.get(&model).cloned()
+}
+
+/// True for a model that has no extracted bound and no survey yet (up to
+/// [TRIES] times while surveys meet too little of it).
+pub fn needs_shape(model: u32) -> bool {
+    let Some(dir) = TEMPLATE_DIR.get() else { return false };
+    let mut asked = ASKED.lock().unwrap_or_else(|e| e.into_inner());
+    let tries = asked.get_or_insert_with(HashMap::new).entry(model).or_insert(0);
+    if *tries >= TRIES || surveyed(model).is_some() {
+        return false;
+    }
+    *tries += 1;
+    if dir.join(format!("{model:08x}.svwc")).is_file() {
+        *tries = TRIES;
+        return false;
+    }
+    true
+}
+
+/// Surveys `model` (its box `min`..`max`, model space) with `probe` (from,
+/// to -> where it hits, model space); keeps and returns its triangles.
+pub fn survey(model: u32, min: Vec3, max: Vec3, mut probe: impl FnMut(Vec3, Vec3) -> Option<Vec3>) -> usize {
+    let mut survey = Survey::new(min, max);
+    while let Some((top, bottom)) = survey.next_probe() {
+        survey.record(probe(top, bottom).map(|p| p.z));
+    }
+    let shape = survey.finish();
+    if shape.is_box() {
+        // Too little met: SK8V's own box stands, and the model is tried again.
+        return shape.triangles().len();
+    }
+    let tris: Vec<svwc::Tri> = shape
+        .triangles()
+        .into_iter()
+        .map(|t| svwc::Tri { v: t.map(|p| p.to_array()), material: 0 })
+        .collect();
+    let n = tris.len();
+    SURVEYED.lock().unwrap_or_else(|e| e.into_inner()).get_or_insert_with(HashMap::new).insert(model, Arc::new(tris));
+    n
+}
+
+/// 1 once per vehicle model that has no extracted bound (the host then
+/// surveys it with `sv_vehicle_survey`), else 0.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn sv_vehicle_needs_shape(_rt: *mut c_void, model: u32) -> u32 {
+    crate::guard(0, || u32::from(needs_shape(model)))
+}
+
+/// A line the host casts against one vehicle, in its model space: from, to
+/// (3 floats each); writes where it hits the vehicle and returns 1, else 0.
+pub type SvModelProbe = unsafe extern "C" fn(ctx: *mut c_void, from: *const f32, to: *const f32, hit: *mut f32) -> u32;
+
+/// Surveys `model` (bounding box `min`/`max`, 3 floats each, model space)
+/// with `probe`; returns the triangles its body got (0: none).
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn sv_vehicle_survey(_rt: *mut c_void, model: u32, min: *const f32, max: *const f32,
+                                           probe: Option<SvModelProbe>, ctx: *mut c_void) -> u32 {
+    crate::guard(0, || {
+        let Some(probe) = probe else { return 0 };
+        if min.is_null() || max.is_null() {
+            return 0;
+        }
+        let v3 = |p: *const f32| unsafe { Vec3::new(*p, *p.add(1), *p.add(2)) };
+        let (lo, hi) = (v3(min), v3(max));
+        if !lo.is_finite() || !hi.is_finite() || (hi - lo).min_element() <= 0.05 || (hi - lo).max_element() > 40.0 {
+            return 0;
+        }
+        survey(model, lo, hi, |a, b| {
+            let (from, to, mut hit) = (a.to_array(), b.to_array(), [0.0f32; 3]);
+            (unsafe { probe(ctx, from.as_ptr(), to.as_ptr(), hit.as_mut_ptr()) } != 0).then(|| Vec3::from(hit))
+        }) as u32
+    })
+}
