+                println!("{f}: rail {len:.2} m, {} points, from ({:.2}, {:.2}, {:.2}) to ({:.2}, {:.2}, {:.2})", r.len(),
+                    r[0][0], r[0][1], r[0][2], r[r.len() - 1][0], r[r.len() - 1][1], r[r.len() - 1][2]);
