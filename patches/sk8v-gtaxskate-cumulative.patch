+pub fn object_rails(tris: &[[Vec3; 3]]) -> Vec<Vec<Vec3>> {
+    if tris.is_empty() { return Vec::new(); }
+    let (mut min, mut max) = (Vec3::splat(f32::MAX), Vec3::splat(f32::MIN));
