+bool OverwriteInPlace(const std::wstring& from, const std::wstring& to) {
+    HANDLE in = CreateFileW(from.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, 0, nullptr);
+    if (in == INVALID_HANDLE_VALUE) return false;
+    LARGE_INTEGER size{};
