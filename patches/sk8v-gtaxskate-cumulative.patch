+fn segment_distance(p: Vec3, [a, b]: [Vec3; 2]) -> f32 {
+    let e = b - a;
+    let len2 = e.length_squared();
+    let t = if len2 > 1e-12 { ((p - a).dot(e) / len2).clamp(0.0, 1.0) } else { 0.0 };
+    (a + e * t).distance(p)
+}
+
+fn support_edge_intersects([a, b]: [Vec3; 2], half: f32) -> bool {
+    let d = b - a;
+    let (mut lo, mut hi) = (0.0f32, 1.0f32);
+    for k in 0..3 {
+        if d[k].abs() < 1e-12 {
+            if a[k].abs() > half { return false; }
+        } else {
+            let (s, t) = ((-half - a[k]) / d[k], (half - a[k]) / d[k]);
+            lo = lo.max(s.min(t)); hi = hi.min(s.max(t));
+            if lo > hi { return false; }
+        }
+    }
+    true
+}
+
+fn clipped_support_polygon(face: [Vec3; 3], half: f32) -> ([Vec3; 12], usize) {
+    // A triangle clipped by six planes has at most nine corners.
+    let mut poly = [Vec3::ZERO; 12];
+    poly[..3].copy_from_slice(&face);
+    let mut len = 3;
+    for k in 0..3 {
+        for sign in [-1.0f32, 1.0] {
+            if len < 3 { return (poly, 0); }
+            let mut next = [Vec3::ZERO; 12];
+            let mut count = 0;
+            for j in 0..len {
+                let (a, b) = (poly[j], poly[(j + 1) % len]);
+                let (fa, fb) = (half - sign * a[k], half - sign * b[k]);
+                if fa >= 0.0 { next[count] = a; count += 1; }
+                if (fa >= 0.0) != (fb >= 0.0) {
+                    next[count] = a + (b - a) * (fa / (fa - fb)); count += 1;
+                }
+            }
+            poly = next; len = count;
+        }
+    }
+    (poly, len)
+}
+
+fn support_polygon_area(poly: &[Vec3]) -> f32 {
+    (1..poly.len().saturating_sub(1)).map(|i| (poly[i] - poly[0]).cross(poly[i + 1] - poly[0]).length() * 0.5).sum()
+}
+
+#[cfg(test)]
+fn clipped_support_area(face: [Vec3; 3], half: f32) -> f32 {
+    let (poly, len) = clipped_support_polygon(face, half);
+    support_polygon_area(&poly[..len])
+}
+
+/// Minimum caliper width of the projected clipped support. Area alone admits
+/// long coping strips, especially along the cube's diagonal.
+fn support_min_width(points: &mut Vec<Vec2>, hull: &mut Vec<Vec2>) -> f32 {
+    points.sort_unstable_by(|a,b| a.x.total_cmp(&b.x).then(a.y.total_cmp(&b.y)));
+    points.dedup();
+    hull.clear();
+    if points.len() < 3 { return 0.0; }
+    let cross = |a: Vec2,b: Vec2,c: Vec2| (b-a).perp_dot(c-a);
+    for &p in points.iter() {
+        while hull.len() >= 2 && cross(hull[hull.len()-2],hull[hull.len()-1],p) <= 0.0 { hull.pop(); }
+        hull.push(p);
+    }
+    let lower = hull.len();
+    for &p in points.iter().rev().skip(1) {
+        while hull.len() > lower && cross(hull[hull.len()-2],hull[hull.len()-1],p) <= 0.0 { hull.pop(); }
+        hull.push(p);
+    }
+    hull.pop(); // repeated first point
+    if hull.len() < 3 { return 0.0; }
+    let mut width = f32::MAX;
+    for i in 0..hull.len() {
+        let e = hull[(i+1)%hull.len()] - hull[i];
+        if e.length_squared() == 0.0 { continue; }
+        let axis = Vec2::new(-e.y,e.x).normalize();
+        let (mut lo, mut hi) = (f32::MAX,f32::MIN);
+        for &p in hull.iter() { let d = p.dot(axis); lo = lo.min(d); hi = hi.max(d); }
+        width = width.min(hi-lo);
+    }
+    if width == f32::MAX { 0.0 } else { width }
+}
+
+fn replace_park(tris: &mut Vec<Tri>, stairs: &[Tri], visible: &[[[f32; 3]; 3]], centre: Vec2, radius: f32, id: &'static str, out: &mut Replacement) {
+    let inside = |t: &[[f32; 3]; 3]| centroid(t).truncate().distance(centre) <= radius;
+    let park: Vec<usize> = (0..tris.len()).filter(|&i| inside(&tris[i].v)).collect();
+    if park.is_empty() { return; }
+    // Visible triangles near this area only.
+    let lo = |k: usize| park.iter().flat_map(|&i| tris[i].v).map(|p| p[k]).fold(f32::MAX, f32::min) - 1.0;
+    let hi = |k: usize| park.iter().flat_map(|&i| tris[i].v).map(|p| p[k]).fold(f32::MIN, f32::max) + 1.0;
+    let (x0, x1, y0, y1) = (lo(0), hi(0), lo(1), hi(1));
+    let near: Vec<&[[f32; 3]; 3]> = visible.iter()
+        .filter(|t| inside(t) && { let c = centroid(t); c.x >= x0 && c.x <= x1 && c.y >= y0 && c.y <= y1 })
+        .collect();
+    if near.is_empty() { return; }
+    let gta_grid = Grid::new(park.iter().map(|&i| &tris[i].v), MATCH);
+    let stair_grid = Grid::new(stairs.iter().map(|t| &t.v), MATCH);
+    // 1.1: used visible triangles: near a GTA park triangle facing the same
+    // way, and with no sample near a stair (a large visible triangle reaching
+    // over a flight would lie on its steps).
+    let nearest_gta = |p: Vec3| gta_grid.at(p).iter().map(|&k| park[k as usize])
+        .map(|i| (distance(p, &tris[i].v), i)).min_by(|a, b| a.0.total_cmp(&b.0));
+    // Candidates: near a GTA park surface facing nearly the same way (40
+    // deg: a curve's facets do, a ledge's 45 deg chamfer does not), clear of
+    // stairs, not facing down.
+    let mut support = None;
+    let candidates: Vec<(Used, usize)> = near.iter().filter_map(|t| {
+        let c = centroid(t);
+        let (d, i) = nearest_gta(c)?;
+        let partner_n = normal(&tris[i].v);
+        if d > MATCH || normal(t).z < -0.2 { return None; }
+        if normal(t).dot(partner_n) < CURVE_FACING {
+            let gta = tris[i].v.map(v3);
+            let area = (gta[1] - gta[0]).cross(gta[2] - gta[0]).length() / 2.0;
+            if area >= SURFACE || partner_n.z <= 0.5 || normal(t).z <= 0.5 { return None; }
+        }
+        let by_stairs = samples(t).into_iter()
+            .any(|p| stair_grid.at(p).iter().any(|&k| distance(p, &stairs[k as usize].v) <= MATCH));
+        if by_stairs { return None; }
+        let partner = if normal(t).dot(partner_n) >= CURVE_FACING {
+            i
+        } else {
+            support.get_or_insert_with(|| SurfaceSupport::new(tris, &park))
+                .adjacent_partner(i, d, c, normal(t), &park)?
+        };
+        // How far this visible triangle lies from its own GTA surface: only
+        // GTA surfaces that close (plus PARTNER_SLACK) are the same surface.
+        // A ground 20 cm under a visible ledge top is not (its partner is
+        // the GTA ledge top a few centimetres off). When `partner` was
+        // transferred across a shared edge from a tilted small chord `i`, use
+        // the larger of the two plane deviations so the displaced chord still
+        // qualifies as a curve and is cut by the visible surface.
+        let dev = |k: usize| {
+            let a = v3(tris[k].v[0]);
+            let n = normal(&tris[k].v);
+            t.iter().map(|&p| (v3(p) - a).dot(n).abs()).fold(0.0f32, f32::max)
+        };
+        let deviation = dev(i).max(dev(partner));
+        Some((Used { v: **t, partner, limit: (deviation + PARTNER_SLACK).min(MATCH) }, i))
+    }).collect();
+    // How far each GTA face lies from the visible one. 3 cm or more somewhere
+    // makes it a curve chord (the wide cut, chord sag); design
+    // 2026-11-09-visible-owner: the other surfaces the visible model covers
+    // are owned by it too, cut narrowly.
+    // A visible sliver (handrail bracket, trim; under 0.01 m2) or a flat
+    // visible face over a flat GTA deck never makes its chord deviate: the
+    // bracket facets 9-21 cm in front of the flat wall at 1105-11 and the
+    // raised ledge top over the deck at 1105-10 cut both into shards
+    // (design 2026-11-07-park-narrow-fixes; decision 2026-10-26: flat decks
+    // stay GTA's; `turn` below already skips slivers).
+    let is_sliver = |v: &[[f32; 3]; 3]| {
+        let p = v.map(v3);
+        (p[1] - p[0]).cross(p[2] - p[0]).length() / 2.0 < SLIVER_AREA
+    };
+    // A flat face a ledge's height off a flat deck is another surface
+    // (the 23-26 cm ledge top at 1105-10), not the deck bending.
+    let raised_top = |u: &Used, chord: usize| normal(&u.v).z >= CURVE_NEIGHBOUR_MAX_Z && normal(&tris[u.partner].v).z >= CURVE_NEIGHBOUR_MAX_Z
+        && normal(&tris[chord].v).z >= CURVE_NEIGHBOUR_MAX_Z && {
+            // Every corner that far off (a parallel ledge top), not only the
+            // highest one: a 10 deg transition facet rising from the floor
+            // reaches 15 cm at its far corner and is curve evidence
+            // (Goldfish 2026-11-07, item D).
+            let a = v3(tris[chord].v[0]);
+            let n = normal(&tris[chord].v);
+            u.v.iter().map(|&q| (v3(q) - a).dot(n).abs()).fold(f32::MAX, f32::min) >= LEDGE_RISE
+        };
+    let mut deviates: HashMap<usize, f32> = HashMap::default();
+    for &(ref u, chord) in &candidates {
+        let e = deviates.entry(chord).or_insert(0.0);
+        if is_sliver(&u.v) || raised_top(u, chord) { continue; }
+        *e = e.max(u.limit - PARTNER_SLACK);
+    }
+    // Rescue upward bowl facets, and the small faces of the same visible surface:
+    // a bowl's rim strips (GTA's small chords there hover 3-20 cm in front of the
+    // visible faces, 1103-4..8, M21) are joined edge to edge to the owned bowl; a
+    // rail or a post is a mesh of its own and stays GTA's (design 2026-11-09-see-through).
+    let small_ok = |u: &Used, chord: usize, support: &mut Option<SurfaceSupport>| {
+        if u.partner != chord { return true; }
+        let gta = tris[u.partner].v.map(v3);
+        let area = (gta[1] - gta[0]).cross(gta[2] - gta[0]).length() / 2.0;
+        area >= SURFACE || (normal(&tris[u.partner].v).z > 0.5 && normal(&u.v).z > 0.5
+            && support.get_or_insert_with(|| SurfaceSupport::new(tris, &park)).qualifies(u.partner, centroid(&u.v)))
+    };
+    let mut same_surface: Vec<bool> = candidates.iter().map(|(u, chord)| small_ok(u, *chord, &mut support)).collect();
+    {
+        let quant = |p: [f32; 3]| p.map(|c| (c * 1e3).round() as i32);
+        let edge = |a: [f32; 3], b: [f32; 3]| { let (x, y) = (quant(a), quant(b)); if x <= y { (x, y) } else { (y, x) } };
+        let mut by_edge: std::collections::BTreeMap<([i32; 3], [i32; 3]), Vec<usize>> = std::collections::BTreeMap::new();
+        for (k, (u, _)) in candidates.iter().enumerate() {
+            for e in [edge(u.v[0], u.v[1]), edge(u.v[1], u.v[2]), edge(u.v[2], u.v[0])] { by_edge.entry(e).or_default().push(k); }
+        }
+        // Whole connected surfaces: a rail's tube near a big wall chord has a seed too, but
+        // it is no surface of this size, so its other faces stay GTA's (Goldfish 2026-11-09).
+        let mut seen = vec![false; candidates.len()];
+        for start in 0..candidates.len() {
+            if seen[start] || !same_surface[start] { continue; }
+            seen[start] = true;
+            let (mut members, mut stack, mut area) = (vec![start], vec![start], 0.0f32);
+            while let Some(k) = stack.pop() {
+                let v = candidates[k].0.v;
+                let p = v.map(v3);
+                area += (p[1] - p[0]).cross(p[2] - p[0]).length() / 2.0;
+                for e in [edge(v[0], v[1]), edge(v[1], v[2]), edge(v[2], v[0])] {
+                    for &j in &by_edge[&e] {
+                        if !seen[j] && normal(&candidates[j].0.v).dot(normal(&v)) >= 0.0 {
+                            seen[j] = true;
+                            members.push(j);
+                            stack.push(j);
+                        }
+                    }
+                }
+            }
+            if area >= SAME_SURFACE_AREA { for k in members { same_surface[k] = true; } }
+        }
+    }
+    let deviation = |u: &Used, chord: usize| deviates[&chord].max(deviates.get(&u.partner).copied().unwrap_or(0.0));
+    // A chord just under CURVE beside a replaced curve chord facing the same
+    // way is part of that curve (design 2026-11-02-bowl-wall-owner): one hop
+    // from the chords at CURVE or more that keep a visible face, never
+    // further; floors and decks (CURVE_NEIGHBOUR_MAX_Z) never.
+    let quant = |p: [f32; 3]| p.map(|c| (c * 1e4).round() as i32);
+    let mut seeds: Vec<usize> = Vec::new();
+    for (k, (u, chord)) in candidates.iter().enumerate() {
+        if deviation(u, *chord) >= CURVE && same_surface[k] {
+            seeds.extend([*chord, u.partner].into_iter().filter(|k| deviates.get(k).is_some_and(|&d| d >= CURVE)));
+        }
+    }
+    seeds.sort_unstable();
+    seeds.dedup();
+    let mut curve_corners: HashMap<[i32; 3], Vec<usize>> = HashMap::default();
+    for &k in &seeds {
+        for p in tris[k].v { curve_corners.entry(quant(p)).or_default().push(k); }
+    }
+    // Whether the visible faces over a chord turn away from it: a flat
+    // visible wall 2 cm in front of GTA's is offset, not curved (M20,
+    // Manatros 2026-11-03: "partly even worse"; its faces turn 2.5-2.9 deg,
+    // 1102-6's 5.8 deg). Only a bend makes a chord part of the curve beside it.
+    let mut turn: HashMap<usize, f32> = HashMap::default();
+    for (u, chord) in &candidates {
+        // Only faces of the chord's own surface, and no stray sliver (peer
+        // review 2026-11-03: one small trim facet must not make a wall bend).
+        let p = u.v.map(v3);
+        if u.partner != *chord || (p[1] - p[0]).cross(p[2] - p[0]).length() / 2.0 < 0.01 { continue; }
+        let dot = normal(&u.v).dot(normal(&tris[*chord].v));
+        let e = turn.entry(*chord).or_insert(1.0);
+        *e = e.min(dot);
+    }
+    let bends = |k: usize| turn.get(&k).is_some_and(|&dot| dot <= CURVE_NEIGHBOUR_TURN);
+    let beside_curve = |k: usize| deviates.get(&k).is_some_and(|d| (CURVE_NEIGHBOUR..CURVE).contains(d)) && bends(k)
+        && normal(&tris[k].v).z < CURVE_NEIGHBOUR_MAX_Z
+        && tris[k].v.iter().any(|&p| curve_corners.get(&quant(p))
+            .is_some_and(|ks| ks.iter().any(|&j| normal(&tris[j].v).dot(normal(&tris[k].v)) >= CURVE_FACING)));
+    // GTA faces a used visible face stands on (its nearest chord and its
+    // partner): those are always cut by it, whatever their facing.
+    let mut owned: std::collections::HashSet<usize> = std::collections::HashSet::new();
+    // Chords a curve replaces (the wide cut, chord sag); the other owned faces
+    // are cut narrowly (design 2026-11-09-visible-owner 1).
+    let mut curve_chords: std::collections::HashSet<usize> = std::collections::HashSet::new();
+    let mut curve_partners: std::collections::HashSet<usize> = std::collections::HashSet::new();
+    let used: Vec<Used> = candidates.into_iter().zip(same_surface).filter_map(|((u, chord), same)| {
+        if !same { return None; }
+        let d = deviation(&u, chord);
+        let curve = d >= CURVE || (d >= CURVE_NEIGHBOUR && (beside_curve(chord) || beside_curve(u.partner)));
+        // The visible model owns every surface it covers (Manatros 2026-11-08
+        // 05:36; A50 as updated 2026-10-27; box gates in the design), except a
+        // raised top with no GTA top (the deck under it must stay: no lid over
+        // a hole) and a bracket off a flat face.
+        if !curve && (is_sliver(&u.v) || raised_top(&u, chord)) { return None; }
+        owned.insert(chord);
+        if curve {
+            curve_chords.extend([chord, u.partner]);
+            curve_partners.insert(u.partner);
+        }
+        // The whole face's deviation is the limit: the parts of the chord
+        // close to the curve go with it.
+        Some(Used { limit: (d + PARTNER_SLACK).min(MATCH), ..u })
+    }).collect();
+    #[cfg(test)]
+    if let Some(support) = &support { out.support_work = support.work; }
+    if used.is_empty() { return; }
+    // Sag faces (design 2026-11-08-chord-sag): visible faces directly behind
+    // an admitted curve chord, farther than MATCH from it, where the flat chord
+    // spans a round wall ("the triangle hovers next to the actual bowl",
+    // 1103-2). They cut only their own chord and nothing snaps onto them.
+    let chords = &curve_chords;
+    let in_used: std::collections::HashSet<[[u32; 3]; 3]> = used.iter().map(|u| u.v.map(|p| p.map(f32::to_bits))).collect();
+    let sag_grid = Grid::new(park.iter().map(|&i| &tris[i].v), SAG_REACH);
+    // A chord's flat surface: admitted chord triangles in its plane (a quad's
+    // two halves): normals within 0.8 deg, planes within 2 mm.
+    let mut chord_list: Vec<usize> = chords.iter().copied().collect();
+    chord_list.sort_unstable();
+    let chord_grid = Grid::new(chord_list.iter().map(|&i| &tris[i].v), 0.0);
+    let mut surfaces: HashMap<usize, Vec<usize>> = HashMap::default();
+    let surface_of = |i: usize| -> Vec<usize> {
+        let (ni, g0) = (normal(&tris[i].v), v3(tris[i].v[0]));
+        let mut out: Vec<usize> = tris[i].v.iter().flat_map(|&p| chord_grid.at(v3(p)).iter().map(|&k| chord_list[k as usize]))
+            .filter(|&j| normal(&tris[j].v).dot(ni) > 0.9999 && tris[j].v.iter().all(|&q| (v3(q) - g0).dot(ni).abs() < 0.002))
+            .collect();
+        out.sort_unstable(); out.dedup(); out
+    };
+    // Ordered: the output order must not depend on hashing (same bake, same bytes).
+    let mut sag: std::collections::BTreeMap<usize, Vec<Used>> = std::collections::BTreeMap::new();
+    let mut sag_faces: Vec<Used> = Vec::new();
+    for t in &near {
+        if in_used.contains(&t.map(|p| p.map(f32::to_bits))) || normal(t).z < -0.2 { continue; }
+        let c = centroid(t);
+        let pts = [c, v3(t[0]) + (c - v3(t[0])) * 0.02, v3(t[1]) + (c - v3(t[1])) * 0.02, v3(t[2]) + (c - v3(t[2])) * 0.02];
+        let mut best: Option<(f32, usize, f32, Vec<usize>)> = None;
+        for &k in sag_grid.at(c) {
+            let i = park[k as usize];
+            if !chords.contains(&i) { continue; }
+            let ni = normal(&tris[i].v);
+            if ni == Vec3::ZERO || ni.z >= CURVE_NEIGHBOUR_MAX_Z || normal(t).dot(ni) < CURVE_FACING { continue; }
+            let g = tris[i].v.map(v3);
+            let mut worst = 0.0f32;
+            // Cheap depth test first (peer review 2026-11-08).
+            let back_c = (g[0] - c).dot(ni);
+            if back_c <= CURVE || back_c > SAG_REACH { continue; }
+            let surface = surfaces.entry(i).or_insert_with(|| surface_of(i)).clone();
+            // The centroid directly behind the chord's surface; corners within
+            // MATCH of its border (a leaning wall's outer corners project just
+            // past the chord's straight edge).
+            let behind = pts.iter().enumerate().all(|(k, &p)| {
+                let back = (g[0] - p).dot(ni);
+                let q = p + ni * back;
+                worst = worst.max(back);
+                back > CURVE && back <= SAG_REACH && if k == 0 {
+                    surface.iter().any(|&j| {
+                        let h = tris[j].v.map(v3);
+                        (0..3).all(|e| (h[(e + 1) % 3] - h[e]).cross(q - h[e]).dot(ni) >= -ON_EDGE * h[(e + 1) % 3].distance(h[e]))
+                    })
+                } else {
+                    // Corners: within MATCH of the surface (distance, not
+                    // widened half-planes: a thin triangle's widened corner
+                    // reaches metres; peer review 2026-11-08).
+                    surface.iter().any(|&j| distance(q, &tris[j].v) <= MATCH)
+                }
+            });
+            if !behind { continue; }
+            let back = (g[0] - c).dot(ni);
+            if best.as_ref().is_none_or(|b| back < b.0) { best = Some((back, i, worst, surface)); }
+        }
+        let Some((_, i, worst, surface)) = best else { continue };
+        // Another GTA face within MATCH, facing the same way and no part of
+        // this chord, would stay as a second layer under the sag face (peer
+        // review 2026-11-08); a floor or coping beside it would not.
+        if nearest_gta(c).is_some_and(|(d, k)| d <= MATCH && !surface.contains(&k) && normal(&tris[k].v).dot(normal(t)) >= CURVE_FACING) { continue; }
+        if samples(t).into_iter().any(|p| stair_grid.at(p).iter().any(|&k| distance(p, &stairs[k as usize].v) <= MATCH)) { continue; }
+        // It cuts every triangle of the chord's surface; it is collision once.
+        let limit = (worst + PARTNER_SLACK).min(SAG_REACH);
+        for j in surface { sag.entry(j).or_default().push(Used { v: **t, partner: i, limit }); }
+        sag_faces.push(Used { v: **t, partner: i, limit });
+    }
+    // Chamfers (design 2026-11-09-visible-owner 2): thin visible strips beside an
+    // owned face, two hops at most (a strip's two triangles).
+    let mut chamfers: Vec<Used> = Vec::new();
+    {
+        let bits = |v: &[[f32; 3]; 3]| v.map(|p| p.map(f32::to_bits));
+        let taken: std::collections::HashSet<[[u32; 3]; 3]> = used.iter().chain(&sag_faces).map(|u| bits(&u.v)).collect();
+        let thin: Vec<&[[f32; 3]; 3]> = near.iter().copied().filter(|t| {
+            let p = t.map(v3);
+            let area = (p[1] - p[0]).cross(p[2] - p[0]).length() / 2.0;
+            let longest = p[0].distance(p[1]).max(p[1].distance(p[2])).max(p[2].distance(p[0]));
+            !taken.contains(&bits(t)) && normal(t).z >= 0.3 && longest > 0.0 && 2.0 * area / longest < CHAMFER_WIDTH
+                && !samples(t).into_iter().any(|q| stair_grid.at(q).iter().any(|&k| distance(q, &stairs[k as usize].v) <= MATCH))
+        }).collect();
+        // Edge -> lowest index of the owner holding it.
+        let edge = |a: [f32; 3], b: [f32; 3]| { let (x, y) = (quant(a), quant(b)); if x <= y { (x, y) } else { (y, x) } };
+        let edges_of = |v: &[[f32; 3]; 3]| [edge(v[0], v[1]), edge(v[1], v[2]), edge(v[2], v[0])];
+        let mut owner_edges: HashMap<([i32; 3], [i32; 3]), usize> = HashMap::default();
+        for (k, u) in used.iter().enumerate() {
+            for e in edges_of(&u.v) { let o = owner_edges.entry(e).or_insert(k); *o = (*o).min(k); }
+        }
+        let mut hop1: Vec<bool> = vec![false; thin.len()];
+        let mut first_edges: HashMap<([i32; 3], [i32; 3]), usize> = HashMap::default();
+        for (k, t) in thin.iter().enumerate() {
+            let owner = edges_of(t).iter().filter_map(|e| owner_edges.get(e).copied()).min()
+                .filter(|&o| {
+                    let (un, a) = (normal(&used[o].v), v3(used[o].v[0]));
+                    normal(t).dot(un) > 0.0 && t.iter().all(|&q| (v3(q) - a).dot(un).abs() <= MATCH)
+                });
+            if let Some(o) = owner {
+                hop1[k] = true;
+                let partner = used[o].partner;
+                chamfers.push(Used { v: **t, partner, limit: 0.0 });
+                for e in edges_of(t) { first_edges.entry(e).or_insert(partner); }
+            }
+        }
+        for (k, t) in thin.iter().enumerate() {
+            if hop1[k] { continue; }
+            if let Some(&partner) = edges_of(t).iter().find_map(|e| first_edges.get(e)) {
+                chamfers.push(Used { v: **t, partner, limit: 0.0 });
+            }
+        }
+    }
+    let vis_grid = Grid::new(used.iter().map(|u| &u.v), MATCH);
+    // 1.2/1.4: GTA triangles near a used visible one facing the same way are
+    // cut by the visible footprints, and the vertices on the footprints'
+    // edges move onto them.
+    let mut changed: Vec<(usize, Vec<[[f32; 3]; 3]>)> = Vec::new();
+    let mut moved: HashMap<[i32; 3], [f32; 3]> = HashMap::default();
+    let mut pinned: std::collections::HashSet<[i32; 3]> = std::collections::HashSet::new();
+    let mut cover: Vec<u32> = Vec::new();
+    // Whether a cut piece is on an owned visible face: its centroid, corners and
+    // edge midpoints each within a used face's own limit (the same surface: a
+    // deck 20 cm under an overhang's top is not), facing like the piece's
+    // chord, no bracket. `inside`: projecting inside the face (a second owner);
+    // otherwise near it (a thin remnant beside it).
+    let piece_points = |piece: &[[f32; 3]; 3]| {
+        let p = piece.map(v3);
+        let c = (p[0] + p[1] + p[2]) / 3.0;
+        [c, p[0], p[1], p[2], (p[0] + p[1]) * 0.5, (p[1] + p[2]) * 0.5, (p[2] + p[0]) * 0.5].map(|q| q + (c - q) * 0.02)
+    };
+    let on_owned = |piece: &[[f32; 3]; 3], n: Vec3, inside: bool| piece_points(piece).iter().all(|&q| vis_grid.at(q).iter().any(|&k| {
+        let u = &used[k as usize];
+        let un = normal(&u.v);
+        if un.dot(n) < FACING || is_sliver(&u.v) { return false; }
+        // A remnant under 2 cm wide: dropping it leaves at most that slit, so
+        // the reach is MATCH (standing slivers came back with the limit).
+        if !inside { return distance(q, &u.v) <= MATCH; }
+        let (a, b, e) = (v3(u.v[0]), v3(u.v[1]), v3(u.v[2]));
+        let d = (q - a).dot(un);
+        if d.abs() > u.limit { return false; }
+        let s = q - un * d;
+        [(a, b), (b, e), (e, a)].iter().all(|&(g, h)| (h - g).cross(s - g).dot(un) >= -1e-4)
+    }));
+    for i in 0..tris.len() {
+        let t = tris[i].v;
+        let n = normal(&t);
+        if n == Vec3::ZERO { continue; }
+        let (tlo, thi) = bounds(&t, MATCH);
+        cover.clear();
+        for x in tlo.x.floor() as i32..=thi.x.floor() as i32 {
+            for y in tlo.y.floor() as i32..=thi.y.floor() as i32 {
+                cover.extend(vis_grid.cells.get(&(x, y)).map_or(&[][..], |v| v.as_slice()));
+            }
+        }
+        cover.sort_unstable();
+        cover.dedup();
+        let replaced_chord = curve_partners.contains(&i);
+        cover.retain(|&k| {
+            let u = &used[k as usize];
+            // A replaced chord's covers reach POCKET_REACH (peer review 2026-11-03).
+            let (vlo, vhi) = bounds(&u.v, if replaced_chord { u.limit.max(POCKET_REACH) } else { u.limit });
+            // A neighbour no used face stands on is cut only by faces of its
+            // own surface (within 40 deg): a wall grazing a lip row's seam by
+            // millimetres sliced it into dozens of shards (1104-5; design
+            // 2026-11-07-park-narrow-fixes).
+            let own = curve_chords.contains(&i);
+            // (Goldfish item I, "trim cuts only the faces it stands on", was
+            // measured and dropped: it left 2-5 cm floor layers at Hawick,
+            // box bakes exp4/N3 2026-11-07.)
+            vlo.cmple(thi).all() && vhi.cmpge(tlo).all() && normal(&u.v).dot(n) >= if own { FACING } else { CURVE_FACING }
+        });
+        let extra = sag.get(&i);
+        if cover.is_empty() && extra.is_none() { continue; }
+        let extra = || extra.into_iter().flatten();
+        // Ordinary covers touching this chord's sag faces (a shared corner)
+        // cut it with the sag reach, so no slit stays between the footprints;
+        // other covers keep their limits (peer review 2026-11-08).
+        let sag_corners: std::collections::HashSet<[i32; 3]> = extra().flat_map(|u| u.v.iter().map(|&p| quant(p)).collect::<Vec<_>>()).collect();
+        let reaches = |u: &Used| u.v.iter().any(|&p| sag_corners.contains(&quant(p)));
+        // A chord the curve replaces goes whole: where the flat chord lies
+        // farther from the curve than a cover's limit, pockets of it stayed
+        // standing in the bowl (connector marks 1103-1..8, M21; design
+        // 2026-11-03-replaced-chord-pockets).
+        let pieces = if replaced_chord {
+            // Covers turned 40-60 deg keep their reach measured along their
+            // own normal (cut_along measures along the chord's).
+            let wide: Vec<Used> = cover.iter().map(|&k| &used[k as usize])
+                .map(|u| {
+                    let along = normal(&u.v).dot(n);
+                    Used { v: u.v, partner: u.partner, limit: if along >= CURVE_FACING { u.limit.max(POCKET_REACH) } else { u.limit / along.max(FACING) } }
+                })
+                .chain(extra().map(|u| Used { v: u.v, partner: u.partner, limit: u.limit }))
+                .collect();
+            // Whole when the unfiltered subtraction leaves nothing. A partly
+            // covered chord keeps the wide cut unless one of its remnants
+            // would fold when snapped: those trenched remnants stood off the
+            // curve as detached shards (1105-1..4, 1104-5..11; the
+            // BOWL_DIAG_ATOMIC bake). Only then the ordinary reach, still
+            // projected along the chord's own normal (`square`, the M21 crease
+            // wedge; Goldfish 2026-11-07, item E). Everywhere else the wide
+            // cut stays: the ordinary one left floor remnants 2-5 cm over the
+            // visible floor at Hawick (box bakes N2/N3, 2026-11-07).
+            // Coverage is judged in double precision on the unfiltered
+            // residual; the cut itself stays the single-precision one the
+            // installed world was baked with.
+            if subtract_along(&t, wide.iter(), true, false).raw_covered {
+                Vec::new()
+            } else {
+                let pieces = cut_along(&t, wide.iter(), true);
+                // A piece snapping collapses to nothing is dropped later, no fold.
+                let folds = pieces.iter().any(|p| {
+                    let s = normal(&p.map(|q| snap(q, &used, &vis_grid)));
+                    s != Vec3::ZERO && s.dot(n) < SNAP_FOLD
+                });
+                if folds {
+                    let reach: Vec<Used> = cover.iter().map(|&k| &used[k as usize]).map(|u| Used { v: u.v, partner: u.partner,
+                        limit: if reaches(u) { u.limit.max(SAG_REACH) } else { u.limit } }).collect();
+                    cut_along(&t, reach.iter().chain(extra()), true)
+                } else { pieces }
+            }
+        } else {
+            let reach: Vec<Used> = cover.iter().map(|&k| &used[k as usize]).map(|u| Used { v: u.v, partner: u.partner,
+                limit: if reaches(u) { u.limit.max(SAG_REACH) } else { u.limit } }).collect();
+            cut(&t, reach.iter().chain(extra()))
+        };
+        if pieces.len() == 1 && pieces[0] == t { continue; }
+        // A piece is flat in its face before snapping; snapping that turns it
+        // away from the face folds it onto the visible footprints' edges
+        // (shards standing in the bowl: connector marks 1103-1..8, M21;
+        // Manatros 2026-11-03). Its corners stay where they are, for every
+        // face sharing them (pinned; peer review 2026-11-03: no cracks).
+        for p in &pieces {
+            let s = p.map(|q| snap(q, &used, &vis_grid));
+            if normal(&s).dot(n) < SNAP_FOLD { pinned.extend(p.iter().map(|&q| quant(q))); }
+        }
+        for &corner in &t {
+            let s = snap(corner, &used, &vis_grid);
+            if s != corner { moved.insert(quant(corner), s); }
+        }
+        changed.push((i, pieces));
+    }
+    if changed.is_empty() { return; }
+    // Neighbours sharing a moved corner move it too (no crack at the seam).
+    // A floor sharing a corner with a wall that snapping moved up must not be
+    // pulled up with it (Manatros 2026-11-03: "a vertex placed too high at the
+    // walls, so the floor curves up there"): such a corner is pinned.
+    let done: std::collections::HashSet<usize> = changed.iter().map(|c| c.0).collect();
+    let neighbours: Vec<usize> = (0..tris.len())
+        .filter(|&i| !done.contains(&i) && tris[i].v.iter().any(|&p| moved.contains_key(&quant(p))))
+        .collect();
+    // Pins until none is added (re-review 2026-11-03): a pin can make a piece
+    // or neighbour that was fine fold; it then pins all its corners too. Pins
+    // only grow, so this ends; afterwards every face folds nowhere.
+    for &i in &neighbours {
+        let t = tris[i].v;
+        if normal(&t).z < CURVE_NEIGHBOUR_MAX_Z { continue; }
+        let far = t.iter().any(|&p| !pinned.contains(&quant(p)) && moved.get(&quant(p)).is_some_and(|&m| v3(m).distance(v3(p)) > FLAT_NEIGHBOUR_MOVE));
+        if far { pinned.extend(t.iter().map(|&q| quant(q))); }
+    }
+    loop {
+        let before = pinned.len();
+        let place = |q: [f32; 3]| if pinned.contains(&quant(q)) { q } else { snap(q, &used, &vis_grid) };
+        let mut add: Vec<[i32; 3]> = Vec::new();
+        for (i, pieces) in &changed {
+            let n = normal(&tris[*i].v);
+            for p in pieces {
+                if normal(&p.map(place)).dot(n) < SNAP_FOLD { add.extend(p.iter().map(|&q| quant(q))); }
+            }
+        }
+        for &i in &neighbours {
+            let t = tris[i].v;
+            let m = t.map(|p| if pinned.contains(&quant(p)) { p } else { moved.get(&quant(p)).copied().unwrap_or(p) });
+            if normal(&m).dot(normal(&t)) < SNAP_FOLD { add.extend(t.iter().map(|&q| quant(q))); }
+        }
+        pinned.extend(add);
+        if pinned.len() == before { break; }
+    }
+    let place = |q: [f32; 3]| if pinned.contains(&quant(q)) { q } else { snap(q, &used, &vis_grid) };
+    // A small cut piece off every visible face, on the side a board comes from,
+    // is a fragment: nothing is there to see (design 2026-11-09-see-through).
+    let near_grid = Grid::new(near.iter().copied(), HOVER_REACH);
+    // Or a small piece standing up to HOVER_REACH in front of owned faces at every point:
+    // those faces are there, so dropping it leaves no hole (1105-2: 11-14 cm over the
+    // bowl's owned floor, its corners on it).
+    let over_grid = Grid::new(used.iter().map(|u| &u.v), HOVER_REACH);
+    let over_owned = |piece: &[[f32; 3]; 3], n: Vec3| {
+        let mut most = 0.0f32;
+        let all = piece_points(piece).iter().all(|&q| over_grid.at(q).iter().any(|&k| {
+            let u = &used[k as usize];
+            if normal(&u.v).dot(n) < FACING || is_sliver(&u.v) { return false; }
+            match stands_over(q, &u.v) {
+                Some(d) => { most = most.max(d); true }
+                None => false,
+            }
+        }));
+        all && most > HOVER_OFF
+    };
+    let hovering = |piece: &[[f32; 3]; 3], n: Vec3| {
+        let p = piece.map(v3);
+        if (p[1] - p[0]).cross(p[2] - p[0]).length() / 2.0 >= HOVER_AREA { return false; }
+        over_owned(piece, n) || piece_points(piece).iter().all(|&q| {
+            let mut best: Option<(f32, usize)> = None;
+            for &k in near_grid.at(q) {
+                let d = distance(q, near[k as usize]);
+                if best.is_none_or(|b| d < b.0) { best = Some((d, k as usize)); }
+            }
+            let Some((d, k)) = best else { return false };
+            d > HOVER_OFF && d <= HOVER_REACH && (q - v3(near[k][0])).dot(normal(near[k])) > 0.0
+        })
+    };
+    // Snapping can squeeze a piece into a sliver: those go too (they broke the
+    // lip test of a park curb, 2026-10-26).
+    let changed: Vec<(usize, Vec<[[f32; 3]; 3]>)> = changed.into_iter().map(|(i, pieces)| {
+        let chord_n = normal(&tris[i].v);
+        let kept = pieces.iter().map(|p| p.map(place))
+            .filter(|t| {
+                let p = t.map(v3);
+                let area = (p[1] - p[0]).cross(p[2] - p[0]).length() / 2.0;
+                let longest = p[0].distance(p[1]).max(p[1].distance(p[2])).max(p[2].distance(p[0]));
+                // A piece lying on an owned visible face is a second owner; a
+                // remnant under 2 cm wide beside one stands off it as a shard.
+                area >= PIECE_AREA && area / longest >= PIECE_WIDTH && !on_owned(t, chord_n, true) && !hovering(t, chord_n)
+                    && !(2.0 * area / longest < REMNANT_WIDTH && on_owned(t, chord_n, false))
+            })
+            .collect();
+        (i, kept)
+    }).chain(neighbours.into_iter().filter_map(|i| {
+        let t = tris[i].v;
+        let m = t.map(|p| if pinned.contains(&quant(p)) { p } else { moved.get(&quant(p)).copied().unwrap_or(p) });
+        (m != t).then(|| (i, vec![m]))
+    })).collect();
+    for u in used.iter().chain(&sag_faces).chain(&chamfers) {
+        out.added.push(Tri { v: u.v, material: tris[u.partner].material });
+        out.surface_from.push(svwc::surfaces::key(&tris[u.partner].v));
+        out.cut.push(false);
+        out.park.push(id);
+    }
+    let mut replaced = vec![false; tris.len()];
+    for (i, pieces) in changed {
+        replaced[i] = true;
+        let key = svwc::surfaces::key(&tris[i].v);
+        for p in pieces {
+            out.added.push(Tri { v: p, material: tris[i].material });
+            out.surface_from.push(key);
+            out.cut.push(true);
+            out.park.push(id);
+        }
+    }
+    let mut index = 0;
+    tris.retain(|t| {
+        let drop = replaced[index];
+        index += 1;
+        if drop { out.removed.push(*t); }
+        !drop
+    });
+}
+
+/// How far `q` stands in front of face `v`, when it projects inside the face along its
+/// normal, from just behind it (`HOVER_OFF`) to `HOVER_REACH`.
+fn stands_over(q: Vec3, v: &[[f32; 3]; 3]) -> Option<f32> {
+    let n = normal(v);
+    let (a, b, e) = (v3(v[0]), v3(v[1]), v3(v[2]));
+    let d = (q - a).dot(n);
+    if !(-HOVER_OFF..=HOVER_REACH).contains(&d) { return None; }
+    let s = q - n * d;
+    [(a, b), (b, e), (e, a)].iter().all(|&(g, h)| (h - g).cross(s - g).dot(n) >= -1e-4).then_some(d)
+}
+
+fn bounds(t: &[[f32; 3]; 3], widen: f32) -> (Vec3, Vec3) {
+    let p = t.map(v3);
+    (p[0].min(p[1]).min(p[2]) - Vec3::splat(widen), p[0].max(p[1]).max(p[2]) + Vec3::splat(widen))
+}
+
+/// `t` minus the regions the visible triangles `cover` take from it: each
+/// visible triangle projected along its own normal onto `t`'s plane, where
+/// it lies within `MATCH` of that plane (a convex region). The rest comes back
+/// as triangles in `t`'s plane; pieces too small to stand on are dropped.
+fn cut<'a>(t: &[[f32; 3]; 3], cover: impl Iterator<Item = &'a Used>) -> Vec<[[f32; 3]; 3]> {
+    cut_along(t, cover, false)
+}
+
+/// As [`cut`]; with `square` each visible triangle is projected along `t`'s
+/// own normal (a chord the curve replaces: over a convex crease, projecting
+/// each face along its own normal leaves a wedge of the chord uncovered,
+/// M21), and its limit is measured along that normal too.
+fn cut_along<'a>(t: &[[f32; 3]; 3], cover: impl Iterator<Item = &'a Used>, square: bool) -> Vec<[[f32; 3]; 3]> {
+    let [a, b, c] = t.map(v3);
+    let n = (b - a).cross(c - a).normalize();
+    let eu = (b - a).normalize();
+    let ew = n.cross(eu);
+    let to2 = |p: Vec3| Vec2::new((p - a).dot(eu), (p - a).dot(ew));
+    let to3 = |q: Vec2| a + eu * q.x + ew * q.y;
+    let corners = [to2(a), to2(b), to2(c)];
+    let face_area = polygon_area(&corners);
+    let mut pieces: Vec<Vec<Vec2>> = vec![corners.to_vec()];
+    let mut was_cut = false;
+    for u in cover {
+        let (v, limit) = (&u.v, u.limit);
+        let nv = normal(v);
+        let along = nv.dot(n);
+        if along <= FACING { continue; }
+        // Visible corners projected along nv (or n) onto t's plane.
+        let dir = if square { n } else { nv };
+        let x: Vec<Vec2> = v.iter().map(|&p| { let p = v3(p); to2(p - dir * ((p - a).dot(n) / dir.dot(n))) }).collect();
+        // Along n, the visible plane's height over t is s/along: the same
+        // limit along n is limit*along along nv.
+        let limit = if square { limit * along } else { limit };
+        // Half-planes (point, inward normal) of the region: the projected
+        // triangle's edges, then |signed distance along nv| <= MATCH.
+        let ccw = (x[1] - x[0]).perp_dot(x[2] - x[0]);
+        if ccw.abs() < 1e-9 { continue; }
+        let mut planes: Vec<(Vec2, Vec2, f32)> = (0..3).map(|k| {
+            let (p, q) = (x[k], x[(k + 1) % 3]);
+            let e = q - p;
+            let inward = if ccw > 0.0 { Vec2::new(-e.y, e.x) } else { Vec2::new(e.y, -e.x) };
+            (inward, p, 0.0)
+        }).collect();
+        // s(X) = (v0 - X) . nv for X on t's plane: affine in the 2D point.
+        let v0 = v3(v[0]);
+        let s0 = (v0 - a).dot(nv);
+        let g = Vec2::new(-eu.dot(nv), -ew.dot(nv));
+        // s0 + g.X <= limit  and  -(s0 + g.X) <= limit, as inward form c + m.X >= 0.
+        planes.push((-g, Vec2::ZERO, limit - s0));
+        planes.push((g, Vec2::ZERO, limit + s0));
+        let mut next = Vec::new();
+        for poly in pieces {
+            // Untouched polygons stay whole (no needless split).
+            let mut probe = poly.clone();
+            for (k, &(m, p, c)) in planes.iter().enumerate() {
+                probe = clip(&probe, |q| if k < 3 { m.dot(q - p) } else { c + m.dot(q) });
+                if probe.len() < 3 { break; }
+            }
+            if probe.len() < 3 || polygon_area(&probe) < 1e-8 { next.push(poly); continue; }
+            was_cut = true;
+            let mut rest = poly;
+            for (k, &(m, p, c)) in planes.iter().enumerate() {
+                let inside = |q: Vec2| if k < 3 { m.dot(q - p) } else { c + m.dot(q) };
+                let outside_piece = clip(&rest, |q| -inside(q));
+                if outside_piece.len() >= 3 { next.push(outside_piece); }
+                rest = clip(&rest, inside);
+                if rest.len() < 3 { break; }
+            }
+        }
+        pieces = next;
+        if pieces.is_empty() { break; }
+    }
+    let mut out = Vec::new();
+    for poly in pieces {
+        // Cut remnants (design 2026-10-31 remnant cleanup): clipping leaves
+        // near-duplicate and collinear corners whose fan made 100-300 tiny
+        // triangles per railing mark (M23-M26) and the bowl connector (M21/22);
+        // the same surface with clean corners (GTA's own corners always stay).
+        // A remnant narrower than REMNANT_WIDTH that is only a small part of
+        // its face is a strip along the visible edge, not a surface; a long
+        // thin face the visible mesh barely touched keeps its remnant.
+        let poly = if was_cut { simplify(&poly, &corners) } else { poly };
+        if poly.len() < 3 { continue; }
+        if was_cut && convex_width(&poly) < REMNANT_WIDTH && polygon_area(&poly) <= REMNANT_SHARE * face_area { continue; }
+        for k in 1..poly.len() - 1 {
+            let tri = [to3(poly[0]), to3(poly[k]), to3(poly[k + 1])];
+            let area = (tri[1] - tri[0]).cross(tri[2] - tri[0]).length() / 2.0;
+            let longest = tri[0].distance(tri[1]).max(tri[1].distance(tri[2])).max(tri[2].distance(tri[0]));
+            if area < PIECE_AREA || area / longest < PIECE_WIDTH { continue; }
+            out.push(tri.map(|p| p.to_array()));
+        }
+    }
+    // An uncut triangle comes back exactly as it was.
+    if out.len() == 1 && pieces_equal(&out[0], t) { return vec![*t]; }
+    out
+}
+
+struct Subtraction { pieces: Vec<[[f32; 3]; 3]>, raw_covered: bool }
+
+fn subtract_along<'a>(t: &[[f32; 3]; 3], cover: impl Iterator<Item = &'a Used>, square: bool, preserve: bool) -> Subtraction {
+    let [a, b, c] = t.map(|p| bevy_math::DVec3::from_array(p.map(f64::from)));
+    let n = (b - a).cross(c - a).normalize();
+    let eu = (b - a).normalize();
+    let ew = n.cross(eu);
+    let to2 = |p: bevy_math::DVec3| bevy_math::DVec2::new((p - a).dot(eu), (p - a).dot(ew));
+    let to3 = |q: bevy_math::DVec2| a + eu * q.x + ew * q.y;
+    let corners = [to2(a), to2(b), to2(c)];
+    let face_area = polygon_area64(&corners);
+    let mut pieces: Vec<Vec<bevy_math::DVec2>> = vec![corners.to_vec()];
+    let mut was_cut = false;
+    for u in cover {
+        let (v, limit) = (&u.v, f64::from(u.limit));
+        let v = v.map(|p| bevy_math::DVec3::from_array(p.map(f64::from)));
+        let nv = (v[1]-v[0]).cross(v[2]-v[0]).normalize_or_zero();
+        let along = nv.dot(n);
+        if along <= f64::from(FACING) { continue; }
+        // Visible corners projected along nv (or n) onto t's plane.
+        let dir = if square { n } else { nv };
+        let x: Vec<bevy_math::DVec2> = v.iter().map(|&p| { to2(p - dir * ((p - a).dot(n) / dir.dot(n))) }).collect();
+        // Along n, the visible plane's height over t is s/along: the same
+        // limit along n is limit*along along nv.
+        let limit = if square { limit * along } else { limit };
+        // Half-planes (point, inward normal) of the region: the projected
+        // triangle's edges, then |signed distance along nv| <= MATCH.
+        let ccw = (x[1] - x[0]).perp_dot(x[2] - x[0]);
+        if ccw.abs() < 1e-9 { continue; }
+        let mut planes: Vec<(bevy_math::DVec2, bevy_math::DVec2, f64)> = (0..3).map(|k| {
+            let (p, q) = (x[k], x[(k + 1) % 3]);
+            let e = q - p;
+            let inward = if ccw > 0.0 { bevy_math::DVec2::new(-e.y, e.x) } else { bevy_math::DVec2::new(e.y, -e.x) };
+            (inward, p, 0.0)
+        }).collect();
+        // s(X) = (v0 - X) . nv for X on t's plane: affine in the 2D point.
+        let v0 = v[0];
+        let s0 = (v0 - a).dot(nv);
+        let g = bevy_math::DVec2::new(-eu.dot(nv), -ew.dot(nv));
+        // s0 + g.X <= limit  and  -(s0 + g.X) <= limit, as inward form c + m.X >= 0.
+        planes.push((-g, bevy_math::DVec2::ZERO, limit - s0));
+        planes.push((g, bevy_math::DVec2::ZERO, limit + s0));
+        let mut next = Vec::new();
+        for poly in pieces {
+            // Untouched polygons stay whole (no needless split).
+            let mut probe = poly.clone();
+            for (k, &(m, p, c)) in planes.iter().enumerate() {
+                probe = clip64(&probe, |q| if k < 3 { m.dot(q - p) } else { c + m.dot(q) });
+                if probe.len() < 3 { break; }
+            }
+            if probe.len() < 3 || polygon_area64(&probe) < if square || preserve { 1e-8 } else { f64::from(PIECE_AREA) } { next.push(poly); continue; }
+            was_cut = true;
+            let mut rest = poly;
+            for (k, &(m, p, c)) in planes.iter().enumerate() {
+                let inside = |q: bevy_math::DVec2| if k < 3 { m.dot(q - p) } else { c + m.dot(q) };
+                let outside_piece = clip64(&rest, |q| -inside(q));
+                if outside_piece.len() >= 3 { next.push(outside_piece); }
+                rest = clip64(&rest, inside);
+                if rest.len() < 3 { break; }
+            }
+        }
+        pieces = next;
+        if pieces.is_empty() { break; }
+    }
+    // Raw residuals are inspected before simplification, share, width or area
+    // filters. Only clipping-tolerance degeneracies count as covered.
+    let raw_covered = pieces.iter().all(|p| polygon_area64(p) <= 1e-8);
+    let corners = corners.map(|p| p.as_vec2());
+    let mut out = Vec::new();
+    for poly in pieces {
+        let poly: Vec<Vec2> = poly.into_iter().map(|p| p.as_vec2()).collect();
+        // Cut remnants (design 2026-10-31 remnant cleanup): clipping leaves
+        // near-duplicate and collinear corners whose fan made 100-300 tiny
+        // triangles per railing mark (M23-M26) and the bowl connector (M21/22);
+        // the same surface with clean corners (GTA's own corners always stay).
+        // A remnant narrower than REMNANT_WIDTH that is only a small part of
+        // its face is a strip along the visible edge, not a surface; a long
+        // thin face the visible mesh barely touched keeps its remnant.
+        let poly = if was_cut && !preserve { simplify(&poly, &corners) } else { poly };
+        if poly.len() < 3 { continue; }
+        if !preserve && was_cut && convex_width(&poly) < REMNANT_WIDTH && f64::from(polygon_area(&poly)) <= f64::from(REMNANT_SHARE) * face_area { continue; }
+        for k in 1..poly.len() - 1 {
+            let tri = [to3(poly[0].as_dvec2()), to3(poly[k].as_dvec2()), to3(poly[k + 1].as_dvec2())];
+            let area = (tri[1] - tri[0]).cross(tri[2] - tri[0]).length() / 2.0;
+            let longest = tri[0].distance(tri[1]).max(tri[1].distance(tri[2])).max(tri[2].distance(tri[0]));
+            if !preserve && (area < f64::from(PIECE_AREA) || area / longest < f64::from(PIECE_WIDTH)) { continue; }
+            out.push(tri.map(|p| p.as_vec3().to_array()));
+        }
+    }
+    // An uncut triangle comes back exactly as it was.
+    if out.len() == 1 && pieces_equal(&out[0], t) { out = vec![*t]; }
+    Subtraction { pieces: out, raw_covered }
+}
+
+// Shared-edge subtraction uses double precision from the original world
+// positions, so thousands of small covers cannot leave float-rounding slits.
+fn polygon_area64(poly: &[bevy_math::DVec2]) -> f64 {
+    (1..poly.len().saturating_sub(1)).map(|k| (poly[k]-poly[0]).perp_dot(poly[k+1]-poly[0])).sum::<f64>().abs()*0.5
+}
+
+fn clip64(poly: &[bevy_math::DVec2], f: impl Fn(bevy_math::DVec2) -> f64) -> Vec<bevy_math::DVec2> {
+    let mut out = Vec::with_capacity(poly.len()+1);
+    for k in 0..poly.len() {
+        let (a,b) = (poly[k],poly[(k+1)%poly.len()]);
+        let (fa,fb) = (f(a),f(b));
+        if fa >= 0.0 { out.push(a); }
+        if (fa >= 0.0) != (fb >= 0.0) { out.push(a+(b-a)*(fa/(fa-fb))); }
+    }
+    out
+}
+
+/// Narrowest cut remnant kept (m): a strip below this beside the visible
+/// surface is a gap no wheel can catch, not a surface to ride.
+const REMNANT_WIDTH: f32 = 0.02;
+/// A cut piece under this area (m2), every point more than `HOVER_OFF` (m) and
+/// at most `HOVER_REACH` (m) off the visible model, in front of it, is a fragment.
+const HOVER_AREA: f32 = 0.05;
+const HOVER_OFF: f32 = 0.03;
+const HOVER_REACH: f32 = 0.60;
+/// A connected visible surface of at least this much (m2) owns its small faces too; a
+/// long handrail's tube has about 5.
+const SAME_SURFACE_AREA: f32 = 10.0;
+/// ... and that is at most this share of its original face's area.
+const REMNANT_SHARE: f32 = 0.25;
+/// Corners closer than this to a neighbour or to the line through their
+/// neighbours carry no shape (m).
+const CORNER: f32 = 0.001;
+
+/// A convex remnant without near-duplicate or collinear cut corners; the
+/// face's own corners are kept exactly (its neighbours share them).
+fn simplify(poly: &[Vec2], keep: &[Vec2]) -> Vec<Vec2> {
+    let mut p = poly.to_vec();
+    loop {
+        let n = p.len();
+        if n < 3 { return p; }
+        let drop = (0..n).find(|&k| {
+            if keep.iter().any(|q| q.distance(p[k]) < 1e-6) { return false; }
+            let (a, b, c) = (p[(k + n - 1) % n], p[k], p[(k + 1) % n]);
+            let ac = c - a;
+            a.distance(b) < CORNER || ac.length() < CORNER || ((b - a).perp_dot(ac) / ac.length()).abs() < CORNER
+        });
+        match drop { Some(k) => { p.remove(k); } None => return p }
+    }
+}
+
+/// Width of a convex polygon: the smallest of its edge-to-farthest-corner distances.
+fn convex_width(poly: &[Vec2]) -> f32 {
+    let n = poly.len();
+    (0..n).map(|k| {
+        let (a, e) = (poly[k], poly[(k + 1) % n] - poly[k]);
+        let len = e.length().max(1e-12);
+        poly.iter().map(|&q| (e.perp_dot(q - a) / len).abs()).fold(0.0, f32::max)
+    }).fold(f32::INFINITY, f32::min)
+}
+
+fn pieces_equal(a: &[[f32; 3]; 3], b: &[[f32; 3]; 3]) -> bool {
+    a.iter().zip(b).all(|(p, q)| v3(*p).distance(v3(*q)) < 1e-5)
+}
+
+fn polygon_area(poly: &[Vec2]) -> f32 {
+    (1..poly.len().saturating_sub(1)).map(|k| (poly[k] - poly[0]).perp_dot(poly[k + 1] - poly[0])).sum::<f32>().abs() / 2.0
+}
+
+/// Convex polygon `poly` clipped to `f(q) >= 0` (Sutherland-Hodgman, one plane).
+fn clip(poly: &[Vec2], f: impl Fn(Vec2) -> f32) -> Vec<Vec2> {
+    let mut out = Vec::with_capacity(poly.len() + 1);
+    for k in 0..poly.len() {
+        let (p, q) = (poly[k], poly[(k + 1) % poly.len()]);
+        let (fp, fq) = (f(p), f(q));
+        if fp >= 0.0 { out.push(p); }
+        if (fp >= 0.0) != (fq >= 0.0) {
+            out.push(p + (q - p) * (fp / (fp - fq)));
+        }
+    }
+    out
+}
+
+/// A vertex on the edge of a used visible triangle's footprint (projected
+/// along that triangle's normal, within `MATCH` of its plane) moves onto it;
+/// the smallest move wins. Depends only on the point, so every triangle
+/// sharing the vertex moves it the same way.
+fn snap(p: [f32; 3], used: &[Used], grid: &Grid) -> [f32; 3] {
+    let x = v3(p);
+    let mut best: Option<(f32, Vec3)> = None;
+    for &k in grid.at(x) {
+        let u = &used[k as usize];
+        let v = u.v.map(v3);
+        let cross = (v[1] - v[0]).cross(v[2] - v[0]);
+        let nv = cross.normalize_or_zero();
+        if nv == Vec3::ZERO { continue; }
+        // Never onto trim: a floor corner pulled 16 cm up onto a sliver of a
+        // raised slab tilted a whole floor piece (Strawberry -255,-1581, box
+        // bake 2026-11-07). Slivers still cut; they only hold no vertex.
+        if cross.length() / 2.0 < SLIVER_AREA { continue; }
+        let s = (v[0] - x).dot(nv);
+        if s.abs() > u.limit { continue; }
+        let q = x + nv * s;
+        // On the triangle (closed) and within ON_EDGE of one of its edges.
+        let inside = (0..3).all(|e| (v[(e + 1) % 3] - v[e]).cross(q - v[e]).dot(nv) >= -ON_EDGE * v[(e + 1) % 3].distance(v[e]));
+        if !inside { continue; }
+        let edge = (0..3).map(|e| {
+            let (a, b) = (v[e], v[(e + 1) % 3]);
+            let t = ((q - a).dot(b - a) / (b - a).length_squared().max(1e-12)).clamp(0.0, 1.0);
+            (a + (b - a) * t).distance(q)
+        }).fold(f32::MAX, f32::min);
+        if edge > ON_EDGE { continue; }
+        if best.is_none_or(|(d, _)| s.abs() < d) { best = Some((s.abs(), q)); }
+    }
+    match best {
+        Some((d, q)) if d > 1e-5 => q.to_array(),
+        _ => p,
+    }
+}
