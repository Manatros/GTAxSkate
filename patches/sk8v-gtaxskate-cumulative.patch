+            }
+        }
+        for k in 0..rings as u32 - 1 {
+            for j in 0..8u32 {
+                let (p, q) = (base + k * 8 + j, base + k * 8 + (j + 1) % 8);
+                idx.extend([p, q, p + 8, q, q + 8, p + 8]);
