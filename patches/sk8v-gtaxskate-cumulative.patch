diff --git a/tools/SkateVLegacy.ini.template b/tools/SkateVLegacy.ini.template
index df9b9b1047b943a9674ff41a38097941f058978b..1af6f6c8f2bb3b902ae3aaa3e00f47200225197f 100644
--- a/tools/SkateVLegacy.ini.template
+++ b/tools/SkateVLegacy.ini.template
@@ -13,6 +13,44 @@ Snow=0
 RadioControls=1
 ; TrickAnalyzer: 1 = Skate 3's Trick Analyzer shows each trick's stick gesture (bottom centre); 0 = off.
 TrickAnalyzer=1
+; Keyboard: without a controller, the keyboard and mouse play Skate (keys in SkateVKeys.txt
+;   beside this file, written with the defaults: WASD move, Shift push, Space pop, arrows trick
+;   stick, E board, Q hippie jump). 0 turns it off.
+Keyboard=1
+; KeyboardHints: while skating on the keyboard, its keys down the left side of the screen. 0 hides them.
+KeyboardHints=1
+; GpsWhileSkating: GTA's GPS route to the waypoint stays on while skating (as in a vehicle). 0 turns it off.
+GpsWhileSkating=1
+; SkateSpots: GTA's skate parks (Vespucci Beach, Hawick, Little Seoul, Strawberry, La Mesa) as map blips. 0 turns it off.
+SkateSpots=1
+; BoardShop: Skate 3's boards and parts for sale in Binco, the Discount Store and Suburban (G in the store).
+;   Needs the part models (tools/prepare-board-parts.py). 0 turns it off.
+BoardShop=1
+; WheelsFromPaint: painted wheels from the shop set the wheel hardness (matte soft, gloss medium, metallic hard);
+;   0 keeps WheelHardness.
+WheelsFromPaint=1
+; CameraView: standard view for the first session (or every session with CameraRemember=0).
+; Skate = original SK8V / Skate 3; Near, Middle, Far, FirstPerson = GTA's own on-foot camera.
+; Head is a legacy alias for FirstPerson. V cycles Skate -> Near -> Middle -> Far -> FirstPerson.
+; R (keyboard) cycles the cinematic camera, skate filmer and back.
+CameraView=Skate
+; CameraRemember: remember whether SK8V or GTA was last used while skating.
+; A remembered GTA view keeps the current on-foot mode and orientation when getting on.
+CameraRemember=1
+; Legacy CameraFollow and CameraFocus values are accepted but no longer used.
+; The cinematic camera's and the skate filmer's look (R): a GTA timecycle modifier each ("none" for none) and its strength.
+CinemaFilter=NG_filmic01
+FilmerFilter=NG_filmic06
+FilmFilterStrength=0.85
+; SkateRadio: the radio station skate mode tunes to, e.g. RADIO_19_USER (Self Radio: your User Music, such as
+;   Skate 3's soundtrack). Empty leaves the radio as it is.
+SkateRadio=
+; PedsSurvive: 1 = peds the board knocks down cannot die until they are up again (bowled over, not
+;   killed; with PedLaunch=0 they are pushed rather than launched). 0 = as Skate's impulse leaves them.
+PedsSurvive=0
+; VehicleShapes: 1 = a vehicle model with no extracted bound (most DLC cars) is surveyed once with probes, so it
+;   has a roof, hood and trunk to ride and a gap under it to hippie jump, not its bounding box. 0 = the box.
+VehicleShapes=1
 DrawBoard=1
 ; Native Skate board: owned skeletal drawable, original texture/normal/specular inputs, GTA lighting and shadows.
 BoardNative=1
