+        assert_eq!(Garage::from_text(&text), garage);
+        let mut forged = text.clone();
+        forged.push_str("riding d1:ff,,\n");
+        assert!(Garage::from_text(&forged).riding.is_default(), "an unbought deck is not ridden");
+    }
+
+    #[test]
+    fn the_list_scrolls_with_the_row() {
+        let offers: Vec<Offer> = (0..30)
+            .map(|i| Offer { title: i.to_string(), goods: Goods::Part(Part::Deck, PartRef::new("a", "b")), price: 1, preview: String::new(), group: None })
+            .collect();
+        let mut menu = Menu::new(Tier::Mid, vec![Section { title: "Deck".into(), offers }]);
+        let garage = Garage::default();
+        assert_eq!(menu.first_visible(), 0);
+        for _ in 0..12 {
+            menu.handle(Input::Down, &garage);
+        }
+        let first = menu.first_visible();
+        assert!(first <= 12 && 12 < first + VISIBLE, "{first}");
+        menu.handle(Input::Up, &garage);
+        for _ in 0..20 {
+            menu.handle(Input::Down, &garage);
+        }
+        assert_eq!(menu.row, 1, "wrapped");
+        assert_eq!(menu.first_visible(), 0);
+        assert_eq!(Tier::parse("Ponsonbys"), Some(Tier::High));
+    }
+
+    #[test]
+    fn parts_are_listed_by_maker_and_a_maker_opens_and_closes() {
+        let offer = |title: &str, group: &str| Offer {
+            title: title.into(),
+            goods: Goods::Grip(title.into()),
+            price: 10,
+            preview: String::new(),
+            group: Some(group.into()),
+        };
+        let offers = vec![offer("Bailout", "Zero"), offer("Baked", "Baker"), offer("Koston", "Girl"), offer("Strapped", "Zero")];
+        let mut menu = Menu::new(Tier::Mid, vec![Section { title: "Deck".into(), offers }]);
+        let garage = Garage::default();
+        assert_eq!(menu.lines(), [Line::Group("Baker".into(), 1), Line::Group("Girl".into(), 1), Line::Group("Zero".into(), 2)]);
+        assert_eq!(menu.current(), None, "a maker is no offer");
+        menu.handle(Input::Down, &garage);
+        menu.handle(Input::Down, &garage);
+        assert_eq!(menu.handle(Input::Accept, &garage), Action::None, "opening buys nothing");
+        let titles: Vec<String> = menu.lines().iter().map(|l| match l { Line::Offer(o) => o.title.clone(), Line::Group(g, _) => g.clone() }).collect();
+        assert_eq!(titles, ["Bailout", "Strapped"]);
+        assert!(matches!(menu.handle(Input::Accept, &garage), Action::Buy(_)));
+        assert_eq!(menu.handle(Input::Back, &garage), Action::None, "back closes the maker");
+        assert_eq!(menu.row, 2, "on the maker it was");
+        assert_eq!(menu.handle(Input::Back, &garage), Action::Close);
+    }
+
+    #[test]
+    fn stall_racks_stand_boards_upright_in_front_of_the_shelves_on_the_floor() {
+        use bevy_math::{Vec2, Vec3};
+        let floor = 3.34;
+        let racks = super::stall_racks(floor, 12);
+        assert_eq!(racks.len(), 12);
+        assert_eq!(super::stall_racks(floor, super::STALL_BOARDS).len(), super::STALL_BOARDS);
+        let along = Vec2::from(super::STALL_ALONG).normalize();
+        for (k, m) in racks.iter().enumerate() {
+            let (x, z, o) = (m.x_axis.truncate(), m.z_axis.truncate(), m.w_axis.truncate());
+            assert!((x.length() - 1.).abs() < 1e-4 && (z.length() - 1.).abs() < 1e-4 && x.dot(z).abs() < 1e-4, "orthonormal {k}");
+            assert!(z.z > 15f32.to_radians().cos(), "upright within 15 deg: {k}");
+            let tail = o - z * 0.1;
+            assert!((tail.z - floor).abs() < 0.02, "tail on the floor: {k} {tail:?}");
+            let (centre, n) = super::STALL_UNITS[k / 2];
+            let n = Vec2::from(n).normalize();
+            let rel = o.truncate() - Vec2::from(centre);
+            assert!(x.truncate().normalize().dot(n) > 0.95, "graphic out of the shelf: {k}");
+            assert!((rel.dot(n) - 0.40).abs() < 1e-3 && rel.dot(along).abs() <= 0.36, "in front of its unit: {k}");
+            // The top tips toward the shelf, and stays 5 cm or more clear of its front.
+            let top = (o + z * 0.7).truncate() - Vec2::from(centre);
+            assert!(top.dot(n) < rel.dot(n) && top.dot(n) > 0.25, "lean toward the shelf, clear of it: {k}");
+            // No point of the board (length 0.8 m from 0.1 behind the origin) inside any unit.
+            for t in [-0.1f32, 0.3, 0.7] {
+                let p = (o + z * t).truncate();
+                for (c, un) in super::STALL_UNITS {
+                    let (c, un) = (Vec2::from(c), Vec2::from(un).normalize());
+                    let r = p - c;
+                    assert!(!(r.dot(un).abs() < 0.2 && r.dot(along).abs() < 0.7), "board {k} at {t} inside a shelf");
+                }
+            }
+        }
+        let mut seen: Vec<Vec3> = Vec::new();
+        for m in &racks { let o = m.w_axis.truncate(); assert!(seen.iter().all(|s| s.distance(o) > 0.3)); seen.push(o); }
+    }
+
+}
diff --git a/rust/skatev-runtime/src/spot.rs b/rust/skatev-runtime/src/spot.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a1f7b2349b58b81587b9bc77418d9e5181975ea4
--- /dev/null
+++ b/rust/skatev-runtime/src/spot.rs
@@ -0,0 +1,281 @@
+//! What collision lies at a spot (design 2026-10-26-one-source-collision 6.3,
+//! 6.4; Manatros 2026-10-26: "add IDs to the different faces to see which
+//! bake id they got"). The installed area's faces with their origins are
+//! kept here whether or not the collision view is on; Developer > Mark this
+//! spot asks for them (`sv_describe_spot`) and the runtime log gets a
+//! MARK-INFO block.
+use bevy_math::Vec3;
+use rustc_hash::FxHashMap as HashMap;
+use std::sync::Mutex;
+
+/// Per triangle an index into `names` (area level: "tile x_y: file").
+#[derive(Default, Clone)]
+pub struct Origins {
+    pub per: Vec<u32>,
+    pub names: Vec<String>,
+    index: HashMap<String, u32>,
+}
+
+impl Origins {
+    pub fn id(&mut self, name: &str) -> u32 {
+        if let Some(&k) = self.index.get(name) {
+            return k;
+        }
+        let k = self.names.len() as u32;
+        self.index.insert(name.to_owned(), k);
+        self.names.push(name.to_owned());
+        k
+    }
+
+    pub fn push(&mut self, name: &str) {
+        let k = self.id(name);
+        self.per.push(k);
+    }
+}
+
+struct Installed {
+    /// GTA space, with tag and origin name.
+    faces: Vec<([Vec3; 3], u32, String)>,
+    rails: Vec<Vec<Vec3>>,
+}
+
+/// A moving body near the player as the last dynamic update had it.
+#[derive(Clone)]
+pub struct Body {
+    pub model: u32,
+    pub position: Vec3,
+    pub triangles: usize,
+    pub fixed: bool,
+    pub allow_box: bool,
+}
+
+static INSTALLED: Mutex<Option<Installed>> = Mutex::new(None);
+static BODIES: Mutex<Vec<Body>> = Mutex::new(Vec::new());
+
+/// Contact witness (design 2026-11-02-contact-witness): the last hard
+/// (non-floor) contacts of the board with the static world, each with the
+/// face it hit as installed then, newest last.
+struct Hit {
+    tick: u64,
+    body: String,
+    point: Vec3,
+    normal: Vec3,
+    face: Option<([Vec3; 3], u32, String)>,
+}
+static HITS: Mutex<std::collections::VecDeque<Hit>> = Mutex::new(std::collections::VecDeque::new());
+/// How far back Mark this spot reports (Skate ticks, 60 a second).
+const HIT_TICKS: u64 = 180;
+const HIT_KEEP: usize = 400;
+static LAST_TICK: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// One tick's hard contacts (Skate space, as `Session::take_static_hits`).
+pub fn record_hits(tick: u64, hits: Vec<(usize, [f32; 3], [f32; 3], String)>) {
+    LAST_TICK.store(tick, std::sync::atomic::Ordering::Relaxed);
+    // The faces first (INSTALLED, then HITS: never both held, so no lock order to keep).
+    let new: Vec<Hit> = if hits.is_empty() {
+        Vec::new()
+    } else {
+        let installed = INSTALLED.lock().unwrap();
+        // Board parts only (wheels, trucks, deck): the skater's own volumes
+        // touch walls in every bail and read as "Attached(n)" (peer review).
+        hits.into_iter().filter(|h| h.3.starts_with("Board(")).map(|(index, point, normal, body)| Hit {
+            tick,
+            body,
+            point: crate::coords::from_skate(Vec3::from_array(point)),
+            normal: crate::coords::basis() * Vec3::from_array(normal),
+            face: installed.as_ref().and_then(|a| a.faces.get(index)).cloned(),
+        }).collect()
+    };
+    let mut kept = HITS.lock().unwrap();
+    while kept.front().is_some_and(|h| h.tick + HIT_TICKS < tick || h.tick > tick) {
+        kept.pop_front();
+    }
+    for hit in new {
+        // One entry per face and body, renewed by each contact, so a board
+        // resting against a lip cannot push the stopping face out (peer review).
+        let face = |h: &Hit| h.face.as_ref().map(|f| f.0);
+        if let Some(i) = kept.iter().position(|h| h.body == hit.body && face(h).is_some() && face(h) == face(&hit)) {
+            kept.remove(i);
+        }
+        kept.push_back(hit);
+        if kept.len() > HIT_KEEP {
+            kept.pop_front();
+        }
+    }
+}
+
+/// The witness lines for MARK-INFO: per face hit, newest first.
+fn hit_lines(now: u64) -> String {
+    let kept = HITS.lock().unwrap();
+    if kept.is_empty() {
+        return "  hard contacts in the last 3 s: none\n".to_owned();
+    }
+    let mut out = format!("  hard contacts in the last 3 s: {}\n", kept.len());
+    // One line per face (its newest contact) and body, newest first.
+    let mut seen: Vec<(String, String)> = Vec::new();
+    for h in kept.iter().rev() {
+        let key = (h.face.as_ref().map_or("?".to_owned(), |f| format!("{:?}", f.0)), h.body.clone());
+        if seen.contains(&key) {
+            continue;
+        }
+        seen.push(key);
+        if seen.len() > 16 {
+            break;
+        }
+        let ago = now.saturating_sub(h.tick) as f32 / 60.0;
+        out.push_str(&format!("    {ago:.2} s ago {} at {:.2} {:.2} {:.2} normal {:.2} {:.2} {:.2}", h.body, h.point.x, h.point.y, h.point.z,
+            h.normal.x, h.normal.y, h.normal.z));
+        match &h.face {
+            Some((t, tag, origin)) => {
+                let c = (t[0] + t[1] + t[2]) / 3.0;
+                let n = (t[1] - t[0]).cross(t[2] - t[0]).normalize_or_zero();
+                let area = (t[1] - t[0]).cross(t[2] - t[0]).length() / 2.0;
+                out.push_str(&format!(": {} centre {:.2} {:.2} {:.2} normal {:.2} {:.2} {:.2} area {:.4} m2 tags {} from {origin}\n",
+                    kind(t), c.x, c.y, c.z, n.x, n.y, n.z, area, tag_names(*tag)));
+                out.push_str(&format!("      corners {:.3} {:.3} {:.3} / {:.3} {:.3} {:.3} / {:.3} {:.3} {:.3}\n",
+                    t[0].x, t[0].y, t[0].z, t[1].x, t[1].y, t[1].z, t[2].x, t[2].y, t[2].z));
+            }
+            None => out.push_str(": face not in the installed area (rebuilt since)\n"),
+        }
+    }
+    out
+}
+static STATUS: Mutex<String> = Mutex::new(String::new());
+
+/// Tag bits and their names (`live.rs`, `skate_host::bridge::NO_GRIND_TAG`).
+fn tag_names(tag: u32) -> String {
+    let bits: [(u32, &str); 13] = [
+        (crate::live::PARKMESH_TAG, "park-visible"),
+        (crate::live::PARKCUT_TAG, "park-cut"),
+        (crate::live::PARKGTA_TAG, "park-gta"),
+        (crate::live::URAMP_TAG, "unflagged-ramp"),
+        (crate::live::USTEP_TAG, "unflagged-step"),
+        (crate::live::FALLBACK_TAG, "fallback"),
+        (crate::live::STEP_TAG, "step"),
+        (crate::live::RAMP_TAG, "ramp"),
+        (crate::live::LIVE_TAG, "live"),
+        (crate::live::RAILBOX_TAG, "railbox"),
+        (crate::live::VISBAR_TAG, "visbar"),
+        (crate::live::SLAB_TAG, "slab"),
+        (skate_host::bridge::NO_GRIND_TAG, "no-grind"),
+    ];
+    let names: Vec<&str> = bits.iter().filter(|(b, _)| tag & b != 0).map(|(_, n)| *n).collect();
+    if names.is_empty() { "-".to_owned() } else { names.join("+") }
+}
+
+fn kind(t: &[Vec3; 3]) -> &'static str {
+    let n = (t[1] - t[0]).cross(t[2] - t[0]).normalize_or_zero();
+    if n.z >= 0.65 { "floor" } else if n.z > 0.2 { "bank" } else if n.z >= -0.2 { "wall" } else { "underside" }
+}
+
+/// The area just installed into Skate (Skate space, as `world::Area`).
+pub fn install(area: &crate::world::Area) {
+    let g = |p: [f32; 3]| crate::coords::from_skate(Vec3::from_array(p));
+    let faces = area.triangles.iter().zip(&area.tags).enumerate().map(|(i, (t, &tag))| {
+        let name = area.origins.per.get(i).and_then(|&k| area.origins.names.get(k as usize)).cloned()
+            .unwrap_or_else(|| "live GTA collision (no baked tile here, or plain GTA compare)".to_owned());
+        (t.map(g), tag, name)
+    }).collect();
+    let rails = area.rails.iter().map(|r| r.iter().map(|&p| g(p)).collect()).collect();
+    *INSTALLED.lock().unwrap() = Some(Installed { faces, rails });
+}
+
+pub fn set_bodies(bodies: Vec<Body>) {
+    *BODIES.lock().unwrap() = bodies;
+}
+
+/// Legend line 2 of the collision view (design 6.3).
+pub fn set_status(status: String) {
+    *STATUS.lock().unwrap() = status;
+}
+
+pub fn status() -> String {
+    STATUS.lock().unwrap().clone()
+}
+
+fn face_distance(p: Vec3, t: &[Vec3; 3]) -> f32 {
+    crate::world::closest_on_triangle(p, t).distance(p)
+}
+
+fn segment_distance(p: Vec3, a: Vec3, b: Vec3) -> f32 {
+    let ab = b - a;
+    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-12)).clamp(0.0, 1.0);
+    (a + ab * t).distance(p)
+}
+
+/// The MARK-INFO text for GTA point `centre` and how many faces it names.
+pub fn describe(centre: Vec3, radius: f32) -> (String, usize) {
+    let mut out = format!("MARK-INFO at {:.2} {:.2} {:.2} (within {radius:.1} m)\n  {}\n", centre.x, centre.y, centre.z, status());
+    // The witness first: HITS and INSTALLED are never held together.
+    let witness = hit_lines(LAST_TICK.load(std::sync::atomic::Ordering::Relaxed));
+    let installed = INSTALLED.lock().unwrap();
+    let Some(area) = installed.as_ref() else {
+        out.push_str("  no collision area installed\n");
+        return (out, 0);
+    };
+    let near: Vec<&([Vec3; 3], u32, String)> = area.faces.iter().filter(|(t, _, _)| face_distance(centre, t) <= radius).collect();
+    // Grouped by origin, kind and tags.
+    let mut groups: std::collections::BTreeMap<(String, &str, String), usize> = Default::default();
+    for (t, tag, origin) in &near {
+        *groups.entry((origin.clone(), kind(t), tag_names(*tag))).or_default() += 1;
+    }
+    out.push_str(&format!("  {} faces:\n", near.len()));
+    for ((origin, kind, tags), n) in groups.iter().take(60) {
+        out.push_str(&format!("    {n:4} {kind:9} tags {tags:28} from {origin}\n"));
+    }
+    // The nearest faces one by one (what the board touches).
+    let mut nearest: Vec<_> = near.iter().map(|f| (face_distance(centre, &f.0), *f)).collect();
+    nearest.sort_by(|a, b| a.0.total_cmp(&b.0));
+    for (d, (t, tag, origin)) in nearest.iter().take(12) {
+        let c = (t[0] + t[1] + t[2]) / 3.0;
+        out.push_str(&format!("    face {d:.2} m: {} centre {:.2} {:.2} {:.2} tags {} from {origin}\n", kind(t), c.x, c.y, c.z, tag_names(*tag)));
+    }
+    let rails: Vec<&Vec<Vec3>> = area.rails.iter()
+        .filter(|r| r.windows(2).any(|w| segment_distance(centre, w[0], w[1]) <= radius + 1.0))
+        .collect();
+    out.push_str(&format!("  {} grind lines within {:.1} m:\n", rails.len(), radius + 1.0));
+    for r in rails.iter().take(20) {
+        let len: f32 = r.windows(2).map(|w| w[0].distance(w[1])).sum();
+        let (a, b) = (r[0], r[r.len() - 1]);
+        out.push_str(&format!("    {len:5.2} m, {} points, {:.2} {:.2} {:.2} -> {:.2} {:.2} {:.2}\n", r.len(), a.x, a.y, a.z, b.x, b.y, b.z));
+    }
+    let bodies = BODIES.lock().unwrap();
+    let close: Vec<&Body> = bodies.iter().filter(|b| b.position.distance(centre) <= radius + 3.0).collect();
+    out.push_str(&format!("  {} moving or placed bodies within {:.1} m:\n", close.len(), radius + 3.0));
+    for b in close.iter().take(20) {
+        out.push_str(&format!("    model {:08x} at {:.2} {:.2} {:.2}: {} triangles{}{}\n", b.model, b.position.x, b.position.y, b.position.z, b.triangles,
+            if b.fixed { ", fixed (dropped object)" } else { "" },
+            if b.allow_box && b.triangles == 12 { ", BOX (no exact collision)" } else { "" }));
+    }
+    out.push_str(&witness);
+    (out, near.len())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tags_read_as_names() {
+        assert_eq!(tag_names(0), "-");
+        assert_eq!(tag_names(crate::live::PARKMESH_TAG | crate::live::PARKCUT_TAG), "park-visible+park-cut");
+    }
+
+    /// Design 2026-11-02 contact witness: hard contacts are kept 3 s, one
+    /// line per face and body, newest first; older ones go.
+    #[test]
+    fn hard_contacts_are_kept_three_seconds_one_line_per_face() {
+        let hit = |i: usize, body: &str| (i, [0.0, 0.5, 0.0], [1.0, 0.1, 0.0], body.to_owned());
+        record_hits(1000, vec![hit(7, "Board(RightFrontWheel)"), hit(7, "Board(RightFrontWheel)"), hit(8, "Board(Deck)")]);
+        record_hits(1100, vec![hit(9, "Board(LeftBackWheel)")]);
+        let lines = hit_lines(1100);
+        assert!(lines.contains("hard contacts in the last 3 s: 4"), "{lines}");
+        // No area installed in this test: the faces are named as rebuilt since.
+        // Two contacts of the front wheel make one line: three lines in all.
+        assert_eq!(lines.matches("face not in the installed area").count(), 3, "one line per face and body: {lines}");
+        assert!(lines.find("LeftBackWheel").unwrap() < lines.find("Deck").unwrap(), "newest first: {lines}");
+        // 3 s (180 ticks) after tick 1000 those are gone; the one at 1100 stays.
+        record_hits(1279, Vec::new());
+        assert!(hit_lines(1279).contains("hard contacts in the last 3 s: 1"), "{}", hit_lines(1279));
+    }
+}
diff --git a/rust/skatev-runtime/src/stairs.rs b/rust/skatev-runtime/src/stairs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..960eda9d375e37b3b7db806ebfba1d95d9fee903
--- /dev/null
+++ b/rust/skatev-runtime/src/stairs.rs
@@ -0,0 +1,143 @@
+//! Conservative fallback for unflagged mineral stair ramps. No detail-copy
+//! matching: approved planar flights go through the same 17 cm terrace builder.
+use bevy_math::Vec3;
+use rustc_hash::FxHashMap;
+use svwc::Tri;
+
+/// GTAxSkate UnflaggedStairs (World page, test, default off): a fall through
+/// Skate's collision at a replaced flight (2026-10-20 16:14) and the earlier
+/// holes from guessed stairs keep it opt-in until verified.
+pub static ENABLED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn rebuild(tris: &mut Vec<Tri>, tubes: &[([f32; 3], [f32; 3], f32)]) -> (Vec<Tri>, usize) {
+    if !ENABLED.load(std::sync::atomic::Ordering::Relaxed) {
+        return (Vec::new(), 0);
+    }
+    rebuild_enabled(tris, tubes)
+}
+
+fn rebuild_enabled(tris: &mut Vec<Tri>, tubes: &[([f32; 3], [f32; 3], f32)]) -> (Vec<Tri>, usize) {
+    let (steps, ramps) = rebuild_keeping(tris, tubes);
+    (steps, ramps.len())
+}
+
+/// The unflagged rebuild whatever the switch, returning the replaced ramps
+/// too (the bake keeps both variants; the game picks one by its setting).
+pub fn rebuild_keeping(tris: &mut Vec<Tri>, tubes: &[([f32; 3], [f32; 3], f32)]) -> (Vec<Tri>, Vec<Tri>) {
+    let points: Vec<_> = tris.iter().map(|t| t.v.map(Vec3::from_array)).collect();
+    let normal = |i: usize| (points[i][1] - points[i][0]).cross(points[i][2] - points[i][0]).normalize_or_zero();
+    let candidates: Vec<_> = (0..tris.len()).filter(|&i| {
+        matches!(tris[i].material, 1..=3 | 14..=17 | 81 | 174)
+            && (40f32.to_radians().cos()..=25f32.to_radians().cos()).contains(&normal(i).z)
+    }).collect();
+    if candidates.is_empty() { return (Vec::new(), Vec::new()); }
+    let mut parent: Vec<_> = (0..candidates.len()).collect();
+    fn root(parent: &mut [usize], i: usize) -> usize {
+        if parent[i] != i { parent[i] = root(parent, parent[i]); }
+        parent[i]
+    }
+    let mut edges: FxHashMap<([i32; 3], [i32; 3]), Vec<usize>> = FxHashMap::default();
+    for (k, &i) in candidates.iter().enumerate() {
+        for e in 0..3 {
+            let key = |v: Vec3| v.to_array().map(|x| (x * 100.).round() as i32);
+            let (a, b) = (key(points[i][e]), key(points[i][(e + 1) % 3]));
+            let peers = edges.entry(if a < b { (a, b) } else { (b, a) }).or_default();
+            for &j in peers.iter() {
+                if tris[i].material == tris[candidates[j]].material && normal(i).dot(normal(candidates[j])) > 0.9999 {
+                    let (a, b) = (root(&mut parent, k), root(&mut parent, j));
+                    parent[a] = b;
+                }
+            }
+            peers.push(k);
+        }
+    }
+    let mut groups: FxHashMap<usize, Vec<usize>> = FxHashMap::default();
+    for (k, &i) in candidates.iter().enumerate() { groups.entry(root(&mut parent, k)).or_default().push(i); }
+    let grid = crate::grid::XyGrid::triangles(2., &points);
+    let mut drop = vec![false; tris.len()];
+    let mut steps = Vec::new();
+    for group in groups.values() {
+        let n = normal(group[0]);
+        let up = Vec3::new(-n.x, -n.y, 0.).normalize();
+        let side = Vec3::new(-up.y, up.x, 0.);
+        let origin = points[group[0]][0];
+        let (mut lo, mut hi) = (Vec3::splat(f32::MAX), Vec3::splat(f32::MIN));
+        let (mut u0, mut u1, mut v0, mut v1) = (f32::MAX, f32::MIN, f32::MAX, f32::MIN);
+        let mut area = 0.;
+        let mut planar = true;
+        for &i in group {
+            let t = points[i];
+            area += (t[1] - t[0]).cross(t[2] - t[0]).z * 0.5;
+            for p in t {
+                planar &= (p - origin).dot(n).abs() <= 0.02;
+                lo = lo.min(p); hi = hi.max(p);
+                u0 = u0.min(p.dot(up)); u1 = u1.max(p.dot(up));
+                v0 = v0.min(p.dot(side)); v1 = v1.max(p.dot(side));
+            }
+        }
+        let (length, width) = (u1 - u0, v1 - v0);
+        // Full rectangular footprint prevents sparse strips/triangles passing
+        // just because their bounding box is large enough.
+        if !planar || length < 1.5 || width < 1.0 || !(0.95..=1.05).contains(&(area / (length * width))) { continue; }
+        // Conservative AABB separation from *all* decoded tubes, independent
+        // of TubeRails. Rejection may be wider than 0.5 m, never narrower.
+        if tubes.iter().any(|&(a, b, radius)| {
+            let (a, b) = (Vec3::from_array(a), Vec3::from_array(b));
+            let pad = Vec3::splat(0.5 + radius);
+            (a.min(b) - pad).cmple(hi).all() && (a.max(b) + pad).cmpge(lo).all()
+        }) { continue; }
+        let landing = |u: f32, z: f32| {
+            [0.15, 0.5, 0.85].into_iter().all(|f| {
+                let p = up * u + side * (v0 + width * f);
+                grid.at(p.x, p.y).iter().any(|&j| {
+                    let j = j as usize;
+                    normal(j).z > 0.995 && svwc::clean::floor_at(&tris[j], [p.x, p.y]).is_some_and(|h| (h - z).abs() < 0.06)
+                })
+            })
+        };
+        if ![0.15, 0.4].into_iter().all(|d| landing(u0 - d, lo.z) && landing(u1 + d, hi.z)) { continue; }
+        let flight: Vec<_> = group.iter().map(|&i| tris[i]).collect();
+        let built = svwc::clean::terrace(&flight);
+        if built.is_empty() { continue; }
+        steps.extend(built);
+        for &i in group { drop[i] = true; }
+    }
+    let mut removed = Vec::new();
+    let mut i = 0;
+    tris.retain(|t| { let keep = !drop[i]; if !keep { removed.push(*t); } i += 1; keep });
+    (steps, removed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn scene(material: u8) -> Vec<Tri> {
+        let mut tris = Vec::new();
+        for (y0, y1, z0, z1) in [(-1., 0., 0., 0.), (0., 3., 0., 1.8), (3., 4., 1.8, 1.8)] {
+            let [a, b, c, d] = [[0., y0, z0], [2., y0, z0], [2., y1, z1], [0., y1, z1]];
+            tris.extend([Tri { v: [a, b, c], material }, Tri { v: [a, c, d], material }]);
+        }
+        tris
+    }
+    #[test]
+    fn concrete_flight_between_landings_becomes_steps() {
+        let mut tris = scene(1);
+        let (steps, replaced) = rebuild_enabled(&mut tris, &[]);
+        assert_eq!(replaced, 2);
+        assert_eq!(tris.len(), 4);
+        assert!(steps.len() > 20);
+        assert!(steps.iter().any(|t| t.v.iter().all(|p| p[2] == t.v[0][2])));
+    }
+    #[test]
+    fn coping_wood_metal_and_missing_landings_keep_ramps() {
+        for material in [55, 69] { assert_eq!(rebuild_enabled(&mut scene(material), &[]).1, 0); }
+        assert_eq!(rebuild_enabled(&mut scene(1), &[([0., 3., 1.8], [2., 3., 1.8], 0.05)]).1, 0);
+        assert_eq!(rebuild_enabled(&mut scene(1), &[([0., 0., 0.], [0., 3., 1.8], 0.05)]).1, 0,
+            "sloping coping remains protected too");
+        let mut no_landing = scene(1); no_landing.truncate(4);
+        assert_eq!(rebuild_enabled(&mut no_landing, &[]).1, 0);
+        let mut narrow = scene(1);
+        for t in &mut narrow { for p in &mut t.v { p[0] *= 0.4; } }
+        assert_eq!(rebuild_enabled(&mut narrow, &[]).1, 0);
+    }
+}
