+    /// An 8-sided tube of radius `r` from `a` to `b`, `rings` rings.
+    fn tube(a: V, b: V, r: f32, rings: usize, pos: &mut Vec<V>, idx: &mut Vec<u32>) {
+        let d = norm(sub(b, a));
