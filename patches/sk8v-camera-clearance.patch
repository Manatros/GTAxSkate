+// Keep a script-camera eye on the skater's side of world geometry. This is
+// deliberately independent of camera aim and does not alter GTA's own camera.
+void ConstrainCameraEye(Session& s, const float (&anchor)[3], float (&eye)[3], int flags) {
+    const int test = Call<int>(gta::START_EXPENSIVE_SYNCHRONOUS_SHAPE_TEST_LOS_PROBE,
+        anchor[0], anchor[1], anchor[2], eye[0], eye[1], eye[2], flags, s.ped, 7);
+    BOOL hit = 0;
+    Vector3 end{}, normal{};
+    Entity entity = 0;
+    if (Call<int>(gta::GET_SHAPE_TEST_RESULT, test, &hit, &end, &normal, &entity) != 2 || !hit) return;
+    const float d[3] = {anchor[0] - end.x, anchor[1] - end.y, anchor[2] - end.z};
+    const float len = std::sqrt(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+    const float k = len > 0.0001f ? std::min(0.3f / len, 1.0f) : 0.0f;
+    eye[0] = end.x + d[0] * k, eye[1] = end.y + d[1] * k, eye[2] = end.z + d[2] * k;
+}
