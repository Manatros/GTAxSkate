+// ReadPad resolves the active device, including native PlayStation/XInput.
+// A disabled GTA axis still reports controller trick input; it is not a
+// mouse delta merely because a script camera wants to look around.
+bool SkateMouseLook() {
+    return !g_controller && Call<BOOL>(gta::IS_USING_KEYBOARD_AND_MOUSE, 0);
+}
+
+void ReadSkateCameraLook(float& x, float& y) {
+    x = y = 0.0f;
+    if (!SkateMouseLook()) return;
+    x = Call<float>(gta::GET_DISABLED_CONTROL_NORMAL, 0, 1);
+    y = Call<float>(gta::GET_DISABLED_CONTROL_NORMAL, 0, 2);
+}
+
+void DisableControllerCameraLook(bool aiming) {
+    if (!g_controller || aiming || g_weaponWheel) return;
+    // These two axes must stay suppressed even after a long idle interval.
+    // Native aiming and the weapon wheel explicitly retain the right stick.
+    Call<void>(gta::DISABLE_CONTROL_ACTION, 0, 1, 1);
+    Call<void>(gta::DISABLE_CONTROL_ACTION, 0, 2, 1);
+}
